%% TEST-NAME: test-codepbackrefs-suppresses-auto
%% TEST-PURPOSE: Single-theorem double-emit scenario: theorem body calls
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-REND-INLINE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Single-theorem double-emit scenario: theorem body calls
%%            \codepbackrefs; auto-flush at theorem-end must NOT
%%            re-emit. PDF contains exactly one "Used in" line for
%%            thm:src (per-atom flag semantics).
%% TEST-SOURCE: wave3-plan-v11.md P01(A2) flag-suppresses-auto contract
%% TEST-SECTION: codependent.sty §\codepbackrefs, §per-atom flag CHECK
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{theorem} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:src}
%% TEST-PDF-CONTAINS: Used in 1.2
%% --- Exactly one "Used in 1.2" occurrence; theorem auto-flush suppressed.
%% TEST-PDF-STEXT-NOT: Used in 1\.2[^0-9].*Used in 1\.2
%% TEST-PACKAGES: amsthm,hyperref,codependent
%% TEST-RERUN: 2
%%
%% Sub-case 1 of the four suppression scenarios: single theorem calls
%% \codepbackrefs in body. At pass 2, the call-site emission fires
%% AND sets \codep@manuallyemitted@<atom-key>. The theorem-end auto
%% flush reads the flag via \ifcsname and skips; exactly one "Used in"
%% line appears. TEST-PDF-STEXT-NOT enforces no double emission.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Results}

\begin{theorem}\label{thm:src}
  Source theorem.
  \codepbackrefs
\end{theorem}

\begin{theorem}
  Second theorem referencing Theorem~\ref{thm:src}.
\end{theorem}

\END
\end{document}
