%% TEST-NAME: test-sbl-end-marker
%% TEST-WHAT: Verify the last record of the .sbl sidecar is the sentinel
%%            \semtex@sbl@end{OK}, written from \AtEndDocument.
%% TEST-SOURCE: REVIEW_C #7, DESIGN.md §9a "Close timing"
%% TEST-SECTION: DESIGN.md §9a Close timing
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-LAST-RECORD: \semtex@sbl@end{OK}
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% REVIEW_C finding #7. The .sbl sentinel is the CLI's
%% indicator that the file is complete and valid. If pdflatex
%% is killed with SIGKILL, hits \errmessage, or segfaults,
%% \AtEndDocument does not fire and the sentinel is absent.
%% The CLI treats absence as "stale / partial / corrupt" and
%% refuses to analyse. This fixture verifies the sentinel
%% lands as the FINAL record of the .sbl (no records may
%% follow it), so the CLI can stream-parse and trust any
%% data read up through the sentinel.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{End sentinel}

A single paragraph. After \end{document} the .sbl must have
exactly one end{OK} sentinel and no records after it.

\END
\end{document}
