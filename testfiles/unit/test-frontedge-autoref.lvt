%% TEST-NAME: test-frontedge-autoref
%% TEST-PURPOSE: Verify \autoref{thm:A} from theorem 1.2 emits
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \autoref{thm:A} from theorem 1.2 emits
%%            \codep@atomref{theorem:1.2}{thm:A} via the front-edge
%%            wrapper installed at begindocument/end.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 7: \autoref)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% hyperref's \autoref formats the reference with a type-specific
%% prefix ("Theorem~1.1") and routes through \HyRef@autosetref which
%% bypasses kernel \@setref. The backend patch (patching
%% \HyRef@autosetref directly) also fires at commit 2, but the
%% front-edge wrapper (wrapping the public \autoref macro at
%% begindocument/end) provides a second, label-level capture point
%% that will survive the backend removal in commit 3.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge autoref test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \autoref{thm:A} the conclusion follows.
\end{theorem}

\END
\end{document}
