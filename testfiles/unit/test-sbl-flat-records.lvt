%% TEST-NAME: test-sbl-flat-records
%% TEST-WHAT: Verify \semtextag{key}{value with spaces} produces a flat
%%            3-argument \semtex@sbl@tag record, NOT a kv blob embedded
%%            in a single argument.
%% TEST-SOURCE: REVIEW_C #6, DESIGN.md §9a "Record format" (flattened)
%% TEST-SECTION: DESIGN.md §9a Record format
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-CONTAINS: \semtex@sbl@tag{1.1}{uid}{cat:category theory}
%% TEST-SBL-NOT: \semtex@sbl@tag{1.1}{uid=cat:category theory}
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% REVIEW_C finding #6. The original v0.5 sketch proposed
%% records like \semtex@sbl@atom{1.1}{paragraph}{src=foo,env=bar}
%% with a comma-separated kv blob in the third argument. That
%% format is fragile: filenames can contain commas, values can
%% contain equals signs, and naive parsers misparse. The
%% landed design is flat: one metadata pair per record, fixed
%% arity. This fixture pins the flat shape specifically for
%% \semtextag{kind}{value}, where the value contains spaces.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Flat record}

A paragraph with a semantic tag.\semtextag{uid}{cat:category theory}
The \semtextag above must produce exactly one three-argument
\semtex@sbl@tag record in the .sbl, with atom number 1.1,
key "uid", and value "cat:category theory" (with a space).

\END
\end{document}
