%% TEST-NAME: test-frontedge-in-multiline-eq
%% TEST-WHAT: Verify that \ref inside an align environment (Track 2 source)
%%            produces exactly one atomref record despite both front-edge
%%            and backend potentially firing. The \codep@arw@pending guard
%%            prevents double-enqueue.
%% TEST-SOURCE: docs/SW5c.md §4 dual-fire guard; B-FRONTEDGE-DEDUP-EQ
%% TEST-SECTION: docs/SW5c.md §4 Equation deduplication
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1--2}{thm:A}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{theorem:1.1}{thm:A}
%% TEST-ATOMS-MIN: 1
%% TEST-PACKAGES: amsmath,hyperref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE, B-FRONTEDGE-DEDUP-EQ
%%
%% A two-line align environment (Track 2, range 1--2) references thm:A
%% via \ref. At commit 2 both the front-edge wrapper on \ref and the
%% backend track-2 instrumentation can fire. The pending guard
%% (\codep@arw@pending@<tgt>) ensures only one atomref is enqueued
%% for the align range. The TEST-AUX-NOT-CONTAINS line verifies no
%% rogue record attributes the edge to theorem:1.1 instead of the
%% align range.

\documentclass{article}
\usepackage{amsmath}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Equation dedup test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{align}
  a &= b \quad \text{by \ref{thm:A}} \label{eq:line1} \\
  c &= d \label{eq:line2}
\end{align}

\END
\end{document}
