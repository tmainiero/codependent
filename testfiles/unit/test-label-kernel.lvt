%% TEST-NAME: test-label-kernel
%% TEST-WHAT: Verify a plain \label{key} inside a tracked atom produces
%%            a \codep@cdp@label{<num>}{key} record in the sidecar.
%% TEST-SOURCE: docs/DESIGN.md §9a "Label wrap" emission site
%% TEST-SECTION: docs/DESIGN.md §9a Emission points (label wrap)
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@label{1.1}{thm:foo}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Baseline label-wrap regression. A plain \label{thm:foo}
%% inside a tracked theorem environment must be captured and
%% mirrored as a \codep@cdp@label record in the .cdp. The
%% record's first argument is the atom number (1.1 here) and
%% the second is the label key. No optional-arg branch is
%% exercised in this baseline; see test-label-cleveref-opt.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Label kernel}

\begin{theorem}\label{thm:foo}
  Statement.
\end{theorem}

\END
\end{document}
