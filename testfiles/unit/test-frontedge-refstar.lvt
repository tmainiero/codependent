%% TEST-NAME: test-frontedge-refstar
%% TEST-PURPOSE: Verify \ref*{thm:A} (star variant, suppresses hyperlink)
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \ref*{thm:A} (star variant, suppresses hyperlink)
%%            from theorem 1.2 still emits \codep@atomref{theorem:1.2}{thm:A}
%%            via the front-edge wrapper.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 2: \ref*)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% hyperref defines \ref* (starred) to suppress the hyperlink, routing
%% through \HyRef@@StarSetRef which bypasses our kernel \@setref patch.
%% The front-edge wrapper handles the star variant via \@ifstar so that
%% the atomref is still recorded even though no clickable link is
%% produced. This fixture pins that behaviour.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge ref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \ref*{thm:A} the conclusion follows (hyperlink suppressed).
\end{theorem}

\END
\end{document}
