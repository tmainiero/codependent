%% TEST-NAME: test-numbering-depth3
%% TEST-PURPOSE: depth=3 option produces section.subsection.subsubsection.atom
%% TEST-KIND: unit
%% TEST-STATUS: LIVE
%% TEST-WHAT: depth=3 option produces section.subsection.subsubsection.atom
%%            display numbers (e.g. "1.1.2.1") under the article class.
%% TEST-SOURCE: docs/DESIGN.md §Numbering "Depth"
%% TEST-SECTION: docs/DESIGN.md §Numbering, codependent.sty lines 200-204
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1.1.1}{paragraph} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1.2.1}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% (no TEST-BEHAVIOR: depth=3 display format has no matching B-* ID; B-NUM-DEPTH2 covers only 2-level format)
%%
%% Pins depth=3: atom resets on \subsubsection. Display format is
%% section.subsection.subsubsection.atom. Two subsubsections under
%% one subsection, one paragraph each, yields 1.1.1.1 and 1.1.2.1.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[depth=3]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Sec}
\subsection{Sub}

\subsubsection{SubSubA}

Paragraph under subsubsection A. Expected atom 1.1.1.1.

\subsubsection{SubSubB}

Paragraph under subsubsection B. Expected atom 1.1.2.1.

\END
\end{document}
