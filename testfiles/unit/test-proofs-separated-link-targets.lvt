%% TEST-NAME: test-proofs-separated-link-targets
%% TEST-PURPOSE: For a rebound proof (\codepproofof, B-PROOF-SEP), backref
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-SEP, B-LINK-PROOF-DEST, B-PROOF-ANCHOR-NEAR-HEADING
%% TEST-STATUS: LIVE
%% TEST-WHAT: For a rebound proof (\codepproofof, B-PROOF-SEP), backref
%%            entries in source-token "Used in" lists for both the
%%            pre-rebind id 2.1* and post-rebind id 1.1* land near
%%            the rebound proof's rendered heading.  The proof emits
%%            one proof-begin anchor; \codep@anchormap rebinds both
%%            proof keys onto that location.
%% TEST-SOURCE: .claude/comms/waves/W04/plan-synthesized-rev3.md (vii)
%% TEST-SECTION: codependent.sty §6 (\codep@proof@capturebeginanchor),
%%               §10 (\codep@proofof@resolve), §graph (\codep@graph@getanchor)
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-PDF-LINK-Y-NEAR: 1\.1\* | Proof of Theorem 1\.1 | within=10
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{2.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a2}{theorem:1.1}{1.1}{*}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a4}{theorem:1.1}{1.1}{*}
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a2}{codep-proof:a2}
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a4}{codep-proof:a4}
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a4}{codep-proof:a4}
%% TEST-AUX-NOT-CONTAINS: \codep@keymap
%% TEST-PACKAGES: amsthm,hyperref,codependent
%% TEST-RERUN: 2
%%
%% Companion to test-proofs-separated.lvt, which asserts the source-
%% level rendering ("Used in 2.1*" on thm:main, "Used in 1.1*" on
%% thm:target) without hyperref.  This fixture loads hyperref and
%% verifies the canonical proof:a<N> link annotation lands near the same
%% proof-begin anchor:
%%
%%   * Theorem 1.1 thm:main is referenced from the optional arg
%%     \ref{thm:main} in \begin{proof}[Proof of Theorem~\ref{thm:main}].
%%     That \ref runs BEFORE \codepproofof rebinds, so \codep@atomref
%%     records source-key proof:a4 (the canonical proof atom key).
%%     thm:main's "Used in" line contains "2.1*", and its link
%%     lands at the rebound proof's heading.
%%
%%   * Theorem 2.1 thm:target is referenced from the body's
%%     \ref{thm:target}, which runs AFTER \codepproofof rebinds.
%%     \codep@atomref records source-key proof:a4 (post-rebind).
%%     thm:target's "Used in" line contains "1.1*", and its link
%%     lands at the same rebound proof heading.
%%
%% The adjacent proof begin emits codep-proof:a4 before \codepproofof
%% rebinds the proof key.  \codep@proofof@resolve then aliases the
%% canonical proof:a4 key bound to that stored proof-begin anchor, so
%% pre- and post-rebind source keys both land near the same proof.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Statements}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  Main theorem statement.
\end{theorem}

% Adjacent proof: inherits 1.1*
\begin{proof}
  Adjacent proof of main theorem.
\end{proof}

\section{Deferred proofs}

% Atom 2.1 -- theorem (target for backref)
\begin{theorem}\label{thm:target}
  A target theorem.
\end{theorem}

% Non-adjacent proof with \codepproofof — rebound to thm:main.
% Optional-arg \ref{thm:main} fires pre-rebind (source-key proof:2.1);
% body \ref{thm:target} fires post-rebind (source-key proof:1.1).
\begin{proof}[Proof of Theorem~\ref{thm:main}]
  \codepproofof{thm:main}
  We reference \ref{thm:target} from inside this separated proof.
\end{proof}

\END
\end{document}
