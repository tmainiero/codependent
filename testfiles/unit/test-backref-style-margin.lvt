%% TEST-NAME: test-backref-style-margin
%% TEST-WHAT: Verify that backref-style=margin works as a package option
%%            passed to \usepackage, and that backrefs render without error.
%% TEST-SOURCE: DESIGN.md \semtexsetup key-value API, package options
%% TEST-SECTION: semtex.sty §Options, §Rendering
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.1}{theorem} = 1
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.2}{theorem} = 1
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% Passes backref-style=margin as a package option via \usepackage.
%% Two theorems where the second references the first exercise the
%% margin rendering path.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[backref-style=margin]{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Results}

\begin{theorem}\label{thm:X}
  First theorem.
\end{theorem}

\begin{theorem}
  Second theorem referencing Theorem~\ref{thm:X}.
\end{theorem}

\END
\end{document}
