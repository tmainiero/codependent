%% TEST-NAME: test-frontedge-Crefstar
%% TEST-WHAT: Verify \Cref*{thm:A} (capitalised, no hyperlink) from
%%            theorem 1.2 still emits \codep@atomref{theorem:1.2}{thm:A}.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 12: \Cref*)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% \Cref* combines sentence-start capitalisation with hyperlink
%% suppression. The front-edge wrapper for \Cref uses \@ifstar so that
%% both forms are intercepted by a single wrapper definition.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge Cref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  \Cref*{thm:A} gives the foundation (capitalised, no hyperlink).
\end{theorem}

\END
\end{document}
