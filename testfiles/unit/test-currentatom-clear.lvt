%% TEST-NAME: test-currentatom-clear
%% TEST-WHAT: Verify a \ref AFTER an atom but BEFORE the next atom does
%%            NOT get attributed to the just-ended atom. The \ref fires
%%            in a between-atoms gap (e.g., section heading, caption,
%%            footnote) where \codep@currentatom must be \@empty.
%% TEST-SOURCE: REVIEW_A finding 3 (LIVE DEFECT in current codependent.sty),
%%              REVIEW_C #4 (MAJOR), REVIEW_E reaffirmation
%% TEST-SECTION: DESIGN.md §8a.5 currentatom state management
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@sbl@end{OK}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{1.1.2}{thm:A}
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% Current codependent.sty (v0.1, lines 244-255 area) sets
%% \codep@currentatom on theorem-begin and on para/begin but
%% does NOT clear it on atom-end. As a result, a \ref fired
%% between atoms (in a section heading, caption, or after the
%% paragraph but before another paragraph starts) gets
%% attributed to the LAST atom, producing a wrong-source edge
%% in the backref graph.
%%
%% The fix in §8a.5 adds \let\codep@currentatom\@empty to
%% three sites:
%%   1. \AtEndEnvironment for tracked theorem envs (after the
%%      backref flush)
%%   2. \AtEndEnvironment{proof} (after the flush)
%%   3. \AddToHook{para/end} after \codep@flushbackref
%%
%% With the fix: the \ref{thm:A} in the section heading below
%% fires with \codep@currentatom = \@empty, so the
%% \@setref/\HyRef@autosetref/\cref@getlabel patches
%% short-circuit and DO NOT write \codep@atomref records.
%% The expected result: zero atomref edges from atom 1.1.2
%% (the section heading paragraph, which itself is suppressed)
%% to thm:A.
%%
%% Without the fix: there would be a stale \codep@atomref
%% record attributing the section-heading \ref to whichever
%% paragraph finished last.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{First}

A paragraph in the first section.

\begin{theorem}\label{thm:A}
  Statement of theorem A.
\end{theorem}

% After the theorem ends, \codep@currentatom must be cleared.
% A paragraph follows, which sets a new currentatom.

A second paragraph in the first section.

% Now another paragraph ends. The next thing is a section
% heading whose \ref must NOT carry the just-ended paragraph
% as currentatom.

\section{Reference test \ref{thm:A}}

% The \ref above fires INSIDE \section's heading body, after
% the previous paragraph ended and before the new section's
% first paragraph begins. \codep@currentatom must be empty
% at that point.

A paragraph in the second section. This one IS a real atom.

\END
\end{document}
