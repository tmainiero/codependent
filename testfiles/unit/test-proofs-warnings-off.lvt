%% TEST-NAME: test-proofs-warnings-off
%% TEST-PURPOSE: proof-warnings=off suppresses the "Proof not adjacent"
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-NONADJ
%% TEST-STATUS: LIVE
%% TEST-WHAT: proof-warnings=off suppresses the "Proof not adjacent"
%%            warning for non-adjacent (standalone) proofs.
%% TEST-SOURCE: docs/DESIGN.md §Options, proof-warnings
%% TEST-SECTION: docs/DESIGN.md §Options
%% TEST-EXIT: 0
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.3}{proof}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% With proof-warnings=off, a non-adjacent proof becomes STANDALONE
%% (opaque proof-id key, no shared-counter slot) but no warning is
%% emitted in the log.  The standalone CDP atom record carries the
%% opaque a<N> key, so {1.3}{proof} no longer appears.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[proof-warnings=off]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}
  A theorem.
\end{theorem}

% Atom 1.2 -- paragraph (clears adjacency)
Some intervening text that breaks adjacency.

% Atom 1.3 -- proof (standalone, no warning)
\begin{proof}
  This non-adjacent proof should NOT trigger any warning.
\end{proof}

\END
\end{document}
