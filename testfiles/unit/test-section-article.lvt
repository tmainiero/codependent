%% TEST-NAME: test-section-article
%% TEST-WHAT: Verify \section{Foo} heading paragraph is NOT numbered as an
%%            atom under the standard article class (baseline).
%% TEST-SOURCE: docs/DESIGN.md §Paragraph numbering, §Section 8a.6 sectioning
%% TEST-SECTION: docs/DESIGN.md §Paragraph numbering "Sectioning heading suppression"
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{paragraph} = 1
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@meta{1.1}{env}{heading}
%% TEST-ATOMS-MIN: 1
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-SUPP-SECTION
%%
%% Baseline: under vanilla article, \section{Foo} must NOT fire the
%% para/begin hook in numbering mode. Only the body paragraph below
%% the heading should be atom 1.1. If the sectioning heading itself
%% gets numbered, we see atom 1.1 on the heading and 1.2 on the body
%% paragraph -- the assertion would fire.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Foo}

Body paragraph. Expected atom 1.1 (and only 1.1).

\END
\end{document}
