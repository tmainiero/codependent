%% TEST-NAME: test-frontedge-in-atbegindocument
%% TEST-WHAT: Verify that \ref called from an \AtBeginDocument callback
%%            (which fires before begindocument/end where our front-edge
%%            wrappers install) does not crash. The ref fires outside any
%%            atom context, so no atomref is expected from that callback.
%%            A normal theorem-internal \ref DOES produce the atomref.
%% TEST-SOURCE: docs/SW5c.md §8.5 AtBeginDocument waiver
%% TEST-SECTION: docs/SW5c.md §3 Safety cases
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.1}{thm:A}
%% TEST-ATOMS-MIN: 1
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% Hook ordering in \begin{document}:
%%   1. begindocument/before hooks (aux read, backend patches install)
%%   2. \AtBeginDocument callbacks (legacy LaTeX2e queue)
%%   3. begindocument/end hooks (front-edge wrappers install HERE)
%%
%% An \AtBeginDocument callback calling \ref fires BEFORE our
%% front-edge wrappers are in place. The backend (\@setref patch) is
%% in place, but \codep@currentatom is \@empty at that point (no
%% theorem is active), so no atomref is recorded. This is expected
%% and documented behaviour at commit 2; the front-edge wrapper cannot
%% intercept calls that precede its own installation.
%%
%% The test verifies: no crash, normal theorem-internal capture works.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

% This ref fires before our front-edge wrapper installs; no atomref.
\AtBeginDocument{\typeout{AtBeginDocument ref test: \ref{thm:A}}}

\begin{document}
\START

\section{AtBeginDocument safety test}

\begin{theorem}\label{thm:A}
  By \ref{thm:A} (self-ref inside atom, atomref recorded by front-edge wrapper).
\end{theorem}

\END
\end{document}
