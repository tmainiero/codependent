%% TEST-NAME: test-setref-refstar
%% TEST-WHAT: Verify \ref*{thm:A} produces a \semtex@atomref edge via
%%            the hyperref \HyRef@@StarSetRef patch site (NOT \@setref,
%%            because \ref* uses the saved \real@setref copy).
%% TEST-SOURCE: REVIEW_E #2 (BLOCKER), REVIEW_E #3, DESIGN.md §8a.0 patch site 3
%% TEST-SECTION: DESIGN.md §8a.0 Reference interception
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-AUX-CONTAINS: \semtex@atomref{1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,semtex
%% TEST-RERUN: 2
%%
%% REVIEW_E finding #2 subsumes finding #3: hyperref's \ref* uses
%% \HyRef@@StarSetRef which calls \real@setref (hyperref's saved copy
%% of \@setref, taken BEFORE our patch applied). So our \@setref
%% wrapper is invisible to \ref*. The fix patches
%% \HyRef@@StarSetRef directly at begindocument/before.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{ref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \ref*{thm:A} the conclusion follows (no hyperlink).
\end{theorem}

\END
\end{document}
