%% TEST-NAME: test-setref-refstar
%% TEST-WHAT: Verify \ref*{thm:later} still emits
%%            \codep@atomref{theorem:1.1}{thm:later} on pass 1 after
%%            backend wrapper removal.
%% TEST-SOURCE: .claude/comms/w03-sw5c-plan/PLAN.md §4 commit 3
%% TEST-SECTION: .claude/comms/w03-sw5c-plan/PLAN.md §5 commit 3
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.1}{thm:later}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 1
%% This fixture intentionally inspects the unresolved forward-ref pass to pin
%% \ref* front-edge capture before the target theorem has been seen.
%% TEST-ALLOW-UNDEFINED-REFS: yes
%% TEST-BEHAVIOR: B-PASS-ONE, B-FRONTEDGE-CAPTURE
%%
%% This fixture intentionally does NOT assert clickability; the label is
%% unresolved on the only pass. That concern stays covered by
%% test-frontedge-refstar.lvt. Here we only pin that front-edge capture
%% still writes the edge when the backend wrappers are gone.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{ref-star forward-capture test}

\begin{theorem}
  By \ref*{thm:later} the conclusion follows (no hyperlink yet).
\end{theorem}

\begin{theorem}\label{thm:later}
  Theorem declared after the reference.
\end{theorem}

\END
\end{document}
