%% TEST-NAME: test-label-cleveref-opt
%% TEST-WHAT: Verify \label[theorem]{thm:foo} (cleveref optional-arg form)
%%            is correctly wrapped and emits \semtex@sbl@label{<num>}{thm:foo}
%%            with the CLEAN key (no square-bracket type prefix).
%% TEST-SOURCE: REVIEW_E #4 (MAJOR), REVIEW_F J3 (verified)
%% TEST-SECTION: DESIGN.md §9a "Label wrap: cleveref optional argument"
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-CONTAINS: \semtex@sbl@label{1.1}{thm:foo}
%% TEST-SBL-NOT: \semtex@sbl@label{1.1}{[theorem]thm:foo}
%% TEST-PACKAGES: hyperref,cleveref,amsthm,semtex
%% TEST-RERUN: 2
%%
%% REVIEW_E finding #4 MAJOR. cleveref's \label accepts an
%% optional [type] argument (cleveref.sty lines 66-97). A
%% naive \pretocmd{\label}{...} in semtex would either fail
%% to see the optional argument, or capture it as part of
%% the mandatory argument and write \semtex@sbl@label{1.1}{[theorem]thm:foo}
%% --- a corrupted key. The fix (REVIEW_F J3) uses
%% \@ifnextchar[ to detect the optional arg and strip it,
%% writing only the clean mandatory key.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Label with cleveref type}

\begin{theorem}\label[theorem]{thm:foo}
  Statement with a cleveref-typed label.
\end{theorem}

\END
\end{document}
