%% TEST-NAME: test-load-hyperref-then-semtex
%% TEST-WHAT: Verify hyperref loaded BEFORE semtex works cleanly (the
%%            recommended load order); backref edges and the .sbl end
%%            marker both land.
%% TEST-SOURCE: DESIGN.md §Load order "Recommended order"
%% TEST-SECTION: DESIGN.md §Load order
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-AUX-CONTAINS: \semtex@atomref{1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,semtex
%% TEST-RERUN: 2
%%
%% Baseline "happy path" load order regression. hyperref
%% BEFORE semtex is the recommended order because semtex's
%% reference-patch sites (§8a.0) wrap hyperref's already-
%% wrapped \@setref / \HyRef@autosetref / \HyRef@@StarSetRef,
%% so we sit on the outside. This fixture is the control
%% against which test-load-semtex-then-hyperref is compared.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Load order happy}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \ref{thm:A}, done.
\end{theorem}

\END
\end{document}
