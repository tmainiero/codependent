%% TEST-NAME: test-proofs-off
%% TEST-WHAT: proofs=off disables all proof tracking; no atom numbers,
%%            no SBL records, no adjacency detection.
%% TEST-SOURCE: docs/DESIGN.md §Proof environments
%% TEST-SECTION: docs/DESIGN.md §Options
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Proof not adjacent
%% TEST-PDF-NOT: Used in
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.2}{proof}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@proof
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-PROOF-OFF
%%
%% With proofs=off, proof environments only suppress paragraph
%% numbering; they do not get atom numbers or SBL records.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[proofs=off]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  A theorem.
\end{theorem}

% No atom -- proofs=off
\begin{proof}
  Proof content (no atom number); compare \ref{thm:main}.%
  \codepbackrefs
\end{proof}

\END
\end{document}
