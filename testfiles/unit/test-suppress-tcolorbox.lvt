%% TEST-NAME: test-suppress-tcolorbox
%% TEST-WHAT: Verify a tcolorbox environment does NOT contribute atom
%%            numbers for the paragraphs inside its body.
%% TEST-SOURCE: REVIEW_E #13 (MINOR)
%% TEST-SECTION: docs/DESIGN.md §8a.6 suppression list / tcolorbox integration
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{paragraph} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: tcolorbox,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-SUPP-TRACKED
%%
%% REVIEW_E finding #13. tcolorbox boxes are a common display
%% wrapper in math/CS monographs (for examples, remarks, call-
%% outs). Paragraphs rendered inside a tcolorbox are NOT
%% primary content atoms; the box body is a visual accent, not
%% a numbered unit. The default suppression set must include
%% tcolorbox (directly via \codep@suppressenv or via its list
%% / savebox internals).

\documentclass{article}
\usepackage{tcolorbox}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{tcolorbox suppression}

Paragraph before the box. Atom 1.1.

\begin{tcolorbox}
  Body paragraph inside the colored box. Must NOT be an atom.
\end{tcolorbox}

Paragraph after the box. Atom 1.2.

\END
\end{document}
