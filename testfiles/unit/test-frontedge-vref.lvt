%% TEST-NAME: test-frontedge-vref
%% TEST-PURPOSE: Verify \vref{thm:A} (varioref smart reference) from
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \vref{thm:A} (varioref smart reference) from
%%            theorem 1.2 emits \codep@atomref{theorem:1.2}{thm:A}
%%            via delegation through the \ref front-edge wrapper.
%% TEST-SOURCE: docs/SW5c.md §2.3 delegation table (vref row)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,varioref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% varioref's \vref produces context-sensitive references ("below",
%% "on the following page", etc.) by calling \ref internally. With the
%% front-edge wrapper installed on \ref, the inner call fires
%% \codep@frontedge@emit before reaching the saved original.

\documentclass{article}
\usepackage{hyperref}
\usepackage{varioref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge vref delegation test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \vref{thm:A} (varioref smart reference) the conclusion follows.
\end{theorem}

\END
\end{document}
