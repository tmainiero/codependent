%% TEST-NAME: test-frontedge-labelcref
%% TEST-WHAT: Verify \labelcref{thm:A} from theorem 1.2 emits one
%%            \codep@atomref{theorem:1.2}{thm:A}.  \labelcref is a
%%            cleveref command that formats only the label (no type text)
%%            and is now wrapped by the front-edge capture hook.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive wrap list; GPT review §2.4
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge labelcref test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \labelcref{thm:A} the conclusion follows.
\end{theorem}

\END
\end{document}
