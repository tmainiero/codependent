%% TEST-NAME: test-equations-all
%% TEST-WHAT: equations=all: equation inside a theorem uses the
%%            parenthesized equation number as backref source, NOT
%%            the theorem atom number.  Standalone equations also
%%            use the equation number.
%% TEST-SOURCE: docs/DESIGN.md §Equation backref tracking
%% TEST-SECTION: codependent.sty equations option
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{definition} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1}{thm:main}
%% TEST-AUX-CONTAINS: \codep@atomref{equation:2}{thm:main}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{definition:1.2}{thm:main}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,hyperref,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-EQ-ALL
%%
%% With equations=all, even equations inside theorems use the
%% parenthesized equation number.  Atom 1.2 (definition) contains
%% equation 2 which references thm:main; the source should be
%% "(2)" not "1.2".

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{hyperref}
\usepackage[depth=1,equations=all]{codependent}
\codeptrack{theorem,definition}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  The main theorem statement.
\end{theorem}

% Standalone equation referencing the theorem.
% Source should be "(1)" (equation number 1).
\begin{equation}\label{eq:standalone}
  f(x) = g(x) \quad\text{by \ref{thm:main}}.
\end{equation}

% Atom 1.2 -- definition containing an equation
\begin{definition}\label{def:foo}
  A definition with an internal equation.
  % With equations=all, even inside a theorem the source is "(2)".
  \begin{equation}\label{eq:inside}
    a = b \quad\text{see \ref{thm:main}}.
  \end{equation}
\end{definition}

\END
\end{document}
