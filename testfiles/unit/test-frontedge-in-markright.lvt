%% TEST-NAME: test-frontedge-in-markright
%% TEST-PURPOSE: Verify \ref inside \markright (running header) does not
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE, B-EDGE-HEADING
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \ref inside \markright (running header) does not
%%            crash and does not produce a spurious atomref, while a
%%            normal theorem-internal \ref DOES produce the atomref.
%% TEST-SOURCE: docs/SW5c.md §3.1 moving arguments (running headers)
%% TEST-SECTION: docs/SW5c.md §3 Safety cases
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-CONTAINS: Theorem 1.1. Theorem A. Used in 1.2.
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% \markright stores its argument in a mark register; when the running
%% header is typeset (at shipout) the stored tokens are re-expanded.
%% Our \ref wrapper is \protected, so it fires only at explicit typeset
%% time, not during the mark-store phase. When the header is typeset,
%% \codep@currentatom is \@empty, so no spurious atomref is written.
%% TEST-EXIT: 0 and TEST-LOG-NOT cover the no-crash requirement.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Running header safety test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\markright{See~\ref{thm:A}}

\begin{theorem}
  By \ref{thm:A} (inside theorem, atomref recorded).
\end{theorem}

\END
\end{document}
