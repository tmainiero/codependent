%% TEST-NAME: test-concept-in-restatable-appendix
%% TEST-PURPOSE: Verify the opposite pattern to the intro-teaser case:
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-REST-CONCEPT
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify the opposite pattern to the intro-teaser case:
%%            \restatable{theorem}{thm:main}{body with \Hom*} in
%%            the main body (fires first, alias intact), then
%%            \restate{thm:main} in the appendix (fires later,
%%            alias broken). The def site must be the main-body
%%            declaration atom, NOT the appendix restate atom.
%%            The §8a.5.a save/clear/restore ensures the appendix
%%            restate's \Hom* is a silent no-op.
%% TEST-SOURCE: docs/DESIGN.md §8a.5.a save/clear/restore, §8a.9
%%              Interaction with restatable (appendix pattern)
%% TEST-SECTION: docs/DESIGN.md §8a.5.a, §8a.9
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@def{1.1}{Hom} = 1
%% TEST-CDP-COUNT: \codep@cdp@def{2.1}{Hom} = 0
%% TEST-AUX-CONTAINS: \codep@concept{Hom}{1.1}
%% TEST-AUX-NOT-CONTAINS: \codep@concept{Hom}{2.1}
%% TEST-PACKAGES: thmtools,hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% Section 1 (main) declares the restatable theorem. First firing,
%% alias intact, normal hook body: \codep@currentatom = 1.1
%% (theorem atom in section 1). \Hom* inside the body registers
%% 1.1 as the def site.
%%
%% Section 2 (appendix) calls \restate{thm:main}. Second firing,
%% alias broken, restate branch: \codep@pushcurrentatom saves the
%% enclosing appendix paragraph's currentatom and sets it to
%% \@empty. \Hom* inside the restated body sees empty currentatom
%% and silently no-ops (the duplicate-def-site error is NOT
%% triggered because emit@def short-circuits on empty currentatom
%% BEFORE the duplicate check). \codep@popcurrentatom restores
%% the appendix paragraph's currentatom at end-of-environment.
%%
%% If the duplicate check fired first (before the empty guard),
%% this fixture would erroneously error out with "Hom* defined at
%% atoms 1.1 and 2.1" — verify the emit@def sequence in §9a's
%% sketch places the empty-currentatom short-circuit BEFORE the
%% \@ifundefined duplicate check.
%%
%% Until §8a.5.a extension + §8a.9 are implemented, this fixture
%% FAILS: the second firing of \Hom* would hit the duplicate-def
%% detection and error, or register a second def site.

\documentclass{article}
\usepackage{amsthm}
\usepackage{thmtools}
\usepackage{hyperref}
\usepackage{cleveref}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\codepnewcommand{\Hom}[2]{\mathrm{Hom}(#1,#2)}

\begin{document}
\START

\section{Main}

\begin{restatable}{theorem}{thmMain}\label{thm:main}
  The $\Hom*{X}{Y}$ set has the expected universal property.
\end{restatable}

Uses of $\Hom{A}{B}$ in the main body resolve backward.

\section{Appendix}

For convenience we restate the main theorem here.

\thmMain*

The \verb|\Hom*| inside the restated body MUST be a silent
no-op: the §8a.5.a guard clears currentatom on the restate
branch, so the second emit sees empty and skips the
duplicate-def-site check entirely.

\END
\end{document}
