%% TEST-NAME: test-equations-allnotag
%% TEST-WHAT: Track 2: align where all lines have \notag.  No equation
%%            source is produced; refs fall through to the containing
%%            theorem's atom number.
%% TEST-SOURCE: docs/DESIGN.md §Equations as backref sources (Track 2)
%% TEST-SECTION: codependent.sty \codep@flusheqrange
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-CONTAINS: Theorem 1.1. The main theorem statement. Used in 1.2.
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{definition} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{definition:1.2}{thm:main}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{equation:
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-EQ-NOTAG, B-EDGE-NOTAG
%%
%% An align inside a definition where all lines have \notag.  The
%% equation counter doesn't advance, so no equation range is produced.
%% The refs fall through to the containing definition's atom (1.2).

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage[equations=all]{codependent}
\codeptrack{theorem,definition}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  The main theorem statement.
\end{theorem}

% Atom 1.2 -- definition with all-notag align inside.
\begin{definition}\label{def:derivation}
  We derive from the main theorem:
  \begin{align}
    x &= y  \quad\text{by \ref{thm:main}} \notag \\
    a &= b  \notag
  \end{align}
\end{definition}

\END
\end{document}
