%% TEST-NAME: test-setref-eqref
%% TEST-WHAT: Verify amsmath's \eqref{eq:A} produces a \codep@atomref
%%            edge. \eqref is implemented as \textup{(\ref{...})} in
%%            amsmath, so it routes through the kernel \@setref patch.
%% TEST-SOURCE: DESIGN.md §8a.0 coverage table (eqref row)
%% TEST-SECTION: DESIGN.md §8a.0 Reference interception
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{1.2}{eq:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,codependent
%% TEST-RERUN: 2
%%
%% Pins \eqref coverage. amsmath defines \eqref as a formatting
%% wrapper around \ref, so the kernel \@setref patch should catch
%% it without needing a dedicated \eqref patch site. Display math
%% environments are suppressed and do not produce atom records;
%% the equation is between atoms 1.1 and 1.2, and the \eqref in
%% the theorem (atom 1.2) emits atomref{1.2}{eq:A}. If a future
%% amsmath release changes \eqref to bypass \ref, this test catches
%% the regression.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{eqref test}

One lead paragraph so the theorem below is predictably atom 1.2.

\begin{equation}\label{eq:A}
  a + b = c.
\end{equation}

\begin{theorem}
  By \eqref{eq:A} the conclusion follows.
\end{theorem}

\END
\end{document}
