%% TEST-NAME: test-setref-eqref
%% TEST-WHAT: Verify amsmath's \eqref{eq:later} still emits
%%            \codep@atomref{theorem:1.1}{eq:later} on pass 1 after
%%            backend wrapper removal.
%% TEST-SOURCE: .claude/comms/w03-sw5c-plan/PLAN.md §4 commit 3
%% TEST-SECTION: .claude/comms/w03-sw5c-plan/PLAN.md §5 commit 3
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.1}{eq:later}
%% TEST-ATOMS-MIN: 1
%% TEST-PACKAGES: amsmath,amsthm,codependent
%% TEST-RERUN: 1
%% TEST-BEHAVIOR: B-EQ-TRACK1, B-DISP-EQ, B-FRONTEDGE-CAPTURE
%%
%% Single-pass forward ref proves \eqref still captures through the
%% front-edge path alone: the theorem cites an equation declared later
%% in the document, so the old resolved-backend callsites cannot be the
%% source of the aux edge.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{eqref forward-capture test}

\begin{theorem}
  By \eqref{eq:later} the conclusion follows.
\end{theorem}

\begin{equation}\label{eq:later}
  a + b = c.
\end{equation}

\END
\end{document}
