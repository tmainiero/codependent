%% TEST-NAME: test-setref-eqref
%% TEST-WHAT: Verify amsmath's \eqref{eq:A} produces a \semtex@atomref
%%            edge. \eqref is implemented as \textup{(\ref{...})} in
%%            amsmath, so it routes through the kernel \@setref patch.
%% TEST-SOURCE: DESIGN.md §8a.0 coverage table (eqref row)
%% TEST-SECTION: DESIGN.md §8a.0 Reference interception
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-AUX-CONTAINS: \semtex@atomref{1.3}{eq:A}
%% TEST-ATOMS-MIN: 3
%% TEST-PACKAGES: amsmath,amsthm,semtex
%% TEST-RERUN: 2
%%
%% Pins \eqref coverage. amsmath defines \eqref as a formatting
%% wrapper around \ref, so the kernel \@setref patch should catch
%% it without needing a dedicated \eqref patch site. If a future
%% amsmath release changes \eqref to bypass \ref, this test catches
%% the regression.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{eqref test}

One lead paragraph so the theorem below is predictably atom 1.2.

\begin{equation}\label{eq:A}
  a + b = c.
\end{equation}

\begin{theorem}
  By \eqref{eq:A} the conclusion follows.
\end{theorem}

\END
\end{document}
