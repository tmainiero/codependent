%% TEST-NAME: test-equations-align
%% TEST-WHAT: Track 2: align environment records equation range as
%%            backref source.  Two numbered lines produce a single
%%            range source (2--3), not per-line numbers.  The equation
%%            env before the align sets the counter to 1.
%% TEST-SOURCE: DESIGN.md §Equations as backref sources
%% TEST-SECTION: codependent.sty \codep@trackalignenv
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{definition} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{(2--3)}{thm:alpha}
%% TEST-AUX-CONTAINS: \codep@atomref{(2--3)}{def:beta}
%% TEST-AUX-CONTAINS: \codep@anchormap{(2--3)}{codep.eq.1}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{(1)}{thm:alpha}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{(2)}{thm:alpha}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,hyperref,codependent
%% TEST-RERUN: 2
%%
%% An equation environment before the align sets the counter to 1.
%% The align has two numbered lines, stepping the counter to 2 and 3.
%% Track 2 defers ref targets to a pending list and computes the range
%% (2--3) at \end{align}.  Both refs (to thm:alpha and def:beta) are
%% attributed to the range source (2--3).

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{hyperref}
\usepackage[depth=1]{codependent}
\codeptrack{theorem,definition}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:alpha}
  First theorem.
\end{theorem}

% Atom 1.2 -- definition
\begin{definition}\label{def:beta}
  First definition.
\end{definition}

% Step the equation counter to 1 so the align range starts at 2.
\begin{equation}\label{eq:setup}
  z = w.
\end{equation}

% Standalone align with two numbered lines.
% Range source = (2--3).
\begin{align}
  x &= y  \quad\text{by \ref{thm:alpha}} \label{eq:line1} \\
  a &= b  \quad\text{by \ref{def:beta}}  \label{eq:line2}
\end{align}

\END
\end{document}
