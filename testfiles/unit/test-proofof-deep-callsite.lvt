%% TEST-NAME: test-proofof-deep-callsite
%% TEST-PURPOSE: A separated proof whose \codepproofof call appears deep
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-SEP, B-PROOF-ANCHOR-NEAR-HEADING, B-LINK-PROOF-DEST
%% TEST-STATUS: LIVE
%% TEST-WHAT: A separated proof whose \codepproofof call appears deep
%%            inside the proof body still routes the post-rebind
%%            proof key to the proof-begin anchor.  The 1.1* backref
%%            lands near the proof heading rather than at the later
%%            \codepproofof call site.
%% TEST-SOURCE: .claude/comms/waves/W04-CLOSEOUT/W04-F-fix-briefing.md
%% TEST-SECTION: codependent.sty §6 (\codep@proof@capturebeginanchor),
%%               §10 (\codep@proofof@resolve), §graph
%%               (\codep@graph@getanchor)
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-PDF-LINK-Y-NEAR: 1\.1\* | Proof of Theorem 1\.1 | within=10
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a3}{codep-proof:a3}
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a3}{codep-proof:a3}
%% TEST-AUX-NOT-CONTAINS: \codep@keymap
%% TEST-AUX-CONTAINS: \codep@entitymeta{proof:a3}{proof}{1.1*}{proof}{theorem:1.1}
%% TEST-PACKAGES: amsthm,hyperref,codependent
%% TEST-RERUN: 2
%% TEST-CENSUS: enabled
%% TEST-CENSUS-PASS: yes
%%
%% Behavior contract: docs/BEHAVIOR.md §3.3
%% [B-PROOF-ANCHOR-NEAR-HEADING], [B-LINK-PROOF-DEST].
%%
%% This fixture forces the separated-proof rebind to happen well below
%% the heading.  The proof begins adjacent to theorem 2.1, so the
%% proof-begin anchor is emitted as codep-proof:a3.  Much later,
%% \codepproofof{thm:main} rebinds the proof to theorem 1.1.  The fix
%% under test must keep proof:a3 bound to the stored proof-begin
%% anchor instead of emitting a second call-site anchor.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Statements}

\begin{theorem}\label{thm:main}
  Main theorem statement.
\end{theorem}

\section{Deferred proofs}

\begin{theorem}\label{thm:target}
  A target theorem.
\end{theorem}

\begin{proof}[Proof of Theorem~\ref{thm:main}]
  The opening paragraph sits above the later rebound site so the
  proof heading and the \codepproofof command are visibly separated.

  A second paragraph continues the body with enough text to keep the
  later command far from the heading even after line wrapping in the
  extracted PDF text used by the regression runner.

  A third paragraph adds another break before the attribution command.
  The current buggy implementation would place the rebound anchor here,
  well below the heading.

  \codepproofof{thm:main}

  After the rebound, we reference \ref{thm:target} so theorem 2.1's
  backref rail contains the post-rebind source token 1.1*.
\end{proof}

\END
\end{document}
