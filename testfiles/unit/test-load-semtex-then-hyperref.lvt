%% TEST-NAME: test-load-semtex-then-hyperref
%% TEST-WHAT: Verify hyperref loaded AFTER semtex still works: the
%%            AtEndPreamble hooks and \DeclareHookRule ordering in
%%            Section 8a.7 guarantee semtex's patches fire AFTER
%%            hyperref has wrapped the kernel dispatchers.
%% TEST-SOURCE: REVIEW_C #3, DESIGN.md §Load order, §8a.7 hook install
%% TEST-SECTION: DESIGN.md §Load order, §8a.7 Hook rules
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-AUX-CONTAINS: \semtex@atomref{1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,semtex,hyperref
%% TEST-RERUN: 2
%%
%% REVIEW_C finding #3. Pre-2023 hyperref, when loaded at any
%% point after semtex, clobbered semtex's \newlabel override
%% mid aux-read via hyperref's own aux-injection block. The
%% fix uses \AtEndPreamble / begindocument/before with an
%% explicit \DeclareHookRule so semtex's reference patches
%% always install AFTER hyperref has had its chance to wrap
%% the reference dispatchers, regardless of source order.
%% This fixture verifies the hook-ordering path works even
%% when the user writes \usepackage{semtex} before
%% \usepackage{hyperref}.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\usepackage{hyperref}
\semtextrack{theorem}

\begin{document}
\START

\section{Load order reverse}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \ref{thm:A}, done.
\end{theorem}

\END
\end{document}
