%% TEST-NAME: test-frontedge-Ref
%% TEST-PURPOSE: Verify \Ref{thm:A} (capital-R, from nameref package)
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \Ref{thm:A} (capital-R, from nameref package)
%%            from theorem 1.2 emits \codep@atomref{theorem:1.2}{thm:A}
%%            via the front-edge wrapper.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 5: \Ref)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,nameref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% nameref defines \Ref as a capitalised variant of \ref that also
%% expands the cross-reference name. It routes through NR@setref
%% rather than kernel \@setref, so the backend patch does not fire.
%% The front-edge wrapper for \Ref (installed at begindocument/end)
%% intercepts this call and emits the atomref before delegating to
%% the saved original. nameref is loaded explicitly here; in practice
%% it is usually loaded transitively by hyperref.

\documentclass{article}
\usepackage{hyperref}
\usepackage{nameref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge Ref test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \Ref{thm:A} (capitalised form) the conclusion follows.
\end{theorem}

\END
\end{document}
