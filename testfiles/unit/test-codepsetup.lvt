%% TEST-NAME: test-codependentsetup
%% TEST-WHAT: Verify that \codepsetup accepts all rendering configuration
%%            keys without error, and that a document with backrefs still
%%            compiles correctly after changing every key.
%% TEST-SOURCE: DESIGN.md \codepsetup key-value API
%% TEST-SECTION: codependent.sty §Options, §Rendering
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-SBL-CONTAINS: \codep@sbl@end{OK}
%% TEST-SBL-COUNT: \codep@sbl@atom{1.1}{theorem} = 1
%% TEST-SBL-COUNT: \codep@sbl@atom{1.2}{theorem} = 1
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Exercises every \codepsetup key: backref-style, backref-align,
%% backref-font, backref-prefix, backref-label, margin-font.
%% The document contains two theorems where the second references
%% the first, so the "Used in" line actually renders.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

% Exercise every key via \codepsetup.
\codepsetup{backref-style=inline}
\codepsetup{backref-align=left}
\codepsetup{backref-font=\footnotesize\ttfamily}
\codepsetup{backref-prefix=$\triangleright$\;}
\codepsetup{backref-label=Referenced by}
\codepsetup{margin-font=\tiny}

\begin{document}
\START

\section{Results}

\begin{theorem}\label{thm:A}
  First result.
\end{theorem}

\begin{theorem}
  Second result, which uses Theorem~\ref{thm:A}.
\end{theorem}

\END
\end{document}
