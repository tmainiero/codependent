%% TEST-NAME: test-frontedge-Cref
%% TEST-WHAT: Verify \Cref{thm:A} (capitalised Cref from cleveref)
%%            from theorem 1.2 emits \codep@atomref{theorem:1.2}{thm:A}
%%            via the front-edge wrapper.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 11: \Cref)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% cleveref's \Cref is the sentence-start variant that capitalises the
%% type label ("Theorem" rather than "theorem"). It is a distinct macro
%% from \cref and must be wrapped separately by
%% \codep@installfrontedgerefpatch. This fixture pins that the \Cref
%% wrapper correctly fires \codep@frontedge@emit.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge Cref test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  \Cref{thm:A} gives the foundation for this result.
\end{theorem}

\END
\end{document}
