%% TEST-NAME: test-suppress-enumitem-newlist
%% TEST-PURPOSE: Verify a user-declared \newlist{mylist}{itemize}{1} environment
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-SUPP-LISTS
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify a user-declared \newlist{mylist}{itemize}{1} environment
%%            auto-suppresses atom numbering for paragraphs inside it.
%% TEST-PINS-KNOWN-BROKEN: yes
%% TEST-SOURCE: REVIEW_E #10 (MINOR)
%% TEST-SECTION: docs/DESIGN.md §8a.6 suppression list / enumitem integration
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-NOT: 1.2• First item body; not an atom.
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{paragraph} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: enumitem,amsthm,codependent
%% TEST-RERUN: 2
%%
%% REVIEW_E finding #10. enumitem's \newlist creates new list
%% environments on the fly. The codependent suppression registry
%% must recognize these (via the generic trivlist/list hook or
%% by tapping into enumitem's registration) so authors don't
%% have to call \codepsuppress{mylist} manually after every
%% \newlist. Body paragraphs outside the list are atoms 1.1
%% and 1.2; item bodies inside the list are NOT atoms.

\documentclass{article}
\usepackage{enumitem}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\newlist{mylist}{itemize}{1}
\setlist[mylist]{label=$\bullet$}

\begin{document}
\START

\section{Enumitem newlist}

Paragraph before the list. Atom 1.1.

\begin{mylist}
  \item First item body; not an atom.
  \item Second item body; not an atom.
\end{mylist}

Paragraph after the list. Atom 1.2.

\END
\end{document}
