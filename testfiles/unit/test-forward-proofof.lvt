%% TEST-NAME: test-forward-proofof
%% TEST-PURPOSE: \codepproofof fires BEFORE the referenced label is
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-SEP
%% TEST-STATUS: LIVE
%% TEST-WHAT: \codepproofof fires BEFORE the referenced label is
%%            assigned, but resolves in the same run via the
%%            enddoc drain against the now-complete in-memory
%%            label->entity binding.  Exercises W03-P03 same-run
%%            forward-ref settlement (no cross-run dependency).
%% TEST-SOURCE: .claude/comms/wave3-plan-v11.md §P03 (item 5,
%%              "Forward-ref settlement in same run")
%% TEST-SECTION: docs/DESIGN.md §8a (proof environments)
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: codepproofof:.*unknown label
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.2}{theorem}
%% TEST-AUX-CONTAINS: \codep@lblentity{thm:target}{theorem:1.1}
%% TEST-AUX-CONTAINS: \codep@lblentity{thm:later}{theorem:1.2}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 1
%%
%% Forward-ref scenario: the \codepproofof call happens textually
%% BEFORE the \label it references.  Under pre-P03 code this would
%% warn "unknown label 'thm:target'" and not emit a binding until a
%% second pass.  Under P03 the deferred call is replayed from the
%% enddoc drain, so even on a cold first compile the proof binds to
%% the theorem's starred key.  Same-run resolution on pass 1: the
%% forward-ref is deferred at proof-close time, then resolved at
%% enddoc by the drain before drains finish.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Forward-ref scenario}

% A theorem containing a proof that references a not-yet-defined theorem.
% The \codepproofof call is inside the proof environment nested in thm:target.
% Even though the proof closes before the later theorem is defined,
% the forward-ref is resolved at enddoc by the drain.
\begin{theorem}\label{thm:target}
  This is a target theorem.

  \begin{proof}[Proof of later theorem]
    \codepproofof{thm:later}%
    This proof references a theorem defined later in the document.
  \end{proof}

  Main content of the target theorem.
\end{theorem}

% A later theorem referenced by the proof above
\begin{theorem}\label{thm:later}
  A theorem declared after the proof that references it.
\end{theorem}

\END
\end{document}
