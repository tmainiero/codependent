%% TEST-NAME: test-frontedge-Vref
%% TEST-WHAT: Verify \Vref{thm:A} (capitalised varioref variant) from
%%            theorem 1.2 emits \codep@atomref{theorem:1.2}{thm:A}
%%            via delegation through the \Ref front-edge wrapper.
%% TEST-SOURCE: docs/SW5c.md §2.3 delegation table (Vref row)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,nameref,varioref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% varioref's \Vref is the sentence-start capitalised form; it delegates
%% to \Ref (from nameref) rather than \ref. With the front-edge wrapper
%% installed on \Ref, the inner call fires \codep@frontedge@emit before
%% reaching the saved original \Ref.

\documentclass{article}
\usepackage{hyperref}
\usepackage{nameref}
\usepackage{varioref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge Vref delegation test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  \Vref{thm:A} gives the key result (capitalised varioref form).
\end{theorem}

\END
\end{document}
