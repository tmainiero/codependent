%% TEST-NAME: test-reference-edge-cases-visible
%% TEST-PURPOSE: Multiple refs from one source deduplicate to one visible
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-DEDUP, B-SELFREF, B-ZERO-REF, B-EDGE-ZERO-REF, B-EDGE-DEDUP, B-EDGE-MULTI-SAME
%% TEST-STATUS: LIVE
%% TEST-WHAT: Multiple refs from one source deduplicate to one visible
%%            backref entry, self-refs are ignored, and an atom with no
%%            inbound refs renders no "Used in" annotation.
%% TEST-SOURCE: .claude/comms/behavior-coverage-audit-report.md B-DEDUP, B-SELFREF, B-ZERO-REF
%% TEST-SECTION: ref-edge visible behavior
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-CONTAINS: Used in 1.2
%% TEST-PDF-STEXT-NOT: Used in 1\.2[^0-9].*Used in 1\.2
%% TEST-PDF-STEXT-NOT: Self-referential theorem with zero inbound refs\..*Used in
%% TEST-PACKAGES: amsthm,hyperref,codependent
%% TEST-RERUN: 2

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Reference edges}

\begin{theorem}\label{thm:target}
  Target theorem with one deduplicated inbound source.
\end{theorem}

\begin{theorem}\label{thm:self}
  By \ref{thm:target}, again \ref{thm:target}, and self \ref{thm:self}.
\end{theorem}

\begin{theorem}
  Self-referential theorem with zero inbound refs.
\end{theorem}

\END
\end{document}
