%% TEST-NAME: test-frontedge-cpagerefrange-absent
%% TEST-PURPOSE: Verify \cpagerefrange{thm:A}{thm:C} does NOT produce
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \cpagerefrange{thm:A}{thm:C} does NOT produce
%%            atomrefs. This family remains a documented coverage gap.
%% TEST-SOURCE: .claude/comms/w03-sw5c-plan/PLAN.md §2.3 / §5 row 15
%% TEST-SECTION: .claude/comms/w03-sw5c-plan/PLAN.md §2.4 Waiver rationale
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{theorem:1.4}{thm:A}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{theorem:1.4}{thm:C}
%% TEST-ATOMS-MIN: 4
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% \cpagerefrange (cleveref, prints page ranges) routes through
%% \cpageref@getlabel, which remains outside the wrapped primitive set.
%% The test pins the ABSENCE of atomrefs so any future change that
%% accidentally adds coverage (or breaks the no-crash guarantee) is
%% caught immediately.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{cpagerefrange gap test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}\label{thm:B}
  Theorem B.
\end{theorem}

\begin{theorem}\label{thm:C}
  Theorem C.
\end{theorem}

\begin{theorem}
  Theorems on pages~\cpagerefrange{thm:A}{thm:C}
  (page range; atomrefs not captured, documented gap).
\end{theorem}

\END
\end{document}
