\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage[depth=1]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Subequations}

\begin{theorem}\label{thm:target}
  Target theorem for a subequation range.
\end{theorem}

\begin{subequations}
\begin{align}
  a &= b \quad \text{by \ref{thm:target}} \label{eq:a} \\
  c &= d \quad \text{by \ref{thm:target}} \label{eq:b} \\
  e &= f \quad \text{by \ref{thm:target}} \label{eq:c}
\end{align}
\end{subequations}

\END
\end{document}
