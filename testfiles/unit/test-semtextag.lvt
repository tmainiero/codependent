%% TEST-NAME: test-semtextag
%% TEST-WHAT: Verify \semtextag{kind}{value} emits a flat
%%            \semtex@sbl@tag record carrying the current atom number,
%%            kind, and value, with no visible typeset effect.
%% TEST-SOURCE: DESIGN.md §9a User API: \semtextag
%% TEST-SECTION: DESIGN.md §9a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-CONTAINS: \semtex@sbl@tag{1.1}{uid}{cat:category}
%% TEST-SBL-CONTAINS: \semtex@sbl@tag{1.1}{introduces}{Hom}
%% TEST-SBL-CONTAINS: \semtex@sbl@tag{1.1}{type}{Cat}
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% \semtextag is the user-facing semantic-tagging command.
%% It writes one \semtex@sbl@tag record per call, scoped to
%% the current atom. Multiple tags per atom are allowed
%% (different kind values, or even repeated kind for lists
%% like "introduces").
%%
%% Format must be FLAT (one record per (atom, kind, value)
%% triple), per REVIEW_C #6: no kv blobs, no embedded commas
%% or equals signs.
%%
%% \semtextag must produce zero typeset output (sidecar-only).

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{semtex}
\semtextrack{theorem,definition}

\begin{document}
\START

\section{Test}

\begin{definition}
  \semtextag{uid}{cat:category}%
  \semtextag{introduces}{Hom}%
  \semtextag{type}{Cat}%
  A \emph{category} consists of objects and morphisms.
\end{definition}

\END
\end{document}
