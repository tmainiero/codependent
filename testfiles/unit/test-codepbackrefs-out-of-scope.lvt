%% TEST-NAME: test-codepbackrefs-out-of-scope
%% TEST-WHAT: \codepbackrefs called outside any tracked atom emits a
%%            package warning and produces no "Used in" rendering.
%% TEST-SOURCE: wave3-plan-v11.md P01(A2) out-of-scope contract
%% TEST-SECTION: codependent.sty §\codepbackrefs
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-EXPECT-PACKAGE-WARNING: called outside any tracked atom
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-PDF-NOT: Used in
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-REND-INLINE
%%
%% \codepbackrefs called at the top of the document body, before any
%% tracked env and with paragraphs=off so no paragraph atom is live.
%% \codep@getcurrentatomkey returns empty; the macro emits a package
%% warning and no "Used in" line renders.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[paragraphs=off]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\codepbackrefs

\begin{theorem}
  A tracked theorem that does not itself reference anything.
\end{theorem}

\END
\end{document}
