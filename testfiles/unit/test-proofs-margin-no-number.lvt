%% TEST-NAME: test-proofs-margin-no-number
%% TEST-WHAT: Adjacent proof tracked in .cdp but does NOT create its own atom
%%            record; with margin style, no starred margin number appears.
%% TEST-SOURCE: docs/DESIGN.md §Proof adjacency, codependent.sty §6 proof@adjacent
%% TEST-SECTION: codependent.sty §6
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Proof not adjacent
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.1*}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.2}{theorem}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% With backref-style=margin, an adjacent proof inherits the theorem's
%% atom number (1.1*) and records a \codep@cdp@proof sub-record, but
%% does NOT create a separate \codep@cdp@atom record.  The proof shares
%% the theorem's visual identity — no independent margin number.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[backref-style=margin]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Margin proofs}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:margin}
  A theorem whose proof should not get a margin number.
\end{theorem}

% Adjacent proof: inherits 1.1*, no own atom record
\begin{proof}
  Proof of the theorem.
\end{proof}

% Atom 1.2 -- theorem that references thm:margin (generates a backref)
\begin{theorem}
  A second theorem referencing Theorem~\ref{thm:margin}.
\end{theorem}

\END
\end{document}
