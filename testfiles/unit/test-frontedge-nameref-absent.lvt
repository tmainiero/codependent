\usepackage{nameref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{nameref waiver test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  As in \nameref{thm:A} (name-based ref; waived from front-edge
  capture, so no atomref is expected).
\end{theorem}

\END
