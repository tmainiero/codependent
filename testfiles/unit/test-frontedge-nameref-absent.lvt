%% TEST-NAME: test-frontedge-nameref-absent
%% TEST-WHAT: Verify that \nameref{thm:A} at commit 2 produces an
%%            atomref via the backend (\@setref patch, since nameref
%%            ultimately calls \@setref via \NR@setref). Documents that
%%            \nameref is NOT wrapped by the front-edge mechanism and
%%            that after commit 3 (backend removal) \nameref will
%%            produce NO atomref (the documented waiver).
%% TEST-SOURCE: docs/SW5c.md §8.3 / §5 row 16 (\nameref waiver)
%% TEST-SECTION: docs/SW5c.md §5 Waivers
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,nameref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% COMMIT-2 STATE: \nameref calls \NR@setref, which eventually calls
%% \@setref. The backend patch on \@setref captures the edge, so an
%% atomref IS recorded at commit 2.
%%
%% COMMIT-3 STATE (future): the backend is removed. \nameref is NOT
%% in the front-edge primitive list (waiver §8.3). The test must be
%% updated to TEST-AUX-NOT-CONTAINS at commit 3 to pin the absence.
%%
%% Note: \Ref (capital-R) IS wrapped by the front-edge and thus
%% retains coverage beyond commit 3 (see test-frontedge-Ref.lvt).

\documentclass{article}
\usepackage{hyperref}
\usepackage{nameref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{nameref waiver test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  As in \nameref{thm:A} (name-based ref; backend captures at commit 2,
  waived from front-edge wrapper; absent after commit 3).
\end{theorem}

\END
\end{document}
