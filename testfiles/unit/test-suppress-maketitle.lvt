%% TEST-NAME: test-suppress-maketitle
%% TEST-WHAT: Verify \maketitle does NOT produce a spurious atom number.
%%            The first real atom should be 1.1, not 0.1.
%% TEST-SOURCE: Pickup doc (maketitle gets margin atom number)
%% TEST-SECTION: DESIGN.md §8a.6 suppression
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.1}{paragraph} = 1
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.2}{paragraph} = 1
%% TEST-SBL-NOT-CONTAINS: \semtex@sbl@atom{0
%% TEST-ATOMS-MIN: 2
%% TEST-SBL-NOT-CONTAINS: \semtex@sbl@atom{1.3
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% When \maketitle is not suppressed, its internal paragraph gets
%% numbered as atom 0.1 (before any \section resets the counter).
%% With suppression, the first atom should be 1.1 inside the
%% first section.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\title{A Test Document}
\author{Test Author}

\begin{document}
\START

\maketitle

\section{First section}

First body paragraph. Expected atom 1.1.

Second body paragraph. Expected atom 1.2.

\END
\end{document}
