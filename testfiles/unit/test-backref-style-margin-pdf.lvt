%% TEST-NAME: test-backref-style-margin-pdf
%% TEST-WHAT: Verify that backref-style=margin renders "Used in" text
%%            in the PDF and that the backrefs are clickable hyperlinks.
%%            Extends test-backref-style-margin with PDF-level assertions.
%% TEST-SOURCE: docs/DESIGN.md §Rendering, §Backref styles
%% TEST-SECTION: codependent-render.sty \codep@rendermargin
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{theorem} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:first}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{theorem:1.1}{thm:first}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,hyperref,codependent
%% TEST-RERUN: 2
%% TEST-PDF-CONTAINS: Used in
%% TEST-PDF-ALL-BACKREFS-LINKED: yes
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
%% Two theorems where the second references the first.  With
%% backref-style=margin, the "Used in 1.2" annotation should appear
%% in the right margin of Theorem 1.1, rendered via
%% \codep@emitmarginbackref.  The PDF assertions verify the text
%% is present and that the hyperlinks are functional.
%%
%% Negative assertions:
%%   - Theorem 1.1 does not reference itself, so no self-backref.
%%   - No orphan links (every link dest has a matching anchor).

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true, linkcolor=blue}
\usepackage[depth=1,backref-style=margin]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem (backref target: referenced by 1.2)
\begin{theorem}\label{thm:first}
  The first theorem establishes the base case.
\end{theorem}

% Atom 1.2 -- theorem (references thm:first, generating a backref)
\begin{theorem}\label{thm:second}
  The second theorem extends Theorem~\ref{thm:first}
  to the general case.
\end{theorem}

\END
\end{document}
