%% TEST-NAME: test-equations-consecutive-align
%% TEST-WHAT: Two separate align blocks in the same section produce two
%%            independent ranges (1--2) and (3--4).  Ranges must NOT
%%            merge across blocks.  Refs in each block are attributed
%%            only to that block's range.
%% TEST-SOURCE: DESIGN.md §Equations as backref sources (Track 2)
%% TEST-SECTION: codependent.sty \codep@trackalignenv
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{definition} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1--2}{thm:alpha}
%% TEST-AUX-CONTAINS: \codep@atomref{equation:3--4}{def:beta}
%% TEST-AUX-CONTAINS: \codep@anchormap{equation:1--2}
%% TEST-AUX-CONTAINS: \codep@anchormap{equation:3--4}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:1--4}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:1--3}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:2--4}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:2--3}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:1}{thm:alpha}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:3}{def:beta}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,hyperref,codependent
%% TEST-RERUN: 2
%%
%% First align: equations 1 and 2 → range (1--2).
%% Second align: equations 3 and 4 → range (3--4).
%% The two ranges must be independent; no cross-block merging.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{hyperref}
\usepackage[depth=1]{codependent}
\codeptrack{theorem,definition}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:alpha}
  First theorem.
\end{theorem}

% Atom 1.2 -- definition
\begin{definition}\label{def:beta}
  First definition.
\end{definition}

% First align block: equations 1 and 2 → range source (1--2).
\begin{align}
  x &= y  \quad\text{by \ref{thm:alpha}} \label{eq:a1} \\
  u &= v  \label{eq:a2}
\end{align}

% Second align block: equations 3 and 4 → range source (3--4).
% Must NOT merge with the first block.
\begin{align}
  p &= q  \label{eq:b1} \\
  a &= b  \quad\text{by \ref{def:beta}}  \label{eq:b2}
\end{align}

\END
\end{document}
