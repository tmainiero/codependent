%% TEST-NAME: test-equations-unnumbered-no-backref
%% TEST-WHAT: Unnumbered equation environments do not create equation
%%            backref sources, so visible "Used in" text never appears.
%% TEST-SOURCE: .claude/comms/behavior-coverage-audit-report.md B-EQ-UNNUM
%% TEST-SECTION: unnumbered equation suppression
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-NOT: Used in
%% TEST-PACKAGES: amsmath,amsthm,hyperref,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-EQ-UNNUM

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage[depth=1]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Unnumbered equations}

\begin{theorem}\label{thm:target}
  Target theorem for unnumbered equation references.
\end{theorem}

\begin{equation*}
  x = y \quad \text{by \ref{thm:target}}
\end{equation*}

\begin{align*}
  u &= v \quad \text{by \ref{thm:target}} \\
  p &= q
\end{align*}

\END
\end{document}
