%% TEST-NAME: test-frontedge-Refstar
%% TEST-WHAT: Verify \Ref*{thm:A} (capitalised star variant from nameref)
%%            from theorem 1.2 still emits \codep@atomref{theorem:1.2}{thm:A}.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 6: \Ref*)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,nameref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% \Ref* is the no-hyperlink starred form of \Ref from the nameref
%% package. The front-edge wrapper uses \@ifstar to detect the star
%% and still fires \codep@frontedge@emit before delegating to the
%% saved \Ref original (which handles the star variant internally).

\documentclass{article}
\usepackage{hyperref}
\usepackage{nameref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge Ref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \Ref*{thm:A} (capitalised, no hyperlink) the conclusion follows.
\end{theorem}

\END
\end{document}
