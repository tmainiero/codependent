%% TEST-NAME: test-base-counter-custom
%% TEST-WHAT: Verify that codependent works when the base counter is NOT named
%%            "theorem".  Uses \newtheorem{thm}{Theorem}[section] as the
%%            base, with \newtheorem{defn}[thm]{Definition} as a sibling.
%%            Both must share the atom counter, produce sequential numbering,
%%            and emit correct SBL records.
%% TEST-SOURCE: Bug fix: \codep@setupcounter hardcoded c@theorem; now
%%              auto-detects via \codep@basecounter from first env in list.
%% TEST-SECTION: codependent.sty \codeptrack, \codep@setupcounter
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{thm} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{defn} = 1
%% TEST-CDP-COUNT: \codep@cdp@meta{1.1}{env}{thm} = 1
%% TEST-CDP-COUNT: \codep@cdp@meta{1.2}{env}{defn} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-NUM-SHARED, B-NUM-SEQ
%%
%% Pins the auto-detection fix: the first env in \codeptrack is "thm",
%% not "theorem".  Before the fix, \codep@setupcounter would look for
%% \c@theorem (undefined) and silently skip the counter alias, breaking
%% all numbering.  After the fix, \codep@basecounter is set to "thm"
%% and all counter wiring uses that name.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{thm}{Theorem}[section]
\newtheorem{defn}[thm]{Definition}
\usepackage{codependent}
\codeptrack{thm,defn}

\begin{document}
\START

\section{Custom counter names}

\begin{thm}
  A theorem using the ``thm'' environment. Expected atom 1.1.
\end{thm}

\begin{defn}
  A definition sharing the ``thm'' counter. Expected atom 1.2
  (sequential with the theorem above).
\end{defn}

\END
\end{document}
