%% TEST-NAME: test-proofs-paragraph-breaks-adjacency
%% TEST-PURPOSE: A paragraph between theorem and proof breaks adjacency;
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-ADJRULE
%% TEST-STATUS: LIVE
%% TEST-WHAT: A paragraph between theorem and proof breaks adjacency;
%%            the proof becomes STANDALONE (opaque proof-id key,
%%            no shared-counter slot, suppressed from source-token output).
%% TEST-SOURCE: docs/DESIGN.md §Proof adjacency
%% TEST-SECTION: docs/DESIGN.md §8a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-CONTAINS: Proof not adjacent to a tracked
%% TEST-PDF-NOT: Used in
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.3}{proof}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-ATOMS-MIN: 3
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% The paragraph of text between theorem and proof clears
%% \codep@lasttheorematom, so the proof falls through to the
%% standalone path: opaque proof-id key, no shared-counter slot,
%% and suppressed from rendered "Used in ..." source-token output
%% on the theorem.  The standalone proof's CDP atom record uses
%% the opaque a<N> key, so {1.3}{proof} no longer appears.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  Main theorem statement.
\end{theorem}

% Atom 1.2 -- paragraph (clears adjacency)
A paragraph of text that intervenes between the theorem
and its proof, breaking adjacency detection.

% Atom 1.3 -- proof (standalone, NOT inherited)
\begin{proof}
  This proof is separated by a paragraph. See \ref{thm:main}.%
  \codepbackrefs
  It should get its own atom number, not inherit from the theorem.
\end{proof}

\END
\end{document}
