%% TEST-NAME: test-suppress-display-math
%% TEST-WHAT: Verify display math environments (equation, align, etc.)
%%            do NOT produce spurious atom margin numbers.
%% TEST-SOURCE: Pickup doc bug #2 (display equations get margin numbers)
%% TEST-SECTION: DESIGN.md §8a.6 suppression
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.1}{theorem} = 1
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.2}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-SBL-NOT-CONTAINS: \semtex@sbl@atom{1.3
%% TEST-PACKAGES: amsthm,amsmath,semtex
%% TEST-RERUN: 2
%%
%% Display math environments (equation, align, gather, etc.) fire
%% para/begin hooks and would get spurious atom numbers without
%% suppression. This test verifies that equation and align inside
%% a theorem, plus a standalone equation, do NOT create atom
%% records. Only the theorem and the trailing paragraph are atoms.

\documentclass{article}
\usepackage{amsthm}
\usepackage{amsmath}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Display math suppression}

\begin{theorem}
Let $f$ be continuous. Then
\begin{equation}
  f(x) = \int_0^x f'(t)\,dt.
\end{equation}
Moreover,
\begin{align}
  g(x) &= f(x) + 1, \\
  h(x) &= f(x) - 1.
\end{align}
\end{theorem}

Body paragraph after the theorem. Atom 1.2.

\begin{equation}
  a^2 + b^2 = c^2
\end{equation}

\END
\end{document}
