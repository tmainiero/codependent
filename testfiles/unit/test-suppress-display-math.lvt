%% TEST-NAME: test-suppress-display-math
%% TEST-PURPOSE: Verify display math environments (equation, align, etc.)
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-SUPP-MATH
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify display math environments (equation, align, etc.)
%%            do NOT produce spurious atom margin numbers.
%% TEST-SOURCE: Pickup doc bug #2 (display equations get margin numbers)
%% TEST-SECTION: docs/DESIGN.md §8a.6 suppression
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-NOT: 1.3
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.3
%% TEST-PACKAGES: amsthm,amsmath,codependent
%% TEST-RERUN: 2
%%
%% Display math environments (equation, align, gather, etc.) fire
%% para/begin hooks and would get spurious atom numbers without
%% suppression. This test verifies that equation and align inside
%% a theorem, plus a standalone equation, do NOT create atom
%% records. Only the theorem and the trailing paragraph are atoms.

\documentclass{article}
\usepackage{amsthm}
\usepackage{amsmath}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Display math suppression}

\begin{theorem}
Let $f$ be continuous. Then
\begin{equation}
  f(x) = \int_0^x f'(t)\,dt.
\end{equation}
Moreover,
\begin{align}
  g(x) &= f(x) + 1, \\
  h(x) &= f(x) - 1.
\end{align}
\end{theorem}

Body paragraph after the theorem. Atom 1.2.

\begin{equation}
  a^2 + b^2 = c^2
\end{equation}

\END
\end{document}
