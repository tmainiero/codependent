%% TEST-NAME: test-frontedge-pagerefstar
%% TEST-PURPOSE: Verify \pageref*{thm:A} (star variant, no hyperlink on
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \pageref*{thm:A} (star variant, no hyperlink on
%%            page number) from theorem 1.2 still emits
%%            \codep@atomref{theorem:1.2}{thm:A}.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 4: \pageref*)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% hyperref defines \pageref* analogously to \ref*: the page number is
%% rendered without a hyperlink. The front-edge wrapper uses \@ifstar
%% to detect the star and still calls \codep@frontedge@emit before
%% delegating to the saved \pageref original.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge pageref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  Theorem A is on page~\pageref*{thm:A} (no hyperlink on page number).
\end{theorem}

\END
\end{document}
