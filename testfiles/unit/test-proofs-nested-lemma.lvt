%% TEST-NAME: test-proofs-nested-lemma
%% TEST-PURPOSE: A lemma inside a proof gets its own atom number; the proof
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-INNER
%% TEST-STATUS: LIVE
%% TEST-WHAT: A lemma inside a proof gets its own atom number; the proof
%%            inherits the theorem number; the lemma is independent because
%%            proofs are not tracked envs (only nestlevel, not trackedlevel).
%% TEST-SOURCE: docs/DESIGN.md §Proof environments, §Tracked env hooks
%% TEST-SECTION: docs/DESIGN.md §8a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-PDF-CONTAINS: Lemma 1.2. A helper lemma inside the proof.
%% TEST-PDF-NOT: Proof 1.
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.2}{lemma}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% A lemma inside an adjacent proof is not inside another tracked env
%% (proofs use nestlevel for paragraph suppression, not trackedlevel),
%% so the lemma gets its own independent atom number (1.2).  The proof
%% inherits the theorem's number as 1.1*.  The SBL has records for
%% both the theorem atom, the inherited proof, and the lemma atom.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\usepackage{codependent}
\codeptrack{theorem,lemma}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  Main theorem.
\end{theorem}

% Adjacent proof: inherits 1.1*
\begin{proof}
  We begin by establishing a helper.
  % Lemma inside proof: gets its own atom (1.2)
  \begin{lemma}
    A helper lemma inside the proof.
  \end{lemma}
  Using the lemma, the result follows.
\end{proof}

\END
\end{document}
