%% TEST-NAME: test-equations-separate
%% TEST-WHAT: Verify the equation counter stays independent of the atom
%%            counter; \eqref works; a paragraph-then-equation-then-paragraph
%%            sequence produces two atoms, not three.
%% TEST-SOURCE: DESIGN.md §Equation numbering
%% TEST-SECTION: DESIGN.md §Equation numbering
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@sbl@end{OK}
%% TEST-CDP-COUNT: \codep@sbl@atom{1.1}{paragraph} = 1
%% TEST-CDP-COUNT: \codep@sbl@atom{1.2}{paragraph} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{1.2}{eq:first}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,codependent
%% TEST-RERUN: 2
%%
%% The equation counter advances independently (eq:first gets
%% equation number 1, the standard amsmath behaviour) and the
%% atom counter does not step on \begin{equation}. Display math
%% environments are suppressed so they do not produce atom
%% records. The two paragraphs around the display equation are
%% atoms 1.1 and 1.2. \eqref{eq:first} in the second paragraph
%% emits an atomref edge from 1.2 to eq:first.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Equations separate}

First paragraph before the display equation. Atom 1.1.

\begin{equation}\label{eq:first}
  a + b = c.
\end{equation}

Second paragraph, which references \eqref{eq:first}. Atom 1.2.

\END
\end{document}
