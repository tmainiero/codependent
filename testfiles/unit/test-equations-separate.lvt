%% TEST-NAME: test-equations-separate
%% TEST-WHAT: Verify the default equations=separate mode keeps the
%%            equation counter independent of the atom counter; \eqref
%%            works; a paragraph-then-equation-then-paragraph sequence
%%            produces two atoms, not three.
%% TEST-SOURCE: DESIGN.md §Equation numbering, REVIEW_E #6 context
%% TEST-SECTION: DESIGN.md §Equation numbering
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.1}{paragraph} = 1
%% TEST-SBL-COUNT: \semtex@sbl@atom{1.2}{paragraph} = 1
%% TEST-AUX-CONTAINS: \semtex@atomref{1.3}{eq:first}
%% TEST-ATOMS-MIN: 3
%% TEST-PACKAGES: amsmath,amsthm,semtex
%% TEST-RERUN: 2
%%
%% Pins default equations=separate behaviour. Under this mode
%% the equation counter advances independently (eq:first gets
%% equation number 1, the standard amsmath behaviour) and the
%% atom counter does not step on \begin{equation}. The two
%% paragraphs around the display equation are atoms 1.1 and
%% 1.2. \eqref{eq:first} in the second paragraph emits an
%% atomref edge from 1.2 to eq:first.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[equations=separate]{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Equations separate}

First paragraph before the display equation. Atom 1.1.

\begin{equation}\label{eq:first}
  a + b = c.
\end{equation}

Second paragraph, which references \eqref{eq:first}. Atom 1.2.

\END
\end{document}
