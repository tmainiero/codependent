%% TEST-NAME: test-newdoccommand-tracking
%% TEST-WHAT: Verify \semtexNewDocumentCommand{\Cite}{s o m}{...} emits
%%            the expected \semtex@sbl@cmddef records (kind=NewDocumentCommand,
%%            argspec, src) and that the defined \Cite command works with
%%            xparse-style argument variants (star, optional, mandatory).
%% TEST-SOURCE: DESIGN.md §9a User API: \semtexNewDocumentCommand
%% TEST-SECTION: DESIGN.md §9a User API
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-CONTAINS: \semtex@sbl@cmddef{Cite}{kind}{NewDocumentCommand}
%% TEST-SBL-CONTAINS: \semtex@sbl@cmddef{Cite}{argspec}{s o m}
%% TEST-SBL-CONTAINS: \semtex@sbl@cmddef{Cite}{src}
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% Parallel test to test-newcommand-tracking but for the
%% \semtexNewDocumentCommand variant. The schema differs in
%% one record: instead of `arity` (integer), the cmddef
%% records carry `argspec` (xparse spec string verbatim).
%%
%% The defined command must support all xparse argument
%% types from the spec ("s o m" = star, optional, mandatory)
%% via \IfBooleanTF and \IfValueTF inside the body. Each
%% invocation inside an atom must emit \semtex@sbl@use.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\semtexNewDocumentCommand{\Cite}{s o m}{%
  \IfBooleanTF{#1}%
    {[\textbf{#3}\IfValueT{#2}{, #2}]}%
    {[#3\IfValueT{#2}{, #2}]}%
}

\begin{document}
\START

\section{Test}

A paragraph with \Cite{Lurie2009},
\Cite[p. 12]{Lurie2009}, and
\Cite*{Lurie2009}.  Each invocation should emit
\semtex@sbl@use{<atom>}{Cite} to the sidecar.

\END
\end{document}
