%% TEST-NAME: test-numbering-sibling
%% TEST-WHAT: thmtools sibling=theorem envs get correct atom numbering.
%%            With depth=2, all tracked envs (theorem, corollary,
%%            definition) must display section.subsection.atom format
%%            and share a single sequential counter.
%% TEST-SOURCE: Bug report: sibling envs displayed wrong format
%%              (e.g. 3.4 instead of 3.0.3) because \the<env> was
%%              not re-aliased to \theatom in the \codeptrack loop.
%% TEST-SECTION: DESIGN.md §Numbering, codependent.sty \codeptrack loop
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@sbl@end{OK}
%% TEST-CDP-COUNT: \codep@sbl@atom{1.1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@sbl@atom{1.1.2}{corollary} = 1
%% TEST-CDP-COUNT: \codep@sbl@atom{1.1.3}{definition} = 1
%% TEST-ATOMS-MIN: 3
%% TEST-PACKAGES: thmtools,amsthm,codependent
%% TEST-RERUN: 2
%%
%% Pins sibling counter-sharing: thmtools' sibling=theorem makes
%% corollary and definition share theorem's counter register.
%% codependent must re-alias both \c@<env> and \the<env> to the atom
%% counter/display.  Without the \the<env> fix, depth=2 would
%% show e.g. "1.4" for corollary instead of "1.1.2".

\documentclass{article}
\usepackage{amsthm}
\usepackage{thmtools}
\declaretheorem[numberwithin=section]{theorem}
\declaretheorem[sibling=theorem]{corollary}
\declaretheorem[sibling=theorem]{definition}
\usepackage[depth=2]{codependent}
\codeptrack{theorem,corollary,definition}

\begin{document}
\START

\section{Results}

\subsection{Main results}

\begin{theorem}
  First result. Expected atom 1.1.1.
\end{theorem}

\begin{corollary}
  Follows from the theorem. Expected atom 1.1.2.
\end{corollary}

\begin{definition}
  A key definition. Expected atom 1.1.3.
\end{definition}

\END
\end{document}
