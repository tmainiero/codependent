%% TEST-NAME: test-concept-in-restatable-intro-teaser
%% TEST-WHAT: Verify the intro-teaser pattern: restatable* (teaser,
%%            non-primary) in the intro, then restatable (primary)
%%            in the main body. The def site for \Hom* MUST be the
%%            main-body atom, NEVER the intro teaser.
%% TEST-SOURCE: DESIGN.md §8a.5.a save/clear/restore, §8a.9
%%              Interaction with restatable
%% TEST-SECTION: DESIGN.md §8a.5.a, §8a.9
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-SBL-CONTAINS: \codep@sbl@end{OK}
%% TEST-SBL-COUNT: \codep@sbl@def{2.1}{Hom} = 1
%% TEST-AUX-CONTAINS: \codep@concept{Hom}{2.1}
%% TEST-PACKAGES: thmtools,hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% The intro section 1 uses restatable* (starred = non-primary)
%% to show a teaser of the theorem. Inside the teaser body,
%% \Hom* fires but the §8a.5.a guard clears currentatom on
%% the restate branch, so the star silently no-ops.
%%
%% Later, in section 2, the unstarred restatable fires as the
%% primary occurrence. The counter alias is intact, the normal
%% hook body runs, and the \Hom* inside the body registers 2.1
%% as the def site.
%%
%% Assertions verify that ONLY 2.1 is recorded as the def site.

\documentclass{article}
\usepackage{thmtools}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\codepnewcommand{\Hom}[2]{\mathrm{Hom}(#1,#2)}

\begin{document}
\START

\section{Introduction}

We tease a result early.

\begin{restatable*}{theorem}{thmMain}
  The $\Hom*{X}{Y}$ set has the expected universal property.
\end{restatable*}

The paragraph after the teaser resumes normal atom flow.

\section{Main}

\begin{restatable}{theorem}{thmMain}\label{thm:main}
  The $\Hom*{X}{Y}$ set has the expected universal property.
\end{restatable}

Later uses of $\Hom{A}{B}$ resolve via the concept map to the
main-body atom, not the intro teaser.

\END
\end{document}
