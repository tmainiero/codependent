%% TEST-NAME: test-setref-kernel-ref
%% TEST-WHAT: Verify plain \ref{thm:later} still emits
%%            \codep@atomref{theorem:1.1}{thm:later} on pass 1 after
%%            the resolved-backend wrappers are removed.
%% TEST-SOURCE: .claude/comms/w03-sw5c-plan/PLAN.md §4 commit 3
%% TEST-SECTION: .claude/comms/w03-sw5c-plan/PLAN.md §5 commit 3
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.1}{thm:later}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 1
%% TEST-BEHAVIOR: B-PASS-ONE, B-FRONTEDGE-CAPTURE
%%
%% Commit-3 regression guard: the theorem references a label defined
%% later in the same run, so the old resolved-backend path cannot be
%% the source of the aux record. If the atomref is present here, the
%% front-edge wrapper is carrying the load by itself.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Kernel ref forward-capture test}

\begin{theorem}
  By \ref{thm:later} the conclusion follows.
\end{theorem}

\begin{theorem}\label{thm:later}
  Theorem declared after the reference.
\end{theorem}

\END
\end{document}
