%% TEST-NAME: test-setref-kernel-ref
%% TEST-WHAT: Verify plain \ref{thm:A} produces a \semtex@atomref edge
%%            via the kernel \@setref patch site.
%% TEST-SOURCE: DESIGN.md §8a.0 patch site 1 (kernel \@setref)
%% TEST-SECTION: DESIGN.md §8a.0 Reference interception
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package semtex Warning
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-AUX-CONTAINS: \semtex@atomref{1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% Baseline regression for the kernel \@setref patch site. Plain
%% \ref goes through latex.ltx's \@setref, which is the simplest
%% of the three reference interception points. If this test fails
%% the whole back-reference graph is dead; check the \let
%% \semtex@orig@setref\@setref wrap in Section 8a.0.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Kernel ref test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \ref{thm:A} the conclusion follows.
\end{theorem}

\END
\end{document}
