%% TEST-NAME: test-cmd-uses
%% TEST-WHAT: Verify a wrapped command (defined via \semtexnewcommand)
%%            emits one \semtex@sbl@use record per invocation INSIDE
%%            an atom, and ZERO use records when invoked outside any
%%            atom (e.g., in section titles).
%% TEST-SOURCE: DESIGN.md §9a User API "Side effects at invocation time"
%% TEST-SECTION: DESIGN.md §9a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-COUNT: \semtex@sbl@use{1.1}{Hom} = 3
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% The wrapper guards on \ifx\semtex@currentatom\@empty:
%%   - Inside an atom (paragraph 1.1 below): each \Hom call
%%     emits \semtex@sbl@use{1.1}{Hom}.
%%   - Outside any atom (the section title below): \Hom is
%%     called once but \semtex@currentatom is empty, so no
%%     use record fires.
%%
%% Expected: exactly 3 use records for {1.1}, zero for any
%% other atom number, and zero from the title invocation.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{semtex}
\semtextrack{theorem}

\semtexnewcommand{\Hom}[2]{\mathrm{Hom}(#1,#2)}

\begin{document}
\START

% \Hom in a section title: must NOT emit a use record (no
% currentatom). The currentatom-clear fix from §8a.5 ensures
% the previous atom's number is gone before the \section
% expansion runs.
\section{The $\Hom{X}{Y}$ functor}

A paragraph with three uses: $\Hom{X}{Y}$, $\Hom{Y}{Z}$,
and the composite $\Hom{X}{Z}$. Three use records for atom
1.1 are expected.

\END
\end{document}
