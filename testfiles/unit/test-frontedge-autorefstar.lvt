%% TEST-NAME: test-frontedge-autorefstar
%% TEST-PURPOSE: Verify \autoref*{thm:A} (star variant, no hyperlink) from
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \autoref*{thm:A} (star variant, no hyperlink) from
%%            theorem 1.2 still emits \codep@atomref{theorem:1.2}{thm:A}.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 8: \autoref*)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% hyperref defines \autoref* as the no-hyperlink form of \autoref.
%% The front-edge wrapper uses \@ifstar so that both the starred and
%% unstarred form are intercepted; the label argument is emitted via
%% \codep@frontedge@emit before the saved original is called.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge autoref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \autoref*{thm:A} the conclusion follows (type prefix, no hyperlink).
\end{theorem}

\END
\end{document}
