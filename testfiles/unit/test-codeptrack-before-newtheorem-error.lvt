%% TEST-NAME: test-codeptrack-before-newtheorem-error
%% TEST-PURPOSE: Calling \codeptrack before the theorem environment exists
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-EDGE-TRACK-ORDER
%% TEST-STATUS: LIVE
%% TEST-WHAT: Calling \codeptrack before the theorem environment exists
%%            is a package error and produces no visible backrefs.
%% TEST-PINS-KNOWN-BROKEN: no
%% TEST-SOURCE: .claude/comms/behavior-coverage-audit-report.md B-EDGE-TRACK-ORDER
%% TEST-SECTION: codeptrack ordering
%% TEST-EXIT: 1
%% TEST-EXPECT-PACKAGE-ERROR: codeptrack\s+called\s+before\\newtheorem
%% TEST-LOG-NOT: Undefined control sequence
%% TEST-PDF-NOT: Used in
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 1

\documentclass{article}
\usepackage{amsthm}
\usepackage{codependent}
\codeptrack{theorem}
\newtheorem{theorem}{Theorem}[section]

\begin{document}
\START
\section{Ordering}
\begin{theorem}
  This should never typeset normally.
\end{theorem}
\END
\end{document}
