%% TEST-NAME: test-numbering-depth1
%% TEST-WHAT: depth=1 option produces section.atom display numbers
%%            (e.g. "1.1", "2.1") under the default article class.
%% TEST-SOURCE: DESIGN.md §Numbering "Depth"
%% TEST-SECTION: DESIGN.md §Numbering, codependent.sty lines 192-194
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-SBL-CONTAINS: \codep@sbl@end{OK}
%% TEST-SBL-COUNT: \codep@sbl@atom{1.1}{paragraph} = 1
%% TEST-SBL-COUNT: \codep@sbl@atom{2.1}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Pins depth=1 behaviour: the atom counter resets at \section
%% boundaries and the display format is \thesection.\arabic{atom}.
%% Two sections, one paragraph each, yields atoms 1.1 and 2.1 (NOT
%% 1.1 and 1.2). A regression that forgets to \@addtoreset{atom}{section}
%% would emit 1.1 and 1.2 instead.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[depth=1]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{First}

A paragraph in the first section. Expected atom 1.1.

\section{Second}

A paragraph in the second section. Expected atom 2.1.

\END
\end{document}
