%% TEST-NAME: test-concept-scope-visible
%% TEST-PURPOSE: Concept-use edges render only on the definition atom's row,
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-CONC-SCOPE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Concept-use edges render only on the definition atom's row,
%%            not on unrelated referenced atoms.
%% TEST-PINS-KNOWN-BROKEN: yes
%% TEST-SOURCE: .claude/comms/behavior-coverage-audit-report.md B-CONC-SCOPE
%% TEST-SECTION: concept edge scope
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-STEXT: (?s)Used in 1\.3\.
%% TEST-PDF-STEXT: (?s)Used in 1\.4\.
%% TEST-PDF-STEXT-NOT: Used in 1\.3, 1\.4
%% TEST-PDF-STEXT-NOT: Used in 1\.4, 1\.3
%% TEST-PACKAGES: amsthm,hyperref,codependent
%% TEST-RERUN: 2

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{hyperref}
\usepackage{codependent}
\codeptrack{theorem,definition}
\codepnewcommand{\Hom}[2]{\mathrm{Hom}(#1,#2)}

\begin{document}
\START

\section{Concept scope}

\begin{theorem}\label{thm:target}
  Target theorem for an ordinary reference.
\end{theorem}

\begin{definition}
  Definition atom introducing $\Hom*{X}{Y}$.
\end{definition}

\begin{theorem}
  By \ref{thm:target}, the ordinary reference hits only the theorem row.
\end{theorem}

\begin{theorem}
  The concept use $\Hom{A}{B}$ hits only the definition row.
\end{theorem}

\END
\end{document}
