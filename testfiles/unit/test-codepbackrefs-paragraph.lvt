%% TEST-NAME: test-codepbackrefs-paragraph
%% TEST-WHAT: \codepbackrefs called inside a paragraph body (outside
%%            any tracked env) emits the paragraph atom's refs; no
%%            auto-flush collision (paragraphs don't auto-flush).
%% TEST-SOURCE: wave3-plan-v11.md P01(A2) call-site contract
%% TEST-SECTION: codependent.sty §\codepbackrefs
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-PDF-CONTAINS: Used in 1.2.
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{paragraph} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{theorem} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{par:intro}
%% --- Exactly one "Used in 1.2" line for paragraph:1.1:
%% TEST-PDF-STEXT-NOT: Used in 1\.2[^0-9].*Used in 1\.2
%% TEST-PACKAGES: amsthm,hyperref,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-REND-INLINE, B-NUM-PARA
%%
%% Intro paragraph is atom 1.1 and calls \codepbackrefs in its body
%% with \label{par:intro}. Theorem 1.2 refs par:intro. At pass 2,
%% \codepbackrefs emits "Used in 1.2" at the paragraph call site.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{hyperref}
\usepackage[paragraphs=on]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Introduction}

This intro paragraph is atom 1.1.\label{par:intro}
It calls \codepbackrefs to emit its own backrefs at this call site.
\codepbackrefs

\begin{theorem}
  A theorem referencing the intro paragraph~\ref{par:intro}.
\end{theorem}

\END
\end{document}
