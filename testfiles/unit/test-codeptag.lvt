%% TEST-NAME: test-codependenttag
%% TEST-WHAT: Verify \codeptag{kind}{value} emits a flat
%%            \codep@cdp@tag record carrying the current atom number,
%%            kind, and value, with no visible typeset effect.
%% TEST-SOURCE: docs/DESIGN.md §9a User API: \codeptag
%% TEST-SECTION: docs/DESIGN.md §9a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@tag{1.1}{uid}{cat:category}
%% TEST-CDP-CONTAINS: \codep@cdp@tag{1.1}{introduces}{Hom}
%% TEST-CDP-CONTAINS: \codep@cdp@tag{1.1}{type}{Cat}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-NUM-SHARED
%%
%% \codeptag is the user-facing semantic-tagging command.
%% It writes one \codep@cdp@tag record per call, scoped to
%% the current atom. Multiple tags per atom are allowed
%% (different kind values, or even repeated kind for lists
%% like "introduces").
%%
%% Format must be FLAT (one record per (atom, kind, value)
%% triple), per REVIEW_C #6: no kv blobs, no embedded commas
%% or equals signs.
%%
%% \codeptag must produce zero typeset output (sidecar-only).

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{codependent}
\codeptrack{theorem,definition}

\begin{document}
\START

\section{Test}

\begin{definition}
  \codeptag{uid}{cat:category}%
  \codeptag{introduces}{Hom}%
  \codeptag{type}{Cat}%
  A \emph{category} consists of objects and morphisms.
\end{definition}

\END
\end{document}
