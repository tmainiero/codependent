%% TEST-NAME: test-equations-shared-align
%% TEST-WHAT: Verify equations=shared mode inside align: each
%%            equation line is a separate atom (by design).
%% TEST-SOURCE: DESIGN.md §Equation numbering, §Package options
%% TEST-SECTION: DESIGN.md §Equation numbering
%% TEST-EXIT: 0
%% TEST-PINS-KNOWN-BROKEN: yes
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-ATOMS-MIN: 4
%% TEST-PACKAGES: amsmath,amsthm,semtex
%% TEST-RERUN: 2
%%
%% In equations=shared mode, the equation counter is
%% \let-aliased to the atom counter. Each numbered line in
%% an align environment steps the atom counter, producing
%% one atom per equation line. This is CORRECT: align lines
%% are semantically distinct equations (use aligned inside
%% equation for a single logical unit). The lead paragraph,
%% three align lines, and trailing paragraph produce >= 4 atoms.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[equations=shared]{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Equations shared hazard}

Lead paragraph. In shared mode this is atom 1.something; the
exact number depends on whether pdflatex has yet triggered
\refstepcounter via the para/begin hook.

\begin{align}
  a_1 &= b_1, \label{eq:line1} \\
  a_2 &= b_2, \label{eq:line2} \\
  a_3 &= b_3. \label{eq:line3}
\end{align}

Trailing paragraph. In shared mode, multiple atom counter
ticks will have fired between the lead and trailing paras
(one per align line). This behaviour is documented, not
tested for a specific count.

\END
\end{document}
