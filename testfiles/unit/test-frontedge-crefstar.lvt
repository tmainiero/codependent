%% TEST-NAME: test-frontedge-crefstar
%% TEST-PURPOSE: Verify \cref*{thm:A} (star suppresses hyperlink) from
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify \cref*{thm:A} (star suppresses hyperlink) from
%%            theorem 1.2 still emits \codep@atomref{theorem:1.2}{thm:A}.
%% TEST-SOURCE: docs/SW5c.md §2.2 primitive list (row 10: \cref*)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% cleveref's \cref* suppresses the hyperlink on the formatted reference.
%% The front-edge wrapper uses \@ifstar and calls \codep@frontedge@emit
%% with the label before delegating to the saved starred form, so the
%% atomref is recorded even when the hyperlink is suppressed.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge cref-star test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \cref*{thm:A} (no hyperlink) the conclusion follows.
\end{theorem}

\END
\end{document}
