%% TEST-NAME: test-proofs-backref-star
%% TEST-WHAT: Cross-references from inside adjacent proofs produce starred
%%            atom numbers in aux records (e.g. codep@atomref{1.1*}{...}).
%% TEST-SOURCE: DESIGN.md §Proof adjacency, §Back-reference graph
%% TEST-SECTION: DESIGN.md §8a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-AUX-CONTAINS: \codep@atomref{proof:1.1}{thm:target}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Verifies the starred source atom flows through the backref
%% pipeline: \codep@writeatomref uses \codep@sourceatom (set
%% by the adjacent proof path) to emit "1.1*" as the source.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Star backrefs}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:source}
  Source theorem.
\end{theorem}

% Adjacent proof: inherits 1.1*
\begin{proof}
  We use \ref{thm:target} in this proof.
\end{proof}

% Atom 1.2 -- theorem
\begin{theorem}\label{thm:target}
  Target theorem referenced from within the proof above.
\end{theorem}

\END
\end{document}
