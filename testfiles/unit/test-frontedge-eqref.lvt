%% TEST-NAME: test-frontedge-eqref
%% TEST-WHAT: Verify \eqref{thm:A} from theorem 1.2 emits
%%            \codep@atomref{theorem:1.2}{thm:A} via delegation through
%%            the \ref front-edge wrapper (amsmath implements \eqref as
%%            a formatting wrapper around \ref).
%% TEST-SOURCE: docs/SW5c.md §2.3 delegation table (eqref row)
%% TEST-SECTION: docs/SW5c.md §2 Front-edge capture
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,hyperref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-FRONTEDGE-CAPTURE
%%
%% amsmath defines \eqref as \textup{(\ref{#1})}. With the front-edge
%% wrapper in place, the inner \ref call fires \codep@frontedge@emit
%% before delegating to the saved original. The test uses \eqref with a
%% theorem label (rather than an equation label) to avoid coupling this
%% delegation fixture to equation-tracking behaviour.

\documentclass{article}
\usepackage{amsmath}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Front-edge eqref delegation test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  As in \eqref{thm:A} (eqref delegates to ref; front-edge fires).
\end{theorem}

\END
\end{document}
