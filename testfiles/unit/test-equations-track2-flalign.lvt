%% TEST-NAME: test-equations-track2-flalign
%% TEST-PURPOSE: Track 2: flalign with two numbered lines records a range
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-EQ-TRACK2
%% TEST-STATUS: LIVE
%% TEST-WHAT: Track 2: flalign with two numbered lines records a range
%%            source (1--2).  Each \ref in the flalign is attributed to
%%            the range.  Anchormap entry written for the range key.
%% TEST-SOURCE: docs/DESIGN.md §Equations as backref sources (Track 2)
%% TEST-SECTION: codependent.sty \codep@trackalignenv
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1}{theorem} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2}{definition} = 1
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1--2}{thm:alpha}
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1--2}{def:beta}
%% TEST-AUX-CONTAINS: \codep@anchormap{equation:1--2}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:1}{thm:alpha}
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{equation:2}{def:beta}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsmath,amsthm,hyperref,codependent
%% TEST-RERUN: 2
%%
%% No preceding equation env, so the flalign starts at counter 0.
%% Two numbered lines produce range (1--2).  Refs on different
%% lines are both attributed to the range, not to individual
%% equation numbers.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\usepackage{hyperref}
\usepackage[depth=1]{codependent}
\codeptrack{theorem,definition}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:alpha}
  First theorem.
\end{theorem}

% Atom 1.2 -- definition
\begin{definition}\label{def:beta}
  First definition.
\end{definition}

% Standalone flalign: two numbered lines, no preceding equation.
% Range source = (1--2).
\begin{flalign}
  x &= y  &\quad\text{by \ref{thm:alpha}} \label{eq:line1} \\
  a &= b  &\quad\text{by \ref{def:beta}}  \label{eq:line2}
\end{flalign}

\END
\end{document}
