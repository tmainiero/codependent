%% TEST-NAME: test-paragraphs-off
%% TEST-WHAT: paragraphs=off disables bare-paragraph atom tracking;
%%            theorems are still numbered normally.
%% TEST-SOURCE: DESIGN.md §Options
%% TEST-SECTION: DESIGN.md §Options
%% TEST-EXIT: 0
%% TEST-LOG-NOT: semtex.*Error|Undefined control sequence
%% TEST-SBL-CONTAINS: \semtex@sbl@end{OK}
%% TEST-SBL-CONTAINS: \semtex@sbl@atom{1.1}{theorem}
%% TEST-SBL-NOT-CONTAINS: {paragraph}
%% TEST-PACKAGES: amsthm,semtex
%% TEST-RERUN: 2
%%
%% With paragraphs=off, bare paragraphs get no atom numbers, no margin
%% numbers, no SBL records.  Theorem tracking is unaffected; the first
%% theorem should be atom 1.1 (not 1.2).

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[paragraphs=off]{semtex}
\semtextrack{theorem}

\begin{document}
\START

\section{Results}

A bare paragraph that should NOT get an atom number.

% Atom 1.1 -- theorem (no paragraph atom before it)
\begin{theorem}
  A theorem.
\end{theorem}

Another bare paragraph, also not tracked.

\END
\end{document}
