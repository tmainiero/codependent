%% TEST-NAME: test-setref-cleveref
%% TEST-WHAT: Verify \cref{thm:later} still emits
%%            \codep@atomref{theorem:1.1}{thm:later} on pass 1 after
%%            backend wrapper removal.
%% TEST-SOURCE: .claude/comms/w03-sw5c-plan/PLAN.md §4 commit 3
%% TEST-SECTION: .claude/comms/w03-sw5c-plan/PLAN.md §5 commit 3
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.1}{thm:later}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 1
%% TEST-BEHAVIOR: B-PASS-ONE, B-FRONTEDGE-CAPTURE
%%
%% This is the commit-3 regression guard for cleveref. The only pass is
%% a forward ref, so the old \cref@getlabel backend path cannot be the
%% source of the atomref. Resolved rendering remains covered by
%% test-frontedge-cref.lvt.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Cross-reference forward-capture test}

\begin{theorem}
  By \cref{thm:later}, the conclusion follows.
\end{theorem}

\begin{theorem}\label{thm:later}
  This theorem is declared after the \cref call.
\end{theorem}

\END
\end{document}
