%% TEST-NAME: test-setref-cleveref
%% TEST-WHAT: Verify \cref{thm:A} produces a backref edge in .cdp, even though
%%            cleveref bypasses \@setref entirely (uses \cref@getlabel directly).
%% TEST-SOURCE: REVIEW_E #2 (BLOCKER), REVIEW_F J3 (verified)
%% TEST-SECTION: docs/DESIGN.md §8a.0 Reference interception
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,cleveref,amsthm,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-LINK-CLICKABLE
%%
%% This is the canonical regression for REVIEW_E's BLOCKER finding 2:
%% the original codependent.sty (v0.1) only patched \@setref, which cleveref
%% never calls. Without the cleveref/hyperref expansion in §8a.0, this
%% test fails silently with zero atomref records in the .aux even though
%% the \cref renders correctly.

\documentclass{article}
\usepackage{hyperref}
\usepackage{cleveref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Cross-reference test}

\begin{theorem}\label{thm:A}
  This is theorem A. It will be referenced via cleveref.
\end{theorem}

\begin{theorem}
  By \cref{thm:A}, the conclusion follows. The \cref call here
  must produce a backref edge from this theorem to theorem A,
  even though cleveref's \cref does not call \@setref.
\end{theorem}

\END
\end{document}
