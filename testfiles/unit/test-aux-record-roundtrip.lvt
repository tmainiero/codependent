%% TEST-NAME: test-aux-record-roundtrip
%% TEST-PURPOSE: The four W03-P03 .aux record types (\codep@lblentity,
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PASS-ONE, B-PROOF-SEP
%% TEST-STATUS: LIVE
%% TEST-WHAT: The four W03-P03 .aux record types (\codep@lblentity,
%%            \codep@entitymeta, \codep@keymap, \codep@renderlist)
%%            are written at enddoc and round-trip to the next pass.
%%            W04-P01 activated the keymap emitter; this fixture now
%%            also asserts that \codep@keymap{old-key}{new-key} records
%%            (written when \codepproofof rebinds a separated proof)
%%            survive the aux roundtrip.  Scenario: theorem + adjacent
%%            proof + paragraph (section 1) + theorem + separated
%%            proof via \codepproofof (section 2).
%% TEST-SOURCE: .claude/comms/wave3-plan-v11.md §P03 (item 2,
%%              "New .aux record types");
%%              .claude/comms/waves/W04/plan-synthesized-rev3.md W04-P05
%% TEST-SECTION: docs/DESIGN.md §8a (proof envs), §9a (paragraph atoms)
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@lblentity{thm:a}{theorem:1.1}
%% TEST-AUX-CONTAINS: \codep@lblentity{thm:b}{theorem:2.1}
%% TEST-AUX-CONTAINS: \codep@lblentity{p:aside}{paragraph:
%% TEST-AUX-CONTAINS: \codep@entitymeta{theorem:1.1}{theorem}{1.1}{theorem}{}
%% --- W04-P02 (ix) audit — source authority: bug2-investigator §3:218
%% --- (verdict: restore-and-extend).  The failed rewrite hard-coded new
%% --- parent metadata into aux; that deliberate aux-semantic change is
%% --- permitted.  P02 unified \codep@bindproofparent to store the
%% --- prefixed parent key (e.g. theorem:1.1) instead of the raw atom-id,
%% --- so the classifier can discriminate ADJACENT/REBOUND from STANDALONE
%% --- by parent-slot emptiness alone.  This P05 audit confirms the
%% --- prefixed-key parent slot survives the aux roundtrip (TEST-RERUN: 2).
%% --- See \codep@graph@getentityparent + capture at \codep@hookproof@end.
%% TEST-AUX-CONTAINS: \codep@entitymeta{proof:a2}{proof}{1.1*}{proof}{theorem:1.1}
%% TEST-AUX-CONTAINS: \codep@entitymeta{theorem:2.1}{theorem}{2.1}{theorem}{}
%% TEST-AUX-CONTAINS: \codep@entitymeta{paragraph:
%% --- W05-A2: keymap rail removed; separated proof has stable identity proof:a5.
%% --- \codepproofof{thm:a} binds proof:a5 to theorem:1.1.
%% --- The aux may show anchormap{proof:1.1}{codep-proof:a5} for the
%% --- hyperref proof destination, but no keymap records (rail retired in W05-A2).
%% TEST-AUX-CONTAINS: \codep@entitymeta{proof:a5}{proof}{1.1*}{proof}{theorem:1.1}
%% TEST-AUX-NOT-CONTAINS: \codep@keymap
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Roundtrip scenario: a small mix of tracked entities produces
%% one \codep@lblentity per \label-in-tracked-env and one
%% \codep@entitymeta per closed tracked entity.  The keymap emitter
%% (W04-P01) writes one \codep@keymap entry per \codepproofof rebind.
%% All record types must survive the enddoc aux write so next-run
%% begindoc can repopulate the in-memory bindings before the body
%% processes any tracked envs.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Roundtrip}

\begin{theorem}\label{thm:a}
  A tracked theorem; produces theorem:1.1 atom.
\end{theorem}

\begin{proof}
  Adjacent proof; produces the proof atom and, at enddoc, one
  entitymeta aux record keyed on the proof's prefixed key.
\end{proof}

A tracked paragraph follows, labelled for binding.%
\label{p:aside}
One more sentence so the paragraph atom has material.

\section{Deferred proofs}

\begin{theorem}\label{thm:b}
  Second theorem; produces theorem:2.1 atom.
\end{theorem}

% Separated proof of thm:a.  Adjacent to thm:b, but \codepproofof
% rebinds the opaque proof atom proof:a5 to theorem:1.1.  No keymap
% records are written; the W05-A2 stable proof key is canonical.
\begin{proof}[Proof of Theorem~\ref{thm:a}]
  \codepproofof{thm:a}
  Separated proof of the first theorem; body runs after rebind.
\end{proof}

\END
\end{document}
