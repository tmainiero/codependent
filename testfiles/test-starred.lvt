% test-starred.lvt
% Verifies: \codeptrack{definition} auto-registers both "definition"
% and "definition*" (the starred variant amsthm creates automatically).
% Starred environments should receive atom numbers just like unstarred.
%
% Design reference: DESIGN.md "Starred environments" --
% \codeptrack{definition} auto-registers both definition and definition*

\documentclass{article}
\usepackage{amsthm}

\newtheorem{theorem}{Theorem}[section]
\newtheorem*{theorem*}{Theorem}
\newtheorem{definition}[theorem]{Definition}
\newtheorem*{definition*}{Definition}

\usepackage{codependent}
% Registering "definition" should implicitly also register "definition*"
\codeptrack{definition,theorem}

\begin{document}
\START

\section{Starred Variants}

% Atom 1.1 -- unstarred definition (advances counter)
\begin{definition}
  A \textbf{ring} is an abelian group $(R, +)$ with a second
  associative binary operation $(\cdot)$ that distributes over $+$.
\end{definition}

% Atom 1.2 -- starred definition (also gets an atom number per design)
\begin{definition*}
  A \textbf{field} is a commutative ring in which every nonzero element
  is invertible.
\end{definition*}

% Atom 1.3 -- unstarred theorem (counter continues from 1.2)
\begin{theorem}
  Every field is an integral domain.
\end{theorem}

% Atom 1.4 -- starred theorem (also gets an atom number)
\begin{theorem*}
  Every finite integral domain is a field.
\end{theorem*}

\END
\end{document}
