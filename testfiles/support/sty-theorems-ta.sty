%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%                           Custom Theorems                           %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Adds beginning and endmarks to theorems; if using amsthm instead of
% ntheorem, endmarks must be manually tweaked for displaymath and item
% with \qedhere; ignores \qedhere's with ntheorem
% NOTE: amsthm has better spacing and fewer overflow/underfull hbox issues

% WARNING: This will currently throw errors if using ntheorem, as it uses
% the keys notefont and notebraces; just delete these keys to use ntheorem

%%%%%%%%%%%%%%%%%%
%  DEPENDENCIES  %
%%%%%%%%%%%%%%%%%%
% THEOREMS
\RequirePackage{amsthm}

% Alternative (see warning above)
%\usepackage[amsmath,thmmarks]{ntheorem}

% OTHER
\RequirePackage{thmtools} %\declaretheorem, \declaretheoremstyle
\RequirePackage{xparse} %\NewDocumentCommand, \IfValueTF

% Symbols Used
\RequirePackage{fontawesome}
