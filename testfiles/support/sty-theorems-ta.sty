% The following is a workaround
\newsavebox{\rescaleBlueSpock}
\savebox{\rescaleBlueSpock}{\scalebox{0.9}{\textcolor{blue}{\normalfont\faHandSpockO}}}

%%%%%%%%%%%%%%%%%%%%%
%  Symbol synonyms  %
%%%%%%%%%%%%%%%%%%%%%

% Note symbol (from fontawesome)
\newcommand{\notesymbol}{\textcolor{blue}{\text{{\normalfont\faPencilSquareO}}}}

% Terminology symbols
\newcommand{\termsymbolLeft}{\scalebox{-1}[1]{\usebox{\rescaleBlueSpock}}}
\newcommand{\termsymbolRight}{\usebox{\rescaleBlueSpock}}

% Definition symbols
\newcommand{\defsymbolLeft}{\textcolor{blue}{\blacktriangleright}}
\newcommand{\defsymbolRight}{\textcolor{blue}{\blacktriangleleft}}

% Theorem Symbol
% \definecolor{BrickRed}{HTML}{671800}
\definecolor{thmcolor}{RGB}{3,105,79}
\newcommand{\thmsymbol}{\textcolor{thmcolor}{\blacklozenge}}
% \newcommand{\thmsymbol}{\textcolor{BrickRed}{\diamondsuit}}

% Proposition Symbol
\newcommand{\propsymbol}{\lozenge}

% Lemma symbol
\newcommand{\lemsymbol}{\heartsuit}

% Corollary symbol
\newcommand{\corsymbol}{\vartriangle}

%%%%%%%%%%%%%%%%%%%%
%  Macro Creators  %
%%%%%%%%%%%%%%%%%%%%
% Usage \newdefinitionlikeenv{env-name}{display name}{begin symbol}{end symbol}[counter (optional)]
\NewDocumentCommand{\makeDefinitionEnv}{mmmmo}{%
	\declaretheoremstyle[
	spaceabove=6pt, 
	spacebelow=6pt,
	headfont=\normalfont\bfseries,
	qed=$#4$,
	bodyfont=\normalfont,
	notefont=\mdseries\bfseries, %amsthm only
	notebraces={(}{)},           %amsthm only
	]{#1style}
	\IfValueTF{#5}{
		\declaretheorem[
		name = {$#3$ #2},
		style=#1style,
		sibling=#5
		]{#1}
	}{%
		\declaretheorem[
		name = {$#3$ #2},
		style=#1style,
		numberwithin=section
		]{#1}
	}
}

% Usage \newtheoremlikeenv{env-name}{display-name}{begin-symbol}{end-symbol}[counter (optional)]
% slant body format
\NewDocumentCommand{\makeTheoremEnv}{mmmmo}{%
	\declaretheoremstyle[
	spaceabove=6pt, 
	spacebelow=6pt,
	headfont=\normalfont\bfseries,
	qed=$#4$,
	bodyfont=\slshape,
	notefont=\mdseries\bfseries,   %amsthm only
	notebraces={(}{)},             %amsthm only
	]{#1style}
	\IfValueTF{#5}{
		\declaretheorem[
		name = {$#3$ #2},
		style=#1style,
		sibling=#5
		]{#1}
	}{%
		\declaretheorem[
		name = {$#3$ #2},
		style=#1style,
		numberwithin=section
		]{#1}
	}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  Theorem Style Instantiation  %
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Theorem-like/provable environments: all use the same counter named theorem
\makeTheoremEnv{theorem}{Theorem}{\thmsymbol}{\thmsymbol}
\makeTheoremEnv{proposition}{Proposition}{\propsymbol}{\propsymbol}[theorem]
\makeTheoremEnv{lemma}{Lemma}{\lemsymbol}{\lemsymbol}[theorem]
\makeTheoremEnv{corollary}{Corollary}{\corsymbol}{\corsymbol}[theorem]

% Definition environments: use the theorem counter
\makeDefinitionEnv{definition}{Definition}{\defsymbolLeft}{\defsymbolRight}[theorem]
\makeDefinitionEnv{notation}{Notation}{\notesymbol}{\notesymbol}[theorem]
\makeDefinitionEnv{terminology}{Terminology}{\termsymbolLeft}{\termsymbolRight}[theorem]

% Examples/Remarks, etc.: still use the theorem counter
\makeDefinitionEnv{example}{Example}{\clubsuit}{\clubsuit}[theorem]
\makeDefinitionEnv{remark}{Remark}{\triangleright}{\triangleleft}[theorem]
\makeDefinitionEnv{question}{Question}{\boxed{?}}{\boxed{?}}[theorem]

% Proof Appearance (Assumes using either amsthm or ntheorem)
\@ifpackageloaded{amsthm}{%
	% Proof appearance for amsthm
	\expandafter\let\expandafter\oldproof\csname\string\proof\endcsname
	\let\oldendproof\endproof
	\renewenvironment{proof}[1][\proofname]{%
	  \oldproof[\sc #1:]%
	}{\oldendproof}
}{
	%Proof Appearance for ntheorem
	\theoremheaderfont{\sc}\theorembodyfont{\upshape}
	\theoremstyle{nonumberplain}
	\theoremseparator{:}
	\theoremsymbol{\rule{1ex}{1ex}}
	\newtheorem{proof}{Proof}
	% Ignore \qedhere's
	\newcommand{\qedhere}{}
}

