%% ====================================================================
%%  Section 1: Linear maps
%% ====================================================================
\section{Linear maps}%
\label{sec:linear}

\begin{definition}\label{def:linmap}
  A \emph{linear map} between $k$-vector spaces $\Mod*{V}$ and $\Mod{W}$
  is a function $T\colon \Mod{V} \to \Mod{W}$ satisfying
  $T(v_1 + \lambda v_2) = T(v_1) + \lambda T(v_2)$ for all
  $v_1, v_2 \in \Mod{V}$ and $\lambda \in k$.
\end{definition}

\begin{definition}\label{def:eigenvalue}
  A scalar $\lambda \in k$ is an \emph{eigenvalue} of $T$ (\cref{def:linmap})
  if there exists a non-zero $v \in \Mod{V}$ with $Tv = \lambda v$.
\end{definition}

Bare paragraphs between definitions must not produce atom records when
paragraphs=off. This paragraph references \cref{def:linmap} and
\cref{def:eigenvalue} but must not become an atom.

\begin{lemma}\label{lem:kernel}
  The kernel $\ker T$ and image $\mathrm{im}\, T$ of a linear map
  $T\colon \Mod{V} \to \Mod{W}$ (\cref{def:linmap}) are subspaces.
\end{lemma}

\begin{proof}
  Closed under addition and scalar multiplication by linearity of $T$.
\end{proof}

\begin{proposition}\label{prop:rank-nullity}
  For $T\colon \Mod{V} \to \Mod{W}$ (\cref{def:linmap}) with
  $\Mod{V}$ finite-dimensional,
  $\dim(\ker T) + \dim(\mathrm{im}\, T) = \dim(\Mod{V})$.
\end{proposition}

\begin{proof}
  Choose a basis for $\ker T$, extend to a basis of $\Mod{V}$; the
  images of the extension form a basis of $\mathrm{im}\, T$.
\end{proof}

%% ====================================================================
%%  Section 2: Spectral theory — equation tracking
%% ====================================================================
\section{Spectral theory}%
\label{sec:spectral}

Let $T\colon \Mod{V} \to \Mod{V}$ be a linear operator on a
finite-dimensional complex space.

%% --- Track 1: standalone equation outside theorem ---
The characteristic polynomial determines eigenvalues
(\cref{def:eigenvalue}):
\begin{equation}\label{eq:charpoly}
  p_T(\lambda) = \det(\lambda I - T) = 0
  \qquad \text{(\cref{thm:spectral})}
\end{equation}

\begin{theorem}\label{thm:spectral}
  The eigenvalues of $T$ (\cref{def:eigenvalue}) are exactly the roots
  of $p_T$ in \cref{eq:charpoly}.  Moreover, $\Mod{V}$ decomposes as a
  direct sum of generalised eigenspaces.  See also \cref{lem:kernel}.
\end{theorem}

\begin{proof}
  The fundamental theorem of algebra guarantees roots of $p_T$.
  Generalised eigenspace decomposition follows from Jordan normal form,
  using \cref{prop:rank-nullity} at each step.
\end{proof}

A commutative diagram of the spectral projection:
\[
  \begin{tikzcd}
    \Mod{V} \arrow[r, "T"] \arrow[d, "P_i"']
    & \Mod{V} \arrow[d, "P_i"] \\
    E_i \arrow[r, "\lambda_i"']
    & E_i
  \end{tikzcd}
\]

Another bare paragraph referencing \cref{thm:spectral} and
\cref{lem:kernel} — no atom number expected with paragraphs=off.

\begin{corollary}\label{cor:jordan}
  Every linear operator $T$ on a finite-dimensional complex space
  admits a Jordan normal form; the diagonal blocks correspond to
  eigenvalues (\cref{def:eigenvalue,eq:charpoly}) of $T$ from
  \cref{thm:spectral}.
\end{corollary}

%% ====================================================================
%%  Section 3: Applications — cross-section backrefs
%% ====================================================================
\section{Applications}%
\label{sec:apps}

We collect consequences of results from \cref{sec:linear,sec:spectral}.

\begin{theorem}\label{thm:diag}
  A linear operator $T$ on a finite-dimensional complex space
  (\cref{def:linmap}) is diagonalisable if and only if all Jordan blocks
  in \cref{cor:jordan} are $1 \times 1$.  This uses
  \cref{thm:spectral,lem:kernel,prop:rank-nullity}.
\end{theorem}

\begin{proof}
  Immediate from \cref{cor:jordan}: $T$ is diagonal in an eigenbasis
  if and only if every generalised eigenvector is an eigenvector.
\end{proof}

\begin{corollary}\label{cor:symmetric}
  Every self-adjoint operator $T = T^*$ on a finite-dimensional complex
  inner-product space is diagonalisable (\cref{thm:diag}) with real
  eigenvalues (\cref{def:eigenvalue}).
\end{corollary}

A final bare paragraph referencing \Cref{thm:diag,thm:spectral,cor:jordan}
and \autoref{def:linmap} — this paragraph must NOT appear as an atom.

