%% Mathematical content: linear algebra (modules, maps, spectral theory).

\documentclass{article}

%% ---------- Standard math stack ----------
\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}

%% ---------- Theorem infrastructure ----------
\usepackage{amsthm}
\usepackage{thmtools}

\declaretheoremstyle[
  spaceabove=6pt, spacebelow=6pt,
  headfont=\normalfont\bfseries,
  bodyfont=\slshape,
]{thmstyle}
\declaretheoremstyle[
  spaceabove=6pt, spacebelow=6pt,
  headfont=\normalfont\bfseries,
  bodyfont=\normalfont,
]{defstyle}

\declaretheorem[name=Theorem,   style=thmstyle, numberwithin=section]{theorem}
\declaretheorem[name=Lemma,     style=thmstyle, sibling=theorem]{lemma}
\declaretheorem[name=Corollary, style=thmstyle, sibling=theorem]{corollary}
\declaretheorem[name=Proposition,style=thmstyle,sibling=theorem]{proposition}
\declaretheorem[name=Definition,style=defstyle, sibling=theorem]{definition}

%% ---------- tikz-cd ----------
\usepackage{tikz}
\usetikzlibrary{cd}

%% ---------- codependent: paragraphs OFF, everything else on ----------
\usepackage{codependent}
\codepsetup{backrefs=inline, paragraphs=off, equations=outer, proofs=on}
\codeptrack{theorem,lemma,corollary,proposition,definition}

%% \Mod{M} — module / space name formatter (arity 1)
\codepnewcommand{\Mod}[1]{\mathcal{#1}}

%% ---------- hyperref + cleveref ----------
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true, linkcolor=blue, citecolor=gray}
\usepackage{cleveref}

%% ---------- Equation numbering ----------
\numberwithin{equation}{section}

