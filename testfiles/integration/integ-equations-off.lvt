\documentclass{article}

\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\usepackage[hypertexnames=false]{hyperref}
\usepackage{cleveref}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{corollary}[theorem]{Corollary}

%% equations=off: equation environments are suppressed for tracking purposes.
\usepackage[equations=off]{codependent}
\codeptrack{theorem,lemma,definition,corollary}

\numberwithin{equation}{section}

\begin{document}
\START

%% =====================================================================
%%  Section 1: Definitions and main theorems
%% =====================================================================
\section{Real analysis}%
\label{sec:real}

\begin{definition}\label{def:continuous}
  A function $f \colon [a,b] \to \mathbb{R}$ is \emph{continuous at} $x_0$
  if for every $\varepsilon > 0$ there exists $\delta > 0$ such that
  $|x - x_0| < \delta$ implies $|f(x) - f(x_0)| < \varepsilon$.
\end{definition}

\begin{theorem}\label{thm:ivt}
  Let $f \colon [a,b] \to \mathbb{R}$ be continuous (\cref{def:continuous})
  with $f(a) < 0 < f(b)$.  Then there exists $c \in (a,b)$ with $f(c) = 0$.
\end{theorem}

\begin{proof}
  By bisection; continuity (\cref{def:continuous}) ensures the limit
  of the midpoints is a root.
\end{proof}

%% thm:ivt references def:continuous, so we expect an atomref with
%% source = theorem atom number (e.g. "1.2"), NOT a parenthesised eq number.

\begin{lemma}\label{lem:extreme}
  A continuous function (\cref{def:continuous}) on a closed bounded
  interval attains its maximum and minimum.
\end{lemma}

\begin{theorem}\label{thm:mvt}
  Let $f \colon [a,b] \to \mathbb{R}$ be continuous (\cref{def:continuous})
  and differentiable on $(a,b)$.  Then there exists $c \in (a,b)$ such that:
  \begin{equation}\label{eq:mvt}
    f'(c) = \frac{f(b) - f(a)}{b - a}.
  \end{equation}
  This uses \cref{thm:ivt} applied to $f' - \text{(slope)}$.
\end{theorem}

%% With equations=off: the \cref{thm:ivt} inside eq:mvt (Track 1, inside
%% thm:mvt) falls through to the containing theorem atom.  The equation
%% itself (eq:mvt) does NOT become an equation-sourced atom.  The atomref
%% for thm:ivt is attributed to the containing theorem atom for thm:mvt.

%% =====================================================================
%%  Section 2: Cross-section references — theorem backrefs still work
%% =====================================================================
\section{Corollaries}%
\label{sec:corollaries}

A paragraph referencing earlier material: the intermediate value theorem
(\cref{thm:ivt}) and the extreme value theorem (\cref{lem:extreme}) are
the two pillars of elementary real analysis.

\begin{corollary}\label{cor:fixed}
  Every continuous function $f \colon [0,1] \to [0,1]$
  (\cref{def:continuous}) has a fixed point, by \cref{thm:ivt} applied
  to $g(x) = f(x) - x$.
\end{corollary}

\begin{corollary}\label{cor:bounded}
  A continuous function on a closed bounded interval is bounded;
  see \cref{lem:extreme} and \cref{def:continuous}.
\end{corollary}

%% align block — Track 2 path with equations=off.
%% \cref references inside align should NOT produce equation-sourced atomrefs.
The mean value theorem (\cref{thm:mvt}) implies:
\begin{align}
  |f(b) - f(a)| &\le M \cdot (b-a), \label{eq:lipschitz} \\
  M &= \sup_{x \in (a,b)} |f'(x)|. \label{eq:sup-norm}
\end{align}
The bound \cref{eq:lipschitz} combined with \cref{thm:ivt} gives
the Lipschitz condition.

%% With equations=off, eq:lipschitz is not an equation atom source.
%% The \cref{thm:ivt} call at the end of the paragraph above is
%% in paragraph mode (not inside any equation env), so it attributes
%% to the paragraph atom — still NOT a parenthesised equation source.

\END
