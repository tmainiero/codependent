%% TEST-NAME: integ-proofauto-autoref
%% TEST-PURPOSE: A standalone proof heading containing a single \autoref auto-binds silently.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-PROOF-SEP, B-LINK-PROOF-DEST
%% TEST-STATUS: LIVE
%% TEST-WHAT: A standalone proof heading containing a single \autoref auto-binds silently.
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-CENSUS: enabled
%% TEST-CENSUS-PASS: yes
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@version{2}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a
%% TEST-CDP-CONTAINS: }{theorem:1.1}{1.1}{*}
%% TEST-CDP-COUNT: \codep@cdp@proof = 1
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a
%% TEST-PDF-STEXT: (?s)Proof of Theorem 1\.1
%% TEST-PDF-DEST-EXISTS: codep-proof:a[0-9]+
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\providecommand*{\theoremautorefname}{Theorem}
\providecommand*{\lemmaautorefname}{Lemma}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=inline,proofs=on,paragraphs=off,equations=off,proof-warnings=off}
\codeptrack{theorem,lemma}

\begin{document}
\START
\section{Statements}\label{sec:auto-one}
\begin{theorem}\label{thm:autoref-target}
  Main result for autoref auto detection.
\end{theorem}
\begin{lemma}\label{lem:autoref-witness}
  A witness lemma that names Section~\ref{sec:auto-one}.
\end{lemma}
\section{Proofs}\label{sec:auto-two}
\begin{proof}[Proof of \autoref{thm:autoref-target}]
  The proof body cites \cref{lem:autoref-witness} for integration coverage.
\end{proof}
\END
\end{document}
