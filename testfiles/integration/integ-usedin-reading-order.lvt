%% TEST-NAME: integ-usedin-reading-order
%% TEST-PURPOSE: Track-2 equation-range sources keep Used-In lists in reader order
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-USEDIN-READING-ORDER
%% TEST-STATUS: LIVE
%% TEST-WHAT: A theorem source, then a three-row Track-2 align source, then a
%%            later theorem source all cite the same target.  The align source
%%            has a lower equation number than the preceding theorem atom, so
%%            sorting by declaration/display number would render the range too
%%            early.  The PDF-level assertion pins reader encounter order.
%% TEST-SOURCE: W05-INSTALL-DISCIPLINE-CORE P04
%% TEST-SECTION: Track-2 shipout-order Used-In rendering
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Error
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{lemma:1.2}{thm:usedin-target}
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1.1--1.3}{thm:usedin-target}
%% TEST-AUX-CONTAINS: \codep@atomref{corollary:1.4}{thm:usedin-target}
%% TEST-PDF-STEXT: (?s)Target theorem for Track-2 ordering\..*Used in 1\.2, \(1\.1&#x2013;1\.3\), 1\.4\.
%% TEST-PDF-STEXT: Reader-visible reverse row references:.*1\.3.*1\.1.*1\.2
%% TEST-ATOMS-MIN: 3
%% TEST-STABLE-AT: 2
%% TEST-PACKAGES: amsmath,amsthm,hyperref,cleveref,codependent
%% TEST-RERUN: 3

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\usepackage[hypertexnames=false]{hyperref}
\usepackage{cleveref}
\usepackage[depth=1]{codependent}
\codeptrack{theorem,lemma,corollary}
\numberwithin{equation}{section}

\begin{document}
\START

\section{Reading order}

\begin{theorem}\label{thm:usedin-target}
Target theorem for Track-2 ordering.
\end{theorem}

\begin{lemma}\label{lem:before-align-source}
The reader encounters this theorem-source citation before the align:
\cref{thm:usedin-target}.
\end{lemma}

\begin{align}
  a &= b \qquad\text{first reading-order row}\label{eq:reading-first} \\
  c &= d \qquad\text{second reading-order row}\label{eq:reading-second} \\
  e &= f \qquad\text{third row cites }\cref{thm:usedin-target}
    \label{eq:reading-third}
\end{align}

Reader-visible reverse row references: \ref{eq:reading-third},
\ref{eq:reading-first}, then \ref{eq:reading-second}.

\begin{corollary}\label{cor:after-align-source}
The reader encounters this theorem-source citation after the align:
\cref{thm:usedin-target}.
\end{corollary}

\END
\end{document}
