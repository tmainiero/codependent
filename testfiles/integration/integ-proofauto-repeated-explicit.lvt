%% TEST-NAME: integ-proofauto-repeated-explicit
%% TEST-PURPOSE: Two explicit \codepproofof* calls in one proof form one joint atom.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-PROOF-SEP, B-LINK-PROOF-DEST, B-PROOF-ANCHOR-NEAR-HEADING
%% TEST-STATUS: LIVE
%% TEST-WHAT: After A2, two explicit \codepproofof* calls (thm:joint-a + lem:joint-b) in the same
%%            proof form ONE joint atom displayed as {1.1, 1.2}* in both theorem Used-In lists.
%%            One v2 CDP record; no proof-to-proof keymap.
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-CENSUS: enabled
%% TEST-CENSUS-PASS: yes
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-LOG-NOT: codepproofof: unknown label|joint attribution|last-write
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@version{2}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a
%% TEST-CDP-CONTAINS: }{theorem:1.1,lemma:1.2}{1.1,1.2}{*}
%% TEST-CDP-COUNT: \codep@cdp@proof = 1
%% TEST-AUX-NOT-CONTAINS: \codep@keymap{proof:
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a
%% TEST-AUX-CONTAINS: \codep@atomref{proof:a
%% TEST-AUX-CONTAINS: }{thm:joint-a}
%% TEST-AUX-CONTAINS: }{lem:joint-b}
%% TEST-PDF-STEXT: (?s)First joint target.*Used in \{1\.1, 1\.2\}\*
%% TEST-PDF-STEXT: (?s)Second joint target.*Used in \{1\.1, 1\.2\}\*
%% TEST-PDF-LINK-Y-NEAR: \{1\.1, 1\.2\}\* | Joint proof\. We first cite | within=30
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\providecommand*{\theoremautorefname}{Theorem}
\providecommand*{\lemmaautorefname}{Lemma}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=inline,proofs=on,paragraphs=off,equations=off,proof-warnings=off}
\codeptrack{theorem,lemma}

\begin{document}
\START
\section{Statements}\label{sec:joint-statements}
\begin{theorem}\label{thm:joint-a}
  First joint target.
\end{theorem}
\begin{lemma}\label{lem:joint-b}
  Second joint target referring to Section~\ref{sec:joint-statements}.
\end{lemma}
\section{Joint proof}\label{sec:joint-proof}
\begin{proof}[Joint proof]
  \codepproofof*{thm:joint-a}%
  We first cite \cref{thm:joint-a}.
  \codepproofof*{lem:joint-b}%
  We then cite \cref{lem:joint-b}.
\end{proof}
\END
\end{document}
