%%
%% Full-stack integration fixture. All codependent options are on,
%% with backref-style=inline (renders backrefs inline within the theorem body).
%%
%% Mathematical content: commutative algebra (rings, ideals, modules).
%%
%% Feature coverage:
%%   - theorem, lemma, proposition, corollary via thmtools (counter sharing)
%%   - definition via thmtools
%%   - amsthm proof env (adjacent proof — starred atom)
%%   - \codepproofof{...} — non-adjacent proof attribution
%%   - \codepnewcommand{Ring}, \codepnewcommand{Ideal} (arity 1, 2)
%%     starred forms used inside definitions to emit \codep@cdp@def records
%%   - \codeptag semantic sidecar
%%   - tikz-cd commutative diagram inside theorem (tikzcd)
%%   - Track 1 equation backref (standalone \cref outside theorem)
%%   - Outer-mode guard (equation inside theorem — falls through to thm)
%%   - Cross-section backrefs (§3 → §1, §3 → §2)
%%   - hyperref + cleveref: \cref, \Cref, \autoref
%%
%% Note: \codepproofof triggers "Proof not adjacent" warning (expected).

\documentclass{article}

%% ---------- Standard math stack ----------
\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}

%% ---------- Theorem infrastructure ----------
\usepackage{amsthm}
\usepackage{thmtools}

\declaretheoremstyle[
  spaceabove=6pt, spacebelow=6pt,
  headfont=\normalfont\bfseries,
  bodyfont=\slshape,
]{thmstyle}
\declaretheoremstyle[
  spaceabove=6pt, spacebelow=6pt,
  headfont=\normalfont\bfseries,
  bodyfont=\normalfont,
]{defstyle}

\declaretheorem[name=Theorem,   style=thmstyle, numberwithin=section]{theorem}
\declaretheorem[name=Lemma,     style=thmstyle, sibling=theorem]{lemma}
\declaretheorem[name=Proposition,style=thmstyle,sibling=theorem]{proposition}
\declaretheorem[name=Corollary, style=thmstyle, sibling=theorem]{corollary}
\declaretheorem[name=Definition,style=defstyle, sibling=theorem]{definition}

%% ---------- tikz-cd ----------
\usepackage{tikz}
\usetikzlibrary{cd}

%% ---------- codependent (all features on, inline rendering style) ----------
\usepackage{codependent}
\codepsetup{backrefs=inline, paragraphs=on, equations=outer, proofs=on, backref-style=inline}
\codeptrack{theorem,lemma,proposition,corollary,definition}

%% ---------- Concept-tracked macros ----------
%% \Ring{R}   — ring name formatter (arity 1)
\codepnewcommand{\Ring}[1]{\mathbf{#1}}
%% \Ideal{I}{R} — ideal notation (arity 2)
\codepnewcommand{\Ideal}[2]{#1 \trianglelefteq \Ring{#2}}

%% ---------- hyperref + cleveref ----------
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true, linkcolor=blue, citecolor=gray}
\usepackage{cleveref}

%% ---------- Equation numbering ----------
\numberwithin{equation}{section}

\begin{document}
\START

%% ====================================================================
%%  Section 1: Foundations
%% ====================================================================
\section{Rings and ideals}%
\label{sec:rings}

Let $\Ring{R}$ be a commutative ring with unity.

\begin{definition}\label{def:noetherian}
  A ring $\Ring*{R}$ is \emph{Noetherian} if every ascending chain
  $\Ideal*{I_1}{R} \subseteq \Ideal{I_2}{R} \subseteq \cdots$
  eventually stabilises.
  \codeptag{uid}{ring:noetherian}%
\end{definition}

\begin{definition}\label{def:pid}
  A \emph{principal ideal domain} (PID) is an integral domain
  $\Ring{R}$ in which every $\Ideal{I}{R}$ is generated by one element.
\end{definition}

\begin{lemma}\label{lem:pid-noetherian}
  Every PID (\cref{def:pid}) is Noetherian (\cref{def:noetherian}).
\end{lemma}

\begin{proof}
  Let $\Ring{R}$ be a PID.  Given an ascending chain of ideals, each
  $\Ideal{I_n}{R} = (a_n)$.  Since $\Ring{R}$ is a PID, the union
  $\bigcup_n (a_n)$ is principal, say $(d)$.  Then $d \in (a_N)$ for
  some $N$, so the chain stabilises.
\end{proof}

\begin{theorem}\label{thm:hilbert-basis}
  If $\Ring{R}$ is Noetherian (\cref{def:noetherian}), then so is
  the polynomial ring $\Ring{R}[x]$.
  \begin{equation}\label{eq:ideal-inside-thm}
    \Ideal{I}{R[x]} = \langle f_1, \ldots, f_k \rangle
    \qquad \text{for some } k < \infty.
  \end{equation}
\end{theorem}

\begin{proof}
  Classical Hilbert basis theorem; the key step applies
  \cref{def:noetherian} to the leading-coefficient ideal.
\end{proof}

\begin{proposition}\label{prop:ufd}
  Every PID (\cref{def:pid}) is a unique factorisation domain (UFD).
\end{proposition}

%% ====================================================================
%%  Section 2: Module structure — equation backrefs
%% ====================================================================
\section{Module structure}%
\label{sec:modules}

Let $\Ring{R}$ be a Noetherian ring (\cref{def:noetherian}).

%% --- Track 1: standalone equation outside theorem ---
The rank-nullity identity takes the following form
(\cref{thm:hilbert-basis}):
\begin{equation}\label{eq:rank-nullity}
  \mathrm{rank}(M) + \mathrm{rank}(\ker\phi) = \mathrm{rank}(N)
  \qquad \text{(\cref{cor:artin})}
\end{equation}

\begin{corollary}\label{cor:artin}
  A Noetherian ring (\cref{def:noetherian}) satisfies the descending
  chain condition on prime ideals.  In particular,
  \cref{eq:rank-nullity} implies every finitely generated module is
  coherent.
\end{corollary}

\begin{theorem}\label{thm:noether}
  For a Noetherian ring $\Ring{R}$, every submodule of a finitely
  generated $\Ring{R}$-module is itself finitely generated.
  This applies \cref{lem:pid-noetherian}.
\end{theorem}

%% --- Non-adjacent proof using \codepproofof ---
%% (the "Proof not adjacent" warning is expected and intentional here)
A commutative diagram illustrates the module splitting:
\[
  \begin{tikzcd}
    0 \arrow[r]
    & M \arrow[r, "\phi"]
    & N \arrow[r, "\pi"] \arrow[l, "\psi", bend left]
    & N/M \arrow[r]
    & 0
  \end{tikzcd}
\]

\begin{proof}[Proof of \cref{thm:noether}]
  \codepproofof*{thm:noether}%
  By induction on the number of generators, using
  \cref{lem:pid-noetherian,def:noetherian} and the fact
  (\cref{thm:hilbert-basis}) that $\Ring{R}[x_1,\ldots,x_n]$ is
  Noetherian.
\end{proof}

%% ====================================================================
%%  Section 3: Cross-section backrefs
%% ====================================================================
\section{Applications}%
\label{sec:applications}

We draw consequences from \cref{sec:rings,sec:modules}.

\begin{theorem}\label{thm:structure}
  Combining \cref{thm:hilbert-basis,thm:noether,lem:pid-noetherian},
  every finitely generated module over a PID (\cref{def:pid}) decomposes
  as a direct sum of cyclic modules.
\end{theorem}

\begin{proof}
  Apply \cref{thm:noether} to reduce to the finitely generated case,
  then use \cref{prop:ufd} and \cref{cor:artin}.
\end{proof}

\begin{corollary}\label{cor:classification}
  A finitely generated abelian group $G$ satisfies
  \[
    G \cong \mathbb{Z}^r \oplus \mathbb{Z}/d_1 \oplus \cdots \oplus \mathbb{Z}/d_k,
  \]
  with $d_1 \mid d_2 \mid \cdots \mid d_k$, by
  \cref{thm:structure,def:pid}.
\end{corollary}

The structure theorem applies \Cref{thm:hilbert-basis,prop:ufd}; the
coherence condition references \autoref{def:noetherian}.

\END
