%% TEST-NAME: integ-proofauto-bodycite-routing
%% TEST-PURPOSE: Auto proof-heading body cites route through immediate and provisional proof identities.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-PROOF-SEP, B-PASS-ONE, B-LINK-PROOF-DEST, B-PROOF-ANCHOR-NEAR-HEADING
%% TEST-STATUS: LIVE
%% TEST-WHAT: Backward proof-heading refs resolve immediately; forward proof-heading refs migrate unresref:<N> body cites to proof:N.M.
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{3.1*}
%% TEST-CDP-COUNT: \codep@cdp@proof = 2
%% TEST-CDP-NOT-CONTAINS: unresref:
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:1.1}{codep-proof:a
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:3.1}{codep-proof:a
%% TEST-AUX-CONTAINS: \codep@atomref{proof:1.1}{lem:body-tool}
%% TEST-AUX-CONTAINS: \codep@atomref{proof:3.1}{lem:body-tool}
%% TEST-AUX-CONTAINS: \codep@keymap{unresref:1}{proof:3.1}
%% TEST-AUX-NOT-CONTAINS: \codep@keymap{proof:
%% TEST-PDF-STEXT: (?s)Backward body-cite target.*Used in 1\.1\*
%% TEST-PDF-STEXT: (?s)Forward body-cite target.*Used in 3\.1\*
%% TEST-PDF-STEXT: (?s)Shared lemma for proof bodies.*Used in 1\.1\*, 3\.1\*
%% TEST-PDF-LINK-Y-NEAR: Backward body-cite target.*Used in 1\.1\* | (?s)Proof of theorem 1\.1 | within=45
%% TEST-PDF-LINK-Y-NEAR: Forward body-cite target.*Used in 3\.1\* | (?s)Proof of theorem 3\.1 | within=45
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\providecommand*{\theoremautorefname}{Theorem}
\providecommand*{\lemmaautorefname}{Lemma}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=inline,proofs=on,paragraphs=off,equations=off,proof-warnings=off}
\codeptrack{theorem,lemma}

\begin{document}
\START
\section{Statements}\label{sec:bodycite-statements}
\begin{theorem}\label{thm:back-body}
  Backward body-cite target.
\end{theorem}
\begin{lemma}\label{lem:body-tool}
  Shared lemma for proof bodies.
\end{lemma}

\section{Backward proof}\label{sec:bodycite-backward}
\begin{proof}[Proof of \cref{thm:back-body}]
  The resolved proof body cites \cref{lem:body-tool}.
\end{proof}

\section{Forward proof}\label{sec:bodycite-forward}
\begin{proof}[Proof of \cref{thm:forward-body}]
  The provisional proof body also cites \cref{lem:body-tool}.
\end{proof}

\begin{theorem}\label{thm:forward-body}
  Forward body-cite target.
\end{theorem}
\END
\end{document}
