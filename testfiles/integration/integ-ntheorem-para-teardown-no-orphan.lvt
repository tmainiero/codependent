%% TEST-NAME: integ-ntheorem-para-teardown-no-orphan
%% TEST-PURPOSE: ntheorem paragraphs=on teardown does not create orphan paragraph atom
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-NUM-PARA, B-SUPP-TRACKED
%% TEST-STATUS: LIVE
%% TEST-WHAT: With paragraphs=on, ending an ntheorem theorem must not allocate a spurious
%%            paragraph atom. Ntheorem uses the legacy cmd-hook route with ntheorem-specific
%%            lifecycle rewrap (codependent.sty:2628-2674). P01 wires cmd/end#1/after for
%%            legacy backends to clear \codep@teardownpara@suppressdepth after all backend
%%            end material fires.
%%            Failure mode A (HEAD, no P01): orphan paragraph:1.2 allocated during backend
%%            end material -- caught by CDP-NOT-CONTAINS.
%%            Failure mode B (P01 missing legacy cmd/after wire): suppress window stays open;
%%            real paragraph:2.2 suppressed -- caught by CDP-CONTAINS.
%% TEST-SOURCE: W05-PARA-ORPHAN-FIX P04
%% TEST-SECTION: ntheorem legacy cmd-hook teardown correctness
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%% TEST-PACKAGES: amsmath,ntheorem,hyperref,cleveref,codependent
%%
%% Section 1 teardown: list-ending lemma:1.1; orphan would be paragraph:1.2
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.2}{paragraph}
%% TEST-AUX-NOT-CONTAINS: \codep@entitymeta{paragraph:1.2}{paragraph}{1.2}{paragraph}{}
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{paragraph:1.2}
%%
%% Section 1 SText: no orphan number between list end and next-section heading
%% TEST-PDF-STEXT-NOT: (?s)text=".*NTHEOREM-LIST-END-MARKER.*".*text="1\.2".*text="Real paragraph control"
%%
%% Section 2 real paragraph: must be allocated (no over-suppression)
%% TEST-CDP-CONTAINS: \codep@cdp@atom{2.2}{paragraph}
%% TEST-AUX-CONTAINS: \codep@entitymeta{paragraph:2.2}{paragraph}{2.2}{paragraph}{}

\documentclass{article}
\usepackage{amsmath}
\usepackage[amsmath,hyperref]{ntheorem}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\usepackage[hypertexnames=false]{hyperref}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=appendix, paragraphs=on, equations=off, proofs=off}
\codeptrack{theorem,lemma}
\begin{document}
\START

\section{Ntheorem list teardown}

\begin{lemma}\label{lem:ntheorem-first}
  Lemma ending in a list:
  \begin{itemize}
    \item NTHEOREM-LIST-END-MARKER last item.
  \end{itemize}
\end{lemma}
\section{Real paragraph control}

\begin{lemma}\label{lem:ntheorem-real}
  Lemma for real-paragraph control. \cref{lem:ntheorem-first}.
\end{lemma}

Real paragraph after blank line.

\codepappendix
\END
\end{document}
