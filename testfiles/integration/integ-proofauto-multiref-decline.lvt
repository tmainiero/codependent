%% TEST-NAME: integ-proofauto-multiref-decline
%% TEST-PURPOSE: Multi-ref \cref heading becomes one joint atom; section decoration in second proof auto-filtered.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-PROOF-NONADJ, B-PROOF-SEP
%% TEST-STATUS: LIVE
%% TEST-WHAT: After A2: proof 1 with \cref{thm:multi-a,lem:multi-b} → one joint atom {1.1, 1.2}*.
%%            Proof 2 with \ref{thm:multi-a} + section ref → single atom 1.1* (section auto-filtered).
%%            CDP count = 2 (not 3 as in A1 serial-best-effort).
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-CENSUS: enabled
%% TEST-CENSUS-PASS: yes
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@version{2}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a
%% TEST-CDP-CONTAINS: }{theorem:1.1,lemma:1.2}{1.1,1.2}{*}
%% TEST-CDP-CONTAINS: }{theorem:1.1}{1.1}{*}
%% TEST-CDP-COUNT: \codep@cdp@proof = 2
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{proof:1}{codep-proof:a
%% TEST-PDF-STEXT: (?s)Proof of theorems 1\.1 and 1\.2
%% TEST-PDF-STEXT: (?s)Proof of Theorem 1\.1 in &#xa7;1
%% TEST-PDF-STEXT: (?s)First result.*Used in \{1\.1, 1\.2\}\*
%% TEST-PDF-STEXT: (?s)Second result.*Used in \{1\.1, 1\.2\}\*
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\providecommand*{\theoremautorefname}{Theorem}
\providecommand*{\lemmaautorefname}{Lemma}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=inline,proofs=on,paragraphs=off,equations=off,proof-warnings=off}
\codeptrack{theorem,lemma}

\begin{document}
\START
\section{Statements}\label{sec:multi-statements}
\begin{theorem}\label{thm:multi-a}
  First result.
\end{theorem}
\begin{lemma}\label{lem:multi-b}
  Second result, referring to Section~\ref{sec:multi-statements}.
\end{lemma}
\section{Proofs}\label{sec:multi-proofs}
\begin{proof}[Proof of \cref{thm:multi-a,lem:multi-b}]
  The comma-list heading is intentionally ambiguous.
\end{proof}
\begin{proof}[Proof of Theorem~\ref{thm:multi-a} in \S\ref{sec:multi-statements}]
  The section reference is navigational decoration, not joint attribution.
\end{proof}
\END
\end{document}
