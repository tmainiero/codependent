%% TEST-NAME: integ-empty-proof-destination
%% TEST-PURPOSE: Empty adjacent proofs still emit their proof-begin named destination
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-LINK-PROOF-DEST, B-PROOF-ANCHOR-NEAR-HEADING
%% TEST-STATUS: LIVE
%% TEST-WHAT: Regression for P02 deferred proof-heading destination emission.
%%            An adjacent proof with no body paragraph never fires para/begin,
%%            but its proof-begin destination must still be emitted and mapped
%%            through the canonical proof:a<N> anchormap entry.
%% TEST-SOURCE: .claude/comms/w05-vmode-fixes-p02-rework-coder-brief.md
%% TEST-SECTION: Fix A — proof-destination liveness regression
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a2}{codep-proof:a2}
%% TEST-PDF-DEST-EXISTS: codep-proof:a2
%% TEST-PDF-NOT: codependent Error
%% TEST-PACKAGES: amsthm,codependent,hyperref
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codepsetup{backrefs=inline, paragraphs=off, equations=off, proofs=on}
\codeptrack{theorem}
\usepackage[hypertexnames=false]{hyperref}

\begin{document}
\START

\section{Empty proof destination}

\begin{theorem}
  Statement with an adjacent empty proof.
\end{theorem}
\begin{proof}
\end{proof}

\END
\end{document}
