\documentclass{article}
\usepackage[most]{tcolorbox}
\tcbuselibrary{theorems}
\newtcbtheorem[number within=section]{codetcb}{TBox}{colback=blue!3,colframe=blue!50!black,fonttitle=\bfseries}{codetcb}
\usepackage{codependent}
\codepsetup{backrefs=appendix, paragraphs=off, equations=off, proofs=off}
\codeptrack{codetcb}
\usepackage[hypertexnames=false]{hyperref}
\usepackage{cleveref}
\begin{document}
\START
\section{Tcolorbox backend}

\begin{codetcb}[colback=green!3][Short target]{Long optional target}{target}
Optional-heading tcolorbox theorem target.
\end{codetcb}

\begin{codetcb}{Source box}{source}
This source cites \ref{codetcb:target}.
\end{codetcb}

\codepappendix
\END
\end{document}
