\begin{document}
\START
\section{Statements}\label{sec:explicit-diff-statements}
\begin{theorem}\label{thm:heading-target}
  Heading-only target.
\end{theorem}
\begin{lemma}\label{lem:explicit-target}
  Explicit target; it mentions Section~\ref{sec:explicit-diff-statements}.
\end{lemma}
\section{Proofs}\label{sec:explicit-diff-proofs}
\begin{proof}[Proof of \cref{thm:heading-target}]
  \codepproofof*{lem:explicit-target}%
  The body cites \cref{lem:explicit-target} after explicit attribution.
