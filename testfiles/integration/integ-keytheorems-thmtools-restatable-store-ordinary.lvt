\START
\section{Restatable ordinary}

\begin{restatable}{theorem}{RestatableOrdinary}\label{thm:restatable-ordinary}
The ordinary stored theorem is the first occurrence.
\end{restatable}

\RestatableOrdinary*

\begin{lemma}\label{lem:restatable-source}
This source cites the ordinary restatable theorem \cref{thm:restatable-ordinary}.
\end{lemma}

