%% TEST-NAME: integ-proofauto-d3-heading-overrides-adjacent
%% TEST-PURPOSE: Proof heading ref overrides adjacent attribution; warning can be suppressed.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-PROOF-SEP, B-PROOF-ADJ, B-PROOF-ADJRULE, B-PROOF-HEADING-OVERRIDE, B-WARN-ATTR-CONFLICTS
%% TEST-STATUS: LIVE
%% TEST-WHAT: D3 rule: when a proof heading contains a tracked \cref and the proof is
%%            physically adjacent to a DIFFERENT theorem, heading attribution wins and a
%%            package warning is suppressed when warn-attribution-conflicts=false.
%%            thmHeading (1.1) gets the proof attribution; thmAdjacent (2.1) does not.
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: auto-attribution to
%% TEST-LOG-NOT: supersedes adjacent
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@version{2}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a
%% TEST-CDP-CONTAINS: }{theorem:1.1}{1.1}{*}
%% TEST-CDP-COUNT: \codep@cdp@proof = 1
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
%% ====================================================================
%%  W05-A2 closeout — D3 heading-overrides-adjacent warning suppression
%%
%%  warn-attribution-conflicts=false suppresses only the D3 conflict warning:
%%    - thmHeading (1.1) still receives the proof attribution.
%%    - thmAdjacent (2.1) still does not receive leaked proof backrefs.
%%    - the conflict-warning substrings are absent from the log.
%% ====================================================================
%%
%% 1. thmHeading (1.1) receives the proof attribution — Used-In shows 1.1*
%% TEST-PDF-STEXT: (?s)Heading target theorem.*Used in 1\.1\*
%%
%% 2. thmAdjacent (2.1) must NOT receive the proof attribution (no leak)
%% TEST-PDF-STEXT-NOT: (?s)Adjacent theorem target.*Used in 2\.1\*
%%
\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\providecommand*{\theoremautorefname}{Theorem}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=inline,proofs=on,paragraphs=off,equations=off,proof-warnings=on,warn-attribution-conflicts=false}
\codeptrack{theorem}

\begin{document}
\START

%% ====================================================================
%%  Section 1: The theorem named in the proof heading (D3 heading target)
%% ====================================================================
\section{Heading target}\label{sec:d3-heading}

\begin{theorem}\label{thm:d3-heading}
  Heading target theorem.
\end{theorem}

%% ====================================================================
%%  Section 2: D3 conflict scenario
%%  The proof is ADJACENT to thm:d3-adjacent but its heading names thm:d3-heading.
%%  D3 rule: heading wins; warning suppressed because the key is false.
%% ====================================================================
\section{D3 conflict}\label{sec:d3-conflict}

\begin{theorem}\label{thm:d3-adjacent}
  Adjacent theorem target.
\end{theorem}
\begin{proof}[Proof of \cref{thm:d3-heading}]
  This proof is physically adjacent to thm:d3-adjacent (2.1) but its heading
  explicitly names thm:d3-heading (1.1).  The D3 rule attributes the proof
  to the heading target without emitting the suppressible conflict warning.
\end{proof}

\END
\end{document}
