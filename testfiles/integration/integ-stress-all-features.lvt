%% ====================================================================
%%  Section 1: Foundational definitions
%%  Tests: definition tracking (B-NUM-SEQ), adjacent proof after definition
%%         (v12 A5, B-PROOF-ADJ for any tracked env),
%%         remark tracking, adjacent proof after remark (v12 A5),
%%         suppressed quote env (B-SUPP-TRACKED).
%%
%%  Concept notation: \Top*{X} marks a definition site (→ cdp@def),
%%  \Top{X} is a use site (→ cdp@use).
%% ====================================================================
\section{Topological spaces}%
\label{sec:topo}

\begin{definition}\label{def:topspace}
  A \emph{topological space} is a pair $(\Top*{X}, \tau)$ where $\Top{X}$ is a
  set and $\tau$ is a collection of open subsets.%
  \codeptag{uid}{topspace:def}%
\end{definition}

%% Adjacent proof after definition — B-PROOF-ADJ for definition env (v12 A5).
\begin{proof}
  The axioms are self-consistent: $\emptyset,\Top{X}\in\tau$ by assumption;
  finite intersections and arbitrary unions of open sets are open by axiom.
\end{proof}

\begin{definition}\label{def:metric}
  A \emph{metric space} is a pair $\Sp*{X}{d}$ where $\Top{X}$ is a set and
  $d\colon \Top{X}\times\Top{X}\to\mathbb{R}_{\geq 0}$ satisfies the metric axioms.
  The topology is the one induced by the open balls $B(x,r) = \{y: d(x,y)<r\}$.
\end{definition}

\begin{remark}\label{rem:hausdorff}
  Every metric space $\Sp{X}{d}$ (cf.\ \cref{def:metric}) is Hausdorff:
  for distinct $x\neq y$ the balls of radius $d(x,y)/2$ are disjoint.
\end{remark}

%% Adjacent proof after remark — B-PROOF-ADJ for remark env (v12 A5).
\begin{proof}
  If $z\in B(x,\varepsilon)\cap B(y,\varepsilon)$ with $\varepsilon=d(x,y)/2$,
  then $d(x,y)\leq d(x,z)+d(z,y)<2\varepsilon=d(x,y)$, contradiction.
\end{proof}

%% Suppressed block: quote env is registered with \codepsuppress{quote} above.
\begin{quote}
  This excerpt is typeset in a suppressed \texttt{quote} environment.
  codependent does not assign a paragraph atom number to this block.
\end{quote}

