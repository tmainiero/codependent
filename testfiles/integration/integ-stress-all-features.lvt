\documentclass{article}

%% ---------- Standard math stack ----------
\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}

%% ---------- Theorem infrastructure ----------
\usepackage{amsthm}
\usepackage{thmtools}

\declaretheoremstyle[
  spaceabove=6pt, spacebelow=6pt,
  headfont=\normalfont\bfseries,
  bodyfont=\slshape,
]{thmstyle}
\declaretheoremstyle[
  spaceabove=6pt, spacebelow=6pt,
  headfont=\normalfont\bfseries,
  bodyfont=\normalfont,
]{defstyle}

\declaretheorem[name=Theorem,    style=thmstyle, numberwithin=section]{theorem}
\declaretheorem[name=Lemma,      style=thmstyle, sibling=theorem]{lemma}
\declaretheorem[name=Proposition,style=thmstyle, sibling=theorem]{proposition}
\declaretheorem[name=Corollary,  style=thmstyle, sibling=theorem]{corollary}
\declaretheorem[name=Definition, style=defstyle, sibling=theorem]{definition}
\declaretheorem[name=Remark,     style=defstyle, sibling=theorem]{remark}

%% ---------- codependent ----------
\usepackage{codependent}
\codepsetup{backrefs=inline, paragraphs=on, equations=outer, proofs=on,
            backref-style=inline, proof-warnings=on}
%% Register all 6 env types — exercises \codeptrack with multi-item list.
\codeptrack{theorem,lemma,proposition,corollary,definition,remark}

%% ---------- Concept-tracked macros ----------
%% \Top{X} — topological space notation (arity 1); \Top*{X} marks definition site
\codepnewcommand{\Top}[1]{\mathcal{#1}}
%% \Sp{X}{d} — metric space notation (arity 2); \Sp*{X}{d} marks definition site
\codepnewcommand{\Sp}[2]{(\Top{#1},{#2})}

%% ---------- Environment suppression ----------
%% Suppress the quote env from paragraph atom tracking (B-SUPP-TRACKED).
\codepsuppress{quote}

%% ---------- hyperref + cleveref + equation numbering ----------
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true, linkcolor=blue}
\usepackage{cleveref}
\numberwithin{equation}{section}

