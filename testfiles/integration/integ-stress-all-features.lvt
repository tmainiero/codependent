%%  Section 2: Compactness results
%%  Tests: theorem/lemma/proof adjacency (B-PROOF-ADJ, classic theorem-rail),
%%         equation outer-mode guard (B-EQ-OUTER),
%%         Track-1 standalone equation (B-EQ-TRACK1),
%%         Track-2 align equation (B-EQ-TRACK2),
%%         "Proof not adjacent" standalone path + B-LINK-PROOFOF-STAR:
%%           after cor:heine-borel's adjacent proof consumes pendingresultid,
%%           a proof with no pending result triggers proof@materialize warning;
%%           \codepproofof* inside it redirects to thm:compact-closed.
%% ====================================================================
\section{Compactness}%
\label{sec:compact}

\begin{lemma}\label{lem:bounded}
  Every compact metric space $\Sp{X}{d}$ is bounded.
  The following equation is inside the lemma body, so the outer-mode
  guard prevents an equation-sourced backref edge:
  \begin{equation}\label{eq:diam-inside-lemma}
    \mathrm{diam}(\Top{X}) = \sup_{x,y\in\Top{X}} d(x,y) < \infty.
  \end{equation}
\end{lemma}

%% Adjacent proof after lemma (B-PROOF-ADJ, classic theorem-rail).
\begin{proof}
  Fix $x_0\in\Top{X}$.  The cover $\{B(x_0,n)\}_{n\geq 1}$ has a finite
  subcover; the bound from \cref{eq:diam-inside-lemma} follows.
\end{proof}

%% Track-1 standalone equation: produces eq-sourced atomref when referenced
%% from OUTSIDE a tracked theorem environment (B-EQ-TRACK1).
%% The \cref{def:metric} inside the equation body fires while codep@trackeddepth=0,
%% so Track-1 writes \codep@atomref{equation:2.x}{def:metric} to the .aux.
A fundamental estimate is the triangle inequality
(for metric spaces as in \cref{def:metric}):
\begin{equation}\label{eq:triangle}
  d(x,z) \leq d(x,y)+d(y,z) \qquad \forall\, x,y,z\in\Top{X}
  \quad\text{(cf.\ \cref{def:metric})}.
\end{equation}

%% Track-2 align: produces eq-sourced atomref range (B-EQ-TRACK2).
%% The \cref{def:topspace} inside fires while codep@trackeddepth=0.
Also (properties of the metric, cf.\ \cref{def:topspace}):
\begin{align}
  d(x,y) &= d(y,x)   \quad\text{(\cref{def:topspace})},   \label{eq:sym}    \\
  d(x,y) &\geq 0.     \label{eq:nonneg}
\end{align}

\begin{theorem}\label{thm:compact-closed}
  A closed subset of a compact metric space $\Sp{X}{d}$ is compact.
  The triangle inequality \cref{eq:triangle} (a standalone Track-1 equation)
  creates an eq-sourced backref edge to $\Top{X}$ (\cref{def:topspace}).
\end{theorem}

%% Adjacent proof after theorem (B-PROOF-ADJ, classic theorem-rail).
%% This proof consumes pendingresultid for thm:compact-closed.
\begin{proof}
  Let $F\subseteq\Top{X}$ be closed.  Any open cover of $F$ together with
  $\Top{X}\setminus F$ is an open cover of $\Top{X}$; extract a finite
  subcover and drop the extra element.
\end{proof}

\begin{proposition}\label{prop:seq-compact}
  A metric space $\Sp{X}{d}$ is compact iff it is sequentially compact.
\end{proposition}

%% Adjacent proof after proposition — consumes pendingresultid for prop.
\begin{proof}
  Standard: compactness iff every net has a convergent subnet (equiv.
  sequential compactness for metric spaces).  Uses \cref{def:metric}.
\end{proof}

\begin{corollary}\label{cor:heine-borel}
  A subset of $\mathbb{R}^n$ is compact iff it is closed and bounded.
\end{corollary}

%% Adjacent proof after corollary — consumes pendingresultid for cor.
%% After this proof, pendingresultid is EMPTY.
\begin{proof}
  By \cref{prop:seq-compact} and the Bolzano–Weierstrass theorem.
\end{proof}

%% ============================================================
%% B-PROOF-NONADJ path:
%%   At this point pendingresultid is EMPTY (consumed by cor:heine-borel above).
%%   This standalone proof has NO \codepproofof* redirect — it materializes
%%   normally and fires "Proof not adjacent" warning (TEST-EXPECT-PACKAGE-WARNING).
%% ============================================================
\begin{proof}[Alternate proof sketch]
  Ultrafilter argument: any ultrafilter on a compact space converges;
  apply this to characterise compactness via closed sets with the finite
  intersection property (\cref{def:topspace}).  See \cref{thm:compact-closed}.
\end{proof}

%% ============================================================
%% B-LINK-PROOFOF-STAR path:
%%   pendingresultid still EMPTY after the standalone proof above.
%%   \codepproofof*{thm:compact-closed} runs as FIRST statement — it clears
%%   proofdisplaypending and redirects this proof atom to thm:compact-closed,
%%   writing an anchor (B-LINK-PROOFOF-STAR).  A second warning also fires
%%   for this standalone proof (still captured by TEST-EXPECT-PACKAGE-WARNING).
%% ============================================================
\begin{proof}[Long-distance proof via \texorpdfstring{\texttt{\textbackslash codepproofof*}}{codepproofof*}]
  \codepproofof*{thm:compact-closed}%
  An ultrafilter on $\Top{X}$ (\cref{def:topspace}) converges; combined with
  \cref{lem:bounded} this gives compactness via the finite-intersection property.
\end{proof}

