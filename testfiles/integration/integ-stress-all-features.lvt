\section{Cross-references}%
\label{sec:crossref}

\begin{theorem}\label{thm:extreme-value}
  If $\Sp{X}{d}$ (\cref{def:metric}) is compact (\cref{thm:compact-closed})
  then every continuous $f\colon\Top{X}\to\mathbb{R}$ attains its supremum.
  Uses \cref{lem:bounded} and \cref{cor:heine-borel}.
\end{theorem}

\begin{proof}
  By sequential compactness (\cref{prop:seq-compact}) every maximising
  sequence has a convergent subsequence; continuity gives the supremum.
\end{proof}

\begin{definition}\label{def:continuous}
  A function $f\colon\Top{X}\to\Top{Y}$ between topological spaces is
  \emph{continuous} if $f^{-1}(U)$ is open in $\Top{X}$ whenever $U\subseteq\Top{Y}$
  is open.  Uses \cref{def:topspace}.
\end{definition}

\begin{corollary}\label{cor:extreme-value-cont}
  Every continuous $f\colon\Top{X}\to\mathbb{R}$ on a compact $\Sp{X}{d}$
  (cf.\ \cref{def:continuous}, \cref{thm:extreme-value}) is bounded.%
  \codepbackrefs
\end{corollary}

\begin{proof}
  Immediate from \cref{thm:extreme-value}: $f$ attains its supremum, hence
  is bounded.  Uses \cref{cor:heine-borel} and \cref{lem:bounded}.
\end{proof}

A cross-section paragraph referencing \cref{def:topspace}, \cref{def:metric},
\cref{rem:hausdorff}, \cref{thm:compact-closed}, and \cref{cor:heine-borel}
to force graph edges from this paragraph atom to atoms in §1 and §2.

