%% TEST-NAME: integ-tcolorbox-multi-env-shared-style
%% TEST-PURPOSE: Shared tcolorbox styles do not collide across envs.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-COMPAT-TCOLORBOX-THEOREM, B-LINK-APPENDIX-BIDIR
%% TEST-STATUS: LIVE
%% TEST-WHAT: Two newtcbtheorem environments share one style while retaining env-prefixed atom keys, distinct labels, and independent appendix destinations.
%% TEST-SOURCE: W05-BACKENDS-RICH-STRESS P02
%% TEST-SECTION: tcolorbox multi-env shared style
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{bluebox}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.2}{redbox}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.3}{bluebox}
%% TEST-AUX-CONTAINS: \codep@lblentity{bluebox:target}{bluebox:1.1}
%% TEST-AUX-CONTAINS: \codep@lblentity{redbox:target}{redbox:1.2}
%% TEST-AUX-CONTAINS: \codep@atomref{redbox:1.2}{bluebox:target}
%% TEST-AUX-CONTAINS: \codep@atomref{bluebox:1.3}{redbox:target}
%% TEST-PDF-DEST-EXISTS: codep-appendix:bluebox:1\.1
%% TEST-PDF-DEST-EXISTS: codep-appendix:redbox:1\.2
%% TEST-PDF-LINK-DEST: codep-appendix:bluebox:1\.1
%% TEST-PDF-LINK-DEST: codep-appendix:redbox:1\.2
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%% TEST-PDF-NOT: codependent Error
%% TEST-PACKAGES: tcolorbox,hyperref,cleveref,codependent
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2

\documentclass{article}
\usepackage[most]{tcolorbox}
\tcbuselibrary{theorems}
\tcbset{codep shared theorem chrome/.style={colback=blue!3,colframe=blue!55!black,fonttitle=\bfseries}}
\newtcbtheorem[number within=section]{bluebox}{Blue Display}{codep shared theorem chrome}{bluebox}
\newtcbtheorem[number within=section]{redbox}{Red Display}{codep shared theorem chrome}{redbox}
\usepackage{codependent}
\codepsetup{backrefs=appendix, paragraphs=off, equations=off, proofs=off}
\codeptrack{bluebox,redbox}
\usepackage[hypertexnames=false]{hyperref}
\usepackage{cleveref}
\begin{document}
\START
\section{Shared style}

\begin{bluebox}{Blue Target}{target}
The first environment uses the shared style with a blue display name.
\end{bluebox}

\begin{redbox}{Red Target}{target}
The second environment uses the same style and cites \ref{bluebox:target}.
\end{redbox}

\begin{bluebox}{Blue Source}{source}
A later blue environment cites the red target via \ref{redbox:target}.
\end{bluebox}

\codepappendix
\END
\end{document}
