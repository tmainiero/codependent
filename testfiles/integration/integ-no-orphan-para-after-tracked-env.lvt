%% TEST-NAME: integ-no-orphan-para-after-tracked-env
%% TEST-PURPOSE: Theorem teardown must not allocate spurious paragraph atoms after
%%               list-ending or display-math-ending tracked environments.
%%               Root cause: thmtools qed= placement triggers para/begin after
%%               \codep@hooktheorem@end@outer pops suppressdepth to 0.
%% TEST-KIND: integration
%% TEST-BEHAVIOR: B-NUM-PARA, B-SUPP-TRACKED, B-NUM-NESTED, B-EDGE-NESTED, B-PROOF-ADJ, B-PROOF-ADJRULE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Guards \codep@teardownpara@suppressdepth from emitting orphan para/begin
%%            atoms while backend end material (thmtools qed= symbol placement) is
%%            still being processed after theorem-end teardown.
%%            Sections 1-3 verify absence of teardown orphan atoms (negative sidecar).
%%            Section 4 checks headingless proof adjacency via sidecar only (the
%%            adjacency survives because pendingresultid is not cleared by an orphan).
%%            Section 5 checks a real paragraph after a blank line is still allocated.
%% TEST-EXIT: 0
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-PACKAGES: amsmath,amssymb,amsthm,thmtools,hyperref,cleveref,codependent
%% TEST-PDF-NO-ORPHAN-LINKS: yes
%%
%% Section 1: list-ending lemma teardown must not produce paragraph:1.2
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.2}{paragraph}
%% TEST-AUX-NOT-CONTAINS: \codep@entitymeta{paragraph:1.2}{paragraph}{1.2}{paragraph}{}
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{paragraph:1.2}
%%
%% Section 2: display-math-ending lemma teardown must not produce paragraph:2.2
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{2.2}{paragraph}
%% TEST-AUX-NOT-CONTAINS: \codep@entitymeta{paragraph:2.2}{paragraph}{2.2}{paragraph}{}
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{paragraph:2.2}
%%
%% Section 3: nested tracked env must not produce paragraph:3.3
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{3.3}{paragraph}
%% TEST-AUX-NOT-CONTAINS: \codep@entitymeta{paragraph:3.3}{paragraph}{3.3}{paragraph}{}
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{paragraph:3.3}
%%
%% Nested-close SText negative: no club-suit then atom-number then back-triangle
%% TEST-PDF-STEXT-NOT: (?s)text="&#x2663;".*text="[0-9]+\.[0-9]+".*text="&#x25c0;"
%%
%% Section 4: headingless proof after list-ending lemma:4.1; teardown must not produce 4.2
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{4.2}{paragraph}
%% TEST-AUX-NOT-CONTAINS: \codep@entitymeta{paragraph:4.2}{paragraph}{4.2}{paragraph}{}
%% TEST-AUX-NOT-CONTAINS: \codep@anchormap{paragraph:4.2}
%% Adjacency confirmed via sidecar only (headingless proof emits no visible heading text)
%% TEST-CDP-CONTAINS: }{lemma:4.1}{4.1}{*}
%%
%% Section 1 SText negative: no orphan backref link between marker and atom number
%% TEST-PDF-STEXT-NOT: (?s)text=".*ORPHAN-ENDLIST-LAST-ITEM.*".*text="[0-9]+\.[0-9]+".*text="&#x2661;"
%%
%% Section 5: real paragraph after lemma:5.1 must exist
%% TEST-CDP-CONTAINS: \codep@cdp@atom{5.2}{paragraph}
%% TEST-AUX-CONTAINS: \codep@entitymeta{paragraph:5.2}{paragraph}{5.2}{paragraph}{}
%% Proof after real paragraph must NOT be adjacent to lemma:5.1
%% TEST-CDP-NOT-CONTAINS: }{lemma:5.1}{5.1}{*}
%% TEST-PDF-STEXT-NOT: (?s)Proof of lemma 5\.1
%%
\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb,amsthm}
%% thmtools with qed= triggers the teardown orphan bug:
%% \endlemma places the qed symbol via \hfill\qed which forces
%% para/begin while suppressdepth is already 0 (popped by the
%% preend hook).  This mirrors the sty-theorems-ta style used in
%% the stress test.
\usepackage{thmtools}
\declaretheoremstyle[qed=$\heartsuit$]{qedlemstyle}
\declaretheorem[name=Theorem,numberwithin=section]{theorem}
\declaretheorem[name=Lemma,style=qedlemstyle,sibling=theorem]{lemma}
\declaretheorem[name=Definition,style=qedlemstyle,sibling=theorem]{definition}
\declaretheorem[name=Example,style=qedlemstyle,sibling=theorem]{example}
\providecommand*{\theoremautorefname}{Theorem}
\providecommand*{\lemmaautorefname}{Lemma}
\providecommand*{\definitionautorefname}{Definition}
\providecommand*{\exampleautorefname}{Example}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=appendix,paragraphs=on,equations=outer,proofs=on}
\codeptrack{theorem,lemma,definition,example}

\begin{document}
\START

\section{List-ending lemma}

\begin{lemma}\label{lemma:1.1}
  Content ending in a list:
  \begin{itemize}
    \item First item.
    \item ORPHAN-ENDLIST-LAST-ITEM
  \end{itemize}
\end{lemma}

\begin{theorem}\label{thm:1.2}
  The next theorem.  Reference: \cref{lemma:1.1}.
\end{theorem}

\section{Display-math-ending lemma}

\begin{lemma}\label{lemma:2.1}
  Content ending in a numbered display equation:
  \begin{equation}\label{eq:pyth}
    x^2 + y^2 = z^2.
  \end{equation}
\end{lemma}

\begin{theorem}\label{thm:2.2}
  The next theorem.  Reference: \cref{lemma:2.1}.
\end{theorem}

\section{Nested tracked environments}

\begin{definition}\label{defn:3.1}
  Outer definition $\clubsuit$.
  \begin{example}\label{ex:3.2}
    Inner example $\blacktriangleleft$.
  \end{example}
\end{definition}

\begin{theorem}\label{thm:3.3}
  The next theorem.  Reference: \cref{defn:3.1} and \cref{ex:3.2}.
\end{theorem}

\section{Headingless proof adjacency}

\begin{lemma}\label{lemma:4.1}
  A lemma ending in a list:
  \begin{itemize}
    \item Only item.
  \end{itemize}
\end{lemma}
\begin{proof}
  This headingless proof is adjacent to \cref{lemma:4.1}.
\end{proof}

\section{Real paragraph non-adjacency}

\begin{lemma}\label{lemma:5.1}
  A lemma followed by a real paragraph.
\end{lemma}

Next paragraph.

\begin{proof}
  This proof follows a real paragraph; it is not adjacent to \cref{lemma:5.1}.
\end{proof}

\END
\end{document}
