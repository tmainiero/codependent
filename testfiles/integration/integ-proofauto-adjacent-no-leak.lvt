%% TEST-STATUS: LIVE
%% TEST-WHAT: D3: proof heading with \ref{thm:adj-auto} (1.1) adjacent to thm:adjacent-owner (3.1).
%%            Heading tracked target (1.1) wins; adjacent target (3.1) is suppressed; warning emitted.
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-RERUN: 3
%% TEST-STABLE-AT: 2
%% TEST-CENSUS: enabled
%% TEST-CENSUS-PASS: yes
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@version{2}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{proof:a
%% TEST-CDP-CONTAINS: }{theorem:1.1}{1.1}{*}
%% TEST-CDP-COUNT: \codep@cdp@proof = 2
%% TEST-AUX-CONTAINS: \codep@anchormap{proof:a
%% TEST-AUX-NOT-CONTAINS: \codep@atomref{proof:a5}{thm:adjacent-owner}
%% TEST-AUX-NOT-CONTAINS: \codep@renderlist{theorem:3.1}
%% TEST-AUX-NOT-CONTAINS: \codep@prooftargetmeta{proof:a5}{theorem:3.1}
%% TEST-AUX-NOT-CONTAINS: \codep@keymap{proof:
%% TEST-LOG-CONTAINS: auto-attribution to
