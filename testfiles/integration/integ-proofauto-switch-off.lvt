\documentclass{article}

\usepackage[T1]{fontenc}
\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\providecommand*{\theoremautorefname}{Theorem}
\providecommand*{\lemmaautorefname}{Lemma}
\usepackage[hypertexnames=false]{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue}
\usepackage{cleveref}
\usepackage{codependent}
\codepsetup{backrefs=inline,proofs=on,paragraphs=off,equations=off,proof-warnings=off}
\codeptrack{theorem,lemma}

\begin{document}
\START
\section{Statements}\label{sec:switch-statements}
\begin{theorem}\label{thm:switch-auto}
  Auto-detected switch-off target.
\end{theorem}
\begin{lemma}\label{lem:switch-explicit}
  Explicit switch-off target referring to Section~\ref{sec:switch-statements}.
\end{lemma}
\section{Proofs}\label{sec:switch-proofs}
\begin{proof}[Proof of \cref{thm:switch-auto}]
  The heading text is authored by the document, not by codependent.
\end{proof}
\begin{proof}[Proof of Lemma~\ref{lem:switch-explicit}]
  \codepproofof*{lem:switch-explicit}%
  The explicit command is side-effect-only and emits no heading text.
\end{proof}
\END
\end{document}
