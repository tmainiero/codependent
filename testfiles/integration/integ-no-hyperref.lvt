%%
%% Without hyperref the package must:
%%   (1) not define or call \hyperlink / \hypertarget
%%   (2) render "Used in X." as plain, unlinked text
%%   (3) still record atomrefs and produce a valid .cdp
%%
%% The content is two sections of elementary group theory:
%%   - Section 1 defines a group (def:group) and states a uniqueness lemma
%%     (lem:unique-identity) referenced from Section 2.
%%   - Section 2 states Lagrange's theorem (thm:lagrange) which cites
%%     def:group and lem:unique-identity via plain \ref.
%%
%% The back-references from Section 2 → Section 1 should produce
%% "Used in" annotations on the Section 1 atoms with plain (unlinked)
%% atom numbers such as "2.1" and "2.2".

\documentclass{article}

\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{amsthm}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{definition}[theorem]{Definition}
\theoremstyle{definition}
\newtheorem{remark}[theorem]{Remark}

\usepackage{codependent}
\codeptrack{theorem,lemma,corollary,definition,remark}

%% Concept-tracked macro: \GrpOp{G}{\mu} — display a group with operation.
%% Exercises def-site (\GrpOp*) and use-site (\GrpOp) tracking.
\codepnewcommand{\GrpOp}[2]{(#1,\,#2)}

\numberwithin{equation}{section}

\begin{document}
\START

%% =============================================================
%%  Section 1: Foundations of group theory
%% =============================================================
\section{Foundations}%
\label{sec:foundations}

\begin{definition}\label{def:group}
  A \emph{group} is a pair $\GrpOp*{G}{\mu}$ where $G$ is a set and
  $\mu\colon G \times G \to G$ satisfies:
  \begin{enumerate}
    \item[(G1)] \emph{Associativity}: $(ab)c = a(bc)$ for all
      $a,b,c \in G$.
    \item[(G2)] \emph{Identity}: there exists $e \in G$ such that
      $ea = ae = a$ for all $a \in G$.
    \item[(G3)] \emph{Inverses}: for every $a \in G$ there exists
      $a^{-1} \in G$ with $aa^{-1} = a^{-1}a = e$.
  \end{enumerate}
\end{definition}

\begin{remark}\label{rem:abelian}
  When the operation is commutative ($ab = ba$ for all $a,b$),
  the group is called \emph{abelian}.  Not every group satisfying
  \ref{def:group} need be abelian.
\end{remark}

\begin{lemma}\label{lem:unique-identity}
  The identity element $e$ in \ref{def:group} is unique.
\end{lemma}

\begin{proof}
  Suppose $e$ and $e'$ are both identities.  Then
  $e = ee' = e'$, so $e = e'$.
\end{proof}

\begin{corollary}\label{cor:unique-inverse}
  Each element $a \in G$ has a unique inverse.
\end{corollary}

\begin{proof}
  Let $b, c$ both be inverses of $a$.  Then
  $b = be = b(ac) = (ba)c = ec = c$ by
  \ref{lem:unique-identity} and axiom (G1) of \ref{def:group}.
\end{proof}

%% Standalone equation to exercise the equations=outer default
%% (no theorem context, so equation IS an atom source).
The order of a group $G$ is defined by
\begin{equation}\label{eq:order}
  |G| \;=\; \#\{g \in G : g = g\},
\end{equation}
which is finite when $G$ is a finite group.

%% =============================================================
%%  Section 2: Subgroups and Lagrange's theorem
%% =============================================================
\section{Subgroups and Lagrange's theorem}%
\label{sec:subgroups}

\begin{definition}\label{def:subgroup}
  A non-empty subset $H \subseteq G$ is a \emph{subgroup} of $G$
  (see \ref{def:group}) if $H$ is closed under the group operation
  and under inversion.
\end{definition}

\begin{theorem}\label{thm:lagrange}
  Let $\GrpOp{G}{\mu}$ be a finite group (see \ref{def:group},
  \ref{eq:order}) and let $H \leq G$ be a subgroup (\ref{def:subgroup}).
  Then $|H|$ divides $|G|$.  In particular,
  the uniqueness of identity (\ref{lem:unique-identity}) and
  inverses (\ref{cor:unique-inverse}) hold inside $H$.
\end{theorem}

\begin{proof}
  The left cosets $\{gH : g \in G\}$ partition $G$; each coset
  has exactly $|H|$ elements.  Counting gives
  $|G| = [G:H] \cdot |H|$ where $[G:H]$ is the index.
\end{proof}

\begin{corollary}\label{cor:order-divides}
  Every element $g \in G$ satisfies $g^{|G|} = e$.
  This follows immediately from \ref{thm:lagrange}.
\end{corollary}

\END
\end{document}
