%% TEST-NAME: integ-equations-all
%% TEST-WHAT: Verify that equations=all causes equations INSIDE tracked theorem
%%            environments to be tracked as equation-sourced atomrefs, not just
%%            standalone (outer-mode) equations.
%%
%%            In default mode (equations=outer), when a \ref fires inside a
%%            display equation that is nested inside a theorem environment,
%%            \codep@eqshouldtrack clears \codep@eqatom because codep@intheorem
%%            is true — the reference falls through to the containing theorem
%%            atom.  With equations=all, \codep@eqshouldtrack ALWAYS sets the
%%            sentinel, so a \cref inside an equation inside a theorem produces
%%            a PARENTHESISED equation number as the source atom: "(N.M)".
%%
%%            Key pattern: to get an equation-sourced atomref, a \cref{label}
%%            must fire INSIDE the equation body (the equation is the source;
%%            the referenced label is the target).
%%
%%            This fixture exercises three scenarios:
%%            1. Equation INSIDE a theorem containing a \cref — equations=all
%%               produces \codep@atomref{(1.N)}{target}.
%%            2. align block INSIDE a theorem containing \cref on each row —
%%               Track 2 produces a range atomref.
%%            3. Standalone equation (outer mode) with \cref inside the body —
%%               tracked in both equations=outer and equations=all.
%%
%% TEST-SOURCE: codependent.sty §\codep@eqshouldtrack, docs/DESIGN.md §8a equations
%% TEST-SECTION: docs/DESIGN.md §8a (equation tracking)
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Error
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom
%% TEST-AUX-CONTAINS: \codep@atomref
%%
%% equations=all: equation inside theorem with \cref inside body must produce
%% an equation-sourced atomref.  Source key is a parenthesised equation number
%% like "(1.2)" or "(1.3)".  We assert the specific records from the key
%% scenario: eq inside thm referencing def:continuity.
%% TEST-AUX-CONTAINS: \codep@atomref{equation:1.
%%
%% Standalone equation in section 2 also tracks (works in both modes):
%% TEST-AUX-CONTAINS: \codep@atomref{equation:2.
%%
%% TEST-ATOMS-MIN: 4
%% TEST-PACKAGES: amsmath,amssymb,amsthm,hyperref,cleveref,codependent
%% TEST-RERUN: 2
%% TEST-BEHAVIOR: B-EQ-ALL

\documentclass{article}

\usepackage{amsmath,amssymb}
\usepackage{amsthm}
\usepackage[hypertexnames=false]{hyperref}
\usepackage{cleveref}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{definition}[theorem]{Definition}

%% equations=all: track equations inside theorem environments too.
\usepackage[equations=all]{codependent}
\codeptrack{theorem,lemma,definition}

\numberwithin{equation}{section}

\begin{document}
\START

%% =====================================================================
%%  Section 1: Equations inside theorems — the key equations=all scenario
%% =====================================================================
\section{Topology}%
\label{sec:topology}

\begin{definition}\label{def:continuity}
  A function $f \colon X \to Y$ between topological spaces is
  \emph{continuous} if the preimage of every open set is open.
\end{definition}

\begin{definition}\label{def:compactness}
  A topological space $X$ is \emph{compact} if every open cover
  admits a finite subcover.
\end{definition}

%% Key scenario: equation inside a theorem containing \cref in body.
%% With equations=all, this \cref fires while codep@inequation=true
%% and codep@intheorem=true — but equations=all bypasses the outer-mode
%% guard, so the equation "(1.3)" becomes the source atom.
\begin{theorem}\label{thm:continuity-compact}
  If $f \colon X \to Y$ is continuous (\cref{def:continuity}) and
  $X$ is compact (\cref{def:compactness}), then for every net
  $(x_\alpha)$ converging to $x$ the following holds:
  \begin{equation}\label{eq:limit-image}
    f(x) = \lim_{\alpha} f(x_\alpha).
    \qquad\text{(\cref{def:continuity})}
  \end{equation}
  In particular, $f$ maps compact sets to compact sets.
\end{theorem}

%% The \cref{def:continuity} INSIDE eq:limit-image fires while
%% codep@inequation=true (Track 1, inside a theorem).
%% equations=all: codep@eqshouldtrack does NOT suppress → writes
%% \codep@atomref{(1.3)}{def:continuity}.

%% Track 2 inside a theorem: align with \cref on each row.
\begin{lemma}\label{lem:preimage-union}
  Continuity (\cref{def:continuity}) interacts with set operations:
  \begin{align}
    f^{-1}(U \cup V) &= f^{-1}(U) \cup f^{-1}(V)
      \qquad\text{(\cref{def:continuity})} \label{eq:preimage-union} \\
    f^{-1}(U \cap V) &= f^{-1}(U) \cap f^{-1}(V). \label{eq:preimage-inter}
  \end{align}
  Together with \cref{thm:continuity-compact}, this gives
  the closed map theorem.
\end{lemma}

%% The \cref{def:continuity} inside the align body fires while
%% codep@inequation=true and codep@eqmultiline=true (Track 2).
%% equations=all: the pending list accumulates; at \end{align}
%% \codep@flusheqrange writes \codep@atomref{(1.4--1.5)}{def:continuity}.

%% =====================================================================
%%  Section 2: Standalone equations — tracked in both modes
%% =====================================================================
\section{Maps}%
\label{sec:maps}

The image of a compact set under a continuous map
(\cref{def:continuity,def:compactness}) is compact:
\begin{equation}\label{eq:compact-image}
  f(K) \text{ is compact} \qquad\text{(\cref{def:compactness})}
\end{equation}

%% eq:compact-image is standalone (outer mode).  With equations=all
%% (and also with equations=outer), this is tracked.
%% The \cref{def:compactness} inside the equation body writes
%% \codep@atomref{(2.1)}{def:compactness}.

A concluding paragraph: \cref{thm:continuity-compact} and
\cref{lem:preimage-union} establish that continuous maps are the
morphisms of the category of compact Hausdorff spaces.

\END
\end{document}
