% test-nested.lvt
% Verifies: a tracked environment nested inside another tracked
% environment does NOT advance the atom counter.  The inner
% environment is part of the outer atom.
%
% Design reference: docs/DESIGN.md "Nested tracked environments" --
% if \codep@nestlevel > 0 when a tracked env opens, the counter
% is NOT advanced.  One definition containing an example gets
% exactly one atom number, not two.

\documentclass{article}
\usepackage{amsthm}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}

\usepackage{codependent}
\codeptrack{definition,theorem,example}

\begin{document}
\START

\section{Nesting Test}

% Atom 1.1 -- outer definition opens, \codep@nestlevel becomes 1
\begin{definition}
  A \textbf{group} is a set $G$ with a binary operation satisfying
  closure, associativity, identity, and invertibility.

  % Inner example: \codep@nestlevel is already 1, so counter is NOT
  % advanced.  This example shares atom 1.1 with its enclosing definition.
  \begin{example}
    The integers $(\mathbb{Z}, +)$ form a group.
  \end{example}
\end{definition}

% \codep@nestlevel is back to 0 here.
% Atom 1.2 -- next item at top level advances counter normally.
\begin{definition}
  A \textbf{subgroup} is a subset closed under the group operation
  and inverses.
\end{definition}

\END
\end{document}
