% test-ntheorem.lvt
% Verifies: semtex works with ntheorem as the theorem backend.
% ntheorem redefines \newtheorem and theorem internals differently
% from amsthm.  semtex must hook by environment name via etoolbox,
% not by assuming amsthm internals.

\documentclass{article}
\usepackage[amsmath,thmmarks]{ntheorem}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}
\newtheorem{lemma}[theorem]{Lemma}

\usepackage{semtex}
\semtextrack{definition,theorem,lemma}

\begin{document}
\START

\section{Algebra}

% Atom 1.1 -- paragraph
Let $R$ be a commutative ring.

% Atom 1.2 -- definition via ntheorem
\begin{definition}
  An \textbf{ideal} of $R$ is a subset $I \subseteq R$ closed under
  addition and absorption by $R$.
\end{definition}

% Atom 1.3 -- lemma via ntheorem
\begin{lemma}
  The intersection of any family of ideals is an ideal.
\end{lemma}

% Atom 1.4 -- theorem via ntheorem
\begin{theorem}
  Every principal ideal domain is a unique factorisation domain.
\end{theorem}

\END
\end{document}
