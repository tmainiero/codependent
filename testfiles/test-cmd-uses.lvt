%% TEST-NAME: test-cmd-uses
%% TEST-PURPOSE: Verify a wrapped command (defined via \codepnewcommand)
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-CONC-USEDIN, B-CONC-EDGES
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify a wrapped command (defined via \codepnewcommand)
%%            emits one \codep@cdp@use record per invocation INSIDE
%%            an atom, and ZERO use records when invoked outside any
%%            atom (e.g., in section titles).
%% TEST-SOURCE: docs/DESIGN.md §9a User API "Side effects at invocation time"
%% TEST-SECTION: docs/DESIGN.md §9a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@use{1.1}{Hom} = 3
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% The wrapper guards on \ifx\codep@currentatom\@empty:
%%   - Inside an atom (paragraph 1.1 below): each \Hom call
%%     emits \codep@cdp@use{1.1}{Hom}.
%%   - Outside any atom (the section title below): \Hom is
%%     called once but \codep@currentatom is empty, so no
%%     use record fires.
%%
%% Expected: exactly 3 use records for {1.1}, zero for any
%% other atom number, and zero from the title invocation.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\codepnewcommand{\Hom}[2]{\mathrm{Hom}(#1,#2)}

\begin{document}
\START

% \Hom in a section title: must NOT emit a use record (no
% currentatom). The currentatom-clear fix from §8a.5 ensures
% the previous atom's number is gone before the \section
% expansion runs.
\section{The $\Hom{X}{Y}$ functor}

A paragraph with three uses: $\Hom{X}{Y}$, $\Hom{Y}{Z}$,
and the composite $\Hom{X}{Z}$. Three use records for atom
1.1 are expected.

\END
\end{document}
