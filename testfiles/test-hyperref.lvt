%% TEST-NAME: test-hyperref
%% TEST-PURPOSE: hyperref + codependent coexist without conflict. hyperref is loaded BEFORE codependent per the standard load-order rule…
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-LINK-CLICKABLE
%% TEST-STATUS: LIVE
% test-hyperref.lvt
% Verifies: hyperref + codependent coexist without conflict.
% hyperref is loaded BEFORE codependent per the standard load-order rule
% (hyperref rewrites many internals and must precede packages that
% hook into \label/\ref).  codependent detects hyperref via
% \@ifpackageloaded and enables link-wrapped back-ref numbers.

\documentclass{article}
\usepackage{amsthm}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}

% Load hyperref first, then codependent.
\usepackage[hidelinks]{hyperref}
\usepackage{codependent}
\codeptrack{definition,theorem}

\begin{document}
\START

\section{Categories}

% Atom 1.1 -- plain paragraph
Objects and morphisms form the data of a category.

% Atom 1.2 -- definition with a label; hyperref will create a PDF target.
\begin{definition}\label{def:category}
  A \textbf{category} $\mathcal{C}$ consists of a class of objects
  $\operatorname{ob}(\mathcal{C})$ and, for each pair of objects,
  a set of morphisms.
\end{definition}

% Atom 1.3 -- theorem referencing the definition; cross-ref becomes a link.
\begin{theorem}\label{thm:identity}
  Every category has an identity morphism.
  (See Definition~\ref{def:category}.)
\end{theorem}

\END
\end{document}
