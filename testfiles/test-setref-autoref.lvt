%% TEST-NAME: test-setref-autoref
%% TEST-WHAT: Verify \autoref{thm:A} produces a \codep@atomref edge via
%%            the hyperref \HyRef@autosetref patch site (NOT \@setref).
%% TEST-SOURCE: REVIEW_E #2 (BLOCKER), docs/DESIGN.md §8a.0 patch site 3
%% TEST-SECTION: docs/DESIGN.md §8a.0 Reference interception
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% REVIEW_E finding #2 sub-case: hyperref's \autoref does NOT call
%% \@setref. It reaches the cref-style fields via \HyRef@autosetref
%% (hyperref.sty lines 8220-8244). Without the dedicated patch site,
%% \autoref-heavy documents show zero back-reference edges even when
%% the kernel \@setref wrapper is in place.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{autoref test}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \autoref{thm:A} the conclusion follows.
\end{theorem}

\END
\end{document}
