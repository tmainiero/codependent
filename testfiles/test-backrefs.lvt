% test-backrefs.lvt
% Verifies: "Used in" text appears when a .sbr file is present.
% The .sbr file is written inline in the test via \write.
% Tests inline backref mode (the default).

\documentclass{article}
\usepackage{amsthm}

\newtheorem{definition}{Definition}[section]

\usepackage{semtex}
\semtextrack{definition}

\begin{document}
\START

% Write a mock .sbr file so pass-2 behaviour is exercised.
% In a real build, semtex CLI generates this from .aux.
\newwrite\sbrfile
\immediate\openout\sbrfile=\jobname.sbr
\immediate\write\sbrfile{%% Generated by semtex -- do not edit}
\immediate\write\sbrfile{\semtex@section{1}{Test Section}}
\immediate\write\sbrfile{\semtex@backref{1.1}{Category}{1.2, 1.3}}
\immediate\closeout\sbrfile

\section{Test Section}

% Atom 1.1 has back-refs to 1.2 and 1.3; "Used in 1.2, 1.3." should appear.
\begin{definition}\label{def:cat}
  A category consists of objects and morphisms.
\end{definition}

% Atom 1.2 references 1.1
\begin{definition}\label{def:func}
  A functor is a map between categories. See Definition~\ref{def:cat}.
\end{definition}

% Atom 1.3 also references 1.1
\begin{definition}\label{def:nat}
  A natural transformation is a map between functors. See~\ref{def:cat}.
\end{definition}

\END
\end{document}
