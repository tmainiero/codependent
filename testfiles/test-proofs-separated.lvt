%% TEST-NAME: test-proofs-separated
%% TEST-WHAT: \codepproofof associates a separated proof with its theorem;
%%            the proof gets the theorem's starred atom number.
%% TEST-SOURCE: DESIGN.md §Proof environments, \codepproofof command
%% TEST-SECTION: DESIGN.md §8a
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{2.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{2.1*}
%% TEST-AUX-CONTAINS: \codep@atomref{2.1*}{thm:main}
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Tests two scenarios:
%% 1. Theorem in section 1, proof in section 2 with \codepproofof{thm:main}
%% 2. The SBL contains a \codep@cdp@proof record for the starred atom
%% 3. Cross-references from inside the separated proof use starred numbers

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Statements}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:main}
  Main theorem statement.
\end{theorem}

% Adjacent proof: inherits 1.1*
\begin{proof}
  Adjacent proof of main theorem.
\end{proof}

\section{Deferred proofs}

% Atom 2.1 -- theorem (target for backref)
\begin{theorem}\label{thm:target}
  A target theorem.
\end{theorem}

% Non-adjacent proof with \codepproofof
\begin{proof}[Proof of Theorem~\ref{thm:main}]
  \codepproofof{thm:main}
  We reference \ref{thm:target} from inside this separated proof.
\end{proof}

\END
\end{document}
