%% TEST-NAME: test-numbering-depth2
%% TEST-WHAT: depth=2 option produces section.subsection.atom display
%%            numbers (e.g. "1.2.1") under the default article class.
%% TEST-SOURCE: DESIGN.md §Numbering "Depth"
%% TEST-SECTION: DESIGN.md §Numbering, codependent.sty lines 195-199
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-COUNT: \codep@cdp@atom{1.1.1}{paragraph} = 1
%% TEST-CDP-COUNT: \codep@cdp@atom{1.2.1}{paragraph} = 1
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%% TEST-PDF-CONTAINS: 1.1.1
%% TEST-PDF-NOT: 0.0.1
%%
%% Pins depth=2: atom resets on \subsection, display format becomes
%% section.subsection.atom. Two subsections under one section, one
%% paragraph each, yields 1.1.1 and 1.2.1. A bug that uses depth=1
%% paths would produce 1.1 and 1.2; a bug that forgets to reset on
%% subsection would produce 1.1.1 and 1.2.2.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage[depth=2]{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Sec}

\subsection{SubA}

Paragraph in subsection A. Expected atom 1.1.1.

\subsection{SubB}

Paragraph in subsection B. Expected atom 1.2.1.

\END
\end{document}
