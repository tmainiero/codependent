%% TEST-NAME: test-proofs-inherit
%% TEST-PURPOSE: Adjacent proofs inherit theorem atom number with star suffix;
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PROOF-ADJ, B-PROOF-NONADJ, B-PROOF-ADJRULE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Adjacent proofs inherit theorem atom number with star suffix;
%%            non-adjacent proofs get independent atom numbers.
%% TEST-SOURCE: docs/DESIGN.md Proof adjacency, Pavlov-style numbering
%% TEST-SECTION: docs/DESIGN.md §Proof environments
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.1}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.1*}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.2}{theorem}
%% TEST-CDP-CONTAINS: \codep@cdp@proof{1.2*}
%% TEST-CDP-CONTAINS: \codep@cdp@atom{1.4}{proof}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.1*}
%% TEST-CDP-NOT-CONTAINS: \codep@cdp@atom{1.2*}
%% TEST-LOG-CONTAINS: Proof not adjacent to a tracked
%% TEST-ATOMS-MIN: 4
%% TEST-PACKAGES: amsthm,codependent
%% TEST-RERUN: 2
%%
%% Tests three scenarios:
%% 1. Theorem + adjacent proof -> proof inherits theorem's number (1.1*)
%% 2. Theorem + adjacent proof -> same inheritance (1.2*)
%% 3. Paragraph between theorem and proof -> proof gets own number (1.4)
%%    with a "not adjacent" warning.

\documentclass{article}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Adjacent proofs}

% Atom 1.1 -- theorem
\begin{theorem}\label{thm:first}
  First theorem statement.
\end{theorem}

% Adjacent proof: inherits 1.1*
\begin{proof}
  Proof of first theorem.
\end{proof}

% Atom 1.2 -- theorem
\begin{theorem}\label{thm:second}
  Second theorem statement.
\end{theorem}

% Adjacent proof: inherits 1.2*
\begin{proof}
  Proof of second theorem.
\end{proof}

% Atom 1.3 -- paragraph (clears adjacency flag)
A paragraph of text between theorem and proof.

% Atom 1.4 -- non-adjacent proof (own number, triggers warning)
\begin{proof}
  This proof is not adjacent to any theorem.
\end{proof}

\END
\end{document}
