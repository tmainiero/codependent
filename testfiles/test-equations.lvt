% test-equations.lvt
% Verifies: equations=shared mode makes unstarred equation environments
% consume atom numbers from the shared counter.  Starred equations
% do not advance any counter.

\documentclass{article}
\usepackage{amsmath}
\usepackage{amsthm}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{definition}[theorem]{Definition}

\usepackage[equations=shared]{semtex}
\semtextrack{definition,theorem}

\begin{document}
\START

\section{Shared Numbering}

% Atom 1.1 -- paragraph
Let $f \colon X \to Y$ be a continuous map.

% Atom 1.2 -- definition
\begin{definition}
  The map $f$ is a homeomorphism if it is bijective and bicontinuous.
\end{definition}

% Atom 1.3 -- unstarred equation: consumes an atom number in shared mode.
\begin{equation}
  f \circ f^{-1} = \mathrm{id}_Y
\end{equation}

% Starred equation: does NOT consume an atom number.
\begin{equation*}
  f^{-1} \circ f = \mathrm{id}_X
\end{equation*}

% Atom 1.4 -- theorem: counter continues from 1.3.
\begin{theorem}
  Homeomorphisms form a group under composition.
\end{theorem}

\END
\end{document}
