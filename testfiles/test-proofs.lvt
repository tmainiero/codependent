% test-proofs.lvt
% Verifies: proof environments (amsthm's non-\newtheorem environment)
% with Pavlov-style adjacency detection.  Adjacent proofs inherit the
% preceding theorem's atom number with a star suffix; non-adjacent
% proofs get their own atom number.

\documentclass{article}
\usepackage{amsthm}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}

% Default: proofs=on
\usepackage{semtex}
\semtextrack{theorem,lemma}

\begin{document}
\START

\section{Results}

% Atom 1.1 -- lemma
\begin{lemma}\label{lem:trivial}
  The empty set is a subset of every set.
\end{lemma}

% Adjacent proof: inherits 1.1* (no own atom number)
\begin{proof}
  Vacuously true: the condition is satisfied for all $x \in \emptyset$.
\end{proof}

% Atom 1.2 -- theorem
\begin{theorem}\label{thm:union}
  The union of two sets is a set.
\end{theorem}

% Adjacent proof: inherits 1.2* (no own atom number)
\begin{proof}
  By the axiom of union in ZFC.
\end{proof}

\END
\end{document}
