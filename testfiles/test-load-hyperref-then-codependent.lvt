%% TEST-NAME: test-load-hyperref-then-codependent
%% TEST-PURPOSE: Verify hyperref loaded BEFORE codependent works cleanly (the
%% TEST-KIND: unit
%% TEST-BEHAVIOR: B-PASS-ONE
%% TEST-STATUS: LIVE
%% TEST-WHAT: Verify hyperref loaded BEFORE codependent works cleanly (the
%%            recommended load order); backref edges and the .cdp end
%%            marker both land.
%% TEST-SOURCE: docs/DESIGN.md §Load order "Recommended order"
%% TEST-SECTION: docs/DESIGN.md §Load order
%% TEST-EXIT: 0
%% TEST-LOG-NOT: codependent.*Error|Undefined control sequence
%% TEST-LOG-NOT: Package codependent Warning
%% TEST-CDP-CONTAINS: \codep@cdp@end{OK}
%% TEST-AUX-CONTAINS: \codep@atomref{theorem:1.2}{thm:A}
%% TEST-ATOMS-MIN: 2
%% TEST-PACKAGES: hyperref,amsthm,codependent
%% TEST-RERUN: 2
%%
%% Baseline "happy path" load order regression. hyperref
%% BEFORE codependent is the recommended order because codependent's
%% reference-patch sites (§8a.0) wrap hyperref's already-
%% wrapped \@setref / \HyRef@autosetref / \HyRef@@StarSetRef,
%% so we sit on the outside. This fixture is the control
%% against which test-load-codependent-then-hyperref is compared.

\documentclass{article}
\usepackage{hyperref}
\usepackage{amsthm}
\newtheorem{theorem}{Theorem}[section]
\usepackage{codependent}
\codeptrack{theorem}

\begin{document}
\START

\section{Load order happy}

\begin{theorem}\label{thm:A}
  Theorem A.
\end{theorem}

\begin{theorem}
  By \ref{thm:A}, done.
\end{theorem}

\END
\end{document}
