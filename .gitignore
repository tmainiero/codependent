# Build artifacts
# legacy .sbl sidecars (now .cdp)
*.sbl
*.aux
*.log
*.out
*.cdp
*.pdf
*.synctex.gz
*.fls
*.fdb_latexmk
texput.*

# Stale copies — use TEXINPUTS to find canonical codependent.sty
testfiles/compiled-examples/codependent.sty
build/
texbuild/
pdf-out/

# Keep pdf-out ignored except committed visual goldens.
!pdf-out/
pdf-out/*
!pdf-out/goldens/
!pdf-out/goldens/*.pdf
!pdf-out/goldens/*-manifest.json
!pdf-out/goldens/README.md

# Generated VSPACE inventory (ephemeral; committed classification is vspace-inventory-manifest.json)
testfiles/output/vspace-inventory.json

# Ephemeral agent state (findings, comms, candidate claims, wave tracker, locks)
.claude/agent_memory/
.claude/comms/
.claude/build_tracker.md
.claude/scheduled_tasks.lock
.codex
