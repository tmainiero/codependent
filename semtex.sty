%% ===================================================================
%% Section 1: Identification
%% ===================================================================
\NeedsTeXFormat{LaTeX2e}[2021/06/01]
\ProvidesPackage{semtex}[2026/04/10 v1.0 %
  Pavlov-style atom numbering and back-reference display]

%% ===================================================================
%% Section 2: Required packages
%% ===================================================================
\RequirePackage{etoolbox}
\RequirePackage{pgfkeys}

%% ===================================================================
%% Section 3: Options
%% ===================================================================

% Depth: how many sectioning levels in the atom display number.
\newcommand*{\semtex@depth}{1}

% Equations: separate (default) or shared counter.
\newbool{semtex@eqshared}
\boolfalse{semtex@eqshared}

% Back-references: inline (default), appendix, or none.
\newcommand*{\semtex@backrefmode}{inline}
\newbool{semtex@backrefs}
\booltrue{semtex@backrefs}
\newbool{semtex@appendix}
\boolfalse{semtex@appendix}

% Proofs: numbered (default) or unnumbered.
\newbool{semtex@proofsnumbered}
\booltrue{semtex@proofsnumbered}

% Concept warnings: on (default) or off.
\newbool{semtex@conceptwarnings}
\booltrue{semtex@conceptwarnings}

% Rendering configuration (backref style, alignment, fonts).
\newcommand*{\semtex@backrefstyle}{block}
\newcommand*{\semtex@backrefalign}{right}
\newcommand*{\semtex@backreffont}{\scriptsize\sffamily}
\newcommand*{\semtex@backrefprefix}{}
\newcommand*{\semtex@backreflabel}{Used in}
\newcommand*{\semtex@marginfont}{\scriptsize}

\pgfkeys{%
  /semtex/.is family,%
  /semtex/.cd,%
  depth/.store in = \semtex@depth,%
  depth/.default = 1,%
  equations/.is choice,%
  equations/separate/.code = {\boolfalse{semtex@eqshared}},%
  equations/shared/.code = {\booltrue{semtex@eqshared}},%
  equations/.default = separate,%
  backrefs/.is choice,%
  backrefs/inline/.code = {%
    \booltrue{semtex@backrefs}%
    \boolfalse{semtex@appendix}%
    \renewcommand*{\semtex@backrefmode}{inline}%
  },%
  backrefs/appendix/.code = {%
    \booltrue{semtex@backrefs}%
    \booltrue{semtex@appendix}%
    \renewcommand*{\semtex@backrefmode}{appendix}%
  },%
  backrefs/none/.code = {%
    \boolfalse{semtex@backrefs}%
    \boolfalse{semtex@appendix}%
    \renewcommand*{\semtex@backrefmode}{none}%
  },%
  backrefs/.default = inline,%
  proofs/.is choice,%
  proofs/numbered/.code = {\booltrue{semtex@proofsnumbered}},%
  proofs/unnumbered/.code = {\boolfalse{semtex@proofsnumbered}},%
  proofs/.default = numbered,%
  conceptwarnings/.is choice,%
  conceptwarnings/on/.code = {\booltrue{semtex@conceptwarnings}},%
  conceptwarnings/off/.code = {\boolfalse{semtex@conceptwarnings}},%
  conceptwarnings/.default = on,%
  backref-style/.is choice,%
  backref-style/block/.code = {\renewcommand*{\semtex@backrefstyle}{block}},%
  backref-style/inline/.code = {\renewcommand*{\semtex@backrefstyle}{inline}},%
  backref-style/.default = block,%
  backref-align/.is choice,%
  backref-align/left/.code = {\renewcommand*{\semtex@backrefalign}{left}},%
  backref-align/right/.code = {\renewcommand*{\semtex@backrefalign}{right}},%
  backref-align/.default = right,%
  backref-font/.store in = \semtex@backreffont,%
  backref-prefix/.store in = \semtex@backrefprefix,%
  backref-label/.store in = \semtex@backreflabel,%
  margin-font/.store in = \semtex@marginfont,%
}

% Collect all options and forward to pgfkeys.
\def\semtex@rawopts{}%
\DeclareOption*{%
  \ifx\semtex@rawopts\@empty
    \edef\semtex@rawopts{\CurrentOption}%
  \else
    \edef\semtex@rawopts{\semtex@rawopts,\CurrentOption}%
  \fi
}%
\ProcessOptions\relax
\ifx\semtex@rawopts\@empty\else
  \edef\semtex@tmp@opts{%
    \noexpand\pgfkeys{/semtex/.cd,\semtex@rawopts}%
  }%
  \semtex@tmp@opts
\fi

% \semtexsetup{key=value,...}  Configure semtex in preamble or body.
\newcommand*{\semtexsetup}[1]{\pgfkeys{/semtex/.cd,#1}}

%% ===================================================================
%% Section 4: Internal state
%% ===================================================================

% Base counter name: auto-detected from the first env in \semtextrack.
\newcommand*{\semtex@basecounter}{}

% Suppression nesting depth.  When > 0, para/begin skips numbering.
\newcount\semtex@nestlevel
\semtex@nestlevel=0\relax

% Tracked-env nesting depth.  When > 1, inner tracked envs are
% suppressed (no atom record, no SBL entry).  Uses \global\advance
% because hooks may run inside groups.
\newcount\semtex@trackedlevel
\semtex@trackedlevel=0\relax

% Pending back-reference text (flushed at para/end or env end).
\newtoks\semtex@pendingbr

% Current atom display number (set when atom is created).
\newcommand*{\semtex@currentatom}{}

% Saved atom number for the outermost tracked env.  When nesting
% occurs, \theatom at end-time reflects the LAST \refstepcounter
% (the inner env), not the outermost.  This macro captures the
% correct value after the outermost env's \refstepcounter fires.
\newcommand*{\semtex@outeratom}{}

% Flag: true inside a tracked theorem environment.
\newbool{semtex@intheorem}
\boolfalse{semtex@intheorem}

% Flag: true when \semtextrack has been called.
\newbool{semtex@tracked}
\boolfalse{semtex@tracked}

% Flag: true when a sectioning heading paragraph is pending.
% Set by the \@startsection wrapper, cleared after one para/begin.
\newbool{semtex@sectioning}
\boolfalse{semtex@sectioning}

% Flag: true when a standalone proof's margin number is pending.
% Set by the proof hook, cleared after one para/begin emission.
\newbool{semtex@proofpending}
\boolfalse{semtex@proofpending}

% Restate guard: counter-indexed LIFO stack for save/clear/restore
% of \semtex@currentatom across restated theorem occurrences
% (§8a.5.a).  Depth 0 = no active restate; each push increments.
\newcount\semtex@restate@depth
\semtex@restate@depth=0\relax

% \semtex@pushcurrentatom
%   Save \semtex@currentatom onto the restate stack and clear it
%   to \@empty so semantic commands inside the restated body no-op.
\newcommand*{\semtex@pushcurrentatom}{%
  \global\advance\semtex@restate@depth 1\relax
  \expandafter\xdef
    \csname semtex@saved@currentatom@%
      \the\semtex@restate@depth\endcsname
    {\semtex@currentatom}%
  \global\let\semtex@currentatom\@empty
}

% \semtex@popcurrentatom
%   Restore \semtex@currentatom from the restate stack, undefine
%   the slot, and decrement the depth counter.
\newcommand*{\semtex@popcurrentatom}{%
  \global\expandafter\let\expandafter\semtex@currentatom
    \csname semtex@saved@currentatom@%
      \the\semtex@restate@depth\endcsname
  \global\expandafter\let
    \csname semtex@saved@currentatom@%
      \the\semtex@restate@depth\endcsname\@undefined
  \global\advance\semtex@restate@depth -1\relax
}

% Accumulated appendix data (token register).
% Still referenced by \semtexappendix (Section 10); Wave 3 rewires
% its population path per §8a.6.g.
\newtoks\semtex@appendixdata

% Count-indexed atom array for appendix mode (§8a.6.g).
% Each \semtex@atom@<n> expands to {<num>}{<type>}.
% O(1) append via csname array; O(N) walk in \semtexappendix.
\newcount\semtex@atomcount

% Sidecar (.sbl) stream state (§9a).
\newbool{semtex@sblopen}
\boolfalse{semtex@sblopen}

% Deferred sbl writes: preamble cmddef records accumulate here
% and flush once the .sbl stream opens at begindocument/before.
\def\semtex@sbl@deferred{}

%% ===================================================================
%% Section 5: Core numbering machinery
%% ===================================================================

% \semtex@removefromreset{counter}{parent}
%   Remove counter from parent's reset list.
\newcommand*{\semtex@removefromreset}[2]{%
  \@ifundefined{@removefromreset}{%
    % Manual: rewrite \cl@parent without #1.
    \begingroup
      \expandafter\let\expandafter\semtex@resetlist
        \csname cl@#2\endcsname%
      \expandafter\global\expandafter\let
        \csname cl@#2\endcsname\@empty%
      \def\@elt##1{%
        \def\semtex@cur{##1}%
        \def\semtex@tgt{#1}%
        \ifx\semtex@cur\semtex@tgt\else
          \expandafter\g@addto@macro
            \csname cl@#2\endcsname{\@elt{##1}}%
        \fi
      }%
      \semtex@resetlist
    \endgroup
  }{%
    \@removefromreset{#1}{#2}%
  }%
}

% \semtex@setupcounter
%   Create the atom counter and wire it to the base counter
%   (auto-detected from the first env in \semtextrack).
%   Called by \semtextrack.
\newcommand*{\semtex@setupcounter}{%
  \newcounter{atom}%
  % Copy current base counter value (if it exists).
  % Note: \@ifundefined uses \csname internally, which expands
  % \semtex@basecounter automatically.
  \@ifundefined{c@\semtex@basecounter}{}{%
    \setcounter{atom}{\value{\semtex@basecounter}}%
    % Alias: \c@<basecounter> -> \c@atom.
    \expandafter\let\csname c@\semtex@basecounter\endcsname\c@atom
  }%
  \semtex@configuredepth
  % Sync base counter display format with atom display format.
  \@ifundefined{c@\semtex@basecounter}{}{%
    \expandafter\let\csname the\semtex@basecounter\endcsname\theatom
  }%
}

% \semtex@configuredepth
%   Set up counter resets and display format based on depth option
%   and document class.
\newcommand*{\semtex@configuredepth}{%
  % Remove base counter from any existing reset parent.
  \@ifundefined{c@\semtex@basecounter}{}{%
    \@ifundefined{cl@section}{}{%
      \expandafter\semtex@removefromreset\expandafter{\semtex@basecounter}{section}%
    }%
    \@ifundefined{cl@chapter}{}{%
      \expandafter\semtex@removefromreset\expandafter{\semtex@basecounter}{chapter}%
    }%
  }%
  \@ifundefined{chapter}{%
    \semtex@configuredepth@article
  }{%
    \semtex@configuredepth@book
  }%
}

% Article-class depth configuration.
\newcommand*{\semtex@configuredepth@article}{%
  \ifnum\semtex@depth=1\relax
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{\thesection.\arabic{atom}}%
  \else\ifnum\semtex@depth=2\relax
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.\arabic{atom}}%
  \else\ifnum\semtex@depth=3\relax
    \@addtoreset{atom}{subsubsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.%
      \arabic{subsubsection}.\arabic{atom}}%
  \else
    \PackageError{semtex}{Invalid depth '\semtex@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi\fi\fi
}

% Book/report-class depth configuration.
\newcommand*{\semtex@configuredepth@book}{%
  \ifnum\semtex@depth=1\relax
    \@addtoreset{atom}{chapter}%
    \renewcommand*{\theatom}{\thechapter.\arabic{atom}}%
  \else\ifnum\semtex@depth=2\relax
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.\arabic{atom}}%
  \else\ifnum\semtex@depth=3\relax
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.%
      \arabic{subsection}.\arabic{atom}}%
  \else
    \PackageError{semtex}{Invalid depth '\semtex@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi\fi\fi
}

%% ===================================================================
%% Section 6: Theorem environment hooks
%% ===================================================================

% \semtex@hooktheorem{envname}
%   Install begin/end hooks for a tracked theorem environment.
%   Uses LaTeX 2021+ cmd hooks (cmd/<env>/before) instead of
%   etoolbox's \AtBeginEnvironment so that hooks also fire when
%   thmtools' thm-restate.sty calls \theorem / \endtheorem
%   directly (bypassing \begin{theorem}).
%
%   Timing note (DESIGN.md §8a.5.0): the cmd/before hook fires
%   BEFORE amsthm's \refstepcounter{theorem}, so \theatom at
%   begin-time is the PREVIOUS atom's number.  The queuebackref
%   call is therefore in the end hook, where the env body has
%   run and \theatom reflects the current atom.
%   \semtex@currentatom is demoted to a sentinel — its value
%   is not used, only its emptiness; we set it to a literal
%   "1" on begin and clear to \@empty on end.
%
%   Restatable guard (§8a.5.a): \semtex@setupcounter aliases
%   \c@<basecounter> to \c@atom.  When thmtools' thm-restate.sty
%   re-fires the env for \restate, it breaks this alias
%   (\c@<basecounter> -> \c@thmt@dummyctr).  The \ifx guard
%   detects whether the alias is intact (original occurrence) or
%   broken (restate occurrence) and skips the hook body on
%   restate, preventing spurious atom attribution and duplicate
%   .sbl records.  All envs declared with
%   \newtheorem{...}[<basecounter>] share
%   \c@<basecounter>, so the guard covers all shared-counter
%   envs.  Envs with independent counters are not supported by
%   this guard and should not be passed to \semtextrack.
%
%   Note: the env name is captured via the hook argument (#1)
%   rather than \@currenvir, because under restatable the
%   current environment is "restatable", not the theorem type.
\newcommand*{\semtex@hooktheorem}[1]{%
  \AddToHook{cmd/#1/before}{%
    \expandafter\ifx\csname c@\semtex@basecounter\endcsname\c@atom
      % Original occurrence: alias intact, normal hook body.
      \global\advance\semtex@trackedlevel by 1\relax
      \advance\semtex@nestlevel by 1\relax
      \ifnum\semtex@trackedlevel>1\relax
        % Nested tracked env: suppress atom creation.
        \PackageWarning{semtex}{Nested tracked environment '#1'
          inside another tracked environment. The inner
          environment will not be assigned its own atom number}%
      \else
        \booltrue{semtex@intheorem}%
        % Sentinel only — the actual atom number is read at write
        % time via \theatom (see §8a.5.0).
        \def\semtex@currentatom{1}%
      \fi
    \else
      % Restate occurrence: \c@<basecounter> re-let to dummy
      % counter by thm-restate.sty.  Suppress the hook body to avoid
      %   (a) reading the wrong \theatom,
      %   (b) writing a duplicate \semtex@sbl@atom record,
      %   (c) queuing back-refs against a stale atom number.
      % Bump nestlevel so paragraph numbering is suppressed
      % inside the restated body (matching normal theorem
      % semantics), and save/clear currentatom so semantic
      % commands inside the restated body no-op.
      \advance\semtex@nestlevel by 1\relax
      \semtex@pushcurrentatom
    \fi
  }%
  % Save \theatom after \refstepcounter fires for the outermost env.
  % cmd/#1/after fires AFTER amsthm's \refstepcounter (unlike
  % cmd/#1/before which fires BEFORE it), so \theatom is correct
  % here.  For nested tracked envs this is a no-op; only
  % trackedlevel=1 saves.  The restate guard is not needed here
  % because trackedlevel is only incremented on the original path.
  \AddToHook{cmd/#1/after}{%
    \ifnum\semtex@trackedlevel=1\relax
      \xdef\semtex@outeratom{\theatom}%
    \fi
  }%
  \AddToHook{cmd/end#1/before}{%
    \expandafter\ifx\csname c@\semtex@basecounter\endcsname\c@atom
      % Original occurrence: normal end body.
      \ifnum\semtex@trackedlevel>1\relax
        % Nested end: skip SBL/backref, just decrement.
        \global\advance\semtex@trackedlevel by -1\relax
        \advance\semtex@nestlevel by -1\relax
      \else
        % Outermost end: write SBL records and flush backrefs.
        % Use \semtex@outeratom (captured after the outermost
        % env's \refstepcounter) instead of \theatom, because
        % nested tracked envs may have advanced the counter.
        \semtex@sblwrite@atom{%
          \string\semtex@sbl@atom{\semtex@outeratom}{#1}}%
        \semtex@sblwrite@atom{%
          \string\semtex@sbl@meta{\semtex@outeratom}{env}{#1}}%
        \semtex@sblwrite@atom{%
          \string\semtex@sbl@meta{\semtex@outeratom}{src}%
            {\jobname.tex:\the\inputlineno:1}}%
        \global\advance\semtex@atomcount by 1\relax
        \expandafter\xdef\csname semtex@atom@\the\semtex@atomcount\endcsname{%
          {\semtex@outeratom}{#1}}%
        \semtex@queuebackref{\semtex@outeratom}%
        % Backref flush is deferred to env/#1/after so that
        % "Used in" renders AFTER endmarks (QED symbols, etc.).
        % §8a.5 atom-end clear of the in-atom sentinel.
        \let\semtex@currentatom\@empty
        \global\advance\semtex@trackedlevel by -1\relax
        \advance\semtex@nestlevel by -1\relax
        \ifnum\semtex@nestlevel=0\relax
          \boolfalse{semtex@intheorem}%
        \fi
      \fi
    \else
      % Restate end: restore currentatom from the stack, then
      % decrement nestlevel (LIFO order per §8a.5.a).
      \semtex@popcurrentatom
      \advance\semtex@nestlevel by -1\relax
    \fi
  }%
  % Flush backrefs AFTER the environment fully closes, so the
  % "Used in X, Y." line appears after endmarks and QED symbols.
  % Uses \AfterEndEnvironment (etoolbox) which fires after the
  % env's \end{} code completes, including endmarks.  For
  % restatable re-fires (which call \theorem/\endtheorem
  % directly, bypassing \begin/\end), this hook does not fire —
  % correct, since the restate guard already skipped backref
  % queueing in the cmd/end hook above.
  \AfterEndEnvironment{#1}{%
    \semtex@flushbackref
  }%
}

% \semtex@hookproof
%   Install hooks for the proof environment.
%   Standalone proofs defer margin emission to para/begin so the
%   number appears on the "Proof." line, not on a separate line.
\newcommand*{\semtex@hookproof}{%
  \@ifundefined{proof}{}{%
    \AtBeginEnvironment{proof}{%
      \ifbool{semtex@proofsnumbered}{%
        \ifnum\semtex@nestlevel>0\relax
          % Inside a tracked env: just suppress.
          \advance\semtex@nestlevel by 1\relax
        \else
          % Standalone proof: advance counter and defer margin
          % emission to para/begin so it lands on the same line
          % as the proof heading.
          \refstepcounter{atom}%
          \advance\semtex@nestlevel by 1\relax
          \edef\semtex@currentatom{\theatom}%
          \semtex@sblwrite@atom{%
            \string\semtex@sbl@atom{\theatom}{proof}}%
          \semtex@sblwrite@atom{%
            \string\semtex@sbl@meta{\theatom}{src}%
              {\jobname.tex:\the\inputlineno:1}}%
          \global\advance\semtex@atomcount by 1\relax
          \expandafter\xdef\csname semtex@atom@\the\semtex@atomcount\endcsname{%
            {\theatom}{proof}}%
          \global\booltrue{semtex@proofpending}%
          \semtex@queuebackref{\theatom}%
        \fi
      }{%
        % Unnumbered: just suppress paragraph numbering.
        \advance\semtex@nestlevel by 1\relax
      }%
    }%
    \AtEndEnvironment{proof}{%
      \ifbool{semtex@proofsnumbered}{%
        % Backref flush deferred to \AfterEndEnvironment so
        % "Used in" renders after the QED symbol.
        % §8a.5 atom-end clear of the in-atom sentinel.
        \let\semtex@currentatom\@empty
      }{}%
      \advance\semtex@nestlevel by -1\relax
    }%
    \AfterEndEnvironment{proof}{%
      \ifbool{semtex@proofsnumbered}{%
        \semtex@flushbackref
      }{}%
    }%
  }%
}

%% ===================================================================
%% Section 7: Paragraph numbering
%% ===================================================================

% \semtex@emitmargin{number}
%   Typeset a superscript atom number in the left margin.
\newcommand*{\semtex@emitmargin}[1]{%
  \leavevmode%
  \smash{%
    \llap{%
      {\semtex@marginfont\textsuperscript{#1}\kern0.5em}%
    }%
  }%
}

% \semtex@suppressenv{envname}
%   Increment nestlevel on entry, decrement on exit.
\newcommand*{\semtex@suppressenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \advance\semtex@nestlevel by 1\relax
  }%
  \AtEndEnvironment{#1}{%
    \advance\semtex@nestlevel by -1\relax
  }%
}

% \semtex@suppresscmd{command}
%   Patch a command to suppress numbering in its body.
\newcommand*{\semtex@suppresscmd}[1]{%
  \pretocmd{#1}{\advance\semtex@nestlevel by 1\relax}{}{}%
  \apptocmd{#1}{\advance\semtex@nestlevel by -1\relax}{}{}%
}

% \semtex@installsuppress
%   Hook suppression for standard environments.
\newcommand*{\semtex@installsuppress}{%
  \semtex@suppressenv{enumerate}%
  \semtex@suppressenv{itemize}%
  \semtex@suppressenv{description}%
  \semtex@suppressenv{quote}%
  \semtex@suppressenv{quotation}%
  \semtex@suppressenv{figure}%
  \semtex@suppressenv{table}%
  \semtex@suppressenv{minipage}%
  \semtex@suppressenv{tabular}%
  \semtex@suppressenv{tabularx}%
  \semtex@suppressenv{longtable}%
  \semtex@suppressenv{trivlist}%
  % Display math: suppress margin numbers inside displayed equations.
  \semtex@suppressenv{equation}%
  \semtex@suppressenv{equation*}%
  \semtex@suppressenv{displaymath}%
  \semtex@suppressenv{align}%
  \semtex@suppressenv{align*}%
  \semtex@suppressenv{gather}%
  \semtex@suppressenv{gather*}%
  \semtex@suppressenv{multline}%
  \semtex@suppressenv{multline*}%
  \semtex@suppressenv{flalign}%
  \semtex@suppressenv{flalign*}%
}

% \semtex@suppresssectioning
%   Suppress atom numbering for sectioning heading paragraphs.
%   Uses LaTeX 2021+ generic cmd/<level>/before hooks, which
%   fire universally across standard classes, KOMA-Script,
%   memoir, and titlesec (unlike the old \@startsection wrapper
%   which was a no-op under those packages).
\newcommand*{\semtex@suppresssectioning}{%
  \AddToHook{cmd/section/before}[semtex/sectioning]{%
    \global\booltrue{semtex@sectioning}}%
  \AddToHook{cmd/subsection/before}[semtex/sectioning]{%
    \global\booltrue{semtex@sectioning}}%
  \AddToHook{cmd/subsubsection/before}[semtex/sectioning]{%
    \global\booltrue{semtex@sectioning}}%
  \AddToHook{cmd/chapter/before}[semtex/sectioning]{%
    \global\booltrue{semtex@sectioning}}%
  \AddToHook{cmd/paragraph/before}[semtex/sectioning]{%
    \global\booltrue{semtex@sectioning}}%
  \AddToHook{cmd/subparagraph/before}[semtex/sectioning]{%
    \global\booltrue{semtex@sectioning}}%
}

% Auto-suppress enumitem \newlist environments.
%   When enumitem is loaded, wraps \newlist so that every
%   user-defined list environment is automatically registered
%   for paragraph-number suppression.
\AddToHook{begindocument/before}[semtex/suppress/enumitem]{%
  \@ifpackageloaded{enumitem}{%
    \let\semtex@orig@newlist\newlist
    \def\newlist#1#2#3{%
      \semtex@orig@newlist{#1}{#2}{#3}%
      \semtex@suppressenv{#1}%
    }%
  }{}%
}

% Auto-suppress tcolorbox / mdframed environments.
%   Conditionally suppresses boxed-content environments when
%   the respective package is loaded.
\AddToHook{begindocument/before}[semtex/suppress/boxes]{%
  \@ifpackageloaded{tcolorbox}{%
    \semtex@suppressenv{tcolorbox}%
  }{}%
  \@ifpackageloaded{mdframed}{%
    \semtex@suppressenv{mdframed}%
  }{}%
}

% \semtex@suppresscommands
%   Suppress numbering inside footnote, parbox.
%   Note: \caption is NOT patched here because its complex
%   calling convention (\@ifstar + optional arg) makes
%   etoolbox patching unreliable.  Captions appear only
%   inside figure/table environments, which are already
%   suppressed at the env level.
\newcommand*{\semtex@suppresscommands}{%
  \semtex@suppresscmd{\footnote}%
  \semtex@suppresscmd{\parbox}%
  \semtex@suppresscmd{\maketitle}%
}

% \semtex@installparahook
%   Install the para/begin hook for paragraph numbering.
%   Checks three suppression conditions:
%   - semtex@sectioning: one-shot flag for heading paragraphs
%   - semtex@proofpending: deferred proof margin emission
%   - semtex@nestlevel > 0: inside a suppressed env/command
%   Also emits any deferred backref from the previous
%   paragraph (saved by para/end to avoid mode-change error).
\newcommand*{\semtex@installparahook}{%
  \AddToHook{para/begin}{%
    \ifbool{semtex@tracked}{%
      % Emit deferred backref from previous paragraph.
      % Uses \vadjust{pre} to inject the "Used in X." line
      % above the current line (i.e. at the end of the
      % previous paragraph's output) without a mode change.
      \ifx\semtex@deferredbr\@empty\else
        \vadjust pre{%
          \semtex@renderdeferred{\semtex@deferredbr}%
        }%
        \global\let\semtex@deferredbr\@empty
      \fi
      % Sectioning heading paragraph: skip entirely.
      \ifbool{semtex@sectioning}{%
        \global\boolfalse{semtex@sectioning}%
      }{%
        % Proof pending: emit deferred margin number on the
        % proof's first line (the "Proof." heading).
        \ifbool{semtex@proofpending}{%
          \global\boolfalse{semtex@proofpending}%
          \semtex@emitmargin{\semtex@currentatom}%
        }{%
          % Normal paragraph (not suppressed).
          \ifnum\semtex@nestlevel>0\relax\else
            \refstepcounter{atom}%
            \edef\semtex@currentatom{\theatom}%
            \semtex@sblwrite@atom{%
              \string\semtex@sbl@atom
                {\theatom}{paragraph}}%
            \semtex@sblwrite@atom{%
              \string\semtex@sbl@meta{\theatom}{src}%
                {\jobname.tex:\the\inputlineno:1}}%
            \global\advance\semtex@atomcount by 1\relax
            \expandafter\xdef\csname semtex@atom@\the\semtex@atomcount\endcsname{%
              {\theatom}{paragraph}}%
            \semtex@emitmargin{\semtex@currentatom}%
            \semtex@queuebackref{\theatom}%
          \fi
        }%
      }%
    }{}%
  }%
}

