%% --- Section 8a.0: Reference interception (three-site design) ---
%% Per REVIEW_E finding #2 (BLOCKER), the single-\@setref patch
%% covers only \ref/\eqref/\pageref/\vref/\nameref.  cleveref's
%% \cref@getlabel, hyperref's \HyRef@autosetref (\autoref), and
%% hyperref's \HyRef@@StarSetRef (\ref*/\Ref) all bypass \@setref.
%% This subsection installs THREE patch sites.  Per REVIEW_E #16,
%% \hyperref[]{} is deliberately uncovered (manual link, not a
%% cross-reference).

% Pass-1 safety: \semtex@atomref must be defined to SOMETHING at
% package-load time so that if a stale .aux still references it
% (or a user script injects a record), LaTeX's aux read does not
% error.  A \providecommand no-op suits.
\providecommand*{\semtex@atomref}[2]{}

% \semtex@writeatomref{target}
%   Shared aux-write helper called by all patch sites.  Guards
%   on \semtex@currentatom (in-atom sentinel: empty = not inside
%   a tracked atom, so no write) and on \if@filesw so --draftmode
%   / -no-aux compiles work.  The src field is read from \theatom
%   at write time per DESIGN.md §8a.5.0: at hook entry \theatom
%   is pre-\refstepcounter (wrong number); at \ref time the
%   refstepcounter has fired and \theatom is the correct enclosing
%   atom number.  The \semtex@currentatom check is the in-atom
%   sentinel only; its value is not written.
\def\semtex@writeatomref#1{%
  \ifx\semtex@currentatom\@empty\else
    \if@filesw
      \protected@write\@auxout{}{%
        \string\semtex@atomref
          {\theatom}{#1}%
      }%
    \fi
  \fi
}

% \semtex@installatomrefpatch
%   Install all three patch sites.  Called from the
%   begindocument/before hook (Section 8a.7), AFTER
%   hyperref/cleveref have finished wrapping their respective
%   dispatchers.  Patching at this point wraps the OUTERMOST
%   live definition, preserving every prior hook (hyperlink
%   emission, cref formatting).
\def\semtex@installatomrefpatch{%
  %% ---- Patch 1: kernel \@setref ----
  %% Covers \ref, \eqref, \pageref (via \@pagesetref
  %% delegation), \vref, \Vref, \vpageref, \nameref.
  \let\semtex@orig@setref\@setref
  \def\@setref##1##2##3{%
    \semtex@orig@setref{##1}{##2}{##3}%
    \semtex@writeatomref{##3}%
  }%
  %% ---- Patch 2: cleveref \cref@getlabel ----
  %% Covers every cleveref family command.
  \@ifpackageloaded{cleveref}{%
    \let\semtex@orig@crefgetlabel\cref@getlabel
    \def\cref@getlabel##1##2{%
      \semtex@orig@crefgetlabel{##1}{##2}%
      \semtex@writeatomref{##1}%
    }%
  }{}%
  %% ---- Patch 3: hyperref \HyRef@autosetref / \HyRef@@StarSetRef ----
  %% \HyRef@autosetref covers \autoref.
  %% \HyRef@@StarSetRef covers \ref* and \Ref.
  \@ifpackageloaded{hyperref}{%
    \@ifundefined{HyRef@autosetref}{}{%
      \let\semtex@orig@HyRefautosetref\HyRef@autosetref
      \def\HyRef@autosetref##1##2##3{%
        \semtex@orig@HyRefautosetref{##1}{##2}{##3}%
        \semtex@writeatomref{##2}%
      }%
    }%
    \@ifundefined{HyRef@@StarSetRef}{}{%
      \let\semtex@orig@HyRefStarSetRef\HyRef@@StarSetRef
      \def\HyRef@@StarSetRef##1##2##3{%
        \semtex@orig@HyRefStarSetRef{##1}{##2}{##3}%
        \semtex@writeatomref{##2}%
      }%
    }%
  }{}%
}

%% --- Section 8a.1: Defer queue (csname linked list) ---
%% Per REVIEW_C finding #2, the toks-register pattern from dpmac
%% is O(N^2) at 15k refs; replaced with a csname linked list
%% keyed by a monotonic \semtex@brid counter.

\newcount\semtex@brid
\semtex@brid=0\relax

% \semtex@recordbr{src}{tgt}
%   Enqueue a processbackref call.  O(1) per append.
\def\semtex@recordbr#1#2{%
  \global\advance\semtex@brid by 1\relax
  \expandafter\xdef
    \csname semtex@brq@\the\semtex@brid\endcsname{%
      \noexpand\semtex@processbr{#2}{#1}%
    }%
}

% \semtex@flushbrqueue
%   Walk the linked list once, O(N) total.  Called from the
%   begindocument/end hook (Section 8a.7).
\def\semtex@flushbrqueue{%
  \begingroup
    \count@=\z@
    \loop
      \ifnum\count@<\semtex@brid
        \advance\count@ by 1\relax
        \csname semtex@brq@\the\count@\endcsname
        \global\expandafter\let
          \csname semtex@brq@\the\count@\endcsname\relax
    \repeat
  \endgroup
}

%% --- Section 8a.2: Active aux-record callback ---
%% The \providecommand no-op from Section 8a.0 is REPLACED by
%% this active definition at begindocument/before (Section
%% 8a.7), before LaTeX reads .aux in \begin{document}.  From
%% that point on, every \semtex@atomref{src}{tgt} that the .aux
%% read fires lands here and enqueues a processbackref call.
%%
%% Per REVIEW_C finding #4, guard on empty src (orphan refs
%% emitted between atoms).  Belt-and-braces: the \@setref patch
%% already skips the write when \semtex@currentatom is empty.

\def\semtex@atomref@active#1#2{%
  \edef\semtex@tmp@src{#1}%
  \ifx\semtex@tmp@src\@empty\else
    \semtex@recordbr{#1}{#2}%
  \fi
}

%% --- Section 8a.3: Per-target linked list, processbr, collapsebr ---
%% For each target atom we maintain:
%%   \semtex@brcount@<num>     -- count of appended refs
%%   \semtex@brnode@<num>@<k>  -- the k-th ref text
%% At typeset time the nodes are collapsed into the display
%% macro \semtex@br@<num>.  Per REVIEW_C finding #2 second half,
%% this turns O(degree^2) into O(degree).

% \semtex@processbr{tgt}{src}
%   #1 = target label key (display number via lblnum map)
%   #2 = source atom display number
\def\semtex@processbr#1#2{%
  \expandafter\ifx\csname semtex@lblnum@#1\endcsname\relax
    % Unknown target: silently drop.
  \else
    \edef\semtex@tmp@tgt{\csname semtex@lblnum@#1\endcsname}%
    \edef\semtex@tmp@src{#2}%
    % Self-ref guard (REVIEW_C finding #10).
    \ifx\semtex@tmp@src\semtex@tmp@tgt\else
      % Dedup against previous append for this target.
      \edef\semtex@tmp@last{%
        \csname semtex@brlast@\semtex@tmp@tgt\endcsname}%
      \ifx\semtex@tmp@last\semtex@tmp@src
        % Consecutive duplicate: skip.
      \else
        \global\expandafter\let
          \csname semtex@brlast@\semtex@tmp@tgt\endcsname
          \semtex@tmp@src
        % Append a new linked-list node.
        \expandafter\ifx
            \csname semtex@brcount@\semtex@tmp@tgt\endcsname\relax
          \global\expandafter\def
            \csname semtex@brcount@\semtex@tmp@tgt\endcsname{0}%
        \fi
        \edef\semtex@tmp@k{%
          \csname semtex@brcount@\semtex@tmp@tgt\endcsname}%
        \count@=\semtex@tmp@k\relax
        \advance\count@ by 1\relax
        \expandafter\xdef
          \csname semtex@brcount@\semtex@tmp@tgt\endcsname
          {\the\count@}%
        \expandafter\xdef
          \csname
            semtex@brnode@\semtex@tmp@tgt @\the\count@%
          \endcsname
          {#2}%
      \fi
    \fi
  \fi
}

% \semtex@collapsebr{targetnum}
%   Build a comma-joined display macro \semtex@br@<num> from
%   the per-target node csnames.  Called lazily the first time
%   \semtex@queuebackref looks up <num>.
\def\semtex@collapsebr#1{%
  \expandafter\ifx\csname semtex@brcount@#1\endcsname\relax
    % No refs to this target.
    \global\expandafter\let
      \csname semtex@br@#1\endcsname\@empty
  \else
    \begingroup
      \edef\semtex@tmp@n{\csname semtex@brcount@#1\endcsname}%
      \def\semtex@tmp@acc{}%
      \count@=\z@
      \loop
        \ifnum\count@<\semtex@tmp@n
          \advance\count@ by 1\relax
          \edef\semtex@tmp@node{%
            \csname semtex@brnode@#1@\the\count@\endcsname}%
          \ifx\semtex@tmp@acc\@empty
            \edef\semtex@tmp@acc{\semtex@tmp@node}%
          \else
            \edef\semtex@tmp@acc{%
              \semtex@tmp@acc, \semtex@tmp@node}%
          \fi
      \repeat
      \global\expandafter\let
        \csname semtex@br@#1\endcsname\semtex@tmp@acc
    \endgroup
  \fi
}

%% --- Section 8a.4: \newlabel / \newlabelxx override + extractor ---
%% Per REVIEW_C finding #1, use a \@secondoftwo-style grab of
%% the first braced subgroup.  Per REVIEW_C finding #3, install
%% at begindocument/before so hyperref's pre-2023 aux-injection
%% block does not clobber it.  Also override \newlabelxx for
%% the pre-2023 hyperref pathway.

% \semtex@grabfirst#1#2\@nil -> #1
%   Grab the first brace group of a delimited argument.
\def\semtex@grabfirst#1#2\@nil{#1}

% Flag used only inside \semtex@ifcrefkey.
\newif\ifsemtex@iscref

\def\semtex@installnewlabel{%
  \let\semtex@orig@newlabel\newlabel
  \def\newlabel##1##2{%
    \semtex@orig@newlabel{##1}{##2}%
    \semtex@extractlblnum{##1}{##2}%
  }%
  % Pre-2023 hyperref path: \newlabelxx has 6 args.  Hyperref
  % installs it in \AtBeginDocument and it races with our
  % override, so we override it too.
  \@ifundefined{newlabelxx}{}{%
    \let\semtex@orig@newlabelxx\newlabelxx
    \def\newlabelxx##1##2##3##4##5##6{%
      \semtex@orig@newlabelxx
        {##1}{##2}{##3}{##4}{##5}{##6}%
      % ##2 is already the display number for the 6-arg form.
      \expandafter\gdef
        \csname semtex@lblnum@##1\endcsname{##2}%
    }%
  }%
}

% \semtex@extractlblnum{key}{value}
%   value is the raw 2nd arg of \newlabel; after TeX brace-
%   stripping it is "{num}{page}{...}{...}{...}".  Grab the
%   first brace group and stash it under the key.  Skip keys
%   that END in @cref (cleveref internal records).
\def\semtex@extractlblnum#1#2{%
  \semtex@ifcrefkey{#1}{%
    % @cref-suffixed: skip silently.
  }{%
    \expandafter\semtex@extractlblnum@ii
      \expandafter{\semtex@grabfirst#2\@nil}{#1}%
  }%
}
\def\semtex@extractlblnum@ii#1#2{%
  \expandafter\gdef\csname semtex@lblnum@#2\endcsname{#1}%
}

% Sentinel used by \semtex@ifcrefkey.
\def\semtex@ifcrefsentinel{@cref}

% \semtex@ifcrefkey{key}{then}{else}
%   True iff the label key ENDS in "@cref".  Per REVIEW_D
%   finding #4, matching "any key containing @cref" incorrectly
%   dropped keys like "lemma@crefnum".  The delimited-arg probe
%   splits "<key>@cref\@nil" on the FIRST occurrence of "@cref";
%   the key ends in @cref iff the tail is exactly "@cref".
\def\semtex@ifcrefkey#1{%
  \semtex@iscreffalse
  \def\semtex@ifcrefkey@probe##1@cref##2\@nil{%
    \def\semtex@tmp@b{##2}%
    \ifx\semtex@tmp@b\@empty
      % No @cref in the key at all; the probe's own trailing
      % @cref absorbed the split -> NOT a cref key.
    \else
      \ifx\semtex@tmp@b\semtex@ifcrefsentinel
        \semtex@iscreftrue
      \fi
    \fi
  }%
  \semtex@ifcrefkey@probe#1@cref\@nil
  \ifsemtex@iscref
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}

%% --- Section 8a.7: Hook installation ---
%% Per REVIEW_D finding #2, semtex-owned labels on
%% begindocument/before get EXPLICIT relative ordering rather
%% than both claiming "before *".  The \DeclareHookRule below
%% pins \semtex/backref/install to run before hyperref.

% Install the three \@setref-family patches AND the \newlabel
% override AND the active \semtex@atomref callback at
% begindocument/before.  All three belong together because
% they co-depend on being in place before the .aux read during
% \begin{document}.
\AddToHook{begindocument/before}[semtex/backref/install]{%
  \semtex@installatomrefpatch
  \semtex@installnewlabel
  % Swap the providecommand no-op for the active callback.
  \let\semtex@atomref\semtex@atomref@active
}

% Flush the queue AFTER aux has been read.  The aux read
% happens during the kernel's \document macro before any
% \AtBeginDocument hook fires, so begindocument/end is a safe
% point.
\AddToHook{begindocument/end}[semtex/backref/flush]{%
  \semtex@flushbrqueue
}

% External ordering: run before hyperref wraps \@setref a
% second time in its \AtBeginDocument-equivalent hooks.
\DeclareHookRule{begindocument/before}%
  {semtex/backref/install}{before}{hyperref}

% Internal dependency: sbl open sees the backref install.
\DeclareHookRule{begindocument/before}{semtex/sbl/open}%
                {after}{semtex/backref/install}

%% ===================================================================
%% Section 8: Back-reference emission
%% ===================================================================

% \semtex@queuebackref{atomnumber}
%   Look up back-refs for the given atom and queue for emission.
%   Lazily materialises \semtex@br@#1 via \semtex@collapsebr
%   (§8a.3), which walks the per-target linked-list nodes built
%   from \semtex@atomref aux records.  Collapse is idempotent, so
%   calling it unconditionally is fine.
\newcommand*{\semtex@queuebackref}[1]{%
  \ifbool{semtex@backrefs}{%
    \semtex@pendingbr={}%
    \semtex@collapsebr{#1}%
    % After collapse, semtex@br@#1 is either \@empty (no refs)
    % or a comma-joined ref list.  \@ifundefined cannot
    % distinguish \@empty from real data (collapsebr always
    % defines the csname), so use \ifx against \@empty instead.
    \expandafter\ifx\csname semtex@br@#1\endcsname\@empty
      % No refs to this target (collapsed to \@empty): skip.
    \else
      \ifbool{semtex@appendix}{}{%
        % Inline mode: store ref list for flush.
        \semtex@pendingbr=\expandafter{%
          \csname semtex@br@#1\endcsname}%
      }%
    \fi
  }{}%
}

% \semtex@flushbackref
%   Emit the pending back-reference and clear it.
\newcommand*{\semtex@flushbackref}{%
  \ifbool{semtex@backrefs}{%
    \ifbool{semtex@appendix}{}{%
      \edef\semtex@tmp{\the\semtex@pendingbr}%
      \ifx\semtex@tmp\@empty\else
        \semtex@renderinline{\semtex@tmp}%
      \fi
    }%
    \semtex@pendingbr={}%
  }{}%
}

% \semtex@renderinline{reflist}
%   Render "Used in X, Y." at the end of the current atom.
%   Redefined at \begin{document} when hyperref is loaded.
\newcommand*{\semtex@renderinline}[1]{%
  \par\nopagebreak
  \begingroup
    \small\sffamily
    \rightline{Used in #1.}%
  \endgroup
}

% \semtex@installparendhook
%   Install the para/end hook for flushing back-refs.
%   Per §8a.5, clears \semtex@currentatom after the flush so
%   that any \ref firing between paragraphs is not attributed to
%   the just-closed atom.
\newcommand*{\semtex@installparendhook}{%
  \AddToHook{para/end}{%
    \ifbool{semtex@tracked}{%
      \ifbool{semtex@intheorem}{}{%
        \semtex@flushbackref
        \let\semtex@currentatom\@empty
      }%
    }{}%
  }%
}

%% ===================================================================
%% Section 9a: Semantic sidecar (.sbl) writer
%% ===================================================================
%%
%% Write-only sidecar file for Layer 2 (semantic CLI).  The .sty
%% never reads .sbl — it is strictly one-way output.  Record format
%% is line-oriented: one \semtex@sbl@* control sequence per line
%% with fixed-arity brace-delimited arguments (no kv blobs).
%%

% \semtex@sblwrite{text}
%   Guarded write to the .sbl stream.  No-op when the stream
%   is not open (e.g. \if@filesw is false).
\newcommand*{\semtex@sblwrite}[1]{%
  \ifbool{semtex@sblopen}{%
    \immediate\write\semtex@sblout{#1}%
  }{}%
}

% \semtex@sblwrite@atom{text}
%   Atom-scoped guard: drops the write when not inside a tracked
%   atom (\semtex@currentatom is empty).
\newcommand*{\semtex@sblwrite@atom}[1]{%
  \ifx\semtex@currentatom\@empty\else
    \semtex@sblwrite{#1}%
  \fi
}

%% --- Section 9a open hook (begindocument/before) ---
%% Per REVIEW_C finding #5, the stream opens at begindocument/before
%% (before any \AtBeginDocument hook), so atoms emitted from user
%% hooks are never silently dropped.
\AddToHook{begindocument/before}[semtex/sbl/open]{%
  \if@filesw
    \newwrite\semtex@sblout
    \immediate\openout\semtex@sblout=\jobname.sbl\relax
    \global\booltrue{semtex@sblopen}%
    \immediate\write\semtex@sblout{%
      \string\semtex@sbl@version{1}}%
    \immediate\write\semtex@sblout{%
      \string\semtex@sbl@source{\jobname.tex}}%
  \fi
}

%% --- Section 9a close hook (\AtEndDocument) ---
%% Write the \semtex@sbl@end{OK} sentinel and close the stream.
%% Per REVIEW_C finding #7, the sentinel's presence is the CLI's
%% test for "complete file".
\AtEndDocument{%
  \ifbool{semtex@sblopen}{%
    \immediate\write\semtex@sblout{%
      \string\semtex@sbl@end{OK}}%
    \immediate\closeout\semtex@sblout
    \global\boolfalse{semtex@sblopen}%
  }{}%
}

%% --- Section 9a label wrap (cleveref-aware) ---
%% Installed at begindocument/before so we capture \label BEFORE
%% cleveref's \AtBeginDocument wrapper installs around us (see
%% DESIGN.md §9a "Label wrap" double-wrap explanation).
\AddToHook{begindocument/before}[semtex/sbl/labelwrap]{%
  \let\semtex@orig@label\label
  \@ifpackageloaded{cleveref}{%
    %% cleveref path: \label[type]{key}, optional arg.
    \def\label{%
      \@ifnextchar[%]
        \semtex@sbl@label@withopt
        \semtex@sbl@label@noopt
    }%
  }{%
    %% No cleveref: \label{key} only.
    \def\label#1{%
      \semtex@sblwrite@atom{%
        \string\semtex@sbl@label
          {\theatom}{#1}}%
      \semtex@orig@label{#1}%
    }%
  }%
}
\def\semtex@sbl@label@withopt[#1]#2{%
  \semtex@sblwrite@atom{%
    \string\semtex@sbl@label
      {\theatom}{#2}}%
  \semtex@orig@label[#1]{#2}%
}
\def\semtex@sbl@label@noopt#1{%
  \semtex@sblwrite@atom{%
    \string\semtex@sbl@label
      {\theatom}{#1}}%
  \semtex@orig@label{#1}%
}

%% ===================================================================
%% Section 10: User-facing API
%% ===================================================================

% \semtextrack{env1,env2,...}
%   Post-hoc alias theorem counters to atom counter and install
%   all hooks.  Must be called AFTER all \newtheorem declarations.
%   env1, env2, ... -- comma-separated environment names to track
\newcommand*{\semtextrack}[1]{%
  \booltrue{semtex@tracked}%
  \semtex@setupcounter
  % Hook each listed environment and its starred variant.
  \@for\semtex@tmp:=#1\do{%
    \ifx\semtex@tmp\@empty\else
      \semtex@hooktheorem{\semtex@tmp}%
      % Auto-register starred variant (amsthm creates foo*).
      \edef\semtex@starred{\semtex@tmp*}%
      \expandafter\@ifundefined\expandafter{%
        \semtex@starred
      }{}{%
        \expandafter\semtex@hooktheorem
          \expandafter{\semtex@starred}%
      }%
    \fi
  }%
  \semtex@hookproof
  % Equation sharing.
  \ifbool{semtex@eqshared}{%
    \expandafter\let\csname c@equation\endcsname\c@atom
  }{}%
  % Install suppression and paragraph hooks.
  \semtex@installsuppress
  \semtex@suppresssectioning
  \semtex@suppresscommands
  \semtex@installparahook
  \semtex@installparendhook
}

% \semtextag{kind}{value}
%   Emit a semantic tag record to the .sbl sidecar, scoped to the
%   current atom.  No visible typesetting effect.  Ignored outside
%   a tracked atom.
%   kind  -- tag category (e.g. uid, introduces, type)
%   value -- tag payload (free-form UTF-8)
\newcommand*{\semtextag}[2]{%
  \semtex@sblwrite@atom{%
    \string\semtex@sbl@tag
    {\theatom}{#1}{#2}}%
}

% \semtexsuppress{envname}
%   Register a user environment for paragraph-number suppression.
%   envname -- environment name to suppress
\newcommand*{\semtexsuppress}[1]{%
  \semtex@suppressenv{#1}%
}

% \semtexsuppresscmd{\command}
%   Register a user command for paragraph-number suppression.
%   \command -- command to patch
\newcommand*{\semtexsuppresscmd}[1]{%
  \semtex@suppresscmd{#1}%
}

% \semtexappendix
%   Typeset the dependency index (appendix mode only).
%   Walks \semtex@atomlist (populated at each atom site) and
%   emits an entry for every atom that has at least one
%   back-reference.
\newcommand*{\semtexappendix}{%
  \ifbool{semtex@appendix}{%
    \section*{Dependency Index}%
    \begingroup
      \small
      \def\do##1{%
        \semtex@appendix@emit##1%
      }%
      \semtex@atomlist
    \endgroup
  }{%
    \PackageWarning{semtex}{%
      \string\semtexappendix\space ignored: %
      backrefs mode is not 'appendix'}%
  }%
}

% \semtex@appendix@emit{num}{type}
%   Collapse back-refs for atom num and emit an appendix entry
%   if any back-references exist.
\def\semtex@appendix@emit#1#2{%
  \semtex@collapsebr{#1}%
  \expandafter\ifx\csname semtex@br@#1\endcsname\@empty\else
    \semtex@appendixentry{#1}{#2}{%
      \csname semtex@br@#1\endcsname}%
  \fi
}

% Appendix rendering helpers.
% \semtex@appendixsection{number}{title}
\newcommand*{\semtex@appendixsection}[2]{%
  \par\medskip\noindent
  \textbf{#1\quad #2}\par
}

% \semtex@appendixentry{atomnumber}{atomname}{reflist}
\newcommand*{\semtex@appendixentry}[3]{%
  \par\noindent
  \hspace{1.5em}%
  #1\quad #2\quad\dotfill\quad
  \begin{minipage}[t]{0.45\linewidth}%
    \raggedright #3%
  \end{minipage}%
}

%% ===================================================================
%% Section 11: Compatibility guards
%% ===================================================================

% Guard: require LaTeX2e kernel with hook management.
\@ifundefined{AddToHook}{%
  \PackageError{semtex}{%
    LaTeX kernel too old (need 2021+)}{%
    semtex requires \string\AddToHook\space
    (TeX Live 2021 or later).%
  }%
}{}

% Hyperref detection: when loaded, the CLI can emit \hyperref
% commands in .sbr reflist fields that render as clickable links.
% The renderer is redefined to use \sffamily consistently.
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \PackageInfo{semtex}{hyperref detected, enabling links}%
  }{}%
}

\endinput
