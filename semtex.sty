%% --- Section 8a.0: Reference interception (three-site design) ---
%% Per REVIEW_E finding #2 (BLOCKER), the single-\@setref patch
%% covers only \ref/\eqref/\pageref/\vref/\nameref.  cleveref's
%% \cref@getlabel, hyperref's \HyRef@autosetref (\autoref), and
%% hyperref's \HyRef@@StarSetRef (\ref*/\Ref) all bypass \@setref.
%% This subsection installs THREE patch sites.  Per REVIEW_E #16,
%% \hyperref[]{} is deliberately uncovered (manual link, not a
%% cross-reference).

% Pass-1 safety: \semtex@atomref must be defined to SOMETHING at
% package-load time so that if a stale .aux still references it
% (or a user script injects a record), LaTeX's aux read does not
% error.  A \providecommand no-op suits.
\providecommand*{\semtex@atomref}[2]{}

% Pass-1 safety for concept-tracking aux records (§9a User API).
% Active definitions installed at begindocument/before
% (§8a.9 concept resolution).
\providecommand*{\semtex@concept}[2]{}
\providecommand*{\semtex@conceptref}[2]{}

% Concept pending-list: deferred resolveconcept calls for
% forward refs whose def record has not yet been read.
% Flushed at begindocument/end after the full aux read.
\gdef\semtex@conceptpending{}

% Concept name list: each concept whose \semtex@emit@use
% fires at least once appends \do{name} here.  The
% \semtex@conceptwarnscan at \AtEndDocument walks this list
% to detect concepts with uses but no def site.
\def\semtex@conceptnames{}

% \semtex@writeatomref{target}
%   Shared aux-write helper called by all patch sites.  Guards
%   on \semtex@currentatom (in-atom sentinel: empty = not inside
%   a tracked atom, so no write) and on \if@filesw so --draftmode
%   / -no-aux compiles work.  The src field is read from \theatom
%   at write time per DESIGN.md §8a.5.0: at hook entry \theatom
%   is pre-\refstepcounter (wrong number); at \ref time the
%   refstepcounter has fired and \theatom is the correct enclosing
%   atom number.  The \semtex@currentatom check is the in-atom
%   sentinel only; its value is not written.
\def\semtex@writeatomref#1{%
  \ifx\semtex@currentatom\@empty\else
    \if@filesw
      \protected@write\@auxout{}{%
        \string\semtex@atomref
          {\theatom}{#1}%
      }%
    \fi
  \fi
}

% \semtex@installatomrefpatch
%   Install all three patch sites.  Called from the
%   begindocument/before hook (Section 8a.7), AFTER
%   hyperref/cleveref have finished wrapping their respective
%   dispatchers.  Patching at this point wraps the OUTERMOST
%   live definition, preserving every prior hook (hyperlink
%   emission, cref formatting).
\def\semtex@installatomrefpatch{%
  %% ---- Patch 1: kernel \@setref ----
  %% Covers \ref, \eqref, \pageref (via \@pagesetref
  %% delegation), \vref, \Vref, \vpageref, \nameref.
  \let\semtex@orig@setref\@setref
  \def\@setref##1##2##3{%
    \semtex@orig@setref{##1}{##2}{##3}%
    \semtex@writeatomref{##3}%
  }%
  %% ---- Patch 2: cleveref \cref@getlabel ----
  %% Covers every cleveref family command.
  \@ifpackageloaded{cleveref}{%
    \let\semtex@orig@crefgetlabel\cref@getlabel
    \def\cref@getlabel##1##2{%
      \semtex@orig@crefgetlabel{##1}{##2}%
      \semtex@writeatomref{##1}%
    }%
  }{}%
  %% ---- Patch 3: hyperref \HyRef@autosetref / \HyRef@@StarSetRef ----
  %% \HyRef@autosetref covers \autoref.
  %% \HyRef@@StarSetRef covers \ref* and \Ref.
  \@ifpackageloaded{hyperref}{%
    \@ifundefined{HyRef@autosetref}{}{%
      \let\semtex@orig@HyRefautosetref\HyRef@autosetref
      \def\HyRef@autosetref##1##2##3{%
        \semtex@orig@HyRefautosetref{##1}{##2}{##3}%
        \semtex@writeatomref{##2}%
      }%
    }%
    \@ifundefined{HyRef@@StarSetRef}{}{%
      \let\semtex@orig@HyRefStarSetRef\HyRef@@StarSetRef
      \def\HyRef@@StarSetRef##1##2##3{%
        \semtex@orig@HyRefStarSetRef{##1}{##2}{##3}%
        \semtex@writeatomref{##2}%
      }%
    }%
  }{}%
}

%% --- Section 8a.1: Defer queue (csname linked list) ---
%% Per REVIEW_C finding #2, the toks-register pattern from dpmac
%% is O(N^2) at 15k refs; replaced with a csname linked list
%% keyed by a monotonic \semtex@brid counter.

\newcount\semtex@brid
\semtex@brid=0\relax

% \semtex@recordbr{src}{tgt}
%   Enqueue a processbackref call.  O(1) per append.
\def\semtex@recordbr#1#2{%
  \global\advance\semtex@brid by 1\relax
  \expandafter\xdef
    \csname semtex@brq@\the\semtex@brid\endcsname{%
      \noexpand\semtex@processbr{#2}{#1}%
    }%
}

% \semtex@flushbrqueue
%   Walk the linked list once, O(N) total.  Called from the
%   begindocument/end hook (Section 8a.7).
\def\semtex@flushbrqueue{%
  \begingroup
    \count@=\z@
    \loop
      \ifnum\count@<\semtex@brid
        \advance\count@ by 1\relax
        \csname semtex@brq@\the\count@\endcsname
        \global\expandafter\let
          \csname semtex@brq@\the\count@\endcsname\relax
    \repeat
  \endgroup
}

%% --- Section 8a.2: Active aux-record callback ---
%% The \providecommand no-op from Section 8a.0 is REPLACED by
%% this active definition at begindocument/before (Section
%% 8a.7), before LaTeX reads .aux in \begin{document}.  From
%% that point on, every \semtex@atomref{src}{tgt} that the .aux
%% read fires lands here and enqueues a processbackref call.
%%
%% Per REVIEW_C finding #4, guard on empty src (orphan refs
%% emitted between atoms).  Belt-and-braces: the \@setref patch
%% already skips the write when \semtex@currentatom is empty.

\def\semtex@atomref@active#1#2{%
  \edef\semtex@tmp@src{#1}%
  \ifx\semtex@tmp@src\@empty\else
    \semtex@recordbr{#1}{#2}%
  \fi
}

%% --- Section 8a.3: Per-target linked list, processbr, collapsebr ---
%% For each target atom we maintain:
%%   \semtex@brcount@<num>     -- count of appended refs
%%   \semtex@brnode@<num>@<k>  -- the k-th ref text
%% At typeset time the nodes are collapsed into the display
%% macro \semtex@br@<num>.  Per REVIEW_C finding #2 second half,
%% this turns O(degree^2) into O(degree).

% \semtex@processbr{tgt}{src}
%   #1 = target label key (display number via lblnum map)
%   #2 = source atom display number
\def\semtex@processbr#1#2{%
  \expandafter\ifx\csname semtex@lblnum@#1\endcsname\relax
    % Unknown target: silently drop.
  \else
    \edef\semtex@tmp@tgt{\csname semtex@lblnum@#1\endcsname}%
    \edef\semtex@tmp@src{#2}%
    % Self-ref guard (REVIEW_C finding #10).
    \ifx\semtex@tmp@src\semtex@tmp@tgt\else
      % Dedup against previous append for this target.
      \edef\semtex@tmp@last{%
        \csname semtex@brlast@\semtex@tmp@tgt\endcsname}%
      \ifx\semtex@tmp@last\semtex@tmp@src
        % Consecutive duplicate: skip.
      \else
        \global\expandafter\let
          \csname semtex@brlast@\semtex@tmp@tgt\endcsname
          \semtex@tmp@src
        % Append a new linked-list node.
        \expandafter\ifx
            \csname semtex@brcount@\semtex@tmp@tgt\endcsname\relax
          \global\expandafter\def
            \csname semtex@brcount@\semtex@tmp@tgt\endcsname{0}%
        \fi
        \edef\semtex@tmp@k{%
          \csname semtex@brcount@\semtex@tmp@tgt\endcsname}%
        \count@=\semtex@tmp@k\relax
        \advance\count@ by 1\relax
        \expandafter\xdef
          \csname semtex@brcount@\semtex@tmp@tgt\endcsname
          {\the\count@}%
        \expandafter\xdef
          \csname
            semtex@brnode@\semtex@tmp@tgt @\the\count@%
          \endcsname
          {#2}%
      \fi
    \fi
  \fi
}

% \semtex@appendbr{tgtnum}{srcnum}
%   Append a backref edge directly using display numbers
%   (no lblnum lookup).  Used by concept resolution where
%   both source and target atom numbers are already known.
%   Includes self-ref and consecutive-dedup guards.
\def\semtex@appendbr#1#2{%
  \edef\semtex@tmp@tgt{#1}%
  \edef\semtex@tmp@src{#2}%
  % Self-ref guard.
  \ifx\semtex@tmp@src\semtex@tmp@tgt\else
    % Dedup against previous append for this target.
    \edef\semtex@tmp@last{%
      \csname semtex@brlast@\semtex@tmp@tgt\endcsname}%
    \ifx\semtex@tmp@last\semtex@tmp@src
      % Consecutive duplicate: skip.
    \else
      \global\expandafter\let
        \csname semtex@brlast@\semtex@tmp@tgt\endcsname
        \semtex@tmp@src
      \expandafter\ifx
          \csname semtex@brcount@\semtex@tmp@tgt%
          \endcsname\relax
        \global\expandafter\def
          \csname semtex@brcount@\semtex@tmp@tgt%
          \endcsname{0}%
      \fi
      \edef\semtex@tmp@k{%
        \csname semtex@brcount@\semtex@tmp@tgt%
        \endcsname}%
      \count@=\semtex@tmp@k\relax
      \advance\count@ by 1\relax
      \expandafter\xdef
        \csname semtex@brcount@\semtex@tmp@tgt%
        \endcsname{\the\count@}%
      \expandafter\xdef
        \csname
          semtex@brnode@\semtex@tmp@tgt @\the\count@%
        \endcsname
        {#2}%
    \fi
  \fi
}

% \semtex@collapsebr{targetnum}
%   Build a comma-joined display macro \semtex@br@<num> from
%   the per-target node csnames.  Called lazily the first time
%   \semtex@queuebackref looks up <num>.
\def\semtex@collapsebr#1{%
  \expandafter\ifx\csname semtex@brcount@#1\endcsname\relax
    % No refs to this target.
    \global\expandafter\let
      \csname semtex@br@#1\endcsname\@empty
  \else
    \begingroup
      \edef\semtex@tmp@n{\csname semtex@brcount@#1\endcsname}%
      \def\semtex@tmp@acc{}%
      \count@=\z@
      \loop
        \ifnum\count@<\semtex@tmp@n
          \advance\count@ by 1\relax
          \edef\semtex@tmp@node{%
            \csname semtex@brnode@#1@\the\count@\endcsname}%
          \ifx\semtex@tmp@acc\@empty
            \edef\semtex@tmp@acc{%
              \noexpand\semtex@brhyper{\semtex@tmp@node}}%
          \else
            \edef\semtex@tmp@acc{%
              \unexpanded\expandafter{\semtex@tmp@acc}, %
              \noexpand\semtex@brhyper{\semtex@tmp@node}}%
          \fi
      \repeat
      \global\expandafter\let
        \csname semtex@br@#1\endcsname\semtex@tmp@acc
    \endgroup
  \fi
}

%% --- Section 8a.4: \newlabel / \newlabelxx override + extractor ---
%% Per REVIEW_C finding #1, use a \@secondoftwo-style grab of
%% the first braced subgroup.  Per REVIEW_C finding #3, install
%% at begindocument/before so hyperref's pre-2023 aux-injection
%% block does not clobber it.  Also override \newlabelxx for
%% the pre-2023 hyperref pathway.

% \semtex@grabfirst#1#2\@nil -> #1
%   Grab the first brace group of a delimited argument.
\def\semtex@grabfirst#1#2\@nil{#1}

% \semtex@grab4th#1#2#3#4#5\@nil -> #4
%   Grab the 4th brace group.  Used to extract hyperref's
%   anchor name from \newlabel's value ({num}{page}{title}{anchor}{}).
\def\semtex@grab4th#1#2#3#4#5\@nil{#4}

% \semtex@extractanchor{key}{value}
%   Extract hyperref's anchor (4th field of \newlabel value)
%   and store a reverse mapping: atom number -> anchor name.
%   No-ops for @cref keys or when value has fewer than 4 fields.
\def\semtex@extractanchor#1#2{%
  \semtex@ifcrefkey{#1}{}{%
    \semtex@ifdatakey{#1}{}{%
      \expandafter\semtex@extractanchor@ii
        \expandafter{\semtex@grab4th#2{}{}{}{}\@nil}{#1}%
    }%
  }%
}
\def\semtex@extractanchor@ii#1#2{%
  % #1 = anchor (4th field or empty), #2 = label key
  \def\semtex@tmp{#1}%
  \ifx\semtex@tmp\@empty\else
    \expandafter\ifx\csname semtex@lblnum@#2\endcsname\relax\else
      % Resolve atom number first, then define the anchor mapping.
      % Use \protected@edef to survive non-expandable tokens in
      % unusual \newlabel values (e.g. thm-restate counter saves).
      \protected@edef\semtex@tmp@num{%
        \csname semtex@lblnum@#2\endcsname}%
      \expandafter\xdef
        \csname semtex@anchor@\semtex@tmp@num\endcsname{#1}%
    \fi
  \fi
}
% \semtex@ifdatakey{key}{then}{else}
%   True iff the label key ends in "@data" (thm-restate internal).
%   These contain \setcounter calls, not display numbers.
\def\semtex@ifdatakey#1{%
  \semtex@iscreffalse
  \def\semtex@ifdatakey@probe##1@data##2\@nil{%
    \def\semtex@tmp@b{##2}%
    \ifx\semtex@tmp@b\@empty\else
      \def\semtex@tmp@c{@data}%
      \ifx\semtex@tmp@b\semtex@tmp@c
        \semtex@iscreftrue
      \fi
    \fi
  }%
  \semtex@ifdatakey@probe#1@data\@nil
  \ifsemtex@iscref
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}

% Flag used only inside \semtex@ifcrefkey.
\newif\ifsemtex@iscref

\def\semtex@installnewlabel{%
  \let\semtex@orig@newlabel\newlabel
  \def\newlabel##1##2{%
    \semtex@orig@newlabel{##1}{##2}%
    \semtex@extractlblnum{##1}{##2}%
    \semtex@extractanchor{##1}{##2}%
  }%
  % Pre-2023 hyperref path: \newlabelxx has 6 args.  Hyperref
  % installs it in \AtBeginDocument and it races with our
  % override, so we override it too.
  \@ifundefined{newlabelxx}{}{%
    \let\semtex@orig@newlabelxx\newlabelxx
    \def\newlabelxx##1##2##3##4##5##6{%
      \semtex@orig@newlabelxx
        {##1}{##2}{##3}{##4}{##5}{##6}%
      % ##2 is already the display number for the 6-arg form.
      \expandafter\gdef
        \csname semtex@lblnum@##1\endcsname{##2}%
      % ##5 is the hyperref anchor name; store reverse mapping.
      \semtex@ifcrefkey{##1}{}{%
        \def\semtex@tmp{##5}%
        \ifx\semtex@tmp\@empty\else
          \expandafter\xdef
            \csname semtex@anchor@##2\endcsname{##5}%
        \fi
      }%
    }%
  }%
}

% \semtex@extractlblnum{key}{value}
%   value is the raw 2nd arg of \newlabel; after TeX brace-
%   stripping it is "{num}{page}{...}{...}{...}".  Grab the
%   first brace group and stash it under the key.  Skip keys
%   that END in @cref (cleveref internal records).
\def\semtex@extractlblnum#1#2{%
  \semtex@ifcrefkey{#1}{%
    % @cref-suffixed: skip silently.
  }{%
    \expandafter\semtex@extractlblnum@ii
      \expandafter{\semtex@grabfirst#2\@nil}{#1}%
  }%
}
\def\semtex@extractlblnum@ii#1#2{%
  \expandafter\gdef\csname semtex@lblnum@#2\endcsname{#1}%
}

% Sentinel used by \semtex@ifcrefkey.
\def\semtex@ifcrefsentinel{@cref}

% \semtex@ifcrefkey{key}{then}{else}
%   True iff the label key ENDS in "@cref".  Per REVIEW_D
%   finding #4, matching "any key containing @cref" incorrectly
%   dropped keys like "lemma@crefnum".  The delimited-arg probe
%   splits "<key>@cref\@nil" on the FIRST occurrence of "@cref";
%   the key ends in @cref iff the tail is exactly "@cref".
\def\semtex@ifcrefkey#1{%
  \semtex@iscreffalse
  \def\semtex@ifcrefkey@probe##1@cref##2\@nil{%
    \def\semtex@tmp@b{##2}%
    \ifx\semtex@tmp@b\@empty
      % No @cref in the key at all; the probe's own trailing
      % @cref absorbed the split -> NOT a cref key.
    \else
      \ifx\semtex@tmp@b\semtex@ifcrefsentinel
        \semtex@iscreftrue
      \fi
    \fi
  }%
  \semtex@ifcrefkey@probe#1@cref\@nil
  \ifsemtex@iscref
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}

%% --- Section 8a.7: Hook installation ---
%% Per REVIEW_D finding #2, semtex-owned labels on
%% begindocument/before get EXPLICIT relative ordering rather
%% than both claiming "before *".  The \DeclareHookRule below
%% pins \semtex/backref/install to run before hyperref.

% Install the three \@setref-family patches AND the \newlabel
% override AND the active \semtex@atomref callback at
% begindocument/before.  All three belong together because
% they co-depend on being in place before the .aux read during
% \begin{document}.
\AddToHook{begindocument/before}[semtex/backref/install]{%
  \semtex@installatomrefpatch
  \semtex@installnewlabel
  % Swap the providecommand no-op for the active callback.
  \let\semtex@atomref\semtex@atomref@active
}

%% --- Section 8a.9: Concept-aware forward-reference resolution ---
%% Active callbacks for \semtex@concept and \semtex@conceptref.
%% Defined here (at package-load time, under \makeatletter);
%% swapped in at begindocument/before by \let, following the
%% same pattern as \semtex@atomref@active.

% \semtex@concept@active{name}{atomnum}
%   Populate the concept def-site map.  Per J3, silently
%   overwrite on duplicate aux records (stale prior-run).
\def\semtex@concept@active#1#2{%
  \expandafter\gdef
    \csname semtex@conceptdef@#1\endcsname{#2}%
}

% \semtex@conceptref@active{srcatom}{conceptname}
%   If the def site is already in the concept map, resolve
%   immediately; otherwise defer to \semtex@conceptpending
%   for retry after the full aux read completes.
\def\semtex@conceptref@active#1#2{%
  \@ifundefined{semtex@conceptdef@#2}%
    {\g@addto@macro\semtex@conceptpending{%
       \semtex@resolveconcept{#1}{#2}}}%
    {\semtex@resolveconcept{#1}{#2}}%
}

% \semtex@resolveconcept{srcatom}{conceptname}
%   Look up the def atom for the named concept and feed the
%   resolved edge directly into the per-target node list via
%   \semtex@appendbr (bypasses the label lookup in processbr,
%   since concept edges carry raw atom display numbers).
%   If the concept has no def site (semtex@conceptdef@<name>
%   undefined), silently no-op — the missing-def warning
%   fires at \AtEndDocument via the concept name scan.
\def\semtex@resolveconcept#1#2{%
  \@ifundefined{semtex@conceptdef@#2}{}{%
    \edef\semtex@cr@tgt{%
      \csname semtex@conceptdef@#2\endcsname}%
    \edef\semtex@cr@act{%
      \noexpand\semtex@appendbr
        {\semtex@cr@tgt}{#1}}%
    \semtex@cr@act
  }%
}

% Swap the providecommand no-ops for the active callbacks
% at begindocument/before, before the .aux read.
\AddToHook{begindocument/before}[semtex/concept/install]{%
  \let\semtex@concept\semtex@concept@active
  \let\semtex@conceptref\semtex@conceptref@active
}

% Flush the backref queue AFTER aux has been read.  The aux
% read happens during the kernel's \document macro before any
% \AtBeginDocument hook fires, so begindocument/end is safe.
\AddToHook{begindocument/end}[semtex/backref/flush]{%
  \semtex@flushbrqueue
}

% Flush the concept pending list AFTER the backref queue
% flush.  Deferred \semtex@resolveconcept calls expand here;
% the concept map is now complete from the full aux read.
\AddToHook{begindocument/end}[semtex/concept/flush]{%
  \semtex@conceptpending
  \global\let\semtex@conceptpending\@empty
}

% External ordering: run before hyperref wraps \@setref a
% second time in its \AtBeginDocument-equivalent hooks.
\DeclareHookRule{begindocument/before}%
  {semtex/backref/install}{before}{hyperref}

% Internal dependency: sbl open sees the backref install.
\DeclareHookRule{begindocument/before}{semtex/sbl/open}%
                {after}{semtex/backref/install}

% Concept install fires AFTER backref install (needs
% \semtex@recordbr to be in place).
\DeclareHookRule{begindocument/before}%
  {semtex/concept/install}{after}{semtex/backref/install}

% Concept flush fires AFTER backref flush.  Concept edges
% use \semtex@appendbr (direct node-list append, no queue),
% so ordering with the queue flush is not critical.  The
% "after" ordering ensures the backref queue processes first
% and concept edges are appended on top.
\DeclareHookRule{begindocument/end}%
  {semtex/concept/flush}{after}{semtex/backref/flush}

%% ===================================================================
%% Section 8: Back-reference emission
%% ===================================================================

% \semtex@queuebackref{atomnumber}
%   Look up back-refs for the given atom and queue for emission.
%   Lazily materialises \semtex@br@#1 via \semtex@collapsebr
%   (§8a.3), which walks the per-target linked-list nodes built
%   from \semtex@atomref aux records.  Collapse is idempotent, so
%   calling it unconditionally is fine.
\newcommand*{\semtex@queuebackref}[1]{%
  \ifbool{semtex@backrefs}{%
    \semtex@pendingbr={}%
    \semtex@collapsebr{#1}%
    % After collapse, semtex@br@#1 is either \@empty (no refs)
    % or a comma-joined ref list.  \@ifundefined cannot
    % distinguish \@empty from real data (collapsebr always
    % defines the csname), so use \ifx against \@empty instead.
    \expandafter\ifx\csname semtex@br@#1\endcsname\@empty
      % No refs to this target (collapsed to \@empty): skip.
    \else
      \ifbool{semtex@appendix}{}{%
        % Inline mode: store ref list for flush.
        \semtex@pendingbr=\expandafter{%
          \csname semtex@br@#1\endcsname}%
      }%
    \fi
  }{}%
}

% \semtex@flushbackref
%   Emit the pending back-reference and clear it.
%   The pendingbr register is cleared BEFORE rendering so that
%   the \par inside \semtex@renderinline cannot re-enter
%   flushbackref with the same data (para/end → flushbackref
%   → renderinline → \par → para/end → flushbackref loop).
\newcommand*{\semtex@flushbackref}{%
  \ifbool{semtex@backrefs}{%
    \ifbool{semtex@appendix}{}{%
      \expandafter\def\expandafter\semtex@tmp\expandafter{%
        \the\semtex@pendingbr}%
      \semtex@pendingbr={}%
      \ifx\semtex@tmp\@empty\else
        \semtex@renderinline{\semtex@tmp}%
      \fi
    }%
  }{}%
}

% \semtex@formatusedin{reflist}
%   Shared formatting helper for "Used in" lines.  Both the
%   inline path (\semtex@renderinline) and the deferred
%   paragraph path (\vadjust pre in \semtex@installparahook)
%   call this, so overriding it changes ALL rendering.
%   Reads font/prefix/label from \semtexsetup configuration.
\newcommand*{\semtex@formatusedin}[1]{%
  {\normalfont\semtex@backreffont\semtex@backrefprefix\semtex@backreflabel\space#1.}}

% \semtex@renderinline{reflist}
%   Render "Used in X, Y." at the end of the current atom.
%   Used for theorem/definition/lemma atoms (non-paragraph).
%   Respects backref-style and backref-align configuration.
\newcommand*{\semtex@renderinline}[1]{%
  \def\semtex@tmp@block{block}%
  \ifx\semtex@backrefstyle\semtex@tmp@block
    % Block style: separate line after the atom.
    \def\semtex@tmp@right{right}%
    \ifx\semtex@backrefalign\semtex@tmp@right
      \leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill
      \quad\semtex@formatusedin{#1}%
    \else
      \leavevmode\unskip\par\nobreak
      \semtex@formatusedin{#1}\hfill\null
    \fi
    \par\addvspace{\medskipamount}%
  \else
    % Inline style: same line as content, flows with text.
    \unskip\quad\semtex@formatusedin{#1}%
  \fi
}

% \semtex@renderdeferred{reflist}
%   Render "Used in" inside a \vadjust pre context (vertical
%   mode).  Used for paragraph atoms via the deferred-backref
%   mechanism.  Calls \semtex@formatusedin for the text.
%   Respects backref-style and backref-align configuration.
\newcommand*{\semtex@renderdeferred}[1]{%
  \nobreak
  \def\semtex@tmp@block{block}%
  \ifx\semtex@backrefstyle\semtex@tmp@block
    % Block style
    \def\semtex@tmp@right{right}%
    \vbox{%
      \hbox to \linewidth{%
        \ifx\semtex@backrefalign\semtex@tmp@right
          \hfil\semtex@formatusedin{#1}%
        \else
          \semtex@formatusedin{#1}\hfil
        \fi
      }%
      \vskip\medskipamount
    }%
  \else
    % Inline style: compact, no extra vertical space
    \vbox{%
      \hbox to \linewidth{%
        \hfil\semtex@formatusedin{#1}%
      }%
      \vskip\smallskipamount
    }%
  \fi
}

% Deferred backref: data saved at para/end, emitted at the
% next para/begin.  Avoids mode-change error (para/end must
% stay in horizontal mode; \renderinline needs \par).
\gdef\semtex@deferredbr{}

% \semtex@installparendhook
%   Install the para/end hook for flushing back-refs.
%   Per §8a.5, clears \semtex@currentatom after the flush so
%   that any \ref firing between paragraphs is not attributed
%   to the just-closed atom.
%   Instead of calling \semtex@flushbackref (which does \par
%   via \renderinline), we snapshot the pending br data into
%   \semtex@deferredbr and clear the register.  The deferred
%   data is emitted at the NEXT para/begin, before the new
%   atom's margin number.
\newcommand*{\semtex@installparendhook}{%
  \AddToHook{para/end}{%
    \ifbool{semtex@tracked}{%
      \ifbool{semtex@intheorem}{}{%
        % Snapshot pending backref data for deferred emission.
        \ifbool{semtex@backrefs}{%
          \ifbool{semtex@appendix}{}{%
            \expandafter\def\expandafter\semtex@tmp\expandafter{%
              \the\semtex@pendingbr}%
            \semtex@pendingbr={}%
            \ifx\semtex@tmp\@empty\else
              \global\let\semtex@deferredbr\semtex@tmp
            \fi
          }%
        }{}%
        \let\semtex@currentatom\@empty
      }%
    }{}%
  }%
}

%% ===================================================================
%% Section 9a: Semantic sidecar (.sbl) writer
%% ===================================================================
%%
%% Write-only sidecar file for Layer 2 (semantic CLI).  The .sty
%% never reads .sbl — it is strictly one-way output.  Record format
%% is line-oriented: one \semtex@sbl@* control sequence per line
%% with fixed-arity brace-delimited arguments (no kv blobs).
%%

% \semtex@sblwrite{text}
%   Guarded write to the .sbl stream.  No-op when the stream
%   is not open (e.g. \if@filesw is false).
\newcommand*{\semtex@sblwrite}[1]{%
  \ifbool{semtex@sblopen}{%
    \immediate\write\semtex@sblout{#1}%
  }{}%
}

% \semtex@sblwrite@atom{text}
%   Atom-scoped guard: drops the write when not inside a tracked
%   atom (\semtex@currentatom is empty).
\newcommand*{\semtex@sblwrite@atom}[1]{%
  \ifx\semtex@currentatom\@empty\else
    \semtex@sblwrite{#1}%
  \fi
}

%% --- Section 9a open hook (begindocument/before) ---
%% Per REVIEW_C finding #5, the stream opens at begindocument/before
%% (before any \AtBeginDocument hook), so atoms emitted from user
%% hooks are never silently dropped.
\AddToHook{begindocument/before}[semtex/sbl/open]{%
  \if@filesw
    \newwrite\semtex@sblout
    \immediate\openout\semtex@sblout=\jobname.sbl\relax
    \global\booltrue{semtex@sblopen}%
    \immediate\write\semtex@sblout{%
      \string\semtex@sbl@version{1}}%
    \immediate\write\semtex@sblout{%
      \string\semtex@sbl@source{\jobname.tex}}%
  \fi
}

%% --- Section 9a close hook (\AtEndDocument) ---
%% Write the \semtex@sbl@end{OK} sentinel and close the stream.
%% Per REVIEW_C finding #7, the sentinel's presence is the CLI's
%% test for "complete file".
\AtEndDocument{%
  \ifbool{semtex@sblopen}{%
    \immediate\write\semtex@sblout{%
      \string\semtex@sbl@end{OK}}%
    \immediate\closeout\semtex@sblout
    \global\boolfalse{semtex@sblopen}%
  }{}%
}

%% --- Section 9a label wrap (cleveref-aware) ---
%% Installed at begindocument/before so we capture \label BEFORE
%% cleveref's \AtBeginDocument wrapper installs around us (see
%% DESIGN.md §9a "Label wrap" double-wrap explanation).
\AddToHook{begindocument/before}[semtex/sbl/labelwrap]{%
  \let\semtex@orig@label\label
  \@ifpackageloaded{cleveref}{%
    %% cleveref path: \label[type]{key}, optional arg.
    \def\label{%
      \@ifnextchar[%]
        \semtex@sbl@label@withopt
        \semtex@sbl@label@noopt
    }%
  }{%
    %% No cleveref: \label{key} only.
    \def\label#1{%
      \semtex@sblwrite@atom{%
        \string\semtex@sbl@label
          {\theatom}{#1}}%
      \semtex@orig@label{#1}%
    }%
  }%
}
\def\semtex@sbl@label@withopt[#1]#2{%
  \semtex@sblwrite@atom{%
    \string\semtex@sbl@label
      {\theatom}{#2}}%
  \semtex@orig@label[#1]{#2}%
}
\def\semtex@sbl@label@noopt#1{%
  \semtex@sblwrite@atom{%
    \string\semtex@sbl@label
      {\theatom}{#1}}%
  \semtex@orig@label{#1}%
}

%% --- Section 9a concept-tracking helpers ---
%% Supporting macros for \semtexnewcommand / \semtexNewDocumentCommand.
%% The public API lives in Section 10; the emit helpers live here
%% because they write to both .sbl and .aux.

% \semtex@sblwrite@deferred{text}
%   Accumulate a deferred .sbl write for preamble-time emission.
%   Records queued here are flushed once the .sbl stream opens.
%   Used for \semtex@sbl@cmddef records whose declarations occur
%   in the preamble before the stream is available.
%   IMPORTANT: the argument must already be fully expanded (no
%   transient macros like \semtex@tmp@name) because \g@addto@macro
%   does not expand its argument.  Callers use \edef to pre-build
%   the record string.
\newcommand*{\semtex@sblwrite@deferred}[1]{%
  \ifbool{semtex@sblopen}{%
    % Stream already open (late declaration): write immediately.
    \semtex@sblwrite{#1}%
  }{%
    \g@addto@macro\semtex@sbl@deferred{%
      \semtex@sblwrite{#1}}%
  }%
}

% Flush deferred sbl writes after the stream opens.
\AddToHook{begindocument/before}[semtex/sbl/cmddef]{%
  \semtex@sbl@deferred
  \global\let\semtex@sbl@deferred\@empty
}
% Must run AFTER the sbl open hook.
\DeclareHookRule{begindocument/before}{semtex/sbl/cmddef}%
                {after}{semtex/sbl/open}

% \semtex@build@argspec{n}
%   Convert integer arity 0..9 to a repeated-m xparse spec string.
%   Arity 0 produces no tokens (empty spec), arity 2 produces "m m",
%   etc.  Not currently called (the define-let-protected\edef approach
%   sidesteps argspec construction), but retained per DESIGN.md §9a
%   as a utility for future xparse-based variants.
\newcommand*{\semtex@build@argspec}[1]{%
  \ifcase\number#1\relax
    \or m%
    \or m m%
    \or m m m%
    \or m m m m%
    \or m m m m m%
    \or m m m m m m%
    \or m m m m m m m%
    \or m m m m m m m m%
    \or m m m m m m m m m%
  \else
    \PackageError{semtex}%
      {\string\semtexnewcommand\space arity \number#1\space
       out of range (max 9)}%
      {Use \string\semtexNewDocumentCommand\space for more.}%
  \fi}

% \semtex@emit@def{name}
%   Star-branch handler: fires when \cmd* is used (defining site).
%   Records the current atom as the defining site for the named
%   concept.  Emits both .aux and .sbl records.  Per J2: empty-
%   currentatom short-circuit fires BEFORE the duplicate-def check.
%   name -- bare command name (e.g. "Hom")
\newcommand*{\semtex@emit@def}[1]{%
  \ifx\semtex@currentatom\@empty
    % No atom context (footnote, caption, orphan): silent no-op
    % per §8a.9 error model.
  \else
    \@ifundefined{semtex@concept@#1}%
      {\expandafter\xdef
         \csname semtex@concept@#1\endcsname
         {\theatom}%
       \if@filesw
         \immediate\write\@auxout{%
           \string\semtex@concept{#1}{\theatom}}%
       \fi
       \semtex@sblwrite@atom{%
         \string\semtex@sbl@def{\theatom}{#1}}%
      }%
      {\PackageError{semtex}%
        {\string\\#1* defined at atoms
         \csname semtex@concept@#1\endcsname\space and
         \theatom}%
        {Exactly one definition site is permitted per
         concept.  Use \string\\#1\space (without star)
         at the non-definitional site.}%
      }%
  \fi}

% \semtex@emit@use{name}
%   Non-star-branch handler: fires when \cmd is used (use site).
%   Emits both .aux and .sbl records under the current atom guard.
%   Registers the concept name for the missing-def-site scan at
%   \AtEndDocument (first-use only, guarded by conceptused csname).
%   name -- bare command name (e.g. "Hom")
\newcommand*{\semtex@emit@use}[1]{%
  \ifx\semtex@currentatom\@empty\else
    % Register concept name for end-document missing-def scan.
    \@ifundefined{semtex@conceptused@#1}{%
      \expandafter\gdef
        \csname semtex@conceptused@#1\endcsname{1}%
      \g@addto@macro\semtex@conceptnames{\do{#1}}%
    }{}%
    \if@filesw
      \immediate\write\@auxout{%
        \string\semtex@conceptref{\theatom}{#1}}%
    \fi
    \semtex@sblwrite@atom{%
      \string\semtex@sbl@use{\theatom}{#1}}%
  \fi}

%% --- Section 9a.9: Concept missing-def-site scan ---
%% At \AtEndDocument, walk the concept name list and check each
%% concept for a matching def site.  Concepts with uses but no
%% def site trigger a warning (or info per conceptwarnings option).

% \semtex@conceptwarnscan
%   Walk \semtex@conceptnames via \do.  For each concept name,
%   check if semtex@conceptdef@<name> is defined.  If not, the
%   concept has uses but no \cmd* def-site marker; warn.
\def\semtex@conceptwarnscan{%
  \def\do##1{%
    \@ifundefined{semtex@conceptdef@##1}{%
      \ifbool{semtex@conceptwarnings}{%
        \PackageWarning{semtex}{%
          \expandafter\string\csname ##1\endcsname\space
          used but no starred definition site found;\MessageBreak
          backrefs for this concept are disabled}%
      }{%
        \PackageInfo{semtex}{%
          \expandafter\string\csname ##1\endcsname\space
          used but no starred definition site found
          (conceptwarnings=off)}%
      }%
    }{}%
  }%
  \semtex@conceptnames
}

\AtEndDocument{%
  \semtex@conceptwarnscan
}

%% ===================================================================
%% Section 10: User-facing API
%% ===================================================================

% \semtex@extractfirst  env1,env2,...\@nil
%   Extract the first comma-separated element into \semtex@basecounter.
\def\semtex@extractfirst#1,#2\@nil{\def\semtex@basecounter{#1}}

% \semtextrack{env1,env2,...}
%   Post-hoc alias base counter to atom counter and install all
%   hooks.  Must be called AFTER all \newtheorem declarations.
%   env1, env2, ... -- comma-separated environment names to track.
%   The first env name is auto-detected as the base counter name.
\newcommand*{\semtextrack}[1]{%
  \booltrue{semtex@tracked}%
  % Auto-detect the base counter from the first environment name.
  \semtex@extractfirst#1,\@nil
  \semtex@setupcounter
  % Hook each listed environment and its starred variant.
  % Note: \expandafter ensures the env name is fully expanded
  % before \semtex@hooktheorem captures it in \AddToHook
  % bodies; without this, a stale \semtex@tmp reference would
  % resolve to the wrong name at hook-fire time.
  \@for\semtex@tmp:=#1\do{%
    \ifx\semtex@tmp\@empty\else
      % Re-alias this env's counter to \c@atom.  When thmtools
      % declares an env with sibling=<base>, it \let-aliases
      % \c@<env> to \c@<base> at declaration time.  But
      % \semtex@setupcounter later replaces \c@<base> with
      % \c@atom; the sibling counters still point to the old
      % register.  This re-let ensures every tracked env's
      % counter is \c@atom, regardless of declaration order.
      \expandafter\@ifundefined\expandafter{%
        \expandafter c@\semtex@tmp
      }{}{%
        \expandafter\let\csname c@\semtex@tmp\endcsname\c@atom
        % Also alias the display macro \the<env> to \theatom.
        % When thmtools declares an env with sibling=<base>, it
        % snapshots \the<base> at declaration time.  If semtex
        % later rewires \the<base> to \theatom, the sibling's
        % display macro still has the old format.  This re-let
        % ensures every tracked env uses the atom display format.
        \expandafter\let\csname the\semtex@tmp\endcsname\theatom
      }%
      \expandafter\semtex@hooktheorem
        \expandafter{\semtex@tmp}%
      % Auto-register starred variant (amsthm creates foo*).
      \edef\semtex@starred{\semtex@tmp*}%
      \expandafter\@ifundefined\expandafter{%
        \semtex@starred
      }{}{%
        \expandafter\semtex@hooktheorem
          \expandafter{\semtex@starred}%
      }%
    \fi
  }%
  \semtex@hookproof
  % Equation sharing.
  \ifbool{semtex@eqshared}{%
    \expandafter\let\csname c@equation\endcsname\c@atom
  }{}%
  % Install suppression and paragraph hooks.
  \semtex@installsuppress
  \semtex@suppresssectioning
  \semtex@suppresscommands
  \semtex@installparahook
  \semtex@installparendhook
}

% \semtextag{kind}{value}
%   Emit a semantic tag record to the .sbl sidecar, scoped to the
%   current atom.  No visible typesetting effect.  Ignored outside
%   a tracked atom.
%   kind  -- tag category (e.g. uid, introduces, type)
%   value -- tag payload (free-form UTF-8)
\newcommand*{\semtextag}[2]{%
  \semtex@sblwrite@atom{%
    \string\semtex@sbl@tag
    {\theatom}{#1}{#2}}%
}

% \semtexnewcommand{\cmd}[arity]{body}
%   Define a command with semtex concept tracking.  Mirrors
%   \newcommand exactly: \cmd with backslash, optional [arity]
%   (default 0), mandatory {body} using #1..#N.
%
%   At declaration time, emits three global .sbl records:
%     \semtex@sbl@cmddef{name}{kind}{newcommand}
%     \semtex@sbl@cmddef{name}{arity}{N}
%     \semtex@sbl@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command answers both
%   \cmd (use site) and \cmd* (def site).  Both forms typeset
%   the same body; the star controls which emit helper fires.
%
%   \cmd  -- command to define (with backslash, e.g. \Hom)
%   arity -- optional integer 0..9 (default 0)
%   body  -- replacement text, uses #1..#N
\NewDocumentCommand{\semtexnewcommand}{m O{0} +m}{%
  % #1 = \cmd (with backslash), #2 = arity, #3 = body.
  \edef\semtex@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \newcommand (handles all #-
  %    numbering naturally).
  \newcommand#1[#2]{#3}%
  % 2. Save the original definition.
  \expandafter\let
    \csname semtex@body@\semtex@tmp@name\endcsname#1%
  % 3. Define star/nostar dispatch targets first (the \edef
  %    expands \csname...\endcsname at def-time, capturing the
  %    resolved control sequences).
  \expandafter\edef
    \csname semtex@star@\semtex@tmp@name\endcsname{%
      \noexpand\semtex@emit@def{\semtex@tmp@name}%
      \expandafter\noexpand
        \csname semtex@body@\semtex@tmp@name\endcsname}%
  \expandafter\edef
    \csname semtex@nostar@\semtex@tmp@name\endcsname{%
      \noexpand\semtex@emit@use{\semtex@tmp@name}%
      \expandafter\noexpand
        \csname semtex@body@\semtex@tmp@name\endcsname}%
  % 4. Redefine the command with star dispatch via \@ifstar.
  %    \protected\edef makes the wrapper robust so it survives
  %    expansion in moving arguments (\section titles, captions,
  %    .aux writes) without premature \@ifstar expansion.
  \protected\edef#1{%
    \noexpand\@ifstar
      \expandafter\noexpand
        \csname semtex@star@\semtex@tmp@name\endcsname
      \expandafter\noexpand
        \csname semtex@nostar@\semtex@tmp@name\endcsname}%
  % 5. Emit global declaration records (deferred: the .sbl
  %    stream may not be open yet during the preamble).
  %    Records are pre-expanded via \edef so transient values
  %    (\semtex@tmp@name, \inputlineno) are captured eagerly.
  \edef\semtex@tmp@rec{%
    \noexpand\semtex@sblwrite@deferred{%
      \string\semtex@sbl@cmddef{\semtex@tmp@name}%
      {kind}{newcommand}}%
    \noexpand\semtex@sblwrite@deferred{%
      \string\semtex@sbl@cmddef{\semtex@tmp@name}%
      {arity}{\number#2}}%
    \noexpand\semtex@sblwrite@deferred{%
      \string\semtex@sbl@cmddef{\semtex@tmp@name}%
      {src}{\jobname.tex:\the\inputlineno:1}}%
  }%
  \semtex@tmp@rec
}
% Deprecated alias — old documents using \semtexNewCommand still work.
\let\semtexNewCommand\semtexnewcommand

% \semtexNewDocumentCommand{\cmd}{argspec}{body}
%   Define a command with semtex concept tracking, using xparse's
%   full argument specification.  Mirrors \NewDocumentCommand
%   exactly: \cmd with backslash, {argspec} string, {body}.
%
%   At declaration time, emits three global .sbl records:
%     \semtex@sbl@cmddef{name}{kind}{NewDocumentCommand}
%     \semtex@sbl@cmddef{name}{argspec}{<user-spec>}
%     \semtex@sbl@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command prepends a semtex
%   star to the user's argspec.  \cmd* marks a def site; \cmd
%   marks a use site.  Both typeset the same body.  If the
%   user's argspec itself starts with "s", the user's star
%   requires a second "*" at call time (e.g. \cmd** for
%   semtex-def + user-star).
%
%   \cmd    -- command to define (with backslash)
%   argspec -- xparse argument specification string
%   body    -- replacement text, uses #1..#N per the spec
\NewDocumentCommand{\semtexNewDocumentCommand}{m m +m}{%
  % #1 = \cmd, #2 = argspec, #3 = body.
  \edef\semtex@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \NewDocumentCommand (handles
  %    all xparse arg types and #-numbering naturally).
  \NewDocumentCommand{#1}{#2}{#3}%
  % 2. Save the original xparse definition.
  \expandafter\let
    \csname semtex@body@\semtex@tmp@name\endcsname#1%
  % 3. Define star/nostar dispatch targets.
  \expandafter\edef
    \csname semtex@star@\semtex@tmp@name\endcsname{%
      \noexpand\semtex@emit@def{\semtex@tmp@name}%
      \expandafter\noexpand
        \csname semtex@body@\semtex@tmp@name\endcsname}%
  \expandafter\edef
    \csname semtex@nostar@\semtex@tmp@name\endcsname{%
      \noexpand\semtex@emit@use{\semtex@tmp@name}%
      \expandafter\noexpand
        \csname semtex@body@\semtex@tmp@name\endcsname}%
  % 4. Redefine with star dispatch (\protected = robust).
  \protected\edef#1{%
    \noexpand\@ifstar
      \expandafter\noexpand
        \csname semtex@star@\semtex@tmp@name\endcsname
      \expandafter\noexpand
        \csname semtex@nostar@\semtex@tmp@name\endcsname}%
  % 5. Emit global declaration records (deferred, pre-expanded).
  \edef\semtex@tmp@rec{%
    \noexpand\semtex@sblwrite@deferred{%
      \string\semtex@sbl@cmddef{\semtex@tmp@name}%
      {kind}{NewDocumentCommand}}%
    \noexpand\semtex@sblwrite@deferred{%
      \string\semtex@sbl@cmddef{\semtex@tmp@name}%
      {argspec}{#2}}%
    \noexpand\semtex@sblwrite@deferred{%
      \string\semtex@sbl@cmddef{\semtex@tmp@name}%
      {src}{\jobname.tex:\the\inputlineno:1}}%
  }%
  \semtex@tmp@rec
}

% \semtexsuppress{envname}
%   Register a user environment for paragraph-number suppression.
%   envname -- environment name to suppress
\newcommand*{\semtexsuppress}[1]{%
  \semtex@suppressenv{#1}%
}

% \semtexsuppresscmd{\command}
%   Register a user command for paragraph-number suppression.
%   \command -- command to patch
\newcommand*{\semtexsuppresscmd}[1]{%
  \semtex@suppresscmd{#1}%
}

% \semtexappendix
%   Typeset the dependency index (appendix mode only).
%   Walks the atom array (populated at each atom site) and
%   emits an entry for every atom that has at least one
%   back-reference.
\newcommand*{\semtexappendix}{%
  \ifbool{semtex@appendix}{%
    \section*{Dependency Index}%
    \begingroup
      \small
      \count@=\z@
      \loop
        \ifnum\count@<\semtex@atomcount
        \advance\count@ by 1\relax
        \expandafter\expandafter\expandafter\semtex@appendix@emit
          \csname semtex@atom@\the\count@\endcsname
      \repeat
    \endgroup
  }{%
    \PackageWarning{semtex}{%
      \string\semtexappendix\space ignored: %
      backrefs mode is not 'appendix'}%
  }%
}

% \semtex@appendix@emit{num}{type}
%   Collapse back-refs for atom num and emit an appendix entry
%   if any back-references exist.
\def\semtex@appendix@emit#1#2{%
  \semtex@collapsebr{#1}%
  \expandafter\ifx\csname semtex@br@#1\endcsname\@empty\else
    \semtex@appendixentry{#1}{#2}{%
      \csname semtex@br@#1\endcsname}%
  \fi
}

% Appendix rendering helpers.
% \semtex@appendixsection{number}{title}
\newcommand*{\semtex@appendixsection}[2]{%
  \par\medskip\noindent
  \textbf{#1\quad #2}\par
}

% \semtex@appendixentry{atomnumber}{atomname}{reflist}
\newcommand*{\semtex@appendixentry}[3]{%
  \par\noindent
  \hspace{1.5em}%
  #1\quad #2\quad\dotfill\quad
  \begin{minipage}[t]{0.45\linewidth}%
    \raggedright #3%
  \end{minipage}%
}

%% ===================================================================
%% Section 11: Compatibility guards
%% ===================================================================

% Guard: require LaTeX2e kernel with hook management.
\@ifundefined{AddToHook}{%
  \PackageError{semtex}{%
    LaTeX kernel too old (need 2021+)}{%
    semtex requires \string\AddToHook\space
    (TeX Live 2021 or later).%
  }%
}{}

% Hyperref link wrapping for backref numbers.
% Default is identity (plain text); redefined when hyperref
% is loaded to use anchor names extracted from \newlabel (§8a.4).
\newcommand*{\semtex@brhyper}[1]{#1}

\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \PackageInfo{semtex}{hyperref detected, enabling links}%
    \renewcommand*{\semtex@brhyper}[1]{%
      \expandafter\ifx\csname semtex@anchor@#1\endcsname\relax
        #1%
      \else
        \hyperlink{\csname semtex@anchor@#1\endcsname}{#1}%
      \fi}%
  }{}%
}

\endinput
