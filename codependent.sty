% \codep@extractfirst  env1,env2,...\@nil
%   Extract the first comma-separated element into \codep@basecounter.
\def\codep@extractfirst#1,#2\@nil{\def\codep@basecounter{#1}}

% \codeptrack{env1,env2,...}
%   Post-hoc alias base counter to atom counter and install all
%   hooks.  Must be called AFTER all \newtheorem declarations.
%   env1, env2, ... -- comma-separated environment names to track.
%   The first env name is auto-detected as the base counter name.
\newcommand*{\codeptrack}[1]{%
  % Guard against double invocation (newcounter{atom} would crash).
  \ifbool{codep@tracked}{%
    \PackageError{codependent}%
      {\string\codeptrack\space called twice}%
      {Call \string\codeptrack\space only once, after all%
       theorem declarations.}%
  }{}%
  \booltrue{codep@tracked}%
  % Auto-detect the base counter from the first environment name.
  \codep@extractfirst#1,\@nil%
  % Check that the base counter exists (i.e. \newtheorem was called).
  \@ifundefined{c@\codep@basecounter}{%
    \PackageError{codependent}%
      {Counter '\codep@basecounter' undefined -- %
       \string\codeptrack\space called before%
       \string\newtheorem}%
      {Declare all theorem environments with%
       \string\newtheorem\space before calling%
       \string\codeptrack.}%
  }{}%
  \codep@setupcounter%
  % Hook each listed environment and its starred variant.
  % Note: \expandafter ensures the env name is fully expanded
  % before \codep@hooktheorem captures it in \AddToHook
  % bodies; without this, a stale \codep@tmp@envname reference would
  % resolve to the wrong name at hook-fire time.
  \@for\codep@tmp@envname:=#1\do{%
    \ifx\codep@tmp@envname\@empty\else
      % Re-alias this env's counter to \c@atom.  When thmtools
      % declares an env with sibling=<base>, it \let-aliases
      % \c@<env> to \c@<base> at declaration time.  But
      % \codep@setupcounter later replaces \c@<base> with
      % \c@atom; the sibling counters still point to the old
      % register.  This re-let ensures every tracked env's
      % counter is \c@atom, regardless of declaration order.
      \expandafter\@ifundefined\expandafter{%
        \expandafter c@\codep@tmp@envname%
      }{}{%
        \expandafter\let\csname c@\codep@tmp@envname\endcsname\c@atom%
        % Also alias the display macro \the<env> to \theatom.
        % When thmtools declares an env with sibling=<base>, it
        % snapshots \the<base> at declaration time.  If codependent
        % later rewires \the<base> to \theatom, the sibling's
        % display macro still has the old format.  This re-let
        % ensures every tracked env uses the atom display format.
        \expandafter\let\csname the\codep@tmp@envname\endcsname\theatom%
      }%
      \expandafter\codep@hooktheorem%
        \expandafter{\codep@tmp@envname}%
      % Auto-register starred variant (amsthm creates foo*).
      \edef\codep@starred{\codep@tmp@envname*}%
      \expandafter\@ifundefined\expandafter{%
        \codep@starred%
      }{}{%
        \expandafter\codep@hooktheorem%
          \expandafter{\codep@starred}%
      }%
    \fi
  }%
  \codep@hookproof%
  % Install suppression and paragraph hooks.
  \codep@installsuppress%
  \codep@suppresssectioning%
  % Defer section title capture to begindocument/end so that
  % hyperref's \addcontentsline redefinition has already run.
  \AddToHook{begindocument/end}[codependent/sectitle]{%
    \codep@capturesectitle}%
  \codep@suppresscommands%
  \codep@installparahook%
  \codep@installparendhook%
}

% \codeptag{kind}{value}
%   Emit a semantic tag record to the .cdp sidecar, scoped to the
%   current atom.  No visible typesetting effect.  Ignored outside
%   a tracked atom.
%   kind  -- tag category (e.g. uid, introduces, type)
%   value -- tag payload (free-form UTF-8)
\newcommand*{\codeptag}[2]{%
  \codep@getcurrentatomdisplay\codep@tmp@tagatom%
  \ifx\codep@tmp@tagatom\@empty\else%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@tag%
      {\codep@tmp@tagatom}{#1}{#2}}%
  \fi%
}%

% \codepbackrefs
%   User-driven backref emission point.  Resolves the active source
%   atom's key, sets the per-atom
%   \codep@manuallyemitted@<key> flag (so the env-end auto-flush
%   skips a duplicate emission), and routes through the rendering
%   layer's manual-emit hook to queue + flush the "Used in ..." line
%   at the call site.  Outside any tracked atom: emits a package
%   warning and produces no output.  Complete no-op during
%   restatable replay (replay guard wraps the entire body).
%
%   The flag is cleared at env-end / proof-afterend / para-end hook
%   sites (see \codep@manuallyemitted@end@outer@clear,
%   \codep@hookproof@afterend, \codep@installparendhook).
%% @behavior B-REND-INLINE
\newcommand*{\codepbackrefs}{%
  \ifnum\codep@replaydepth=0\relax%
    \codep@getcurrentatomkey\codep@tmp@manualkey%
    \ifx\codep@tmp@manualkey\@empty%
      \PackageWarning{codependent}{%
        \string\codepbackrefs\space called outside any tracked atom%
        \space--- no refs emitted}%
    \else%
      \expandafter\xdef%
        \csname codep@manuallyemitted@\codep@tmp@manualkey\endcsname{1}%
      \codep@render@manual@emit{\codep@tmp@manualkey}%
    \fi%
  \fi%
}%

% \codepproofof{label}    — "Used in 2.4*" links to the theorem
% \codepproofof*{label}   — "Used in 2.4*" links to the proof
%   Associate a separated proof with its theorem.  Must be called
%   inside a \begin{proof}...\end{proof} environment.  Looks up
%   the label's atom number and sets the current atom to the
%   starred version (e.g., 2.1*), enabling correct backref
%   attribution.
%
%   The starred form writes an anchormap entry so the hyperlink
%   for the starred backref points to the proof location instead
%   of falling back to the theorem.  Use this when the proof is
%   far from the theorem and the reader should be taken to the
%   proof, not back to the statement.
%
%   Lazy proof integration: if the proof was non-adjacent,
%   \codep@proof@standalone only set the deferred flag (no atom
%   created yet).  \codepproofof clears the deferred flag and
%   assigns the proof's identity to the target theorem — no
%   standalone atom is ever materialized.
\newcommand{\codepproofof}{%
  \@ifstar{\codep@proofof@star}{\codep@proofof@plain}}
\def\codep@proofof@plain#1{\codep@proofof@do{#1}{}}
\def\codep@proofof@star#1{\codep@proofof@do{#1}{anchor}}
\def\codep@proofof@do#1#2{%
  \ifbool{codep@proofsnumbered}{%
    \ifx\codep@currentproofid\@empty\else%
      \expandafter\ifx\csname codep@lblnum@#1\endcsname\relax%
        \PackageWarning{codependent}{\string\codepproofof: unknown label '#1'.\space%
          The label may not exist or may not have been processed yet}%
      \else%
        \edef\codep@tmp@proofkey{proof:\csname codep@lblnum@#1\endcsname}%
        \codep@atomsetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
        \global\codep@proofdisplaypendingfalse%
        \global\let\codep@pendingproofbind\@empty%
        \codep@cdpwrite@atom{%
          \string\codep@cdp@proof{%
            \csname codep@lblnum@#1\endcsname*}}%
        \def\codep@tmp@anchormode{#2}%
        \ifx\codep@tmp@anchormode\@empty\else%
          \codep@writeanchormap{\codep@tmp@proofkey}%
          \@ifpackageloaded{hyperref}{%
            \expandafter\xdef%
              \csname codep@anchor@\codep@tmp@proofkey\endcsname%
              {\@currentHref}%
          }{}%
        \fi%
        \codep@render@queuebackref{\codep@tmp@proofkey}%
      \fi%
    \fi%
  }{}%
}%

% \codepnewcommand{\cmd}[arity]{body}
%   Define a command with codependent concept tracking.  Mirrors
%   \newcommand exactly: \cmd with backslash, optional [arity]
%   (default 0), mandatory {body} using #1..#N.
%
%   At declaration time, emits three global .cdp records:
%     \codep@cdp@cmddef{name}{kind}{newcommand}
%     \codep@cdp@cmddef{name}{arity}{N}
%     \codep@cdp@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command answers both
%   \cmd (use site) and \cmd* (def site).  Both forms typeset
%   the same body; the star controls which emit helper fires.
%
%   \cmd  -- command to define (with backslash, e.g. \Hom)
%   arity -- optional integer 0..9 (default 0)
%   body  -- replacement text, uses #1..#N
\NewDocumentCommand{\codepnewcommand}{m O{0} +m}{%
  % #1 = \cmd (with backslash), #2 = arity, #3 = body.
  \edef\codep@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \newcommand (handles all #-
  %    numbering naturally).
  \newcommand#1[#2]{#3}%
  % 2-5. Shared pipeline: save body, build wrappers, emit .cdp.
  \codep@definetrackedcmd{\codep@tmp@name}{#1}%
    {newcommand}{arity}{\number#2}%
}
% Deprecated alias — old documents using \codepNewCommand still work.
\let\codepNewCommand\codepnewcommand

% \codepNewDocumentCommand{\cmd}{argspec}{body}
%   Define a command with codependent concept tracking, using xparse's
%   full argument specification.  Mirrors \NewDocumentCommand
%   exactly: \cmd with backslash, {argspec} string, {body}.
%
%   At declaration time, emits three global .cdp records:
%     \codep@cdp@cmddef{name}{kind}{NewDocumentCommand}
%     \codep@cdp@cmddef{name}{argspec}{<user-spec>}
%     \codep@cdp@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command prepends a codependent
%   star to the user's argspec.  \cmd* marks a def site; \cmd
%   marks a use site.  Both typeset the same body.  If the
%   user's argspec itself starts with "s", the user's star
%   requires a second "*" at call time (e.g. \cmd** for
%   codependent-def + user-star).
%
%   \cmd    -- command to define (with backslash)
%   argspec -- xparse argument specification string
%   body    -- replacement text, uses #1..#N per the spec
\NewDocumentCommand{\codepNewDocumentCommand}{m m +m}{%
  % #1 = \cmd, #2 = argspec, #3 = body.
  \edef\codep@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \NewDocumentCommand (handles
  %    all xparse arg types and #-numbering naturally).
  \NewDocumentCommand{#1}{#2}{#3}%
  % 2-5. Shared pipeline: save body, build wrappers, emit .cdp.
  \codep@definetrackedcmd{\codep@tmp@name}{#1}%
    {NewDocumentCommand}{argspec}{#2}%
}

