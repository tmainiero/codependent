%% --- Section 8a.0: Reference interception (three-site design) ---
%% Per REVIEW_E finding #2 (BLOCKER), the single-\@setref patch
%% covers only \ref/\eqref/\pageref/\vref/\nameref.  cleveref's
%% \cref@getlabel, hyperref's \HyRef@autosetref (\autoref), and
%% hyperref's \HyRef@@StarSetRef (\ref*/\Ref) all bypass \@setref.
%% This subsection installs THREE patch sites.  Per REVIEW_E #16,
%% \hyperref[]{} is deliberately uncovered (manual link, not a
%% cross-reference).

% Pass-1 safety: \codep@atomref must be defined to SOMETHING at
% package-load time so that if a stale .aux still references it
% (or a user script injects a record), LaTeX's aux read does not
% error.  A \providecommand no-op suits.
\providecommand*{\codep@atomref}[2]{}

% Pass-1 safety: \codep@lbltype records label→type-prefix mappings.
% Written alongside \label, read during the aux pass to construct
% prefixed target keys in \codep@processbr.
\providecommand*{\codep@lbltype}[2]{}

% Active definition for \codep@lbltype: populates the label type
% lookup table from aux records.
\def\codep@lbltype@active#1#2{%
  \expandafter\gdef\csname codep@ltype@#1\endcsname{#2}}

% Pass-1 safety: \codep@anchormap records atom→hyperref anchor
% mappings.  No-op until hyperref is detected at begindocument/before.
\providecommand*{\codep@anchormap}[2]{}

% Active definition for \codep@anchormap: populates the anchor lookup
% table from aux records.  Defined at package load time (outside any
% macro) so # works; activated in begindocument/before BEFORE the aux
% read, so equation range anchors are not silently discarded.
\def\codep@anchormap@active#1#2{%
  \expandafter\gdef\csname codep@anchor@#1\endcsname{#2}}

% \codep@writeanchormap{atomnum}
%   Write an atom→anchor aux record.  No-op by default; activated
%   at \AtBeginDocument when hyperref is loaded, so the write only
%   happens when \@currentHref is meaningful.
\newcommand*{\codep@writeanchormap}[1]{}

% Pass-1 safety for concept-tracking aux records (§9a User API).
% Active definitions installed at begindocument/before
% (§8a.9 concept resolution).
\providecommand*{\codep@concept}[2]{}
\providecommand*{\codep@conceptref}[2]{}

% Concept pending-list: deferred resolveconcept calls for
% forward refs whose def record has not yet been read.
% Flushed at begindocument/end after the full aux read.
\gdef\codep@conceptpending{}

% Concept name list: each concept whose \codep@emit@use
% fires at least once appends \do{name} here.  The
% \codep@conceptwarnscan at \AtEndDocument walks this list
% to detect concepts with uses but no def site.
\def\codep@conceptnames{}

% \codep@writeatomref{target}
%   Shared aux-write helper called by all patch sites.  Guards
%   on \codep@currentatom (in-atom sentinel: empty = not inside
%   a tracked atom, so no write) and on \if@filesw so --draftmode
%   / -no-aux compiles work.  The src field is normally read from
%   \theatom at write time per DESIGN.md §8a.5.0.  However, when
%   \codep@sourceatom is non-empty (adjacent proofs), it overrides
%   \theatom to emit starred atom numbers (e.g. "2.1*").
%
%   Bug-fix guards (2026-04-11):
%   (a) \ifmeasuring@ — amsmath processes align/gather/multline/
%       flalign bodies twice (measuring + typesetting).  Skip
%       entirely during the measuring pass so no dedup marks are
%       set and no writes are emitted.  \ifmeasuring@ is defined
%       by amsmath; guarded with \@ifundefined for non-amsmath docs.
%   (b) Per-(source, target) dedup — \cref{label} fires both
%       \cref@getlabel (patch 2) and \@setref (patch 1), producing
%       doubled \codep@atomref records.  A csname flag
%       codep@arw@<src>@<tgt> blocks the second write.
% \codep@writeatomref@do{target}
%   Normal (non-equation) aux-write path.  Extracted from the
%   original \codep@writeatomref body so equation branches can
%   fall through to it.
\def\codep@writeatomref@do#1{%
  \if@filesw
    % Determine source atom with type prefix.
    % Priority: \codep@sourceatom (already prefixed, e.g.
    % proof:X for adjacent proofs) > construct from
    % \codep@currenttype:\theatom (thm/para).
    \ifx\codep@sourceatom\@empty
      \edef\codep@tmp@srcatom{\codep@currenttype:\theatom}%
    \else
      \edef\codep@tmp@srcatom{\codep@sourceatom}%
    \fi
    % Per-(source, target) dedup: skip if already written.
    \codep@dedupwrite{\codep@tmp@srcatom}{#1}%
  \fi
}

\def\codep@writeatomref#1{%
  % (a) Skip during amsmath measuring pass.
  \@ifundefined{ifmeasuring@}%
    {\codep@writeatomref@body{#1}}%
    {\ifmeasuring@\else\codep@writeatomref@body{#1}\fi}%
}

% \codep@writeatomref@tracktwo{target}
%   Track 2 (align/gather multiline) path: defer the ref
%   to the pending list for later flush by \codep@flusheqrange.
\def\codep@writeatomref@tracktwo#1{%
  \codep@eqshouldtrack
  \ifx\codep@eqatom\@empty
    % Mode suppressed; fall through to containing atom.
    \ifx\codep@currentatom\@empty\else
      \codep@writeatomref@do{#1}%
    \fi
  \else
    \global\codep@eqpending=\expandafter{%
      \the\codep@eqpending\codep@eqpending@entry{#1}}%
    \global\advance\codep@eqpendingcount by 1\relax
  \fi
}

% \codep@writeatomref@trackone{target}
%   Track 1 (single equation) path: record the ref directly
%   with the parenthesized equation number.
\def\codep@writeatomref@trackone#1{%
  \codep@eqshouldtrack
  \ifx\codep@eqatom\@empty
    % Mode suppressed; fall through to containing atom.
    \ifx\codep@currentatom\@empty\else
      \codep@writeatomref@do{#1}%
    \fi
  \else
    % Record with equation:-prefixed key; display renders as (X).
    \edef\codep@eqatom{equation:\theequation}%
    \codep@writeanchormap{\codep@eqatom}%
    \if@filesw
      \codep@dedupwrite{\codep@eqatom}{#1}%
    \fi
  \fi
}

\def\codep@writeatomref@body#1{%
  % Equation environment handling.
  \ifbool{codep@inequation}{%
    \ifbool{codep@eqmultiline}{%
      \codep@writeatomref@tracktwo{#1}%
    }{%
      \codep@writeatomref@trackone{#1}%
    }%
  }{%
    % Normal (non-equation) path.
    \ifx\codep@currentatom\@empty\else
      \codep@writeatomref@do{#1}%
    \fi
  }%
}

% \codep@installatomrefpatch
%   Install all three patch sites.  Called from the
%   begindocument/before hook (Section 8a.7), AFTER
%   hyperref/cleveref have finished wrapping their respective
%   dispatchers.  Patching at this point wraps the OUTERMOST
%   live definition, preserving every prior hook (hyperlink
%   emission, cref formatting).
\def\codep@installatomrefpatch{%
  %% ---- Patch 1: kernel \@setref ----
  %% Covers \ref, \eqref, \pageref (via \@pagesetref
  %% delegation), \vref, \Vref, \vpageref, \nameref.
  \let\codep@orig@setref\@setref
  \def\@setref##1##2##3{%
    \codep@orig@setref{##1}{##2}{##3}%
    \codep@writeatomref{##3}%
  }%
  %% ---- Patch 2: cleveref \cref@getlabel ----
  %% Covers every cleveref family command.
  \@ifpackageloaded{cleveref}{%
    \let\codep@orig@crefgetlabel\cref@getlabel
    \def\cref@getlabel##1##2{%
      \codep@orig@crefgetlabel{##1}{##2}%
      \codep@writeatomref{##1}%
    }%
  }{}%
  %% ---- Patch 3: hyperref \HyRef@autosetref / \HyRef@@StarSetRef ----
  %% \HyRef@autosetref covers \autoref.
  %% \HyRef@@StarSetRef covers \ref* and \Ref.
  \@ifpackageloaded{hyperref}{%
    \@ifundefined{HyRef@autosetref}{}{%
      \let\codep@orig@HyRefautosetref\HyRef@autosetref
      \def\HyRef@autosetref##1##2##3{%
        \codep@orig@HyRefautosetref{##1}{##2}{##3}%
        \codep@writeatomref{##2}%
      }%
    }%
    \@ifundefined{HyRef@@StarSetRef}{}{%
      \let\codep@orig@HyRefStarSetRef\HyRef@@StarSetRef
      \def\HyRef@@StarSetRef##1##2##3{%
        \codep@orig@HyRefStarSetRef{##1}{##2}{##3}%
        \codep@writeatomref{##2}%
      }%
    }%
  }{}%
}

%% --- Section 8a.1: Defer queue (csname linked list) ---
%% Per REVIEW_C finding #2, the toks-register pattern from dpmac
%% is O(N^2) at 15k refs; replaced with a csname linked list
%% keyed by a monotonic \codep@brid counter.

\newcount\codep@brid
\codep@brid=0\relax

% \codep@recordbr{src}{tgt}
%   Enqueue a processbackref call.  O(1) per append.
\def\codep@recordbr#1#2{%
  \global\advance\codep@brid by 1\relax
  \expandafter\xdef
    \csname codep@brq@\the\codep@brid\endcsname{%
      \noexpand\codep@processbr{#2}{#1}%
    }%
}

% \codep@flushbrqueue
%   Walk the linked list once, O(N) total.  Called from the
%   begindocument/end hook (Section 8a.7).
\def\codep@flushbrqueue{%
  \begingroup
    \count@=\z@
    \loop
      \ifnum\count@<\codep@brid
        \advance\count@ by 1\relax
        \csname codep@brq@\the\count@\endcsname
        \global\expandafter\let
          \csname codep@brq@\the\count@\endcsname\relax
    \repeat
  \endgroup
}

%% --- Section 8a.2: Active aux-record callback ---
%% The \providecommand no-op from Section 8a.0 is REPLACED by
%% this active definition at begindocument/before (Section
%% 8a.7), before LaTeX reads .aux in \begin{document}.  From
%% that point on, every \codep@atomref{src}{tgt} that the .aux
%% read fires lands here and enqueues a processbackref call.
%%
%% Per REVIEW_C finding #4, guard on empty src (orphan refs
%% emitted between atoms).  Belt-and-braces: the \@setref patch
%% already skips the write when \codep@currentatom is empty.

\def\codep@atomref@active#1#2{%
  \edef\codep@tmp@src{#1}%
  \ifx\codep@tmp@src\@empty\else
    \codep@recordbr{#1}{#2}%
  \fi
}

%% --- Section 8a.2a: Type-prefixed key helpers ---
%% All backref graph keys carry a type prefix (envname:, paragraph:,
%% equation:, proof:) to prevent display-number collisions between
%% different atom types that share a numbering scheme (e.g.
%% equation 2.1 vs paragraph 2.1).  Internal csnames use the full
%% prefixed key; the display form is derived by stripping the
%% prefix and applying type-specific formatting.

% \codep@splitprefix{type:num}
%   Split a prefixed key into \codep@tmp@type and \codep@tmp@num.
%   The key format is "type:number" where type is one of
%   thm, para, eq, proof.
\def\codep@splitprefix#1:#2\@nil{%
  \def\codep@tmp@type{#1}%
  \def\codep@tmp@num{#2}%
}%

% String constants for type comparisons in display rules.
\def\codep@const@typeequation{equation}%
\def\codep@const@typeproof{proof}%

% \codep@displayfromkey{type:num}
%   Derive the rendered display form from a prefixed key.
%   equation:X → (X)     (parenthesized)
%   proof:X    → X*      (starred)
%   all others → X       (bare number)
\def\codep@displayfromkey#1{%
  \expandafter\codep@splitprefix#1\@nil
  \ifx\codep@tmp@type\codep@const@typeequation
    (\codep@tmp@num)%
  \else\ifx\codep@tmp@type\codep@const@typeproof
    \codep@tmp@num*%
  \else
    \codep@tmp@num
  \fi\fi
}%

%% --- Section 8a.3: Per-target linked list, processbr, collapsebr ---
%% For each target atom we maintain:
%%   \codep@brcount@<num>     -- count of appended refs
%%   \codep@brnode@<num>@<k>  -- the k-th ref text (prefixed key)
%% At typeset time the nodes are collapsed into the display
%% macro \codep@br@<num>.  Per REVIEW_C finding #2 second half,
%% this turns O(degree^2) into O(degree).

% \codep@appendbr@core
%   Shared body for \codep@processbr and \codep@appendbr.
%   Precondition: \codep@tmp@tgt and \codep@tmp@src are already
%   \edef'd to the resolved display numbers.
%   Performs: self-ref guard, consecutive-dedup, lazy count
%   init, linked-list node store.
\def\codep@appendbr@core{%
  % Self-ref guard (REVIEW_C finding #10).
  \ifx\codep@tmp@src\codep@tmp@tgt\else
    % Dedup against previous append for this target.
    \edef\codep@tmp@last{%
      \csname codep@brlast@\codep@tmp@tgt\endcsname}%
    \ifx\codep@tmp@last\codep@tmp@src
      % Consecutive duplicate: skip.
    \else
      \global\expandafter\let
        \csname codep@brlast@\codep@tmp@tgt\endcsname
        \codep@tmp@src
      % Append a new linked-list node.
      \expandafter\ifx
          \csname codep@brcount@\codep@tmp@tgt\endcsname\relax
        \global\expandafter\def
          \csname codep@brcount@\codep@tmp@tgt\endcsname{0}%
      \fi
      \edef\codep@tmp@k{%
        \csname codep@brcount@\codep@tmp@tgt\endcsname}%
      \count@=\codep@tmp@k\relax
      \advance\count@ by 1\relax
      \expandafter\xdef
        \csname codep@brcount@\codep@tmp@tgt\endcsname
        {\the\count@}%
      \expandafter\xdef
        \csname
          codep@brnode@\codep@tmp@tgt @\the\count@%
        \endcsname
        {\codep@tmp@src}%
    \fi
  \fi
}%

% \codep@processbr{tgt}{src}
%   #1 = target label key (display number via lblnum map)
%   #2 = source atom prefixed key (e.g. thm:2.1, para:1.3)
%   Constructs the prefixed target key using \codep@ltype@<label>
%   and the resolved display number from \codep@lblnum@<label>.
\def\codep@processbr#1#2{%
  \expandafter\ifx\csname codep@lblnum@#1\endcsname\relax
    % Unknown target: silently drop.
  \else
    % Construct prefixed target key: type:number.
    \expandafter\ifx\csname codep@ltype@#1\endcsname\relax
      % No type record (equation labels, stale aux): use bare number.
      \edef\codep@tmp@tgt{\csname codep@lblnum@#1\endcsname}%
    \else
      \edef\codep@tmp@tgt{%
        \csname codep@ltype@#1\endcsname
        :\csname codep@lblnum@#1\endcsname}%
    \fi
    \edef\codep@tmp@src{#2}%
    \codep@appendbr@core
  \fi
}

% \codep@appendbr{tgtnum}{srcnum}
%   Append a backref edge directly using display numbers
%   (no lblnum lookup).  Used by concept resolution where
%   both source and target atom numbers are already known.
%   Includes self-ref and consecutive-dedup guards.
\def\codep@appendbr#1#2{%
  \edef\codep@tmp@tgt{#1}%
  \edef\codep@tmp@src{#2}%
  \codep@appendbr@core
}

% \codep@collapsebr{targetnum}
%   Build a comma-joined display macro \codep@br@<num> from
%   the per-target node csnames.  Called lazily the first time
%   \codep@queuebackref looks up <num>.
\def\codep@collapsebr#1{%
  \expandafter\ifx\csname codep@brcount@#1\endcsname\relax
    % No refs to this target.
    \global\expandafter\let
      \csname codep@br@#1\endcsname\@empty
  \else
    \begingroup
      \edef\codep@tmp@n{\csname codep@brcount@#1\endcsname}%
      \def\codep@tmp@acc{}%
      \count@=\z@
      \loop
        \ifnum\count@<\codep@tmp@n
          \advance\count@ by 1\relax
          \edef\codep@tmp@node{%
            \csname codep@brnode@#1@\the\count@\endcsname}%
          \ifx\codep@tmp@acc\@empty
            \edef\codep@tmp@acc{%
              \noexpand\codep@brhyper{\codep@tmp@node}}%
          \else
            \edef\codep@tmp@acc{%
              \unexpanded\expandafter{\codep@tmp@acc}, %
              \noexpand\codep@brhyper{\codep@tmp@node}}%
          \fi
      \repeat
      \global\expandafter\let
        \csname codep@br@#1\endcsname\codep@tmp@acc
    \endgroup
  \fi
}

%% --- Section 8a.4: \newlabel / \newlabelxx override + extractor ---
%% Per REVIEW_C finding #1, use a \@secondoftwo-style grab of
%% the first braced subgroup.  Per REVIEW_C finding #3, install
%% at begindocument/before so hyperref's pre-2023 aux-injection
%% block does not clobber it.  Also override \newlabelxx for
%% the pre-2023 hyperref pathway.

% \codep@grabfirst#1#2\@nil -> #1
%   Grab the first brace group of a delimited argument.
\def\codep@grabfirst#1#2\@nil{#1}

% \codep@grab4th#1#2#3#4#5\@nil -> #4
%   Grab the 4th brace group.  Used to extract hyperref's
%   anchor name from \newlabel's value ({num}{page}{title}{anchor}{}).
\def\codep@grab4th#1#2#3#4#5\@nil{#4}

% \codep@extractanchor{key}{value}
%   Extract hyperref's anchor (4th field of \newlabel value)
%   and store a reverse mapping: atom number -> anchor name.
%   No-ops for @cref keys or when value has fewer than 4 fields.
\def\codep@extractanchor#1#2{%
  \codep@ifcrefkey{#1}{}{%
    \codep@ifdatakey{#1}{}{%
      \expandafter\codep@extractanchor@ii
        \expandafter{\codep@grab4th#2{}{}{}{}\@nil}{#1}%
    }%
  }%
}
\def\codep@extractanchor@ii#1#2{%
  % #1 = anchor (4th field or empty), #2 = label key
  \def\codep@tmp{#1}%
  \ifx\codep@tmp\@empty\else
    \expandafter\ifx\csname codep@lblnum@#2\endcsname\relax\else
      % Resolve atom number first, then define the anchor mapping
      % using the prefixed key (type:number).
      \protected@edef\codep@tmp@num{%
        \csname codep@lblnum@#2\endcsname}%
      % Build prefixed key from type map if available.
      \expandafter\ifx\csname codep@ltype@#2\endcsname\relax
        % No type record: store under bare number (equation labels).
        \expandafter\xdef
          \csname codep@anchor@\codep@tmp@num\endcsname{#1}%
      \else
        \edef\codep@tmp@prefixed{%
          \csname codep@ltype@#2\endcsname:\codep@tmp@num}%
        \expandafter\xdef
          \csname codep@anchor@\codep@tmp@prefixed\endcsname{#1}%
      \fi
    \fi
  \fi
}
% \codep@ifdatakey{key}{then}{else}
%   True iff the label key ends in "@data" (thm-restate internal).
%   These contain \setcounter calls, not display numbers.
\def\codep@ifdatakey#1{%
  \codep@isdatafalse
  \def\codep@ifdatakey@probe##1@data##2\@nil{%
    \def\codep@tmp@b{##2}%
    \ifx\codep@tmp@b\@empty\else
      \def\codep@tmp@c{@data}%
      \ifx\codep@tmp@b\codep@tmp@c
        \codep@isdatatrue
      \fi
    \fi
  }%
  \codep@ifdatakey@probe#1@data\@nil
  \ifcodep@isdata
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}

% Flag used only inside \codep@ifcrefkey.
\newif\ifcodep@iscref
% Flag used only inside \codep@ifdatakey (separate from \ifcodep@iscref).
\newif\ifcodep@isdata

\def\codep@installnewlabel{%
  \let\codep@orig@newlabel\newlabel
  \def\newlabel##1##2{%
    \codep@orig@newlabel{##1}{##2}%
    \codep@extractlblnum{##1}{##2}%
    \codep@extractanchor{##1}{##2}%
  }%
  % Pre-2023 hyperref path: \newlabelxx has 6 args.  Hyperref
  % installs it in \AtBeginDocument and it races with our
  % override, so we override it too.
  \@ifundefined{newlabelxx}{}{%
    \let\codep@orig@newlabelxx\newlabelxx
    \def\newlabelxx##1##2##3##4##5##6{%
      \codep@orig@newlabelxx
        {##1}{##2}{##3}{##4}{##5}{##6}%
      % ##2 is already the display number for the 6-arg form.
      \expandafter\gdef
        \csname codep@lblnum@##1\endcsname{##2}%
      % ##5 is the hyperref anchor name; store reverse mapping
      % using prefixed key if type is known.
      \codep@ifcrefkey{##1}{}{%
        \def\codep@tmp{##5}%
        \ifx\codep@tmp\@empty\else
          \expandafter\ifx\csname codep@ltype@##1\endcsname\relax
            \expandafter\xdef
              \csname codep@anchor@##2\endcsname{##5}%
          \else
            \edef\codep@tmp@prefixed{%
              \csname codep@ltype@##1\endcsname:##2}%
            \expandafter\xdef
              \csname codep@anchor@\codep@tmp@prefixed\endcsname{##5}%
          \fi
        \fi
      }%
    }%
  }%
}

% \codep@extractlblnum{key}{value}
%   value is the raw 2nd arg of \newlabel; after TeX brace-
%   stripping it is "{num}{page}{...}{...}{...}".  Grab the
%   first brace group and stash it under the key.  Skip keys
%   that END in @cref (cleveref internal records).
\def\codep@extractlblnum#1#2{%
  \codep@ifcrefkey{#1}{%
    % @cref-suffixed: skip silently.
  }{%
    \expandafter\codep@extractlblnum@ii
      \expandafter{\codep@grabfirst#2\@nil}{#1}%
  }%
}
\def\codep@extractlblnum@ii#1#2{%
  \expandafter\gdef\csname codep@lblnum@#2\endcsname{#1}%
}

% Sentinel used by \codep@ifcrefkey.
\def\codep@ifcrefsentinel{@cref}

% \codep@ifcrefkey{key}{then}{else}
%   True iff the label key ENDS in "@cref".  Per REVIEW_D
%   finding #4, matching "any key containing @cref" incorrectly
%   dropped keys like "lemma@crefnum".  The delimited-arg probe
%   splits "<key>@cref\@nil" on the FIRST occurrence of "@cref";
%   the key ends in @cref iff the tail is exactly "@cref".
\def\codep@ifcrefkey#1{%
  \codep@iscreffalse
  \def\codep@ifcrefkey@probe##1@cref##2\@nil{%
    \def\codep@tmp@b{##2}%
    \ifx\codep@tmp@b\@empty
      % No @cref in the key at all; the probe's own trailing
      % @cref absorbed the split -> NOT a cref key.
    \else
      \ifx\codep@tmp@b\codep@ifcrefsentinel
        \codep@iscreftrue
      \fi
    \fi
  }%
  \codep@ifcrefkey@probe#1@cref\@nil
  \ifcodep@iscref
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}

%% --- Section 8a.7: Hook installation ---
%% Per REVIEW_D finding #2, codependent-owned labels on
%% begindocument/before get EXPLICIT relative ordering rather
%% than both claiming "before *".  The \DeclareHookRule below
%% pins \codep/backref/install to run before hyperref.

% Install the three \@setref-family patches AND the \newlabel
% override AND the active \codep@atomref callback at
% begindocument/before.  All three belong together because
% they co-depend on being in place before the .aux read during
% \begin{document}.
\AddToHook{begindocument/before}[codependent/backref/install]{%
  \codep@installatomrefpatch
  \codep@installnewlabel
  % Swap the providecommand no-ops for the active callbacks.
  \let\codep@atomref\codep@atomref@active
  \let\codep@lbltype\codep@lbltype@active
  % Activate anchormap BEFORE aux read so equation range anchors
  % like \codep@anchormap{equation:4.4--4.5}{codep.eq.3} are not discarded.
  \@ifpackageloaded{hyperref}{%
    \let\codep@anchormap\codep@anchormap@active
  }{}%
}

%% --- Section 8a.9: Concept-aware forward-reference resolution ---
%% Active callbacks for \codep@concept and \codep@conceptref.
%% Defined here (at package-load time, under \makeatletter);
%% swapped in at begindocument/before by \let, following the
%% same pattern as \codep@atomref@active.

% \codep@concept@active{name}{atomnum}
%   Populate the concept def-site map.  Per J3, silently
%   overwrite on duplicate aux records (stale prior-run).
\def\codep@concept@active#1#2{%
  \expandafter\gdef
    \csname codep@conceptdef@#1\endcsname{#2}%
}

% \codep@conceptref@active{srcatom}{conceptname}
%   If the def site is already in the concept map, resolve
%   immediately; otherwise defer to \codep@conceptpending
%   for retry after the full aux read completes.
\def\codep@conceptref@active#1#2{%
  \@ifundefined{codep@conceptdef@#2}%
    {\g@addto@macro\codep@conceptpending{%
       \codep@resolveconcept{#1}{#2}}}%
    {\codep@resolveconcept{#1}{#2}}%
}

% \codep@resolveconcept{srcatom}{conceptname}
%   Concept resolution callback.  Originally fed concept edges
%   into the backref linked list via \codep@appendbr; this was
%   removed (2026-04-11) because concept edges are NOT cross-
%   references — they should not appear in "Used in" lists.
%   The .aux records (\codep@concept, \codep@conceptref) and
%   .cdp records (\codep@cdp@def, \codep@cdp@use) remain
%   intact for the CLI layer.  The concept warning system
%   (\codep@conceptwarnscan) also remains.  This function is
%   now a silent no-op; it is kept so that stale .aux files
%   containing \codep@conceptref records (which trigger
%   \codep@resolveconcept via the pending list) do not error.
\def\codep@resolveconcept#1#2{}

% Swap the providecommand no-ops for the active callbacks
% at begindocument/before, before the .aux read.
\AddToHook{begindocument/before}[codependent/concept/install]{%
  \let\codep@concept\codep@concept@active
  \let\codep@conceptref\codep@conceptref@active
}

% Flush the backref queue AFTER aux has been read.  The aux
% read happens during the kernel's \document macro before any
% \AtBeginDocument hook fires, so begindocument/end is safe.
\AddToHook{begindocument/end}[codependent/backref/flush]{%
  \codep@flushbrqueue
}

% Flush the concept pending list AFTER the backref queue
% flush.  Deferred \codep@resolveconcept calls expand here;
% the concept map is now complete from the full aux read.
\AddToHook{begindocument/end}[codependent/concept/flush]{%
  \codep@conceptpending
  \global\let\codep@conceptpending\@empty
}

% External ordering: run before hyperref wraps \@setref a
% second time in its \AtBeginDocument-equivalent hooks.
\DeclareHookRule{begindocument/before}%
  {codependent/backref/install}{before}{hyperref}

% Internal dependency: sbl open sees the backref install.
\DeclareHookRule{begindocument/before}{codependent/sbl/open}%
                {after}{codependent/backref/install}

% Concept install fires AFTER backref install (needs
% \codep@recordbr to be in place).
\DeclareHookRule{begindocument/before}%
  {codependent/concept/install}{after}{codependent/backref/install}

% Concept flush fires AFTER backref flush.  Concept edges
% use \codep@appendbr (direct node-list append, no queue),
% so ordering with the queue flush is not critical.  The
% "after" ordering ensures the backref queue processes first
% and concept edges are appended on top.
\DeclareHookRule{begindocument/end}%
  {codependent/concept/flush}{after}{codependent/backref/flush}

%% ===================================================================
%% Section 8: Back-reference emission
%% ===================================================================

% \codep@queuebackref{atomnumber}
%   Look up back-refs for the given atom and queue for emission.
%   Lazily materialises \codep@br@#1 via \codep@collapsebr
%   (§8a.3), which walks the per-target linked-list nodes built
%   from \codep@atomref aux records.  Collapse is idempotent, so
%   calling it unconditionally is fine.
\newcommand*{\codep@queuebackref}[1]{%
  \ifbool{codep@backrefs}{%
    \codep@pendingbr={}%
    \codep@collapsebr{#1}%
    % After collapse, codep@br@#1 is either \@empty (no refs)
    % or a comma-joined ref list.  \@ifundefined cannot
    % distinguish \@empty from real data (collapsebr always
    % defines the csname), so use \ifx against \@empty instead.
    \expandafter\ifx\csname codep@br@#1\endcsname\@empty
      % No refs to this target (collapsed to \@empty): skip.
    \else
      \ifbool{codep@appendix}{}{%
        % Inline mode: store ref list for flush.
        \codep@pendingbr=\expandafter{%
          \csname codep@br@#1\endcsname}%
      }%
    \fi
  }{}%
}

% \codep@flushbackref
%   Emit the pending back-reference and clear it.
%   The pendingbr register is cleared BEFORE rendering so that
%   the \par inside \codep@renderbackref cannot re-enter
%   flushbackref with the same data (para/end → flushbackref
%   → renderbackref → \par → para/end → flushbackref loop).
\newcommand*{\codep@flushbackref}{%
  \ifbool{codep@backrefs}{%
    \ifbool{codep@appendix}{}{%
      \expandafter\def\expandafter\codep@tmp\expandafter{%
        \the\codep@pendingbr}%
      \codep@pendingbr={}%
      \ifx\codep@tmp\@empty\else
        \codep@renderbackref{\codep@tmp}%
      \fi
    }%
  }{}%
}

% \codep@formatusedin{reflist}
%   Shared formatting helper for "Used in" lines.  Both the
%   inline path (\codep@renderbackref) and the deferred
%   paragraph path (\vadjust pre in \codep@installparahook)
%   call this, so overriding it changes ALL rendering.
%   Reads font/prefix/label from \codepsetup configuration.
\newcommand*{\codep@formatusedin}[1]{%
  {\normalfont\codep@backreffont
   \codep@applycolor{\codep@backrefprefix\codep@backreflabel\space#1.}}}
% \codep@applycolor{text}
%   Wrap text in \textcolor if backref-color is set and a
%   color package (xcolor or color) is loaded.  Falls back
%   to plain text if \textcolor is unavailable.
\newcommand*{\codep@applycolor}[1]{%
  \ifx\codep@backrefcolor\@empty
    #1%
  \else
    \@ifundefined{textcolor}{#1}{\textcolor{\codep@backrefcolor}{#1}}%
  \fi}

% \codep@truncatereflist{reflist}
%   If reflist has more than \codep@backrefmarginmax comma-separated
%   entries, truncate and append "...".  Currently a pass-through
%   stub; proper comma-counting can be added later without changing
%   the rendering contract.
\newcommand*{\codep@truncatereflist}[1]{#1}

% \codep@emitmarginbackref{content}
%   Shared right-margin emission kernel used by \codep@rendermargin
%   and the margin branch of \codep@renderbackref@para.
%   Wraps content in \vbox{\hbox to \linewidth{\hfil\smash{\rlap{...}}}}
%   so it projects past \linewidth without disturbing vertical spacing.
\def\codep@emitmarginbackref#1{%
  \vbox{%
    \hbox to \linewidth{%
      \hfil
      \smash{%
        \rlap{%
          #1%
        }%
      }%
    }%
    \vskip\smallskipamount
  }%
}%

% \codep@rendermargin{reflist}
%   Render "Used in X, Y." in the right margin (past \linewidth).
%   Uses \rlap so it does not conflict with atom numbers in the left margin.
%   Used for margin backref-style on theorem atoms (non-paragraph).
\newcommand*{\codep@rendermargin}[1]{%
  \nobreak
  \codep@emitmarginbackref{%
    \kern0.5em
    {\codep@backreffont\codep@backrefprefix
     \codep@backreflabel\space
     \codep@truncatereflist{#1}.}%
  }%
}

% \codep@renderbackref{reflist}
%   Render "Used in X, Y." at the end of the current atom.
%   Used for theorem/definition/lemma atoms (non-paragraph).
%   Respects backref-style and backref-align configuration.
\newcommand*{\codep@renderbackref}[1]{%
  \ifx\codep@backrefstyle\codep@const@below
    % Below style: separate line after the atom.
    \ifx\codep@backrefalign\codep@const@right
      \leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill
      \quad\codep@formatusedin{#1}%
    \else
      \leavevmode\unskip\par\nobreak
      \codep@formatusedin{#1}\hfill\null
    \fi
    \par\addvspace{\medskipamount}%
  \else\ifx\codep@backrefstyle\codep@const@inline
    % Inline style: same line as content, flows with text.
    % Flush happens from cmd/end#1/before (hmode, before endmark).
    % After display math the hlist is empty (\lastnodetype=-1);
    % after text/inline-math it holds character/math nodes.
    % Add the 0.5em gap only when there is preceding content,
    % so "Used in" sits flush-left when it falls on its own line.
    %
    % The cmd/end#1/before hook evaluates conditionals during
    % hook expansion, NOT at typesetting time.  Mode tests
    % (\ifvmode, \lastnodetype) return wrong values during hook
    % expansion.  We defer the spacing conditional to typesetting
    % time via \toks@: TeX inserts the tokens unexpanded, and the
    % \ifvmode / \lastnodetype checks fire when TeX processes them
    % in the env body.
    \def\codep@inline@arg{#1}%
    \toks@{%
      \ifvmode
        \noindent
      \else
        \ifnum\lastnodetype<\z@
          % Hmode but the horizontal list is empty (typical after
          % display math).  A \parindent-width indent box may or
          % may not be present; neutralise it by ending the
          % current paragraph and starting fresh with \noindent.
          \par\nobreak\noindent
        \else
          \unskip\hspace{0.5em}%
        \fi
      \fi
      \expandafter\codep@formatusedin\expandafter{\codep@inline@arg}%
    }%
    \the\toks@
  \else
    % Margin style: emit in right margin.
    \codep@rendermargin{#1}%
  \fi\fi
}

% \codep@renderbackref@para{reflist}
%   Render "Used in" inside a \vadjust pre context (vertical
%   mode).  Used for paragraph atoms via the deferred-backref
%   mechanism.  Calls \codep@formatusedin for the text.
%   Respects backref-style and backref-align configuration.
\newcommand*{\codep@renderbackref@para}[1]{%
  \nobreak
  \ifx\codep@backrefstyle\codep@const@below
    % Below style
    \vbox{%
      \hbox to \linewidth{%
        \ifx\codep@backrefalign\codep@const@right
          \hfil\codep@formatusedin{#1}%
        \else
          \codep@formatusedin{#1}\hfil
        \fi
      }%
      \vskip\medskipamount
    }%
  \else\ifx\codep@backrefstyle\codep@const@inline
    % Inline style for paragraphs: falls back to block-like rendering
    % (no clean way to inline at paragraph end).  Compact spacing.
    \vbox{%
      \hbox to \linewidth{%
        \hfil\codep@formatusedin{#1}%
      }%
      \vskip\smallskipamount
    }%
  \else
    % Margin style: emit in the right margin (past \linewidth).
    % Uses \rlap without \vtop — paragraph mode inside a box
    % here triggers the para/begin hook recursively (LaTeX 2022+
    % para hooks bypass \everypar).  Long reflists are handled
    % by \codep@truncatereflist instead of line-wrapping.
    \codep@emitmarginbackref{%
      \kern0.5em
      {\codep@backreffont\codep@backrefprefix
       \codep@backreflabel\space
       \codep@truncatereflist{#1}.}%
    }%
  \fi\fi
}

% Deferred backref: data saved at para/end, emitted at the
% next para/begin.  Avoids mode-change error (para/end must
% stay in horizontal mode; \codep@renderbackref needs \par).
\gdef\codep@deferredbr{}

% \codep@parendhook@snapshot
%   Snapshot pending backref data into \codep@deferredbr.
%   Clears the pendingbr register.  Called from the para/end
%   hook when inline backrefs are active and not in appendix mode.
\def\codep@parendhook@snapshot{%
  \expandafter\def\expandafter\codep@tmp\expandafter{%
    \the\codep@pendingbr}%
  \codep@pendingbr={}%
  \ifx\codep@tmp\@empty\else
    \global\let\codep@deferredbr\codep@tmp
  \fi
}%

% \codep@installparendhook
%   Install the para/end hook for flushing back-refs.
%   Per §8a.5, clears \codep@currentatom after the flush so
%   that any \ref firing between paragraphs is not attributed
%   to the just-closed atom.
%   Instead of calling \codep@flushbackref (which does \par
%   via \codep@renderbackref), we snapshot the pending br data into
%   \codep@deferredbr and clear the register.  The deferred
%   data is emitted at the NEXT para/begin, before the new
%   atom's margin number.
\newcommand*{\codep@installparendhook}{%
  \AddToHook{para/end}{%
    \ifbool{codep@tracked}{%
      \ifbool{codep@intheorem}{}{%
        \ifbool{codep@backrefs}{%
          \ifbool{codep@appendix}{}{\codep@render@paraend@snapshot}%
        }{}%
        \let\codep@currentatom\@empty
        \let\codep@currenttype\@empty
      }%
    }{}%
  }%
}

%% ===================================================================
%% Section 9a: Semantic sidecar (.cdp) writer
%% ===================================================================
%%
%% Write-only sidecar file for Layer 2 (semantic CLI).  The .sty
%% never reads .cdp — it is strictly one-way output.  Record format
%% is line-oriented: one \codep@cdp@* control sequence per line
%% with fixed-arity brace-delimited arguments (no kv blobs).
%%

% \codep@cdpwrite{text}
%   Guarded write to the .cdp stream.  No-op when the stream
%   is not open (e.g. \if@filesw is false).
\newcommand*{\codep@cdpwrite}[1]{%
  \ifbool{codep@cdpopen}{%
    \immediate\write\codep@cdpout{#1}%
  }{}%
}

% \codep@cdpwrite@atom{text}
%   Atom-scoped guard: drops the write when not inside a tracked
%   atom (\codep@currentatom is empty).
\newcommand*{\codep@cdpwrite@atom}[1]{%
  \ifx\codep@currentatom\@empty\else
    \codep@cdpwrite{#1}%
  \fi
}

%% --- Section 9a open hook (begindocument/before) ---
%% Per REVIEW_C finding #5, the stream opens at begindocument/before
%% (before any \AtBeginDocument hook), so atoms emitted from user
%% hooks are never silently dropped.
\AddToHook{begindocument/before}[codependent/sbl/open]{%
  \if@filesw
    \newwrite\codep@cdpout
    \immediate\openout\codep@cdpout=\jobname.cdp\relax
    \global\booltrue{codep@cdpopen}%
    \immediate\write\codep@cdpout{%
      \string\codep@cdp@version{1}}%
    \immediate\write\codep@cdpout{%
      \string\codep@cdp@source{\jobname.tex}}%
  \fi
}

%% --- Section 9a close hook (\AtEndDocument) ---
%% Write the \codep@cdp@end{OK} sentinel and close the stream.
%% Per REVIEW_C finding #7, the sentinel's presence is the CLI's
%% test for "complete file".
\AtEndDocument{%
  \ifbool{codep@cdpopen}{%
    \immediate\write\codep@cdpout{%
      \string\codep@cdp@end{OK}}%
    \immediate\closeout\codep@cdpout
    \global\boolfalse{codep@cdpopen}%
  }{}%
}

%% --- Section 9a label wrap (cleveref-aware) ---
%% Installed at begindocument/before so we capture \label BEFORE
%% cleveref's \AtBeginDocument wrapper installs around us (see
%% DESIGN.md §9a "Label wrap" double-wrap explanation).
\AddToHook{begindocument/before}[codependent/sbl/labelwrap]{%
  \let\codep@orig@label\label
  \@ifpackageloaded{cleveref}{%
    %% cleveref path: \label[type]{key}, optional arg.
    \def\label{%
      \@ifnextchar[%]
        \codep@cdp@label@withopt
        \codep@cdp@label@noopt
    }%
  }{%
    %% No cleveref: \label{key} only.
    \def\label#1{%
      \codep@cdpwrite@atom{%
        \string\codep@cdp@label
          {\theatom}{#1}}%
      \codep@writelbltype{#1}%
      \codep@orig@label{#1}%
    }%
  }%
}
\def\codep@cdp@label@withopt[#1]#2{%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@label
      {\theatom}{#2}}%
  \codep@writelbltype{#2}%
  \codep@orig@label[#1]{#2}%
}
\def\codep@cdp@label@noopt#1{%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@label
      {\theatom}{#1}}%
  \codep@writelbltype{#1}%
  \codep@orig@label{#1}%
}

% \codep@writelbltype{label}
%   Write the current atom type prefix to .aux for this label.
%   Guards on \codep@currentatom (in-atom) and \if@filesw.
\def\codep@writelbltype#1{%
  \ifx\codep@currentatom\@empty\else
    \if@filesw
      \protected@write\@auxout{}{%
        \string\codep@lbltype{#1}{\codep@currenttype}}%
    \fi
  \fi
}%

%% --- Section 9a concept-tracking helpers ---
%% Supporting macros for \codepnewcommand / \codepNewDocumentCommand.
%% The public API lives in Section 10; the emit helpers live here
%% because they write to both .cdp and .aux.

% \codep@cdpwrite@deferred{text}
%   Accumulate a deferred .cdp write for preamble-time emission.
%   Records queued here are flushed once the .cdp stream opens.
%   Used for \codep@cdp@cmddef records whose declarations occur
%   in the preamble before the stream is available.
%   IMPORTANT: the argument must already be fully expanded (no
%   transient macros like \codep@tmp@name) because \g@addto@macro
%   does not expand its argument.  Callers use \edef to pre-build
%   the record string.
\newcommand*{\codep@cdpwrite@deferred}[1]{%
  \ifbool{codep@cdpopen}{%
    % Stream already open (late declaration): write immediately.
    \codep@cdpwrite{#1}%
  }{%
    \g@addto@macro\codep@cdp@deferred{%
      \codep@cdpwrite{#1}}%
  }%
}

% Flush deferred sbl writes after the stream opens.
\AddToHook{begindocument/before}[codependent/sbl/cmddef]{%
  \codep@cdp@deferred
  \global\let\codep@cdp@deferred\@empty
}
% Must run AFTER the sbl open hook.
\DeclareHookRule{begindocument/before}{codependent/sbl/cmddef}%
                {after}{codependent/sbl/open}

% \codep@emit@def{name}
%   Star-branch handler: fires when \cmd* is used (defining site).
%   Records the current atom as the defining site for the named
%   concept.  Emits both .aux and .cdp records.  Per J2: empty-
%   currentatom short-circuit fires BEFORE the duplicate-def check.
%   name -- bare command name (e.g. "Hom")
\newcommand*{\codep@emit@def}[1]{%
  \ifx\codep@currentatom\@empty
    % No atom context (footnote, caption, orphan): silent no-op
    % per §8a.9 error model.
  \else
    \@ifundefined{codep@concept@#1}%
      {\expandafter\xdef
         \csname codep@concept@#1\endcsname
         {\theatom}%
       \if@filesw
         \immediate\write\@auxout{%
           \string\codep@concept{#1}{\theatom}}%
       \fi
       \codep@cdpwrite@atom{%
         \string\codep@cdp@def{\theatom}{#1}}%
      }%
      {\PackageError{codependent}%
        {\string\\#1* defined at atoms
         \csname codep@concept@#1\endcsname\space and
         \theatom}%
        {Exactly one definition site is permitted per
         concept.  Use \string\\#1\space (without star)
         at the non-definitional site.}%
      }%
  \fi}

% \codep@emit@use{name}
%   Non-star-branch handler: fires when \cmd is used (use site).
%   Emits both .aux and .cdp records under the current atom guard.
%   Registers the concept name for the missing-def-site scan at
%   \AtEndDocument (first-use only, guarded by conceptused csname).
%   name -- bare command name (e.g. "Hom")
\newcommand*{\codep@emit@use}[1]{%
  \ifx\codep@currentatom\@empty\else
    % Register concept name for end-document missing-def scan.
    \@ifundefined{codep@conceptused@#1}{%
      \expandafter\gdef
        \csname codep@conceptused@#1\endcsname{1}%
      \g@addto@macro\codep@conceptnames{\do{#1}}%
    }{}%
    \if@filesw
      \immediate\write\@auxout{%
        \string\codep@conceptref{\theatom}{#1}}%
    \fi
    \codep@cdpwrite@atom{%
      \string\codep@cdp@use{\theatom}{#1}}%
  \fi}

%% --- Section 9a.9: Concept missing-def-site scan ---
%% At \AtEndDocument, walk the concept name list and check each
%% concept for a matching def site.  Concepts with uses but no
%% def site trigger a warning (or info per conceptwarnings option).

% \codep@conceptwarnscan
%   Walk \codep@conceptnames via \do.  For each concept name,
%   check if codep@conceptdef@<name> is defined.  If not, the
%   concept has uses but no \cmd* def-site marker; warn.
\def\codep@conceptwarnscan{%
  \def\do##1{%
    \@ifundefined{codep@conceptdef@##1}{%
      \ifbool{codep@conceptwarnings}{%
        \PackageWarning{codependent}{%
          \expandafter\string\csname ##1\endcsname\space
          used but no starred definition site found;\MessageBreak
          backrefs for this concept are disabled}%
      }{%
        \PackageInfo{codependent}{%
          \expandafter\string\csname ##1\endcsname\space
          used but no starred definition site found
          (conceptwarnings=off)}%
      }%
    }{}%
  }%
  \codep@conceptnames
}

%% --- Section 9a.10: Shared wrapper-pipeline helper ---

% \codep@definetrackedcmd{name}{cmd}{kind}{key2}{val2}
%   Common pipeline shared by \codepnewcommand and
%   \codepNewDocumentCommand.  The declaration step (step 1) is
%   handled by the caller before invoking this helper.
%   name -- bare command name string (e.g. "Hom")
%   cmd  -- the command token (e.g. \Hom), already declared by caller
%   kind -- kind string for the .cdp cmddef record
%   key2 -- second .cdp attribute key (arity / argspec)
%   val2 -- second .cdp attribute value (pre-expanded by caller)
%
%   Steps performed:
%   2. Save original body to codep@body@<name>.
%   3. Define star/nostar dispatch helpers codep@star@<name> and
%      codep@nostar@<name> via \edef.
%   4. Redefine \cmd as a \protected\edef \@ifstar dispatcher.
%   5. Emit three deferred .cdp cmddef records: kind, key2/val2, src.
\def\codep@definetrackedcmd#1#2#3#4#5{%
  % 2. Save the original definition.
  \expandafter\let
    \csname codep@body@#1\endcsname#2%
  % 3. Define star/nostar dispatch targets.
  \expandafter\edef
    \csname codep@star@#1\endcsname{%
      \noexpand\codep@emit@def{#1}%
      \expandafter\noexpand
        \csname codep@body@#1\endcsname}%
  \expandafter\edef
    \csname codep@nostar@#1\endcsname{%
      \noexpand\codep@emit@use{#1}%
      \expandafter\noexpand
        \csname codep@body@#1\endcsname}%
  % 4. Redefine the command with star dispatch via \@ifstar.
  %    \protected\edef makes the wrapper robust so it survives
  %    expansion in moving arguments (\section titles, captions,
  %    .aux writes) without premature \@ifstar expansion.
  \protected\edef#2{%
    \noexpand\@ifstar
      \expandafter\noexpand
        \csname codep@star@#1\endcsname
      \expandafter\noexpand
        \csname codep@nostar@#1\endcsname}%
  % 5. Emit global declaration records (deferred: the .cdp
  %    stream may not be open yet during the preamble).
  %    Records are pre-expanded via \edef so transient values
  %    (#1, \inputlineno) are captured eagerly.
  \edef\codep@tmp@rec{%
    \noexpand\codep@cdpwrite@deferred{%
      \string\codep@cdp@cmddef{#1}%
      {kind}{#3}}%
    \noexpand\codep@cdpwrite@deferred{%
      \string\codep@cdp@cmddef{#1}%
      {#4}{#5}}%
    \noexpand\codep@cdpwrite@deferred{%
      \string\codep@cdp@cmddef{#1}%
      {src}{\jobname.tex:\the\inputlineno:1}}%
  }%
  \codep@tmp@rec
}

\AtEndDocument{%
  \codep@conceptwarnscan
}

% Flush any deferred backref from the last paragraph.
% Without this, a backref on the final paragraph is lost because
% there is no subsequent para/begin to emit it.
\AtEndDocument{%
  \codep@render@enddocument@flush
}

%% ===================================================================
%% Section 10: User-facing API
%% ===================================================================

% \codep@extractfirst  env1,env2,...\@nil
%   Extract the first comma-separated element into \codep@basecounter.
\def\codep@extractfirst#1,#2\@nil{\def\codep@basecounter{#1}}

% \codeptrack{env1,env2,...}
%   Post-hoc alias base counter to atom counter and install all
%   hooks.  Must be called AFTER all \newtheorem declarations.
%   env1, env2, ... -- comma-separated environment names to track.
%   The first env name is auto-detected as the base counter name.
\newcommand*{\codeptrack}[1]{%
  % Guard against double invocation (newcounter{atom} would crash).
  \ifbool{codep@tracked}{%
    \PackageError{codependent}%
      {\string\codeptrack\space called twice}%
      {Call \string\codeptrack\space only once, after all
       theorem declarations.}%
  }{}%
  \booltrue{codep@tracked}%
  % Auto-detect the base counter from the first environment name.
  \codep@extractfirst#1,\@nil
  % Check that the base counter exists (i.e. \newtheorem was called).
  \@ifundefined{c@\codep@basecounter}{%
    \PackageError{codependent}%
      {Counter '\codep@basecounter' undefined -- %
       \string\codeptrack\space called before
       \string\newtheorem}%
      {Declare all theorem environments with
       \string\newtheorem\space before calling
       \string\codeptrack.}%
  }{}%
  \codep@setupcounter
  % Hook each listed environment and its starred variant.
  % Note: \expandafter ensures the env name is fully expanded
  % before \codep@hooktheorem captures it in \AddToHook
  % bodies; without this, a stale \codep@tmp reference would
  % resolve to the wrong name at hook-fire time.
  \@for\codep@tmp:=#1\do{%
    \ifx\codep@tmp\@empty\else
      % Re-alias this env's counter to \c@atom.  When thmtools
      % declares an env with sibling=<base>, it \let-aliases
      % \c@<env> to \c@<base> at declaration time.  But
      % \codep@setupcounter later replaces \c@<base> with
      % \c@atom; the sibling counters still point to the old
      % register.  This re-let ensures every tracked env's
      % counter is \c@atom, regardless of declaration order.
      \expandafter\@ifundefined\expandafter{%
        \expandafter c@\codep@tmp
      }{}{%
        \expandafter\let\csname c@\codep@tmp\endcsname\c@atom
        % Also alias the display macro \the<env> to \theatom.
        % When thmtools declares an env with sibling=<base>, it
        % snapshots \the<base> at declaration time.  If codependent
        % later rewires \the<base> to \theatom, the sibling's
        % display macro still has the old format.  This re-let
        % ensures every tracked env uses the atom display format.
        \expandafter\let\csname the\codep@tmp\endcsname\theatom
      }%
      \expandafter\codep@hooktheorem
        \expandafter{\codep@tmp}%
      % Auto-register starred variant (amsthm creates foo*).
      \edef\codep@starred{\codep@tmp*}%
      \expandafter\@ifundefined\expandafter{%
        \codep@starred
      }{}{%
        \expandafter\codep@hooktheorem
          \expandafter{\codep@starred}%
      }%
    \fi
  }%
  \codep@hookproof
  % Install suppression and paragraph hooks.
  \codep@installsuppress
  \codep@suppresssectioning
  % Defer section title capture to begindocument/end so that
  % hyperref's \addcontentsline redefinition has already run.
  \AddToHook{begindocument/end}[codependent/sectitle]{%
    \codep@capturesectitle}%
  \codep@suppresscommands
  \codep@installparahook
  \codep@installparendhook
}

% \codeptag{kind}{value}
%   Emit a semantic tag record to the .cdp sidecar, scoped to the
%   current atom.  No visible typesetting effect.  Ignored outside
%   a tracked atom.
%   kind  -- tag category (e.g. uid, introduces, type)
%   value -- tag payload (free-form UTF-8)
\newcommand*{\codeptag}[2]{%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@tag
    {\theatom}{#1}{#2}}%
}

% \codepproofof{label}    — "Used in 2.4*" links to the theorem
% \codepproofof*{label}   — "Used in 2.4*" links to the proof
%   Associate a separated proof with its theorem.  Must be called
%   inside a \begin{proof}...\end{proof} environment.  Looks up
%   the label's atom number and sets the current atom to the
%   starred version (e.g., 2.1*), enabling correct backref
%   attribution.
%
%   The starred form writes an anchormap entry so the hyperlink
%   for the starred backref points to the proof location instead
%   of falling back to the theorem.  Use this when the proof is
%   far from the theorem and the reader should be taken to the
%   proof, not back to the statement.
%
%   Edge case: if the proof was non-adjacent, \codep@hookproof
%   already called \refstepcounter{atom} and wrote SBL records for
%   a standalone atom.  Then \codepproofof overrides
%   \codep@currentatom.  This means:
%   - The counter was already incremented (gap exists, acceptable)
%   - The SBL has both a standalone \codep@cdp@atom{N}{proof}
%     AND a \codep@cdp@proof{M*} -- the CLI can handle this
%     (the proofof record takes precedence)
%   - The backref source switches to starred mid-proof -- any
%     \ref calls BEFORE \codepproofof use the standalone number,
%     after it use the starred number
\newcommand{\codepproofof}{%
  \@ifstar{\codep@proofof@star}{\codep@proofof@plain}}
\def\codep@proofof@plain#1{\codep@proofof@do{#1}{}}
\def\codep@proofof@star#1{\codep@proofof@do{#1}{anchor}}
\def\codep@proofof@do#1#2{%
  \ifbool{codep@proofsnumbered}{%
    \expandafter\ifx\csname codep@lblnum@#1\endcsname\relax
      \PackageWarning{codependent}{\string\codepproofof: unknown label '#1'.
        The label may not exist or may not have been processed yet}%
    \else
      % Construct proof:X key from resolved label number.
      \edef\codep@currentatom{%
        proof:\csname codep@lblnum@#1\endcsname}%
      \def\codep@currenttype{proof}%
      % Update source atom for proof-prefixed backref emission.
      \edef\codep@sourceatom{\codep@currentatom}%
      % Write CDP sub-record (bare display form with star).
      \codep@cdpwrite@atom{%
        \string\codep@cdp@proof{%
          \csname codep@lblnum@#1\endcsname*}}%
      % Starred form: anchor the link at the proof location.
      \def\codep@tmp{#2}%
      \ifx\codep@tmp\@empty\else
        \codep@writeanchormap{\codep@currentatom}%
      \fi
    \fi
  }{}%
}

% \codepnewcommand{\cmd}[arity]{body}
%   Define a command with codependent concept tracking.  Mirrors
%   \newcommand exactly: \cmd with backslash, optional [arity]
%   (default 0), mandatory {body} using #1..#N.
%
%   At declaration time, emits three global .cdp records:
%     \codep@cdp@cmddef{name}{kind}{newcommand}
%     \codep@cdp@cmddef{name}{arity}{N}
%     \codep@cdp@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command answers both
%   \cmd (use site) and \cmd* (def site).  Both forms typeset
%   the same body; the star controls which emit helper fires.
%
%   \cmd  -- command to define (with backslash, e.g. \Hom)
%   arity -- optional integer 0..9 (default 0)
%   body  -- replacement text, uses #1..#N
\NewDocumentCommand{\codepnewcommand}{m O{0} +m}{%
  % #1 = \cmd (with backslash), #2 = arity, #3 = body.
  \edef\codep@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \newcommand (handles all #-
  %    numbering naturally).
  \newcommand#1[#2]{#3}%
  % 2-5. Shared pipeline: save body, build wrappers, emit .cdp.
  \codep@definetrackedcmd{\codep@tmp@name}{#1}%
    {newcommand}{arity}{\number#2}%
}
% Deprecated alias — old documents using \codepNewCommand still work.
\let\codepNewCommand\codepnewcommand

% \codepNewDocumentCommand{\cmd}{argspec}{body}
%   Define a command with codependent concept tracking, using xparse's
%   full argument specification.  Mirrors \NewDocumentCommand
%   exactly: \cmd with backslash, {argspec} string, {body}.
%
%   At declaration time, emits three global .cdp records:
%     \codep@cdp@cmddef{name}{kind}{NewDocumentCommand}
%     \codep@cdp@cmddef{name}{argspec}{<user-spec>}
%     \codep@cdp@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command prepends a codependent
%   star to the user's argspec.  \cmd* marks a def site; \cmd
%   marks a use site.  Both typeset the same body.  If the
%   user's argspec itself starts with "s", the user's star
%   requires a second "*" at call time (e.g. \cmd** for
%   codependent-def + user-star).
%
%   \cmd    -- command to define (with backslash)
%   argspec -- xparse argument specification string
%   body    -- replacement text, uses #1..#N per the spec
\NewDocumentCommand{\codepNewDocumentCommand}{m m +m}{%
  % #1 = \cmd, #2 = argspec, #3 = body.
  \edef\codep@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \NewDocumentCommand (handles
  %    all xparse arg types and #-numbering naturally).
  \NewDocumentCommand{#1}{#2}{#3}%
  % 2-5. Shared pipeline: save body, build wrappers, emit .cdp.
  \codep@definetrackedcmd{\codep@tmp@name}{#1}%
    {NewDocumentCommand}{argspec}{#2}%
}

% \codeptrackeq{envname}
%   Register a custom single-number equation environment (Track 1).
\newcommand*{\codeptrackeq}[1]{\codep@trackeqenv{#1}}
% \codeptrackalign{envname}
%   Register a custom multi-number equation environment (Track 2).
\newcommand*{\codeptrackalign}[1]{\codep@trackalignenv{#1}}

% \codepsuppress{envname}
%   Register a user environment for paragraph-number suppression.
%   envname -- environment name to suppress
\newcommand*{\codepsuppress}[1]{%
  \codep@suppressenv{#1}%
}

% \codepsuppresscmd{\command}
%   Register a user command for paragraph-number suppression.
%   \command -- command to patch
\newcommand*{\codepsuppresscmd}[1]{%
  \codep@suppresscmd{#1}%
}

% \codepappendix
%   Typeset the dependency index (appendix mode only).
%   Walks the atom array (populated at each atom site) and
%   emits an entry for every atom that has at least one
%   back-reference.  Emits section headers (via
%   \codep@appendixsection) when the section number changes
%   between consecutive atoms, using titles captured from
%   \addcontentsline during the document body.
\newcommand*{\codepappendix}{%
  \ifbool{codep@appendix}{%
    \section*{Dependency Index}%
    \begingroup
      \small
      \def\codep@appendix@lastsec{}%
      \count@=\z@
      \loop
        \ifnum\count@<\codep@atomcount
        \advance\count@ by 1\relax
        % Check for section change and emit header if needed.
        \edef\codep@appendix@thissec{%
          \csname codep@atom@sec@\the\count@\endcsname}%
        \ifx\codep@appendix@thissec\codep@appendix@lastsec
        \else
          \ifx\codep@appendix@thissec\@empty\else
            \edef\codep@appendix@thistitle{%
              \csname codep@sectitle@%
                \codep@appendix@thissec\endcsname}%
            \ifx\codep@appendix@thistitle\relax\else
              \codep@appendixsection%
                {\codep@appendix@thissec}%
                {\codep@appendix@thistitle}%
            \fi
          \fi
          \let\codep@appendix@lastsec
            \codep@appendix@thissec
        \fi
        \expandafter\expandafter\expandafter
          \codep@appendix@emit
          \csname codep@atom@\the\count@\endcsname
      \repeat
    \endgroup
  }{%
    \PackageWarning{codependent}{%
      \string\codepappendix\space ignored: %
      backrefs mode is not 'appendix'}%
  }%
}

% \codep@appendix@emit{prefixedkey}{type}
%   Collapse back-refs for the prefixed atom key and emit an
%   appendix entry if any back-references exist.  The display
%   number is derived from the prefixed key via \codep@displayfromkey.
\def\codep@appendix@emit#1#2{%
  \codep@collapsebr{#1}%
  \expandafter\ifx\csname codep@br@#1\endcsname\@empty\else
    \codep@appendixentry{\codep@displayfromkey{#1}}{#2}{%
      \csname codep@br@#1\endcsname}%
  \fi
}

% Appendix rendering helpers.
% \codep@appendixsection{number}{title}
\newcommand*{\codep@appendixsection}[2]{%
  \par\medskip\noindent
  \textbf{#1\quad #2}\par
}

% \codep@appendixentry{atomnumber}{atomname}{reflist}
\newcommand*{\codep@appendixentry}[3]{%
  \par\noindent
  \hspace{1.5em}%
  #1\quad #2\quad\dotfill\quad
  \begin{minipage}[t]{0.45\linewidth}%
    \raggedright #3%
  \end{minipage}%
}

%% ===================================================================
%% Section 11: Compatibility guards
%% ===================================================================

% Guard: require LaTeX2e kernel with hook management.
\@ifundefined{AddToHook}{%
  \PackageError{codependent}{%
    LaTeX kernel too old (need 2021+)}{%
    codependent requires \string\AddToHook\space
    (TeX Live 2021 or later).%
  }%
}{}

% Hyperref link wrapping for backref numbers.
% Receives a prefixed key (e.g. theorem:2.1, equation:3.1, proof:2.1).
% Default (no hyperref): render display form via \codep@displayfromkey.
% With hyperref: render display form wrapped in \hyperlink to the
% anchor stored under the prefixed key.
\newcommand*{\codep@brhyper}[1]{\codep@displayfromkey{#1}}

\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \PackageInfo{codependent}{hyperref detected, enabling links}%
    \renewcommand*{\codep@brhyper}[1]{%
      \expandafter\ifx\csname codep@anchor@#1\endcsname\relax
        \codep@brhyper@noanchor{#1}%
      \else
        \hyperlink{\csname codep@anchor@#1\endcsname}{%
          \codep@displayfromkey{#1}}%
      \fi}%
    % No anchor for this prefixed key: render display form
    % without a hyperlink.
    \def\codep@brhyper@noanchor#1{\codep@displayfromkey{#1}}%
    % Activate atom→anchor aux record WRITING.  The reading side
    % (\codep@anchormap) is activated in begindocument/before
    % (§8a.7) so it is live BEFORE the aux read.
    \renewcommand*{\codep@writeanchormap}[1]{%
      \if@filesw
        \protected@write\@auxout{}{%
          \string\codep@anchormap{#1}{\@currentHref}}%
      \fi}%
  }{}%
}

%% ===================================================================
%% Rendering hook activation
%% ===================================================================
%% Redefine the no-op hook points to wire them to the live
%% rendering implementations.  If the rendering layer were in a
%% separate file, this block would live at the top of that file.

% \codep@render@queuebackref{atomkey}
%   Queue back-references for the given atom key.
\def\codep@render@queuebackref#1{%
  \codep@queuebackref{#1}%
}%

% \codep@render@thm@preparebackref{envname}
%   Queue backrefs for the outermost atom, apply orphan prevention,
%   and flush inline style immediately (block/margin defer).
\def\codep@render@thm@preparebackref#1{%
  \codep@queuebackref{\codep@outeratom}%
  \codep@preventorphan
  \ifx\codep@backrefstyle\codep@const@inline
    \codep@flushbackref
  \fi
}%

% \codep@render@thm@afterend{envname}
%   Block/margin style: flush after the theorem env fully closes.
%   Inline style: already flushed in preparebackref, so no-op.
\def\codep@render@thm@afterend#1{%
  \ifx\codep@backrefstyle\codep@const@inline\else
    \codep@flushbackref
  \fi
}%

% \codep@render@proof@end
%   Inline style: flush before proof env closes (hmode, before QED).
%   Block/margin: apply orphan prevention.
\def\codep@render@proof@end{%
  \ifx\codep@backrefstyle\codep@const@inline
    \codep@flushbackref
  \else
    \codep@preventorphan
  \fi
}%

% \codep@render@proof@afterend
%   Block/margin style: flush after proof env closes (vmode, after QED).
\def\codep@render@proof@afterend{%
  \ifbool{codep@proofsnumbered}{%
    \ifx\codep@backrefstyle\codep@const@inline\else
      \codep@flushbackref
    \fi
  }{}%
}%

% \codep@render@para@emit{prefixedkey}{displaynum}
%   Emit margin label and queue backref for a paragraph atom.
\def\codep@render@para@emit#1#2{%
  \codep@emitmargin{#2}%
  \codep@queuebackref{#1}%
}%

% \codep@render@para@emitdeferred
%   Emit the deferred backref from the previous paragraph, if any.
\def\codep@render@para@emitdeferred{%
  \codep@parahook@emitdeferred
}%

% \codep@render@paraend@snapshot
%   Snapshot pending backref data for deferred emission.
\def\codep@render@paraend@snapshot{%
  \codep@parendhook@snapshot
}%

% \codep@render@enddocument@flush
%   Flush any deferred backref from the final paragraph.
\def\codep@render@enddocument@flush{%
  \ifx\codep@deferredbr\@empty\else
    \codep@renderbackref@para{\codep@deferredbr}%
    \global\let\codep@deferredbr\@empty
  \fi
}%

\endinput
