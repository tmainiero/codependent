% Hyperref link wrapping for backref numbers.
% Receives a prefixed key (e.g. theorem:2.1, equation:3.1, proof:2.1).
% Default (no rendering): bare pass-through.  Redefined by
% codependent-render.sty to format via \codep@displayfromkey
% and (with hyperref) wrap in \hyperlink.
%% @behavior B-LINK-CLICKABLE
\newcommand*{\codep@brhyper}[1]{#1}

% Hyperref detection: activate atom→anchor aux record WRITING.
% The reading side (\codep@anchormap) is activated in
% begindocument/before (§8a.7) so it is live BEFORE the aux read.
% The \codep@brhyper hyperlink rendering is handled by
% codependent-render.sty in its own \AtBeginDocument block.
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \renewcommand*{\codep@writeanchormap}[1]{%
      \if@filesw
        \protected@write\@auxout{}{%
          \string\codep@anchormap{#1}{\@currentHref}}%
      \fi}%
  }{}%
}

