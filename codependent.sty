}%

% \codep@autoproofof@scan@csv@dispatch
%   Route starred/non-starred \cref commands.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@csv@dispatch{%
  \ifx\codep@autoproofof@nexttoken\codep@autoproofof@star%
    \let\codep@autoproofof@next\codep@autoproofof@scan@csv@star%
