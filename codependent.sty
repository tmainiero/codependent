%% @behavior B-PASS-ONE
% \codep@renderlist@active{key}{style}{payload}
%   Hydrate the frozen render payload from aux on begindoc-before.
%   The wire format preserves a style field for forward compat
%   (currently always "inline"; future render-style switches would
%   read it), but the only live consumer — the W3 appendix reader
%   and Moment-2 re-emit path — keys on \codep@rendered@<key>,
%   which Moment-1 also populates synchronously (see
%   \codep@queuebackref).
  \def\codep@renderlist@active#1#2#3{%
    \expandafter\gdef\csname codep@rendered@#1\endcsname{#3}}

  %% @utility
  % \codep@csv@count{csv}{macro}
  %   Count non-empty comma-separated items in csv.
  \def\codep@csv@count#1#2{%
    \def#2{0}%
    \edef\codep@tmp@csv{#1}%
    \ifx\codep@tmp@csv\@empty\else%
      \count@=0\relax%
      \@for\codep@tmp@csvitem:=\codep@tmp@csv\do{%
        \ifx\codep@tmp@csvitem\@empty\else%
          \advance\count@ by 1\relax%
        \fi%
      }%
      \edef#2{\the\count@}%
    \fi%
  }%

  %% @utility
  % \codep@csv@ifcontains{csv}{needle}{then}{else}
  %   Branch on exact CSV membership, preserving source order.
  \def\codep@csv@ifcontains#1#2#3#4{%
    \let\codep@tmp@csvfound\@empty%
    \edef\codep@tmp@csvneedle{#2}%
    \edef\codep@tmp@csvhaystack{#1}%
    \@for\codep@tmp@csvitem:=\codep@tmp@csvhaystack\do{%
      \ifx\codep@tmp@csvitem\@empty\else%
        \ifx\codep@tmp@csvitem\codep@tmp@csvneedle%
          \def\codep@tmp@csvfound{1}%
        \fi%
      \fi%
    }%
    \ifx\codep@tmp@csvfound\@empty%
      #4%
    \else%
      #3%
    \fi%
  }%

  %% @utility
  % \codep@csv@formatdisplay{display-csv}{macro}
  %   Format proof target-display CSV with human spaces after commas.
  \def\codep@csv@formatdisplay#1#2{%
    \let#2\@empty%
    \edef\codep@tmp@displaycsv{#1}%
    \@for\codep@tmp@displayitem:=\codep@tmp@displaycsv\do{%
      \ifx\codep@tmp@displayitem\@empty\else%
        \ifx#2\@empty%
          \edef#2{\codep@tmp@displayitem}%
        \else%
          \edef#2{#2,\space\codep@tmp@displayitem}%
        \fi%
      \fi%
    }%
  }%

  \providecommand*{\codep@prooftargetmeta}[4]{}

  %% @behavior B-PASS-ONE
  % \codep@prooftargetmeta@active{proof-key}{target-keys}{target-displays}{marker}
  %   Hydrate proof target-list metadata from aux.
  \def\codep@prooftargetmeta@active#1#2#3#4{%
    \expandafter\xdef\csname codep@prooftargetkeys@#1\endcsname{#2}%
    \expandafter\xdef\csname codep@prooftargetdisplays@#1\endcsname{#3}%
    \expandafter\xdef\csname codep@prooftargetmarker@#1\endcsname{#4}%
    \codep@csv@count{#2}{\codep@tmp@prooftargetcount}%
    \expandafter\xdef\csname codep@prooftargetcount@#1\endcsname{%
      \codep@tmp@prooftargetcount}%
    \codep@prooftargetmeta@touch{#1}%
  }%

  %% @utility
  % \codep@prooftargetmeta@getkeys{proof-key}{macro}
  %   Retrieve proof target-key CSV into macro.
  \def\codep@prooftargetmeta@getkeys#1#2{%
    \expandafter\ifx\csname codep@prooftargetkeys@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@prooftargetkeys@#1\endcsname%
    \fi%
  }%

  %% @utility
  % \codep@prooftargetmeta@getdisplays{proof-key}{macro}
  %   Retrieve proof target-display CSV into macro.
  \def\codep@prooftargetmeta@getdisplays#1#2{%
    \expandafter\ifx\csname codep@prooftargetdisplays@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@prooftargetdisplays@#1\endcsname%
    \fi%
  }%

  %% @utility
  % \codep@prooftargetmeta@getmarker{proof-key}{macro}
  %   Retrieve proof marker slot into macro, defaulting to *.
  \def\codep@prooftargetmeta@getmarker#1#2{%
    \expandafter\ifx\csname codep@prooftargetmarker@#1\endcsname\relax%
      \def#2{*}%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@prooftargetmarker@#1\endcsname%
    \fi%
  }%

  %% @utility
  % \codep@prooftargetmeta@getcount{proof-key}{macro}
  %   Retrieve proof target count into macro.
  \def\codep@prooftargetmeta@getcount#1#2{%
    \expandafter\ifx\csname codep@prooftargetcount@#1\endcsname\relax%
      \def#2{0}%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@prooftargetcount@#1\endcsname%
    \fi%
  }%

  %% @utility
  % \codep@prooftargetmeta@touch{proof-key}
  %   Add proof-key once to the enddoc metadata emission list.
  \def\codep@prooftargetmeta@touch#1{%
    \@ifundefined{codep@prooftargettouched@#1}{%
      \global\expandafter\let%
        \csname codep@prooftargettouched@#1\endcsname\@empty%
      \edef\codep@tmp@prooftargettouch{\noexpand\do{#1}}%
      \expandafter\g@addto@macro\expandafter\codep@prooftargetmetalist%
        \expandafter{\codep@tmp@prooftargettouch}%
    }{}%
  }%

  %% @utility
  % see @behavior B-PROOF-JOINT at \codep@proofof@capturejointmeta.
  % \codep@prooftargetmeta@append{proof-key}{target-key}{display}{marker}
  %   Append one target unless already present.
  \def\codep@prooftargetmeta@append#1#2#3#4{%
    \codep@prooftargetmeta@getkeys{#1}{\codep@tmp@oldtargetkeys}%
    \codep@csv@ifcontains{\codep@tmp@oldtargetkeys}{#2}{}{%
      \codep@prooftargetmeta@getdisplays{#1}{%
        \codep@tmp@oldtargetdisplays}%
      \ifx\codep@tmp@oldtargetkeys\@empty%
        \edef\codep@tmp@newtargetkeys{#2}%
        \edef\codep@tmp@newtargetdisplays{#3}%
      \else%
        \edef\codep@tmp@newtargetkeys{\codep@tmp@oldtargetkeys,#2}%
        \edef\codep@tmp@newtargetdisplays{%
          \codep@tmp@oldtargetdisplays,#3}%
      \fi%
      \codep@prooftargetmeta@active{#1}{\codep@tmp@newtargetkeys}{%
        \codep@tmp@newtargetdisplays}{#4}%
      \codep@prooftargetmeta@touch{#1}%
    }%
  }%

  %% @utility
  % \codep@prooftargetmeta@clear{proof-key}
  %   Clear same-run target metadata for proof-key.
  \def\codep@prooftargetmeta@clear#1{%
    \codep@prooftargetmeta@active{#1}{}{}{*}%
    \codep@prooftargetmeta@touch{#1}%
  }%

  %% @utility
  % \codep@prooftargetmeta@firstkey{proof-key}{macro}
  %   Return the first target key, or empty.
  \def\codep@prooftargetmeta@firstkey#1#2{%
    \codep@prooftargetmeta@getkeys{#1}{\codep@tmp@firstkeycsv}%
    \let#2\@empty%
    \@for\codep@tmp@firstkeyitem:=\codep@tmp@firstkeycsv\do{%
      \ifx#2\@empty%
        \let#2\codep@tmp@firstkeyitem%
      \fi%
    }%
  }%

  %% @utility
  % \codep@prooftargetmeta@emit@one{proof-key}
  %   Emit one aux proof-target metadata record, if non-empty.
  \def\codep@prooftargetmeta@emit@one#1{%
    \codep@prooftargetmeta@getkeys{#1}{\codep@tmp@emitkeys}%
    \ifx\codep@tmp@emitkeys\@empty\else%
      \codep@prooftargetmeta@getdisplays{#1}{\codep@tmp@emitdisplays}%
      \codep@prooftargetmeta@getmarker{#1}{\codep@tmp@emitmarker}%
      \protected@write\@auxout{}{%
        \string\codep@prooftargetmeta{#1}{\codep@tmp@emitkeys}{%
          \codep@tmp@emitdisplays}{\codep@tmp@emitmarker}}%
    \fi%
  }%

  %% @utility
  % \codep@prooftargetmeta@emit
  %   Emit final proof target metadata to aux.
  \def\codep@prooftargetmeta@emit{%
    \if@filesw%
      \begingroup%
        \let\do\codep@prooftargetmeta@emit@one%
        \codep@prooftargetmetalist%
      \endgroup%
    \fi%
  }%

  %% @utility
  % \codep@cdp@proofmeta@emit@one{proof-key}
  %   Emit one v2 proof record to .cdp, guarded against duplicates.
  \def\codep@cdp@proofmeta@emit@one#1{%
    \codep@prooftargetmeta@getkeys{#1}{\codep@tmp@cdpproofkeys}%
    \ifx\codep@tmp@cdpproofkeys\@empty\else%
      \@ifundefined{codep@cdpproofwritten@#1}{%
        \global\expandafter\let%
          \csname codep@cdpproofwritten@#1\endcsname\@empty%
        \codep@prooftargetmeta@getdisplays{#1}{%
          \codep@tmp@cdpproofdisplays}%
        \codep@prooftargetmeta@getmarker{#1}{%
          \codep@tmp@cdpproofmarker}%
        \codep@cdpwrite{%
          \string\codep@cdp@proof{#1}{\codep@tmp@cdpproofkeys}{%
            \codep@tmp@cdpproofdisplays}{\codep@tmp@cdpproofmarker}}%
      }{}%
    \fi%
  }%

  %% @utility
  % \codep@cdp@proofmeta@emit
  %   Emit final v2 proof records for all proofs with target metadata.
  \def\codep@cdp@proofmeta@emit{%
    \begingroup%
      \let\do\codep@cdp@proofmeta@emit@one%
      \codep@prooftargetmetalist%
    \endgroup%
  }%

  % Accumulator for entitymeta emission at enddoc.  Each tracked-env
% close site appends one token-sequence describing its atom; the
% enddoc drain walks the list in order and emits one aux record
% per entry.  See \codep@captureentitymeta and
% \codep@entitymeta@emit.
%% @utility
\gdef\codep@entitymetaacc{}

% \codep@entitymeta@mark is the accumulator's entry marker.
% \protected so it does NOT expand under \xdef/\edef — keeps
% each stored entry literal across subsequent accumulator
% updates.  At emit time \codep@entitymeta@emit \let's this to
% \codep@entitymeta@emit@one so expanding the accumulator fires
% the aux-write handler once per entry.
%% @utility
\protected\def\codep@entitymeta@mark#1#2#3#4#5{}%

% \codep@captureentitymeta{key}{kind}{display}{print-kind}{parent-key}
%   Record one entity's metadata for both same-run consumption
%   and cross-run persistence.  Two side effects:
%     1. Eagerly call \codep@entitymeta@active to populate the
%        in-memory \codep@entity@<key>@{kind,display,print,parent}
%        csnames.  This makes same-run consumers (notably
%        \codep@proofof@resolve during forward-ref drain) see the
%        entity before enddoc.
%     2. Append a \do-list entry to \codep@entitymetaacc for the
%        enddoc aux-write drain (cross-run replay).  The emit
%        walker binds \do to a handler and expands the accumulator.
%
%   Replay-guarded: skipped during \restatable replay so restated
%   envs don't duplicate their entry.  Defensive; in normal code
%   path the theorem-end/proof-end hooks don't fire during replay
%   anyway.
%
%   Invariant on arg #4 (print-kind): for rails whose env-name is
%   fixed (proof, paragraph) callers pass the literal kind string;
%   for the theorem rail callers pass the actual env-name (which
%   may be lemma, corollary, etc.).  Consumers rendering the
%   printed kind should therefore read #4 directly and not assume
%   #4 == #2.
%% @utility
\def\codep@captureentitymeta#1#2#3#4#5{%
  \ifnum\codep@replaydepth>0\relax%
  \else%
    \codep@entitymeta@active{#1}{#2}{#3}{#4}{#5}%
    % \xdef forces full arg expansion so the accumulator stores
    % final string values (e.g., "theorem:1.2" or "proof:a7")
    % rather than the caller's \codep@tmp@* temp macros, whose bindings may have
    % moved on by enddoc-drain time.  The entry marker
    % \codep@entitymeta@mark is \protected so previously-stored
    % entries survive the re-expansion of \codep@entitymetaacc
    % that \xdef performs on each append.
    \xdef\codep@entitymetaacc{%
      \codep@entitymetaacc%
      \codep@entitymeta@mark{#1}{#2}{#3}{#4}{#5}}%
  \fi%
}%

% \codep@entitymeta@emit@one{key}{kind}{display}{print-kind}{parent-key}
%   Per-entry handler for the emit walker.  Writes one
%   \codep@entitymeta aux record.
%% @utility
\def\codep@entitymeta@emit@one#1#2#3#4#5{%
  \protected@write\@auxout{}{%
    \string\codep@entitymeta{#1}{#2}{#3}{#4}{#5}}%
}%

% \codep@entitymeta@emit
%   Walk \codep@entitymetaacc and emit one aux record per entry.
%   Called from \codep@refpending@drain at enddoc time (commit 7).
%% @utility
\def\codep@entitymeta@emit{%
  \if@filesw%
    \begingroup%
      \let\codep@entitymeta@mark\codep@entitymeta@emit@one%
      \codep@entitymetaacc%
    \endgroup%
  \fi%
}%

% \codep@renderlist@emit@one{atom-key}{atom-kind}
%   Per-atom handler.  Guarded by the "touched this run" flag
%   \codep@rlflag@<key>, set by \codep@queuebackref's non-empty
%   branch at collapse time.  Without the flag, a warmed
%   \codep@rendered@<key> from aux-replay that was NOT refreshed
%   this run (because the atom lost its last ref) would be
%   re-serialized indefinitely — GPT MAJOR #1.  With the flag,
%   we only emit the record when the current run observed live
%   refs for this atom; next-pass .aux drops the stale entry and
%   the cache stabilizes.
%
%   Atom-kind (#2) is ignored — the wire format's style field is
%   literally "inline"; future render styles would switch here.
%   \unexpanded keeps the payload literal against \write's \edef
%   pass so the pre-rendered tokens (display text, or \hyperlink
%   wrappers from Fix 2) land in the .aux verbatim; \immediate
%   flushes at enddoc drain time, independent of shipout timing.
%% @implements \codep@renderlist@emit@all
\def\codep@renderlist@emit@one#1#2{%
  \ifcsname codep@rlflag@#1\endcsname%
    \ifcsname codep@rendered@#1\endcsname%
      \immediate\write\@auxout{%
        \string\codep@renderlist{#1}{inline}{%
          \expandafter\expandafter\expandafter\unexpanded%
          \expandafter\expandafter\expandafter{%
            \csname codep@rendered@#1\endcsname}}}%
    \fi%
  \fi%
}%

% \codep@renderlist@emit@all
%   Walk the count-indexed atom array and emit renderlist records
%   for every atom with a populated Moment-1 cache.  Array entries
%   expand to {<prefixed-key>}{<kind>}; the triple-\expandafter
%   chain resolves the csname before emit@one sees its args.
%% @behavior B-PASS-ONE
\def\codep@renderlist@emit@all{%
  \if@filesw%
    \begingroup%
      \count@=\z@%
      \loop%
        \ifnum\count@<\codep@atomcount%
        \advance\count@ by 1\relax%
        \expandafter\expandafter\expandafter%
          \codep@renderlist@emit@one%
          \csname codep@atom@\the\count@\endcsname%
      \repeat%
    \endgroup%
  \fi%
}%

% Label-key set for the pending forward-ref list.  Each entry is
% \do{label}; per-label token lists live in the separate
% \codep@refpending@<label> csname family.  Appended to (per label)
% by \codep@defer@proofof at proofof-time when the referenced label
% has not yet been seen; walked by \codep@refpending@drain at
% enddoc to replay deferred resolutions against the now-complete
% label->entity binding.
%% @utility
\gdef\codep@refpendinglabels{}

% \codep@defer@proofof{resolver}{proofid}{label}{anchormode}
%   Queue a deferred \codepproofof resolution against <label>.  The
%   proof-id is expanded NOW so the drain has the originating
%   proof's atom-id even if \codep@currentproofid has moved on by
%   drain time.  Resolver, label, and anchormode are preserved.
%
%   Replay-guarded: skipped during \restatable replay.  Deferrals
%   are a pass-1 mechanism; replay should not duplicate queued
%   tokens (the originating proofof call would have already been
%   processed or deferred in the non-replay pass).
%% @utility
\def\codep@defer@proofof#1#2#3#4{%
  \ifnum\codep@replaydepth>0\relax%
  \else%
    \@ifundefined{codep@refpending@#3}{%
      \expandafter\xdef\csname codep@refpending@#3\endcsname{%
        \noexpand#1{#2}{\unexpanded{#3}}{\unexpanded{#4}}}%
      \g@addto@macro\codep@refpendinglabels{\do{#3}}%
    }{%
      \edef\codep@tmp@proofpending{%
        \noexpand#1{#2}{\unexpanded{#3}}{\unexpanded{#4}}}%
      \expandafter\g@addto@macro%
        \csname codep@refpending@#3\endcsname%
        \expandafter{\codep@tmp@proofpending}%
    }%
  \fi%
}%

% \codep@drainrefpending{label}
%   Replay any deferred-resolution tokens queued against this label.
%   Called from \codep@refpending@drain.  No-op if no tokens queued.
%   Clears the per-label csname after execution so a second drain
%   pass (defensive) would be a no-op.
%% @utility
\def\codep@drainrefpending#1{%
  \@ifundefined{codep@refpending@#1}{}{%
    \csname codep@refpending@#1\endcsname%
    \global\expandafter\let%
      \csname codep@refpending@#1\endcsname\@undefined%
  }%
}%

% \codep@refpending@drain
%   P03's enddoc-drain body.  Invoked by \codep@enddoc@orchestrator's
%   drain@p03 slot (Section 9b); no direct \AtEndDocument here.
%
%   Two responsibilities, in order:
%     1. Emit the entitymeta accumulator to the .aux so cross-run
%        readers can repopulate the in-memory entity bindings at
%        next-run begindoc time.
%     2. Drain any pending \codepproofof forward-refs whose target
%        labels are now known (same-run late-resolution); remaining
%        truly-unknown labels warn inside \codep@proofof@resolve.
%% @behavior B-PASS-ONE
%% @behavior B-PROOF-SEP
\def\codep@refpending@drain{%
  \codep@entitymeta@emit%
  \begingroup%
    \let\do\codep@drainrefpending%
    \codep@refpendinglabels%
  \endgroup%
  \codep@prooftargetmeta@emit%
  \codep@cdp@proofmeta@emit%
}%

% P04: \codep@refpending@drain is called from within
% \codep@enddoc@orchestrator (declared in Section 9b, below).
% No direct \AtEndDocument registration here — the orchestrator
% is the single enddocument entry-point.

% \codep@writeatomref{target}
%   Shared aux-write helper called by all patch sites.  Guards
%   on \codep@currentatom (in-atom sentinel: empty = not inside
%   a tracked atom, so no write) and on \if@filesw so --draftmode
%   / -no-aux compiles work.  The src field is normally read from
%   \theatom at write time per docs/DESIGN.md §8a.5.0.  However, when
%   \codep@sourceatom is non-empty (adjacent proofs), it overrides
%   \theatom to emit starred atom numbers (e.g. "2.1*").
%
%   Bug-fix guards (2026-04-11):
%   (a) \ifmeasuring@ — amsmath processes align/gather/multline/
%       flalign bodies twice (measuring + typesetting).  Skip
%       entirely during the measuring pass so no dedup marks are
%       set and no writes are emitted.  \ifmeasuring@ is defined
%       by amsmath; guarded with \@ifundefined for non-amsmath docs.
%   (b) Per-(source, target) dedup — \cref{label} fires both
%       \cref@getlabel (patch 2) and \@setref (patch 1), producing
%       doubled \codep@atomref records.  A csname flag
%       codep@arw@<src>@<tgt> blocks the second write.
% \codep@writeatomref@do{target}
%   Normal (non-equation) aux-write path.  Extracted from the
%   original \codep@writeatomref body so equation branches can
%   fall through to it.
%% @implements \codep@writeatomref
\def\codep@writeatomref@do#1{%
  \codep@writerefevent{#1}%
}%

%% @behavior B-PASS-ONE
\def\codep@writeatomref#1{%
  % (a) Skip during amsmath measuring pass.
  \@ifundefined{ifmeasuring@}%
    {\codep@writeatomref@body{#1}}%
    {\ifmeasuring@\else\codep@writeatomref@body{#1}\fi}%
}

% \codep@writeatomref@tracktwo{target}
%   Track 2 (align/gather multiline) path: defer the ref
%   to the pending list for later flush by \codep@flusheqrange.
%   SW5c commit 3 keeps the \codep@arw@pending@<tgt> guard as
%   belt-and-braces: each target is enqueued at most once per
%   multiline block even though the resolved-backend wrappers are gone.
%% @implements \codep@writeatomref
\def\codep@writeatomref@tracktwo#1{%
  \codep@eqshouldtrack%
  \ifx\codep@eqatom\@empty%
    \codep@writeatomref@do{#1}%
  \else%
    \expandafter\ifx\csname codep@arw@pending@#1\endcsname\relax%
      \global\expandafter\let%
        \csname codep@arw@pending@#1\endcsname\@empty%
      \global\codep@eqpendguards=\expandafter{%
        \the\codep@eqpendguards%
        \global\expandafter\let%
          \csname codep@arw@pending@#1\endcsname\relax}%
      \global\codep@eqpending=\expandafter{%
        \the\codep@eqpending\codep@eqpending@entry{#1}}%
      \global\advance\codep@eqpendingcount by 1\relax%
    \fi%
  \fi%
}%

% \codep@writeatomref@trackone{target}
%   Track 1 (single equation) path: record the ref directly
%   with the parenthesized equation number.
%% @implements \codep@writeatomref
\def\codep@writeatomref@trackone#1{%
  \codep@eqshouldtrack%
  \ifx\codep@eqatom\@empty%
    \codep@writeatomref@do{#1}%
  \else%
    \edef\codep@eqatom{equation:\theequation}%
    \ifx\codep@currenteqsourceid\@empty\else%
      \codep@atomsetkey{\codep@currenteqsourceid}{\codep@eqatom}%
    \fi%
    \codep@writeanchormap{\codep@eqatom}%
    \if@filesw%
      \codep@dedupwrite{\codep@eqatom}{#1}%
    \fi%
  \fi%
}%

%% @implements \codep@writeatomref
\def\codep@writeatomref@body#1{%
  \ifbool{codep@inequation}{%
    \ifbool{codep@eqmultiline}{%
      \codep@writeatomref@tracktwo{#1}%
    }{%
      \codep@writeatomref@trackone{#1}%
    }%
  }{%
    \codep@writeatomref@do{#1}%
  }%
}%

%% --- Section 8a.1: Defer queue (csname linked list) ---
%% Per REVIEW_C finding #2, the toks-register pattern from dpmac
%% is O(N^2) at 15k refs; replaced with a csname linked list
%% keyed by a monotonic \codep@brid counter.

\newcount\codep@brid
\codep@brid=0\relax

% \codep@recordbr{src}{tgt}
%   Enqueue a processbackref call.  O(1) per append.
%% @behavior B-EDGE-PROOF-ANY
\def\codep@recordbr#1#2{%
  \global\advance\codep@brid by 1\relax
  \expandafter\xdef%
    \csname codep@brq@\the\codep@brid\endcsname{%
      \noexpand\codep@processbr{#2}{#1}%
    }%
}

% \codep@flushbrqueue
%   Walk the linked list once, O(N) total.  Called from the
%   begindocument/end hook (Section 8a.7).
%% @behavior B-DISP-THM
\def\codep@flushbrqueue{%
  \begingroup
    \count@=\z@%
    \loop%
      \ifnum\count@<\codep@brid%
        \advance\count@ by 1\relax
        \csname codep@brq@\the\count@\endcsname
        \global\expandafter\let%
          \csname codep@brq@\the\count@\endcsname\relax
    \repeat%
  \endgroup
}

%% --- Section 8a.2: Active aux-record callback ---
%% The \providecommand no-op from Section 8a.0 is REPLACED by
%% this active definition at begindocument/before (Section
%% 8a.7), before LaTeX reads .aux in \begin{document}.  From
%% that point on, every \codep@atomref{src}{tgt} that the .aux
%% read fires lands here and enqueues a processbackref call.
%%
%% Per REVIEW_C finding #4, guard on empty src (orphan refs
%% emitted between atoms).  Belt-and-braces: the front-edge and
%% other live write sites already skip the write when the current
%% atom is empty.

%% @behavior B-PASS-ONE
\def\codep@atomref@active#1#2{%
  \edef\codep@tmp@src{#1}%
  \ifx\codep@tmp@src\@empty\else
    \codep@recordbr{#1}{#2}%
  \fi
}

%% --- Section 8a.2a: Type-prefixed key helpers ---
%% All backref graph keys carry a type prefix (envname:, paragraph:,
%% equation:, proof:) to prevent display-number collisions between
%% different atom types that share a numbering scheme (e.g.
%% equation 2.1 vs paragraph 2.1).  Internal csnames use the full
%% prefixed key; the display form is derived by stripping the
%% prefix and applying type-specific formatting.

%% @utility
% \codep@splitprefix{type:num}
%   Split a prefixed key into \codep@tmp@type and \codep@tmp@num.
%   The key format is "type:number" where type is one of
%   thm, para, eq, proof.
\def\codep@splitprefix#1:#2\@nil{%
  \def\codep@tmp@type{#1}%
  \def\codep@tmp@num{#2}%
}%

%% @utility
% \codep@ifunresrefkey{key}{then}{else}
%   Branch on the unresolved-reference source namespace prefix.
\def\codep@ifunresrefkey#1#2#3{%
  \edef\codep@tmp@ifunresrefkey{#1}%
  \expandafter\codep@ifunresrefkey@aux\codep@tmp@ifunresrefkey:\@nil{#2}{#3}%
}%

%% @utility
% \codep@ifunresrefkey@aux key-prefix splitter.
\def\codep@ifunresrefkey@aux#1:#2\@nil#3#4{%
  \def\codep@tmp@ifunresrefprefix{#1}%
  \ifx\codep@tmp@ifunresrefprefix\codep@const@typeunresref%
    #3%
  \else%
    #4%
  \fi%
}%

% Display-key formatting (\codep@displayfromkey, type constants)
% moved to codependent-render.sty.  Tracking code uses only
% \codep@splitprefix (above) for key decomposition.

%% --- Section 8a.3: Per-target linked list, processbr, collapsebr ---
%% For each target atom we maintain:
%%   \codep@brcount@<num>     -- count of appended refs
%%   \codep@brnode@<num>@<k>  -- the k-th ref text (prefixed key)
%% At typeset time the nodes are collapsed into the display
%% macro \codep@br@<num>.  Per REVIEW_C finding #2 second half,
%% this turns O(degree^2) into O(degree).

%% @implements \codep@processbr
% \codep@appendbr@core
%   Shared body for \codep@processbr and \codep@appendbr.
%   Precondition: \codep@tmp@tgt and \codep@tmp@src are already
%   \edef'd to the resolved display numbers.
%   Performs: self-ref guard, consecutive-dedup, lazy count
%   init, linked-list node store.
\def\codep@appendbr@core{%
  % Defensive fallback: ordinary unresref body refs are migrated earlier by
  % \codep@unresref@flushrefs.  If a provisional source reaches replay anyway,
  % rewrite it through the resolved keymap before self-ref/dedup handling.
  \codep@ifunresrefkey{\codep@tmp@src}{%
    \expandafter\ifx\csname codep@keymap@\codep@tmp@src\endcsname\relax%
    \else%
      \edef\codep@tmp@src{%
        \csname codep@keymap@\codep@tmp@src\endcsname}%
    \fi%
  }{}%
  % Self-ref guard (REVIEW_C finding #10).
  \ifx\codep@tmp@src\codep@tmp@tgt\else
    % Dedup against previous append for this target.
    \edef\codep@tmp@last{%
      \csname codep@brlast@\codep@tmp@tgt\endcsname}%
    \ifx\codep@tmp@last\codep@tmp@src%
      % Consecutive duplicate: skip.
    \else
      \global\expandafter\let%
        \csname codep@brlast@\codep@tmp@tgt\endcsname%
        \codep@tmp@src%
      % Append a new linked-list node.
      \expandafter\ifx%
          \csname codep@brcount@\codep@tmp@tgt\endcsname\relax
        \global\expandafter\def%
          \csname codep@brcount@\codep@tmp@tgt\endcsname{0}%
      \fi
      \edef\codep@tmp@k{%
        \csname codep@brcount@\codep@tmp@tgt\endcsname}%
      \count@=\codep@tmp@k\relax
      \advance\count@ by 1\relax
      \expandafter\xdef%
        \csname codep@brcount@\codep@tmp@tgt\endcsname
        {\the\count@}%
      \expandafter\xdef%
        \csname%
          codep@brnode@\codep@tmp@tgt @\the\count@%
        \endcsname
        {\codep@tmp@src}%
    \fi
  \fi
}%

%% @behavior B-LINK-EFFECTIVE-ANCHOR
%% @behavior B-PASS-TWO
%% @behavior B-SELFREF
% \codep@processbr{tgt}{src}
%   #1 = target label key (resolves to canonical atom-key via
%        lblentity, or falls back to ltype:lblnum for stale aux)
%   #2 = source atom prefixed key (e.g. thm:2.1, para:1.3)
%   Prefers \codep@lblentity@<label> (canonical atom-key written
%   by W03-P03 enddoc) so standalone proofs whose label binds to
%   the surrounding paragraph counter (lblnum=para number) still
%   resolve to their opaque atom-key (proof:a<N>) rather than
%   the wrong "proof:<para-num>".  Falls through to legacy
%   ltype:lblnum if lblentity is unavailable (pre-W03-P03 aux,
%   or labels written outside the codependent label hook).
\def\codep@processbr#1#2{%
  \expandafter\ifx\csname codep@lblentity@#1\endcsname\relax
    \expandafter\ifx\csname codep@lblnum@#1\endcsname\relax
      % Unknown target: silently drop.
    \else
      \expandafter\ifx\csname codep@ltype@#1\endcsname\relax
        \edef\codep@tmp@tgt{\csname codep@lblnum@#1\endcsname}%
      \else
        \edef\codep@tmp@tgt{%
          \csname codep@ltype@#1\endcsname
          :\csname codep@lblnum@#1\endcsname}%
      \fi
      \edef\codep@tmp@src{#2}%
      \codep@appendbr@core%
    \fi
  \else
    \edef\codep@tmp@tgt{\csname codep@lblentity@#1\endcsname}%
    \edef\codep@tmp@src{#2}%
    \codep@appendbr@core%
  \fi
}

%% @implements \codep@processbr
% \codep@appendbr{tgtnum}{srcnum}
%   Append a backref edge directly using display numbers
%   (no lblnum lookup).  Used by concept resolution where
%   both source and target atom numbers are already known.
%   Includes self-ref and consecutive-dedup guards.
\def\codep@appendbr#1#2{%
  \edef\codep@tmp@tgt{#1}%
  \edef\codep@tmp@src{#2}%
  \codep@appendbr@core%
}

