%% --- Section 8a.3a: Rendering query API shims ---
%% These macros form the render barrier: codependent-render.sty
%% calls ONLY these to read graph state.  The implementations
%% wrap the current prefixed-key internals (codep@brcount@,
%% codep@brnode@, codep@anchor@, \codep@splitprefix).  In later
%% waves the shim bodies change but the signatures stay fixed.

% String constants for type comparisons in display rules.
% Needed by \codep@graph@getdisplay; previously in render.sty.
%% @utility
\def\codep@const@typeequation{equation}%
%% @utility
\def\codep@const@typeproof{proof}%
%% @utility
\def\codep@const@typeunresref{unresref}%

%% @utility
% \codep@graph@resolvekey{entity-key}{macro}
%   Follow a one-hop key rename through \codep@keymap@<old>.
\def\codep@graph@resolvekey#1#2{%
  \expandafter\ifx\csname codep@keymap@#1\endcsname\relax%
    \edef#2{#1}%
  \else%
    \expandafter\let\expandafter#2\csname codep@keymap@#1\endcsname%
  \fi%
}%

%% @utility
% \codep@graph@hasrefs{target-key}{then}{else}
%   Test whether the target has at least one backref edge.
%   #1 = target key (prefixed key like "theorem:1.2")
%   #2 = then branch
%   #3 = else branch
\def\codep@graph@hasrefs#1#2#3{%
  \expandafter\ifx\csname codep@brcount@#1\endcsname\relax%
    #3%
  \else%
    #2%
  \fi%
}%

%% @utility
% \codep@graph@getdisplay{entity-key}{macro}
%   Derive the rendered display form from a prefixed key and
%   store it in #2 as a self-contained snapshot.  The equation
%   and proof branches use \edef so \codep@tmp@num resolves at
%   definition time, not consumer time — critical for callers
%   that \let or \unexpanded the result macro (e.g. the
%   collapsebr accumulator, which iterates and mutates
%   \codep@tmp@num between sibling callbacks).  The theorem
%   branch already snapshots via \let-meaning.
%
%   Proof display gates on proof target metadata:
%     one target      → "N.M*"          ("N.M" when proofs=off)
%     multiple targets → "{N.M, N.K}*"  ("{N.M, N.K}" when proofs=off)
%   Standalone proofs carry the same stable proof:a<N> key but have
%   no target metadata; they are suppressed upstream by
%   \codep@collapsebr@cb's classifier.
%
%   equation:X → (X)
%   proof:X    → X* | X (per proofs=on|off)
%   otherwise  → X
%% @behavior B-DISP-PROOF
%% @behavior B-PROOF-OFF
\def\codep@graph@getdisplay#1#2{%
  \expandafter\codep@splitprefix#1\@nil%
  \ifx\codep@tmp@type\codep@const@typeequation%
    \edef#2{(\codep@tmp@num)}%
  \else\ifx\codep@tmp@type\codep@const@typeproof%
    \codep@prooftargetmeta@getdisplays{#1}{\codep@tmp@proofdisplays}%
    \ifx\codep@tmp@proofdisplays\@empty%
      \codep@graph@getentitydisplay{#1}{\codep@tmp@proofentitydisplay}%
      \ifx\codep@tmp@proofentitydisplay\@empty%
        \ifbool{codep@proofsnumbered}%
          {\edef#2{\codep@tmp@num*}}%
          {\let#2\codep@tmp@num}%
      \else%
        \let#2\codep@tmp@proofentitydisplay%
      \fi%
    \else%
      \codep@prooftargetmeta@getcount{#1}{\codep@tmp@proofdisplaycount}%
      \codep@prooftargetmeta@getmarker{#1}{\codep@tmp@proofmarker}%
      \codep@csv@formatdisplay{\codep@tmp@proofdisplays}{%
        \codep@tmp@proofformatted}%
      \ifnum\codep@tmp@proofdisplaycount>1\relax%
        \ifbool{codep@proofsnumbered}%
          {\edef#2{\{\codep@tmp@proofformatted\}\codep@tmp@proofmarker}}%
          {\edef#2{\{\codep@tmp@proofformatted\}}}%
      \else%
        \ifbool{codep@proofsnumbered}%
          {\edef#2{\codep@tmp@proofformatted\codep@tmp@proofmarker}}%
          {\let#2\codep@tmp@proofformatted}%
      \fi%
    \fi%
  \else\ifx\codep@tmp@type\codep@const@typeunresref%
    \edef#2{?u\codep@tmp@num*}%
  \else%
    \let#2\codep@tmp@num%
  \fi\fi\fi%
}%

%% @utility
% \codep@graph@getanchor{entity-key}{macro}
%   Retrieve the hyperref anchor for entity-key into #2,
%   or set #2 to \@empty if no anchor exists.
%
%   Rebound-proof keys alias first: if key was produced by a
%   \codep@keymap old->new rename, chase that alias back to the
%   pre-rebind key so the visible proof:N.M key resolves through
%   the original proof-begin anchor.  Otherwise do the usual
%   local-first lookup, falling back through the forward keymap
%   rail when only a newer key recorded an anchor.
\def\codep@graph@getanchor#1#2{%
  \expandafter\ifx\csname codep@anchoralias@#1\endcsname\relax%
    \expandafter\ifx\csname codep@anchor@#1\endcsname\relax%
      \codep@graph@resolvekey{#1}\codep@tmp@graphkey%
      \expandafter\ifx%
          \csname codep@anchor@\codep@tmp@graphkey\endcsname\relax%
        \let#2\@empty%
      \else%
        \expandafter\let\expandafter#2%
          \csname codep@anchor@\codep@tmp@graphkey\endcsname%
      \fi%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@anchor@#1\endcsname%
    \fi%
  \else%
    \edef\codep@tmp@graphalias{%
      \csname codep@anchoralias@#1\endcsname}%
    \codep@graph@getanchor{\codep@tmp@graphalias}{#2}%
  \fi%
}%

%% @utility
% \codep@graph@getkind{entity-key}{macro}
%   Extract the type prefix from a prefixed key into #2.
\def\codep@graph@getkind#1#2{%
  \expandafter\codep@splitprefix#1\@nil%
  \let#2\codep@tmp@type%
}%

%% @utility
% \codep@graph@getentitydisplay{entity-key}{macro}
%   Retrieve the entitymeta display field for entity-key into #2.
\def\codep@graph@getentitydisplay#1#2{%
  \expandafter\let\expandafter#2%
    \csname codep@entity@#1@display\endcsname%
  \ifx#2\relax\let#2\@empty\fi%
}%

%% @utility
% \codep@graph@getprintkind{entity-key}{macro}
%   Retrieve the entitymeta print-kind field for entity-key into #2.
\def\codep@graph@getprintkind#1#2{%
  \expandafter\let\expandafter#2%
    \csname codep@entity@#1@print\endcsname%
  \ifx#2\relax\let#2\@empty\fi%
}%

%% @utility
% \codep@graph@getanchorpage{entity-key}{macro}
%   Retrieve the anchor-start page for entity-key into #2.
\def\codep@graph@getanchorpage#1#2{%
  \expandafter\let\expandafter#2%
    \csname codep@anchorpage@#1\endcsname%
  \ifx#2\relax\let#2\@empty\fi%
}%

%% @utility
% \codep@graph@getentityparent{entity-key}{macro}
%   Retrieve the entitymeta parent-key field for entity-key into #2,
%   or set #2 to \@empty if no entity record is bound or the parent
%   slot is empty.  Used by the rendering classifier to distinguish
%   ADJACENT / REBOUND proofs (non-empty parent) from STANDALONE
%   proofs (empty parent) when deciding source-token visibility.
%
%   Intentionally does NOT call \codep@graph@resolvekey: the parent
%   slot is only populated by the adjacent (\codep@proof@adjacent →
%   \codep@bindproofparent) and rebound (\codep@proofof@resolve)
%   paths, both of which write directly to the post-rebind key.
%   So the keymap rail never needs to be consulted to find a parent
%   record — the record always lives at the final key.
\def\codep@graph@getentityparent#1#2{%
  \expandafter\let\expandafter#2%
    \csname codep@entity@#1@parent\endcsname%
  \ifx#2\relax%
    \let#2\@empty%
  \fi%
  \ifx#2\@empty%
    \codep@prooftargetmeta@firstkey{#1}{#2}%
  \fi%
}%

%% @utility
% \codep@graph@foreachref{target-key}{callback}
%   Iterate over all source refs for target-key, calling
%   #2{source-key} for each.  #2 is a macro that takes one arg.
\def\codep@graph@foreachref#1#2{%
  \expandafter\ifx\csname codep@brcount@#1\endcsname\relax\else%
    \edef\codep@tmp@n{\csname codep@brcount@#1\endcsname}%
    \count@=\z@%
    \loop%
      \ifnum\count@<\codep@tmp@n%
        \advance\count@ by 1\relax%
        \edef\codep@tmp@node{%
          \csname codep@brnode@#1@\the\count@\endcsname}%
        \expandafter#2\expandafter{\codep@tmp@node}%
    \repeat%
  \fi%
}%

%% @utility
% \codep@render@equationblock{source-atom-id}{fallback-atom-id}{target-list}
%   Wave 1 pass-through shim for equation rendering.
%   #1 = source atom id (prefixed eq key, e.g. "equation:1")
%   #2 = fallback atom id (empty or enclosing atom key)
%   #3 = target list as \do{q1}\do{q2}...
%   In the current architecture equation rendering is already
%   handled by \codep@render@queuebackref called from the
%   tracking hooks, so this shim is intentionally empty.
%   The real implementation lands in Wave 2/3.
\def\codep@render@equationblock#1#2#3{}%

%% --- Section 8a.4: \newlabel / \newlabelxx override + extractor ---
%% Per REVIEW_C finding #1, use a \@secondoftwo-style grab of
%% the first braced subgroup.  Per REVIEW_C finding #3, install
%% at begindocument/before so hyperref's pre-2023 aux-injection
%% block does not clobber it.  Also override \newlabelxx for
%% the pre-2023 hyperref pathway.

%% @implements \codep@extractlblnum
% \codep@grabfirst#1#2\@nil -> #1
%   Grab the first brace group of a delimited argument.
\def\codep@grabfirst#1#2\@nil{#1}

%% @implements \codep@extractanchor
% \codep@grab4th#1#2#3#4#5\@nil -> #4
%   Grab the 4th brace group.  Used to extract hyperref's
%   anchor name from \newlabel's value ({num}{page}{title}{anchor}{}).
\def\codep@grab4th#1#2#3#4#5\@nil{#4}

%% @behavior B-LINK-EFFECTIVE-ANCHOR
% \codep@extractanchor{key}{value}
%   Extract hyperref's anchor (4th field of \newlabel value)
%   and store a reverse mapping: atom number -> anchor name.
%   No-ops for @cref keys or when value has fewer than 4 fields.
\def\codep@extractanchor#1#2{%
  \codep@ifcrefkey{#1}{}{%
    \codep@ifdatakey{#1}{}{%
      \expandafter\codep@extractanchor@ii%
        \expandafter{\codep@grab4th#2{}{}{}{}\@nil}{#1}%
    }%
  }%
}
%% @behavior B-LINK-EFFECTIVE-ANCHOR
% \codep@writeanchoreff{label}{ltype}{display}{anchor}
%   Write the effective anchor mapping under the normalized target key.
\def\codep@writeanchoreff#1#2#3#4{%
  \edef\codep@tmp@anchorltype{#2}%
  \edef\codep@tmp@anchordisp{#3}%
  \edef\codep@tmp@anchorval{#4}%
  \ifx\codep@tmp@anchorltype\@empty%
    \expandafter\xdef%
      \csname codep@anchor@\codep@tmp@anchordisp\endcsname{%
        \codep@tmp@anchorval}%
  \else%
    \edef\codep@tmp@prefixed{%
      \codep@tmp@anchorltype:\codep@tmp@anchordisp}%
    \expandafter\xdef%
      \csname codep@anchor@\codep@tmp@prefixed\endcsname{%
        \codep@tmp@anchorval}%
  \fi%
}%
%% @implements \codep@writeanchoreff
\def\codep@extractanchor@ii#1#2{%
  % #1 = anchor (4th field or empty), #2 = label key
  \def\codep@tmp@anchorfield{#1}%
  \ifx\codep@tmp@anchorfield\@empty\else%
    \expandafter\ifx\csname codep@lblnum@#2\endcsname\relax\else%
      % Resolve atom number first, then define the anchor mapping
      % using the prefixed key (type:number).
      \protected@edef\codep@tmp@num{%
        \csname codep@lblnum@#2\endcsname}%
      % Build prefixed key from type map if available.
      \expandafter\ifx\csname codep@ltype@#2\endcsname\relax%
        \let\codep@tmp@anchorltype\@empty%
      \else%
        \edef\codep@tmp@anchorltype{%
          \csname codep@ltype@#2\endcsname}%
      \fi%
      \codep@writeanchoreff{#2}{\codep@tmp@anchorltype}%
        {\codep@tmp@num}{#1}%
    \fi%
  \fi%
}%
%% @utility
% \codep@ifdatakey{key}{then}{else}
%   True iff the label key ends in "@data" (thm-restate internal).
%   These contain \setcounter calls, not display numbers.
\def\codep@ifdatakey#1{%
  \codep@isdatafalse%
  \def\codep@ifdatakey@probe##1@data##2\@nil{%
    \def\codep@tmp@datasuffix{##2}%
    \ifx\codep@tmp@datasuffix\@empty\else
      \def\codep@tmp@datasentinel{@data}%
      \ifx\codep@tmp@datasuffix\codep@tmp@datasentinel%
        \codep@isdatatrue%
      \fi
    \fi
  }%
  \codep@ifdatakey@probe#1@data\@nil%
  \ifcodep@isdata%
    \expandafter\@firstoftwo%
  \else
    \expandafter\@secondoftwo%
  \fi
}

% Flag used only inside \codep@ifcrefkey.
\newif\ifcodep@iscref
% Flag used only inside \codep@ifdatakey (separate from \ifcodep@iscref).
\newif\ifcodep@isdata

%% @behavior B-PASS-ONE
\def\codep@installnewlabel{%
  \let\codep@orig@newlabel\newlabel%
  \def\newlabel##1##2{%
    \codep@orig@newlabel{##1}{##2}%
    \codep@extractlblnum{##1}{##2}%
    \codep@extractanchor{##1}{##2}%
  }%
  % Pre-2023 hyperref path: \newlabelxx has 6 args.  Hyperref
  % installs it in \AtBeginDocument and it races with our
  % override, so we override it too.
  \@ifundefined{newlabelxx}{}{%
    \let\codep@orig@newlabelxx\newlabelxx%
    \def\newlabelxx##1##2##3##4##5##6{%
      \codep@orig@newlabelxx%
        {##1}{##2}{##3}{##4}{##5}{##6}%
      % ##2 is already the display number for the 6-arg form.
      \expandafter\gdef%
        \csname codep@lblnum@##1\endcsname{##2}%
      % ##5 is the hyperref anchor name; store reverse mapping
      % using prefixed key if type is known.
      \codep@ifcrefkey{##1}{}{%
        \def\codep@tmp@anchorval{##5}%
        \ifx\codep@tmp@anchorval\@empty\else%
          \expandafter\ifx\csname codep@ltype@##1\endcsname\relax%
            \let\codep@tmp@anchorltype\@empty%
          \else%
            \edef\codep@tmp@anchorltype{%
              \csname codep@ltype@##1\endcsname}%
          \fi%
          \codep@writeanchoreff{##1}{\codep@tmp@anchorltype}{##2}{##5}%
        \fi%
      }%
    }%
  }%
}

%% @behavior B-PASS-ONE
% \codep@extractlblnum{key}{value}
%   value is the raw 2nd arg of \newlabel; after TeX brace-
%   stripping it is "{num}{page}{...}{...}{...}".  Grab the
%   first brace group and stash it under the key.  Skip keys
%   that END in @cref (cleveref internal records).
\def\codep@extractlblnum#1#2{%
  \codep@ifcrefkey{#1}{%
    % @cref-suffixed: skip silently.
  }{%
    \expandafter\codep@extractlblnum@ii%
      \expandafter{\codep@grabfirst#2\@nil}{#1}%
  }%
}
%% @implements \codep@extractlblnum
\def\codep@extractlblnum@ii#1#2{%
  \expandafter\gdef\csname codep@lblnum@#2\endcsname{#1}%
}

%% @utility
% Sentinel used by \codep@ifcrefkey.
\def\codep@ifcrefsentinel{@cref}

%% @utility
% \codep@ifcrefkey{key}{then}{else}
%   True iff the label key ENDS in "@cref".  Per REVIEW_D
%   finding #4, matching "any key containing @cref" incorrectly
%   dropped keys like "lemma@crefnum".  The delimited-arg probe
%   splits "<key>@cref\@nil" on the FIRST occurrence of "@cref";
%   the key ends in @cref iff the tail is exactly "@cref".
\def\codep@ifcrefkey#1{%
  \codep@iscreffalse%
  \def\codep@ifcrefkey@probe##1@cref##2\@nil{%
    \def\codep@tmp@crefsuffix{##2}%
    \ifx\codep@tmp@crefsuffix\@empty%
      % No @cref in the key at all; the probe's own trailing
      % @cref absorbed the split -> NOT a cref key.
    \else
      \ifx\codep@tmp@crefsuffix\codep@ifcrefsentinel%
        \codep@iscreftrue%
      \fi
    \fi
  }%
  \codep@ifcrefkey@probe#1@cref\@nil%
  \ifcodep@iscref%
    \expandafter\@firstoftwo%
  \else
    \expandafter\@secondoftwo%
  \fi
}

%% --- Section 8a.7: Hook installation ---
%% Per REVIEW_D finding #2, codependent-owned labels on
%% begindocument/before get EXPLICIT relative ordering rather
%% than both claiming "before *".  The \DeclareHookRule below
%% pins \codep/backref/install to run before hyperref.

% Install the \newlabel override AND the active aux callbacks at
% begindocument/before so they are live before the .aux read in
% \begin{document}.
\AddToHook{begindocument/before}[codependent/backref/install]{%
  \codep@installnewlabel
  % Swap the providecommand no-ops for the active callbacks.
  \let\codep@atomref\codep@atomref@active
  \let\codep@lbltype\codep@lbltype@active
  % Activate P03 in-memory/aux binding readers BEFORE the aux read
  % so cross-run binding + entity metadata records are captured.
  \let\codep@lblentity\codep@lblentity@active
  \let\codep@entitymeta\codep@entitymeta@active
  \let\codep@keymap\codep@keymap@active
  \let\codep@renderlist\codep@renderlist@active
  \let\codep@prooftargetmeta\codep@prooftargetmeta@active
  \let\codep@anchorpage\codep@anchorpage@active
  % Activate anchormap BEFORE aux read so equation range anchors
  % like \codep@anchormap{equation:4.4--4.5}{codep.eq.3} are not discarded.
  \@ifpackageloaded{hyperref}{%
    \let\codep@anchormap\codep@anchormap@active
  }{}%
}

%% --- Section 8a.9: Concept-aware forward-reference resolution ---
%% Active callbacks for \codep@concept and \codep@conceptref.
%% Defined here (at package-load time, under \makeatletter);
%% swapped in at begindocument/before by \let, following the
%% same pattern as \codep@atomref@active.

%% @behavior B-CONC-DEFSITE
% \codep@concept@active{name}{atomnum}
%   Populate the concept def-site map.  Per J3, silently
%   overwrite on duplicate aux records (stale prior-run).
\def\codep@concept@active#1#2{%
  \expandafter\gdef%
    \csname codep@conceptdef@#1\endcsname{#2}%
}

%% @behavior B-CONC-FWDREF
% \codep@conceptref@active{srcatom}{conceptname}
%   If the def site is already in the concept map, resolve
%   immediately; otherwise defer to \codep@conceptpending
%   for retry after the full aux read completes.
\def\codep@conceptref@active#1#2{%
  \@ifundefined{codep@conceptdef@#2}%
    {\g@addto@macro\codep@conceptpending{%
       \codep@resolveconcept{#1}{#2}}}%
    {\codep@resolveconcept{#1}{#2}}%
}

%% @behavior B-CONC-SCOPE
% \codep@resolveconcept{srcatom}{conceptname}
%   Concept resolution callback.  Originally fed concept edges
%   into the backref linked list via \codep@appendbr; this was
%   removed (2026-04-11) because concept edges are NOT cross-
%   references — they should not appear in "Used in" lists.
%   The .aux records (\codep@concept, \codep@conceptref) and
%   .cdp records (\codep@cdp@def, \codep@cdp@use) remain
%   intact for the CLI layer.  The concept warning system
%   (\codep@conceptwarnscan) also remains.  This function is
%   now a silent no-op; it is kept so that stale .aux files
%   containing \codep@conceptref records (which trigger
%   \codep@resolveconcept via the pending list) do not error.
\def\codep@resolveconcept#1#2{}

% Swap the providecommand no-ops for the active callbacks
% at begindocument/before, before the .aux read.
\AddToHook{begindocument/before}[codependent/concept/install]{%
  \let\codep@concept\codep@concept@active
  \let\codep@conceptref\codep@conceptref@active
}

% Flush the backref queue AFTER aux has been read.  The aux
% read happens during the kernel's \document macro before any
% \AtBeginDocument hook fires, so begindocument/end is safe.
\AddToHook{begindocument/end}[codependent/backref/flush]{%
  \codep@flushbrqueue
}

% Flush the concept pending list AFTER the backref queue
% flush.  Deferred \codep@resolveconcept calls expand here;
% the concept map is now complete from the full aux read.
\AddToHook{begindocument/end}[codependent/concept/flush]{%
  \codep@conceptpending
  \global\let\codep@conceptpending\@empty
}

% External ordering: run before hyperref wraps \@setref a
% second time in its \AtBeginDocument-equivalent hooks.
\DeclareHookRule{begindocument/before}%
  {codependent/backref/install}{before}{hyperref}

% Internal dependency: sbl open sees the backref install.
\DeclareHookRule{begindocument/before}{codependent/cdp/open}%
                {after}{codependent/backref/install}

% Concept install fires AFTER backref install (needs
% \codep@recordbr to be in place).
\DeclareHookRule{begindocument/before}%
  {codependent/concept/install}{after}{codependent/backref/install}

% Concept flush fires AFTER backref flush.  Concept edges
% use \codep@appendbr (direct node-list append, no queue),
% so ordering with the queue flush is not critical.  The
% "after" ordering ensures the backref queue processes first
% and concept edges are appended on top.
\DeclareHookRule{begindocument/end}%
  {codependent/concept/flush}{after}{codependent/backref/flush}

%% --- Section 8a.10: Front-edge ref-intent capture (SW5c commit 2) ---
%%
%% Wraps 12 user-level ref primitives at begindocument/end so that
%% \codep@atomref records are emitted on EVERY pass, including pass 1
%% when the target is still unresolved ("??").  SW5c commit 3 removes
%% the resolved-backend wrappers; these front-edge wrappers are now the
%% sole \codep@atomref emitters.  The track-two pending guard
%% (\codep@arw@pending@<tgt>, see \codep@writeatomref@tracktwo)
%% remains as defense-in-depth.
%%
%% INV-PASS1-EDGE-AUX-COMPLETE: all ref-uses that affect pass-2 backrefs
%% produce a \codep@atomref record on pass 1 regardless of resolution.
%%
%% §8 open questions resolved at implementation time:
%%   §8.1  \protected\def for all wrappers — survives \protected@edef.
%%   §8.2  Option (a) pending-append guard — see \codep@writeatomref@tracktwo.
%%   §8.3  \nameref survey: no fixture uses \nameref; keep 12-primitive list.
%%   §8.4  \cref@getlabel third-party survey: no exotic callers in integ
%%         fixtures; defer to commit 3 runtime warning.
%%   §8.5  pre-begindocument/end refs stay a documented waiver.

% \codep@splitlabels{csv}{macro}
%   Split comma-separated labels on top-level (unbraced) commas and
%   call \macro{label} for each label.  Brace-wrapped groups are
%   preserved as single labels: \cref{{a},b} -> \macro{a}, \macro{b}.
%   This matches cleveref for the well-formed case where each label is
%   individually brace-wrapped.  For malformed input such as
%   \cref{a,{b,c},d}, this splitter yields \macro{a}, \macro{b,c},
%   \macro{d} --- diverging from cleveref (which warns and treats a,
%   b, c as separate refs); see test-frontedge-cref-csv-divergence.lvt.
%   Empty items (e.g. from trailing commas) are silently skipped.
%% @utility
\def\codep@splitlabels#1#2{%
  \codep@sl@iter#1,\@nil{#2}%
}%
%% @utility
\def\codep@sl@iter#1,#2\@nil#3{%
  \def\codep@sl@item{#1}%
  \ifx\codep@sl@item\@empty\else%
    #3{#1}%
  \fi%
  \def\codep@sl@more{#2}%
  \ifx\codep@sl@more\@empty\else%
    \codep@sl@iter#2\@nil{#3}%
  \fi%
}%

% \codep@frontedge@emit{label}
%   Emit a front-edge atomref record for the current source atom.
%   Delegates to \codep@writeatomref which handles: replay-depth
%   guard, measuring-pass guard, equation track-one / track-two
%   dispatch (with the §2.7(a) pending guard), and dedup.
%% @behavior B-FRONTEDGE-CAPTURE
\def\codep@frontedge@emit#1{%
  \codep@writeatomref{#1}%
}%

% Front-edge single-label delegation helpers (no-star / star paths).
% #1 = saved original command, #2 = label.
%% @implements \codep@installfrontedgerefpatch
\def\codep@fe@single@nostar#1#2{%
  \codep@frontedge@emit{#2}%
  #1{#2}%
}%
%% @implements \codep@installfrontedgerefpatch
\def\codep@fe@single@star#1#2{%
  \codep@frontedge@emit{#2}%
  #1*{#2}%
}%

% Front-edge CSV-label delegation helpers (no-star / star paths).
% #1 = saved original command, #2 = comma-separated label string.
%% @implements \codep@installfrontedgerefpatch
\def\codep@fe@csv@nostar#1#2{%
  \codep@splitlabels{#2}{\codep@frontedge@emit}%
  #1{#2}%
}%
%% @implements \codep@installfrontedgerefpatch
\def\codep@fe@csv@star#1#2{%
  \codep@splitlabels{#2}{\codep@frontedge@emit}%
  #1*{#2}%
}%

% \codep@installfrontedgerefpatch
%   Install front-edge wrappers for the 12 user-level ref primitives.
%   Called at begindocument/end after nameref, hyperref, and cleveref
%   have installed their final definitions; our wrappers wrap whatever
%   is live at that point.  Every install is guarded by \ifcsname so
%   absent commands (e.g. \cref when cleveref not loaded) are silently
%   skipped.  All wrappers are \protected so they survive \protected@edef
%   in moving args (captions, section titles, TOC entries).
%   SW5c commit 3 removes the resolved-backend wrappers; the pending
%   guard stays as belt-and-braces for multiline equation refs.
%% @behavior B-FRONTEDGE-CAPTURE
%% @behavior B-FRONTEDGE-DEDUP-EQ
\def\codep@installfrontedgerefpatch{%
  %% ---- \ref and \ref* ----
  \ifcsname ref\endcsname%
    \let\codep@saved@ref\ref%
    \protected\def\ref{%
      \@ifstar{\codep@fe@single@star\codep@saved@ref}%
              {\codep@fe@single@nostar\codep@saved@ref}%
    }%
  \fi%
  %% ---- \pageref and \pageref* ----
  \ifcsname pageref\endcsname%
    \let\codep@saved@pageref\pageref%
    \protected\def\pageref{%
      \@ifstar{\codep@fe@single@star\codep@saved@pageref}%
              {\codep@fe@single@nostar\codep@saved@pageref}%
    }%
  \fi%
  %% ---- \Ref and \Ref* (nameref) ----
  \ifcsname Ref\endcsname%
    \let\codep@saved@Ref\Ref%
    \protected\def\Ref{%
      \@ifstar{\codep@fe@single@star\codep@saved@Ref}%
              {\codep@fe@single@nostar\codep@saved@Ref}%
    }%
  \fi%
  %% ---- \cref and \cref* (cleveref) ----
  \ifcsname cref\endcsname%
    \let\codep@saved@cref\cref%
    \protected\def\cref{%
      \@ifstar{\codep@fe@csv@star\codep@saved@cref}%
              {\codep@fe@csv@nostar\codep@saved@cref}%
    }%
  \fi%
  %% ---- \Cref and \Cref* (cleveref) ----
  \ifcsname Cref\endcsname%
    \let\codep@saved@Cref\Cref%
    \protected\def\Cref{%
      \@ifstar{\codep@fe@csv@star\codep@saved@Cref}%
              {\codep@fe@csv@nostar\codep@saved@Cref}%
    }%
  \fi%
  %% ---- \labelcref and \labelcref* (cleveref) ----
  \ifcsname labelcref\endcsname%
    \let\codep@saved@labelcref\labelcref%
    \protected\def\labelcref{%
      \@ifstar{\codep@fe@csv@star\codep@saved@labelcref}%
              {\codep@fe@csv@nostar\codep@saved@labelcref}%
    }%
  \fi%
  %% ---- \autoref and \autoref* (hyperref) ----
  \ifcsname autoref\endcsname%
    \let\codep@saved@autoref\autoref%
    \protected\def\autoref{%
      \@ifstar{\codep@fe@single@star\codep@saved@autoref}%
              {\codep@fe@single@nostar\codep@saved@autoref}%
    }%
  \fi%
}%

% Install the front-edge wrappers at begindocument/end, AFTER the
% backref-flush hook so the aux-replay queue is processed first.
\AddToHook{begindocument/end}[codependent/frontedge/install]{%
  \codep@installfrontedgerefpatch%
}%
\DeclareHookRule{begindocument/end}%
  {codependent/frontedge/install}{after}{codependent/backref/flush}%

%% ===================================================================
%% Section 8: Back-reference emission (rendering code in
%%            codependent-render.sty; tracking hooks remain here)
%% ===================================================================

%% @behavior B-NUM-PARA
% \codep@installparendhook
%   Install the para/end paragraph finalization hook.
%   Defensive flag clear: if a user invoked \codepbackrefs inside
%   the paragraph body, the per-atom \codep@manuallyemitted@<key>
%   flag was set; clear it here BEFORE the ctxpop drops the
%   paragraph atom from the ctx stack.  Empty-key branch is the
%   natural replay guard (\codep@getcurrentatomkey returns
%   \@empty during replay via \codep@getcurrentownerid).
\newcommand*{\codep@installparendhook}{%
  \AddToHook{para/end}{%
    \ifbool{codep@tracked}{%
      \ifcodep@paragraphopen%
        \codep@getcurrentatomkey\codep@tmp@parakey%
        \ifx\codep@tmp@parakey\@empty\else%
          \codep@manuallyemitted@clear@key{\codep@tmp@parakey}%
        \fi%
        \codep@ctxpop{paragraph}%
        \global\codep@paragraphopenfalse%
      \fi%
    }{}%
  }%
}%

%% ===================================================================
%% Section 9a: Semantic sidecar (.cdp) writer
%% ===================================================================
%%
%% Write-only sidecar file for Layer 2 (semantic CLI).  The .sty
%% never reads .cdp — it is strictly one-way output.  Record format
%% is line-oriented: one \codep@cdp@* control sequence per line
%% with fixed-arity brace-delimited arguments (no kv blobs).
%%

%% @utility
% \codep@cdpwrite{text}
%   Guarded write to the .cdp stream.  No-op when the stream
%   is not open (e.g. \if@filesw is false).
\newcommand*{\codep@cdpwrite}[1]{%
  \ifbool{codep@cdpopen}{%
    \immediate\write\codep@cdpout{#1}%
  }{}%
}

%% @utility
% \codep@cdpwrite@atom{text}
%   Atom-scoped guard: drops the write when not inside a tracked
%   atom (\codep@currentatom is empty).
\newcommand*{\codep@cdpwrite@atom}[1]{%
  \codep@getcurrentatomdisplay\codep@tmp@cdpdisplay%
  \ifx\codep@tmp@cdpdisplay\@empty\else%
    \codep@cdpwrite{#1}%
  \fi%
}%

%% --- Section 9a open hook (begindocument/before) ---
%% Per REVIEW_C finding #5, the stream opens at begindocument/before
%% (before any \AtBeginDocument hook), so atoms emitted from user
%% hooks are never silently dropped.
\AddToHook{begindocument/before}[codependent/cdp/open]{%
  \if@filesw
    \newwrite\codep@cdpout
    \immediate\openout\codep@cdpout=\jobname.cdp\relax
    \global\booltrue{codep@cdpopen}%
    \immediate\write\codep@cdpout{%
      \string\codep@cdp@version{2}}%
    \immediate\write\codep@cdpout{%
      \string\codep@cdp@source{\jobname.tex}}%
  \fi
}

%% --- Section 9a close hook: CDP sentinel drain ---
%% Write the \codep@cdp@end{OK} sentinel and close the stream.
%% Per REVIEW_C finding #7, the sentinel's presence is the CLI's
%% test for "complete file".  P04: invoked from
%% \codep@enddoc@orchestrator's drain@sentinel slot (must be LAST
%% of the drain slots since closing the stream drops later writes).
%% @utility
\def\codep@enddoc@drain@sentinel{%
  \ifbool{codep@cdpopen}{%
    \immediate\write\codep@cdpout{%
      \string\codep@cdp@end{OK}}%
    \immediate\closeout\codep@cdpout%
    \global\boolfalse{codep@cdpopen}%
  }{}%
}

%% --- Section 9a label wrap (cleveref-aware) ---
%% Installed at begindocument/before so we capture \label BEFORE
%% cleveref's \AtBeginDocument wrapper installs around us (see
%% docs/DESIGN.md §9a "Label wrap" double-wrap explanation).
\AddToHook{begindocument/before}[codependent/cdp/labelwrap]{%
  \let\codep@orig@label\label
  \@ifpackageloaded{cleveref}{%
    %% cleveref path: \label[type]{key}, optional arg.
    \def\label{%
      \@ifnextchar[%]
        \codep@cdp@label@withopt
        \codep@cdp@label@noopt
    }%
  }{%
    %% No cleveref: \label{key} only.
    \def\label#1{%
      \codep@getcurrentatomdisplay\codep@tmp@labeldisplay%
      \ifx\codep@tmp@labeldisplay\@empty\else%
        \codep@cdpwrite@atom{%
          \string\codep@cdp@label
            {\codep@tmp@labeldisplay}{#1}}%
      \fi%
      \codep@recordlabelowner{#1}%
      \codep@label@samerun{#1}%
      \codep@orig@label{#1}%
    }%
  }%
}
%% @behavior B-PASS-ONE
% \codep@label@samerun{label}
%   Replay label-derived same-run anchor hydration from \label-time state.
\def\codep@label@samerun#1{%
  \codep@ifcrefkey{#1}{}{%
    \codep@ifdatakey{#1}{}{%
      \edef\codep@tmp@labelkey{#1}%
      \in@{thmt@@}{\codep@tmp@labelkey}%
      \ifin@\else%
        \expandafter\xdef\csname codep@lblnum@#1\endcsname{\@currentlabel}%
        \@ifpackageloaded{hyperref}{%
          \ifx\@currentHref\@empty\else%
            \expandafter\ifx\csname codep@ltype@#1\endcsname\relax%
              \let\codep@tmp@labeltype\@empty%
            \else%
              \edef\codep@tmp@labeltype{\csname codep@ltype@#1\endcsname}%
            \fi%
            \codep@writeanchoreff{#1}{\codep@tmp@labeltype}%
              {\@currentlabel}{\@currentHref}%
          \fi%
        }{}%
      \fi%
    }%
  }%
}%
%% @behavior B-PASS-ONE
\def\codep@cdp@label@withopt[#1]#2{%
  \codep@getcurrentatomdisplay\codep@tmp@labeldisplay%
  \ifx\codep@tmp@labeldisplay\@empty\else%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@label%
        {\codep@tmp@labeldisplay}{#2}}%
  \fi%
  \codep@recordlabelowner{#2}%
  \codep@label@samerun{#2}%
  \codep@orig@label[#1]{#2}%
}%
%% @behavior B-PASS-ONE
\def\codep@cdp@label@noopt#1{%
  \codep@getcurrentatomdisplay\codep@tmp@labeldisplay%
  \ifx\codep@tmp@labeldisplay\@empty\else%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@label%
        {\codep@tmp@labeldisplay}{#1}}%
  \fi%
  \codep@recordlabelowner{#1}%
  \codep@label@samerun{#1}%
  \codep@orig@label{#1}%
}%

%% @behavior B-PASS-ONE
% \codep@writelbltype{label}
%   Write the current atom type prefix to .aux for this label.
%   Priority order:
%   1. Standalone equation (\codep@eq@lbltype@pending non-empty):
%      amsmath defers \label to after the environment group closes, so
%      codep@inequation is already false and \codep@currentatom may
%      hold the preceding paragraph atom.  The globally-saved pending
%      type wins over any ambient paragraph context — equations own
%      their own labels.  Clear the register after use.
%   2. Inside a tracked theorem/proof atom (\codep@currentatom non-empty):
%      write \codep@currenttype (set by the theorem hook).
%   3. Otherwise: no-op (no owning atom).
\def\codep@writelbltype#1{%
  \codep@recordlabelowner{#1}%
}%

%% --- Section 9a concept-tracking helpers ---
%% Supporting macros for \codepnewcommand / \codepNewDocumentCommand.
%% The public API lives in Section 10; the emit helpers live here
%% because they write to both .cdp and .aux.

%% @utility
% \codep@cdpwrite@deferred{text}
%   Accumulate a deferred .cdp write for preamble-time emission.
%   Records queued here are flushed once the .cdp stream opens.
%   Used for \codep@cdp@cmddef records whose declarations occur
%   in the preamble before the stream is available.
%   IMPORTANT: the argument must already be fully expanded (no
%   transient macros like \codep@tmp@name) because \g@addto@macro
%   does not expand its argument.  Callers use \edef to pre-build
%   the record string.
\newcommand*{\codep@cdpwrite@deferred}[1]{%
  \ifbool{codep@cdpopen}{%
    % Stream already open (late declaration): write immediately.
    \codep@cdpwrite{#1}%
  }{%
    \g@addto@macro\codep@cdp@deferred{%
      \codep@cdpwrite{#1}}%
  }%
}

% Flush deferred sbl writes after the stream opens.
\AddToHook{begindocument/before}[codependent/cdp/cmddef]{%
  \codep@cdp@deferred
  \global\let\codep@cdp@deferred\@empty
}
% Must run AFTER the sbl open hook.
\DeclareHookRule{begindocument/before}{codependent/cdp/cmddef}%
                {after}{codependent/cdp/open}

%% @behavior B-CONC-DEFSITE
%% @behavior B-CONC-DUPDEF
%% @behavior B-CONC-OUTSIDE
%% @behavior B-EDGE-CONC-OUTSIDE
% \codep@emit@def{name}
%   Star-branch handler: fires when \cmd* is used (defining site).
%   Records the current atom as the defining site for the named
%   concept.  Emits both .aux and .cdp records.  Per J2: empty-
%   currentatom short-circuit fires BEFORE the duplicate-def check.
%   name -- bare command name (e.g. "Hom")
\newcommand*{\codep@emit@def}[1]{%
  \codep@getcurrentatomdisplay\codep@tmp@conceptatom%
  \ifx\codep@tmp@conceptatom\@empty%
    % No atom context (footnote, caption, orphan): silent no-op.
  \else%
    \@ifundefined{codep@concept@#1}%
      {\expandafter\xdef%
         \csname codep@concept@#1\endcsname%
         {\codep@tmp@conceptatom}%
       \if@filesw%
         \immediate\write\@auxout{%
           \string\codep@concept{#1}{\codep@tmp@conceptatom}}%
       \fi%
       \codep@cdpwrite@atom{%
         \string\codep@cdp@def{\codep@tmp@conceptatom}{#1}}%
      }%
      {\PackageError{codependent}%
        {\string\\#1* defined at atoms\space%
         \csname codep@concept@#1\endcsname\space and\space%
         \codep@tmp@conceptatom}%
        {Exactly one definition site is permitted per\space%
         concept.  Use \string\\#1\space (without star)\space%
         at the non-definitional site.}%
      }%
  \fi}%

%% @behavior B-CONC-EDGES
%% @behavior B-CONC-USEDIN
%% @behavior B-CONC-OUTSIDE
%% @behavior B-EDGE-CONC-OUTSIDE
% \codep@emit@use{name}
%   Non-star-branch handler: fires when \cmd is used (use site).
%   Emits both .aux and .cdp records under the current atom guard.
%   Registers the concept name for the missing-def-site scan at
%   \AtEndDocument (first-use only, guarded by conceptused csname).
%   name -- bare command name (e.g. "Hom")
\newcommand*{\codep@emit@use}[1]{%
  \codep@getcurrentatomdisplay\codep@tmp@conceptatom%
  \ifx\codep@tmp@conceptatom\@empty\else%
    % Register concept name for end-document missing-def scan.
    \@ifundefined{codep@conceptused@#1}{%
      \expandafter\gdef%
        \csname codep@conceptused@#1\endcsname{1}%
      \g@addto@macro\codep@conceptnames{\do{#1}}%
    }{}%
    \if@filesw%
      \immediate\write\@auxout{%
        \string\codep@conceptref{\codep@tmp@conceptatom}{#1}}%
    \fi%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@use{\codep@tmp@conceptatom}{#1}}%
  \fi}%

%% --- Section 9a.9: Concept missing-def-site scan ---
%% At \AtEndDocument, walk the concept name list and check each
%% concept for a matching def site.  Concepts with uses but no
%% def site trigger a warning (or info per conceptwarnings option).

%% @behavior B-CONC-NODEF
% \codep@conceptwarnscan
%   Walk \codep@conceptnames via \do.  For each concept name,
%   check if codep@conceptdef@<name> is defined.  If not, the
%   concept has uses but no \cmd* def-site marker; warn.
\def\codep@conceptwarnscan{%
  \def\do##1{%
    \@ifundefined{codep@conceptdef@##1}{%
      \ifbool{codep@conceptwarnings}{%
        \PackageWarning{codependent}{%
          \expandafter\string\csname ##1\endcsname\space%
          used but no starred definition site found;\MessageBreak%
          backrefs for this concept are disabled}%
      }{%
        \PackageInfo{codependent}{%
          \expandafter\string\csname ##1\endcsname\space%
          used but no starred definition site found%
          (conceptwarnings=off)}%
      }%
    }{}%
  }%
  \codep@conceptnames%
}

%% --- Section 9a.10: Shared wrapper-pipeline helper ---

%% @implements \codepnewcommand
% \codep@definetrackedcmd{name}{cmd}{kind}{key2}{val2}
%   Common pipeline shared by \codepnewcommand and
%   \codepNewDocumentCommand.  The declaration step (step 1) is
%   handled by the caller before invoking this helper.
%   name -- bare command name string (e.g. "Hom")
%   cmd  -- the command token (e.g. \Hom), already declared by caller
%   kind -- kind string for the .cdp cmddef record
%   key2 -- second .cdp attribute key (arity / argspec)
%   val2 -- second .cdp attribute value (pre-expanded by caller)
%
%   Steps performed:
%   2. Save original body to codep@body@<name>.
%   3. Define star/nostar dispatch helpers codep@star@<name> and
%      codep@nostar@<name> via \edef.
%   4. Redefine \cmd as a \protected\edef \@ifstar dispatcher.
%   5. Emit three deferred .cdp cmddef records: kind, key2/val2, src.
\def\codep@definetrackedcmd#1#2#3#4#5{%
  % 2. Save the original definition.
  \expandafter\let%
    \csname codep@body@#1\endcsname#2%
  % 3. Define star/nostar dispatch targets.
  \expandafter\edef%
    \csname codep@star@#1\endcsname{%
      \noexpand\codep@emit@def{#1}%
      \expandafter\noexpand%
        \csname codep@body@#1\endcsname}%
  \expandafter\edef%
    \csname codep@nostar@#1\endcsname{%
      \noexpand\codep@emit@use{#1}%
      \expandafter\noexpand%
        \csname codep@body@#1\endcsname}%
  % 4. Redefine the command with star dispatch via \@ifstar.
  %    \protected\edef makes the wrapper robust so it survives
  %    expansion in moving arguments (\section titles, captions,
  %    .aux writes) without premature \@ifstar expansion.
  \protected\edef#2{%
    \noexpand\@ifstar%
      \expandafter\noexpand%
        \csname codep@star@#1\endcsname
      \expandafter\noexpand%
        \csname codep@nostar@#1\endcsname}%
  % 5. Emit global declaration records (deferred: the .cdp
  %    stream may not be open yet during the preamble).
  %    Records are pre-expanded via \edef so transient values
  %    (#1, \inputlineno) are captured eagerly.
  \edef\codep@tmp@rec{%
    \noexpand\codep@cdpwrite@deferred{%
      \string\codep@cdp@cmddef{#1}%
      {kind}{#3}}%
    \noexpand\codep@cdpwrite@deferred{%
      \string\codep@cdp@cmddef{#1}%
      {#4}{#5}}%
    \noexpand\codep@cdpwrite@deferred{%
      \string\codep@cdp@cmddef{#1}%
      {src}{\jobname.tex:\the\inputlineno:1}}%
  }%
  \codep@tmp@rec%
}

% P04: \codep@conceptwarnscan is called from
% \codep@enddoc@orchestrator's drain@warnscan slot (Section 9b).
% No direct \AtEndDocument registration here.

%% ===================================================================
%% Section 9b: Enddocument orchestrator (v11 R29 closure)
%% ===================================================================
%% A single \AddToHook{enddocument} registration that dispatches to
%% five named drain slots in a fixed order.  The three historical
%% \AtEndDocument sites (P03 refpending drain, CDP sentinel close,
%% conceptwarnscan) are consolidated here — each legacy body is
%% now an explicit drain slot, making the enddocument sequence
%% trivially inspectable and stable across future changes.
%%
%% Two-tier failure evaluator:
%%   \codep@enddoc@evaluator@pre runs BEFORE drains and may set
%%   \ifcodep@abortfinalize when it detects fatal pre-drain state
%%   (e.g. unsettled proof-binding slot).  When aborted, the
%%   drains are skipped and \codep@enddoc@halt fires \PackageError.
%%   \codep@enddoc@evaluator@post runs AFTER drains and emits
%%   \PackageWarning for residual non-fatal state (e.g. subsystem
%%   counters reporting incomplete work).
%%
%% v11 R29 closure: exactly ONE \AddToHook{enddocument} registration
%% in the entire codebase, enforced by lint_sty_structural.py (P04
%% A6 extension).

% Pre-drain evaluator — walks the subsystems list and flips
% \codep@abortfinalizetrue when any registered subsystem has
% failed==total && total>0 (i.e. EVERY tracked operation failed,
% so the drains would emit only stale records).  Wraps the walk
% in \begingroup so the \let\do... does not escape.
%% @behavior B-ERROR-ENDDOC
\def\codep@enddoc@evaluator@pre{%
  \begingroup%
    \let\do\codep@subsystem@check@fatal%
    \codep@subsystems@list%
  \endgroup%
}%

% Per-subsystem fatal check invoked by \do-walking
% \codep@subsystems@list.  Fatal when failed==total && total>0.
%% @utility
\def\codep@subsystem@check@fatal#1{%
  \ifnum\csname codep@subsys@#1@total\endcsname>0\relax%
    \ifnum\csname codep@subsys@#1@failed\endcsname=%
          \csname codep@subsys@#1@total\endcsname%
      \global\codep@abortfinalizetrue%
    \fi%
  \fi%
}%

% Halt body — fires when the pre-drain evaluator set
% \codep@abortfinalizetrue.  Drains are skipped to prevent
% emitting stale aux records; instead a PackageError names the
% condition and directs the user to preceding warnings for
% per-subsystem context.
%% @behavior B-ERROR-ENDDOC
\def\codep@enddoc@halt{%
  \PackageError{codependent}%
    {all operations in at least one subsystem failed; refusing to finalize output -- aux/cdp drains skipped to avoid stale records}%
    {Inspect preceding \string\PackageWarning\space lines for per-subsystem context.}%
}%

% Post-drain evaluator — warn-only; runs AFTER drains complete
% and emits one \PackageWarning per subsystem with
% 0<failed<total (partial-success residual).  Skipped entirely
% if the pre-drain evaluator aborted (already warned at halt
% time).  The failed==total case cannot occur here since it
% would have halted pre-drain.
%% @behavior B-WARN-ENDDOC
\def\codep@enddoc@evaluator@post{%
  \ifcodep@abortfinalize\else%
    \begingroup%
      \let\do\codep@subsystem@check@partial%
      \codep@subsystems@list%
    \endgroup%
  \fi%
}%

% Per-subsystem partial-success check invoked by \do-walking
% \codep@subsystems@list.  Emits \PackageWarning when the
% subsystem saw partial failures (some but not all operations).
%% @utility
\def\codep@subsystem@check@partial#1{%
  \ifnum\csname codep@subsys@#1@failed\endcsname>0\relax%
    \ifnum\csname codep@subsys@#1@failed\endcsname<%
          \csname codep@subsys@#1@total\endcsname%
      \PackageWarning{codependent}{%
        \the\csname codep@subsys@#1@failed\endcsname\space of\space%
        \the\csname codep@subsys@#1@total\endcsname\space#1%
        \space operations failed -- rendering with partial results}%
    \fi%
  \fi%
}%

% Drain slots — each is a thin wrapper delegating to the macro
% that historically ran inside an \AtEndDocument block.
%
% Order matters: sentinel MUST be last since closing the .cdp
% stream silently drops any later writes.  warnscan runs after
% the main drains so subsystem activity is visible to it.
%
%% @utility
\def\codep@enddoc@drain@p03{%
  \codep@refpending@drain%
}%
% drain@proofs — consume any still-pending proof-binding slot.
% If \codep@pendingproofbind is non-empty at enddoc the binding
% was declared but the proof environment that should have
% consumed it never appeared.  Record the failure and warn with
% the captured context; then clear the slot so an aborted run
% does not persist stale state (runtime-only, no aux impact).
%% @utility
\def\codep@enddoc@drain@proofs{%
  \ifx\codep@pendingproofbind\@empty\else%
    \codep@subsystem@recordfailed{proofof}%
    \PackageWarning{codependent}{proof-bind slot non-empty at \string\end{document} -- target '\codep@pendingproofbind@label' (declared at input line \codep@pendingproofbind@line) never resolved}%
    \global\let\codep@pendingproofbind\@empty%
    \global\let\codep@pendingproofbind@line\@empty%
    \global\let\codep@pendingproofbind@label\@empty%
  \fi%
}%
%% @behavior B-PASS-ONE
\def\codep@enddoc@drain@renderlist{%
  \ifnum\codep@replaydepth>0\relax%
  \else%
    \codep@renderlist@emit@all%
  \fi%
}%
%% @utility
\def\codep@enddoc@drain@warnscan{%
  \codep@conceptwarnscan%
}%
% \codep@enddoc@drain@sentinel is defined in Section 9a next to
% the CDP-stream machinery (must stay near \codep@cdpout).

% Orchestrator body — the single enddocument entry-point.
% Consolidates the three historical \AtEndDocument registrations
% into a fixed-order drain pipeline with a two-tier failure
% evaluator.  No behavior ID yet — this is infrastructure; the
% user-visible behaviors (error-on-fatal, warn-on-residual) are
% asserted via the evaluator bodies populated in commit 3.
%% @utility
\def\codep@enddoc@orchestrator{%
  \codep@enddoc@evaluator@pre%
  \ifcodep@abortfinalize%
    \codep@enddoc@halt%
  \else%
    \codep@enddoc@drain@p03%
    \codep@enddoc@drain@proofs%
    \codep@enddoc@drain@renderlist%
    \codep@enddoc@drain@warnscan%
    \codep@enddoc@drain@sentinel%
  \fi%
  \codep@enddoc@evaluator@post%
}%

% Single registration — enforced by lint_sty_structural.py.
\AddToHook{enddocument}{\codep@enddoc@orchestrator}

%% ===================================================================
%% Section 10: User-facing API
%% ===================================================================

%% @implements \codeptrack
% \codep@extractfirst  env1,env2,...\@nil
%   Extract the first comma-separated element into \codep@basecounter.
\def\codep@extractfirst#1,#2\@nil{\def\codep@basecounter{#1}}

% \codeptrack{env1,env2,...}
%   Post-hoc alias base counter to atom counter and install all
%   hooks.  Must be called AFTER all \newtheorem declarations.
%   env1, env2, ... -- comma-separated environment names to track.
%   The first env name is auto-detected as the base counter name.
%% @behavior B-COMPAT-THMTOOLS-CONTINUED
%% @behavior B-EDGE-TRACK-TWICE
% Generic env-hook surface: covers thmtools[continued] via generic hooks;
% no per-package shim.
\newcommand*{\codeptrack}[1]{%
  % Guard against double invocation (newcounter{atom} would crash).
  \ifbool{codep@tracked}{%
    \PackageError{codependent}%
      {\string\codeptrack\space called twice}%
      {Call \string\codeptrack\space only once, after all%
       theorem declarations.}%
  }{}%
  \booltrue{codep@tracked}%
  % Auto-detect the base counter from the first environment name.
  \codep@extractfirst#1,\@nil%
  % Check that the base counter exists (i.e. \newtheorem was called).
  \@ifundefined{c@\codep@basecounter}{%
    \PackageError{codependent}%
      {Counter '\codep@basecounter' undefined -- %
       \string\codeptrack\space called before%
       \string\newtheorem}%
      {Declare all theorem environments with%
       \string\newtheorem\space before calling%
       \string\codeptrack.}%
  }{}%
  \codep@setupcounter%
  % Hook each listed environment and its starred variant.
  % Note: \expandafter ensures the env name is fully expanded
  % before \codep@hooktheorem captures it in \AddToHook
  % bodies; without this, a stale \codep@tmp@envname reference would
  % resolve to the wrong name at hook-fire time.
  \@for\codep@tmp@envname:=#1\do{%
    \ifx\codep@tmp@envname\@empty\else
      % Re-alias this env's counter to \c@atom.  When thmtools
      % declares an env with sibling=<base>, it \let-aliases
      % \c@<env> to \c@<base> at declaration time.  But
      % \codep@setupcounter later replaces \c@<base> with
      % \c@atom; the sibling counters still point to the old
      % register.  This re-let ensures every tracked env's
      % counter is \c@atom, regardless of declaration order.
      \expandafter\@ifundefined\expandafter{%
        \expandafter c@\codep@tmp@envname%
      }{}{%
        \expandafter\let\csname c@\codep@tmp@envname\endcsname\c@atom%
        % Also alias the display macro \the<env> to \theatom.
        % When thmtools declares an env with sibling=<base>, it
        % snapshots \the<base> at declaration time.  If codependent
        % later rewires \the<base> to \theatom, the sibling's
        % display macro still has the old format.  This re-let
        % ensures every tracked env uses the atom display format.
        \expandafter\let\csname the\codep@tmp@envname\endcsname\theatom%
      }%
      \expandafter\codep@hooktheorem%
        \expandafter{\codep@tmp@envname}%
      % Auto-register starred variant (amsthm creates foo*).
      \edef\codep@starred{\codep@tmp@envname*}%
      \expandafter\@ifundefined\expandafter{%
        \codep@starred%
      }{}{%
        \expandafter\codep@hooktheorem%
          \expandafter{\codep@starred}%
      }%
    \fi
  }%
  \codep@hookproof%
  % Install suppression and paragraph hooks.
  \codep@installsuppress%
  \codep@suppresssectioning%
  % Defer section title capture to begindocument/end so that
  % hyperref's \addcontentsline redefinition has already run.
  \AddToHook{begindocument/end}[codependent/sectitle]{%
    \codep@capturesectitle}%
  \codep@suppresscommands%
  \codep@installparahook%
  \codep@installparendhook%
}

%% @utility
% \codeptag{kind}{value}
%   Emit a semantic tag record to the .cdp sidecar, scoped to the
%   current atom.  No visible typesetting effect.  Ignored outside
%   a tracked atom.
%   kind  -- tag category (e.g. uid, introduces, type)
%   value -- tag payload (free-form UTF-8)
\newcommand*{\codeptag}[2]{%
  \codep@getcurrentatomdisplay\codep@tmp@tagatom%
  \ifx\codep@tmp@tagatom\@empty\else%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@tag%
      {\codep@tmp@tagatom}{#1}{#2}}%
  \fi%
}%

% \codepbackrefs
%   User-driven backref emission point.  Resolves the active source
%   atom's key, sets the per-atom
%   \codep@manuallyemitted@<key> flag (so the env-end auto-flush
%   skips a duplicate emission), and routes through the rendering
%   layer's manual-emit hook to queue + flush the "Used in ..." line
%   at the call site.  Outside any tracked atom: emits a package
%   warning and produces no output.  Complete no-op during
%   restatable replay (replay guard wraps the entire body).
%
%   The flag is cleared at env-end / proof-afterend / para-end hook
%   sites (see \codep@manuallyemitted@end@outer@clear,
%   \codep@hookproof@afterend, \codep@installparendhook).
%% @behavior B-REND-INLINE
\newcommand*{\codepbackrefs}{%
  \ifnum\codep@replaydepth=0\relax%
    \codep@getcurrentatomkey\codep@tmp@manualkey%
    \ifx\codep@tmp@manualkey\@empty%
      \PackageWarning{codependent}{%
        \string\codepbackrefs\space called outside any tracked atom%
        \space--- no refs emitted}%
    \else%
      \expandafter\xdef%
        \csname codep@manuallyemitted@\codep@tmp@manualkey\endcsname{1}%
      \codep@render@manual@emit{\codep@tmp@manualkey}%
    \fi%
  \fi%
}%

% \codepproofof{label}    — bind a separated proof to label
% \codepproofof*{label}   — same, preserving explicit proof-anchor mode
%   Associate a separated proof with its theorem.  Must be called
%   inside a \begin{proof}...\end{proof} environment.  Looks up
%   the label's atom number and sets the current atom to the
%   starred version (e.g., 2.1*), enabling correct backref
%   attribution.
%
%   The proof-begin anchor is emitted when the proof opens.  When
%   \codepproofof rebinds the proof key later in the body, the new
%   proof:N.M key is aliased through \codep@anchormap to that
%   existing proof-begin anchor, so proof backrefs still land near
%   the proof heading rather than on the statement or a later
%   in-proof anchor.  The starred form is retained as a
%   compatibility spelling for the same proof-local target path.
%
%   Lazy proof integration: if the proof was non-adjacent,
%   \codep@proof@standalone only set the deferred flag (no atom
%   created yet).  \codepproofof clears the deferred flag and
%   assigns the proof's identity to the target theorem — no
%   standalone atom is ever materialized.
%% @behavior B-PROOF-SEP
%% @behavior B-LINK-PROOFOF-STAR
\newcommand{\codepproofof}{%
  \@ifstar{\codep@proofof@star}{\codep@proofof@plain}}
%% @implements \codep@proofof@do
\def\codep@proofof@plain#1{\codep@proofof@do{#1}{}}
%% @behavior B-LINK-PROOFOF-STAR
\def\codep@proofof@star#1{\codep@proofof@do{#1}{anchor}}
%% @behavior B-PROOF-SEP
% \codep@proofof@do{label}{anchormode}
%   Entry dispatcher for \codepproofof.  Try resolution paths in
%   order:
%     1. Legacy \codep@lblnum@<label> (aux-round-trip value,
%        stable across passes once the label has been seen once).
%     2. Same-run in-memory \codep@lblentity@<label> ->
%        \codep@entity@<atom-key>@display (active as soon as the
%        referenced entity finishes, so backward refs and same-run
%        forward refs whose target has already closed resolve now).
%     3. Defer via \codep@defer@proofof when neither is available.
%        The deferred token sequence is drained at enddoc by
%        \codep@refpending@drain against the now-complete binding.
\def\codep@proofof@do#1#2{%
  \ifbool{codep@proofsnumbered}{%
    \codep@subsystem@recordtotal{proofof}%
    \ifx\codep@currentproofid\@empty\else%
      \codep@proofof@do@resolver{\codep@proofof@resolve@warn}{#1}{#2}%
    \fi%
  }{}%
}%

% \codep@proofof@do@resolver{resolver}{label}{anchormode}
%   Dispatch a proof-of binding through the requested resolver.
%% @utility
\def\codep@proofof@do@resolver#1#2#3{%
  \expandafter\ifx\csname codep@lblnum@#2\endcsname\relax%
    \expandafter\ifx\csname codep@lblentity@#2\endcsname\relax%
      \codep@defer@proofof{#1}{\codep@currentproofid}{#2}{#3}%
    \else%
      #1{\codep@currentproofid}{#2}{#3}%
    \fi%
  \else%
    #1{\codep@currentproofid}{#2}{#3}%
  \fi%
}%

% \codep@proofof@resolve{proofid}{label}{anchormode}
%   Perform the proof<->target binding once the label is resolvable.
%   Called directly from \codep@proofof@do when the label is known
%   at proofof-time; called indirectly at enddoc drain time via the
%   deferred token sequence stored by \codep@defer@proofof.
%
%   Explicit callers look up the display number via the same cascade
%   as \codep@proofof@do (lblnum first, then lblentity->entity@display).
%   Auto-detected proof headings use only lblentity->entity@display so
%   non-tracked labels such as sections no-op silently.  If still
%   unresolved at this point the label truly never existed; record
%   failure silently so callers can decide whether to warn.
%% @behavior B-PROOF-SEP
\def\codep@proofof@resolve#1#2#3{%
  \codep@proofof@resolve@inner{0}{#1}{#2}{#3}%
}%

% \codep@autoproofof@resolve{proofid}{label}{provisional-key}
%   Auto-detected proof-heading resolver entry.  The third argument
%   may carry an unresref:<N> key for a deferred forward-ref binding.
%% @implements \codep@proofof@resolve
\def\codep@autoproofof@resolve#1#2#3{%
  \codep@proofof@resolve@inner{1}{#1}{#2}{#3}%
}%

% \codep@proofof@resolve@inner{auto-flag}{proofid}{label}{mode-or-prov}
%   Shared proof-attribution resolver.  auto-flag=1 uses the tracked
%   lblentity gate and may migrate body refs from an unresref:<N> source.
%% @implements \codep@proofof@resolve
\def\codep@proofof@resolve@inner#1#2#3#4{%
  \global\codep@proofof@resolvedfalse%
  \let\codep@tmp@proofdisp\@empty%
  \def\codep@tmp@autoflag{#1}%
  \def\codep@tmp@one{1}%
  \ifx\codep@tmp@autoflag\codep@tmp@one%
    \expandafter\ifx\csname codep@lblentity@#3\endcsname\relax\else%
      \edef\codep@tmp@proofentity{\csname codep@lblentity@#3\endcsname}%
      \edef\codep@tmp@proofdispcs{%
        codep@entity@\codep@tmp@proofentity @display}%
      \expandafter\ifx\csname\codep@tmp@proofdispcs\endcsname\relax\else%
        \edef\codep@tmp@proofdisp{%
          \csname\codep@tmp@proofdispcs\endcsname}%
      \fi%
    \fi%
  \else%
    \expandafter\ifx\csname codep@lblnum@#3\endcsname\relax%
      \expandafter\ifx\csname codep@lblentity@#3\endcsname\relax\else%
        \edef\codep@tmp@proofentity{\csname codep@lblentity@#3\endcsname}%
        \edef\codep@tmp@proofdispcs{%
          codep@entity@\codep@tmp@proofentity @display}%
        \expandafter\ifx\csname\codep@tmp@proofdispcs\endcsname\relax\else%
          \edef\codep@tmp@proofdisp{%
            \csname\codep@tmp@proofdispcs\endcsname}%
        \fi%
      \fi%
    \else%
      \edef\codep@tmp@proofdisp{\csname codep@lblnum@#3\endcsname}%
    \fi%
  \fi%
  \ifx\codep@tmp@proofdisp\@empty\else%
    \global\codep@proofof@resolvedtrue%
    \codep@proof@identitykey{#2}{\codep@tmp@proofkey}%
    \codep@atomgetkey{#2}{\codep@tmp@oldproofkey}%
    \ifx\codep@tmp@autoflag\codep@tmp@one%
      \codep@ifunresrefkey{#4}{%
        \edef\codep@tmp@oldproofkey{#4}%
      }{}%
    \fi%
    \codep@proof@setidentity{#2}%
    \expandafter\ifx\csname codep@lblentity@#3\endcsname\relax%
      \edef\codep@tmp@proofparentval{theorem:\codep@tmp@proofdisp}%
    \else%
      \edef\codep@tmp@proofparentval{%
        \csname codep@lblentity@#3\endcsname}%
    \fi%
    \ifx\codep@tmp@autoflag\codep@tmp@one%
      \codep@proof@maybeheadingoverrideadjacent{#2}{%
        \codep@tmp@proofparentval}{\codep@tmp@proofdisp}%
    \fi%
    \codep@prooftargetmeta@append{\codep@tmp@proofkey}{%
      \codep@tmp@proofparentval}{\codep@tmp@proofdisp}{*}%
    \codep@proof@markparent{#2}{\codep@tmp@proofparentval}%
    \codep@atomsetkey{#2}{\codep@tmp@proofkey}%
    \codep@proof@writebeginpage{#2}{\codep@tmp@proofkey}%
    \ifx\codep@tmp@oldproofkey\@empty\else%
      \ifx\codep@tmp@oldproofkey\codep@tmp@proofkey\else%
        \ifx\codep@tmp@autoflag\codep@tmp@one%
          \codep@keymap@record{%
            \codep@tmp@oldproofkey}{\codep@tmp@proofkey}%
        \fi%
      \fi%
    \fi%
    \edef\codep@tmp@resolverproofid{#2}%
    \ifx\codep@tmp@resolverproofid\codep@currentproofid%
    \else%
      \codep@graph@getdisplay{\codep@tmp@proofkey}{%
        \codep@tmp@proofrenderdisp}%
      \codep@captureentitymeta{\codep@tmp@proofkey}{proof}%
        {\codep@tmp@proofrenderdisp}{proof}{\codep@tmp@proofparentval}%
      \if@filesw%
        \protected@write\@auxout{}{%
          \string\codep@entitymeta{\codep@tmp@proofkey}{proof}%
            {\codep@tmp@proofrenderdisp}{proof}{\codep@tmp@proofparentval}}%
      \fi%
    \fi%
    \global\codep@proofdisplaypendingfalse%
    \global\codep@autoproofof@eligiblefalse%
    \global\let\codep@pendingproofbind\@empty%
    \ifx\codep@tmp@autoflag\codep@tmp@one%
      \codep@proof@adjcandidate@drop{#2}%
    \fi%
    \if@filesw%
      \ifx\codep@tmp@autoflag\codep@tmp@one%
        \codep@ifunresrefkey{#4}{%
          \codep@unresref@flushrefs{#4}{\codep@tmp@proofkey}%
        }{}%
      \fi%
      \codep@subsystem@recordtotal{atomref}%
      \codep@dedupwrite{\codep@tmp@proofkey}{#3}%
    \fi%
    \codep@proof@bindbeginanchor{#2}{\codep@tmp@proofkey}%
    \codep@render@queuebackref{\codep@tmp@proofkey}%
    \codep@proofof@attribcount@advance{#2}%
  \fi%
}%

% \codep@proofof@resolve@warn{proofid}{label}{anchormode}
%   Resolver wrapper used by explicit \codepproofof calls.
%% @implements \codep@proofof@resolve
\def\codep@proofof@resolve@warn#1#2#3{%
  \codep@proofof@resolve{#1}{#2}{#3}%
  \ifcodep@proofof@resolved\else%
    \PackageWarning{codependent}{\string\codepproofof: unknown label\space%
      '#2'. The label may not exist or may not have been processed yet}%
  \fi%
}%

% \codepnewcommand{\cmd}[arity]{body}
%   Define a command with codependent concept tracking.  Mirrors
%   \newcommand exactly: \cmd with backslash, optional [arity]
%   (default 0), mandatory {body} using #1..#N.
%
%   At declaration time, emits three global .cdp records:
%     \codep@cdp@cmddef{name}{kind}{newcommand}
%     \codep@cdp@cmddef{name}{arity}{N}
%     \codep@cdp@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command answers both
%   \cmd (use site) and \cmd* (def site).  Both forms typeset
%   the same body; the star controls which emit helper fires.
%
%   \cmd  -- command to define (with backslash, e.g. \Hom)
%   arity -- optional integer 0..9 (default 0)
%   body  -- replacement text, uses #1..#N
%% @behavior B-CONC-EDGES
\NewDocumentCommand{\codepnewcommand}{m O{0} +m}{%
  % #1 = \cmd (with backslash), #2 = arity, #3 = body.
  \edef\codep@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \newcommand (handles all #-
  %    numbering naturally).
  \newcommand#1[#2]{#3}%
  % 2-5. Shared pipeline: save body, build wrappers, emit .cdp.
  \codep@definetrackedcmd{\codep@tmp@name}{#1}%
    {newcommand}{arity}{\number#2}%
}
% Deprecated alias — old documents using \codepNewCommand still work.
\let\codepNewCommand\codepnewcommand

% \codepNewDocumentCommand{\cmd}{argspec}{body}
%   Define a command with codependent concept tracking, using xparse's
%   full argument specification.  Mirrors \NewDocumentCommand
%   exactly: \cmd with backslash, {argspec} string, {body}.
%
%   At declaration time, emits three global .cdp records:
%     \codep@cdp@cmddef{name}{kind}{NewDocumentCommand}
%     \codep@cdp@cmddef{name}{argspec}{<user-spec>}
%     \codep@cdp@cmddef{name}{src}{file:line:1}
%
%   At invocation time, the wrapped command prepends a codependent
%   star to the user's argspec.  \cmd* marks a def site; \cmd
%   marks a use site.  Both typeset the same body.  If the
%   user's argspec itself starts with "s", the user's star
%   requires a second "*" at call time (e.g. \cmd** for
%   codependent-def + user-star).
%
%   \cmd    -- command to define (with backslash)
%   argspec -- xparse argument specification string
%   body    -- replacement text, uses #1..#N per the spec
%% @behavior B-CONC-EDGES
\NewDocumentCommand{\codepNewDocumentCommand}{m m +m}{%
  % #1 = \cmd, #2 = argspec, #3 = body.
  \edef\codep@tmp@name{%
    \expandafter\@gobble\string#1}%
  % 1. Define the command via \NewDocumentCommand (handles
  %    all xparse arg types and #-numbering naturally).
  \NewDocumentCommand{#1}{#2}{#3}%
  % 2-5. Shared pipeline: save body, build wrappers, emit .cdp.
  \codep@definetrackedcmd{\codep@tmp@name}{#1}%
    {NewDocumentCommand}{argspec}{#2}%
}

