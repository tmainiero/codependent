%% ===================================================================
%% Section 4a: Runtime helpers
%% ===================================================================

% Proof atoms are identified by their opaque key (proof:a<N>) only;
% see @behavior B-PROOF-OPAQUE-ID at \codep@proof@identitykey.
% there is no display-keyed alias. \hyperref[proof:1.2]{...} is NOT
% supported -- users must reference proof atoms by their proof:a<N>
% key (extractable from the .cdp file).
%
% A generic display->atom sidecar rail will be added in Wave E
% (sub-item E1) to support display-keyed reverse lookup for joint
% proofs, per-result ordinals, continued theorems, and cross-doc.
%% @utility
% \codep@allocatomid{macro}{kind}
%   Allocate a fresh opaque source-atom ID (aN) into macro.
\def\codep@allocatomid#1#2{%
  \global\advance\codep@atomid by 1\relax
  \xdef#1{a\the\codep@atomid}%
  \expandafter\xdef\csname codep@atomkind@#1\endcsname{#2}%
}%

%% @utility
% \codep@alloctargetid{macro}{kind}
%   Allocate a fresh opaque target ID (qN) into macro.
\def\codep@alloctargetid#1#2{%
  \global\advance\codep@targetid by 1\relax
  \xdef#1{q\the\codep@targetid}%
  \expandafter\xdef\csname codep@targetkind@#1\endcsname{#2}%
}%

%% @utility
% \codep@ctxpush{atom-id}{kind}
%   Push one source context entry onto the global stack.
\def\codep@ctxpush#1#2{%
  \global\advance\codep@ctxdepth by 1\relax%
  \expandafter\xdef\csname codep@ctxid@\the\codep@ctxdepth\endcsname{#1}%
  \expandafter\xdef%
    \csname codep@ctxkind@\the\codep@ctxdepth\endcsname{#2}%
}%

%% @utility
% \codep@ctxpop{kind}
%   Pop one source context entry, hard-erroring on mismatch.
\def\codep@ctxpop#1{%
  \ifnum\codep@ctxdepth<1\relax%
    \PackageError{codependent}{Context stack underflow on '#1'}{%
      codependent detected an internal stack underflow while%
      closing '#1'.}%
  \else%
    \edef\codep@tmp@ctxkind{%
      \csname codep@ctxkind@\the\codep@ctxdepth\endcsname}%
    \def\codep@tmp@expected{#1}%
    \ifx\codep@tmp@ctxkind\codep@tmp@expected\else%
      \PackageError{codependent}{Context stack mismatch on '#1'}{%
        Expected to pop '#1' but found '\codep@tmp@ctxkind'.}%
    \fi%
    \global\expandafter\let%
      \csname codep@ctxid@\the\codep@ctxdepth\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@ctxkind@\the\codep@ctxdepth\endcsname\@undefined%
    \global\advance\codep@ctxdepth by -1\relax%
  \fi%
}%

%% @utility
% \codep@ctxpeekid{macro}
%   Store the top source-context ID into macro, else \@empty.
\def\codep@ctxpeekid#1{%
  \ifnum\codep@ctxdepth<1\relax%
    \let#1\@empty%
  \else%
    \expandafter\let\expandafter#1%
      \csname codep@ctxid@\the\codep@ctxdepth\endcsname%
  \fi%
}%

%% @utility
% \codep@ctxpeekkind{macro}
%   Store the top source-context kind into macro, else \@empty.
\def\codep@ctxpeekkind#1{%
  \ifnum\codep@ctxdepth<1\relax%
    \let#1\@empty%
  \else%
    \expandafter\let\expandafter#1%
      \csname codep@ctxkind@\the\codep@ctxdepth\endcsname%
  \fi%
}%

%% @utility
% \codep@atomsetkey{atom-id}{prefixed-key}
%   Persist the legacy prefixed key derived for this atom.
\def\codep@atomsetkey#1#2{%
  \expandafter\xdef\csname codep@atomkey@#1\endcsname{#2}%
  \expandafter\xdef\csname codep@idbykey@#2\endcsname{#1}%
  \expandafter\codep@splitprefix#2\@nil%
  \expandafter\xdef\csname codep@atomdisplay@#1\endcsname{%
    \codep@tmp@num}%
}%

%% @utility
% \codep@atomgetkey{atom-id}{macro}
%   Store the legacy prefixed key for atom-id into macro.
\def\codep@atomgetkey#1#2{%
  \ifx#1\@empty%
    \let#2\@empty%
  \else%
    \expandafter\ifx\csname codep@atomkey@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2\csname codep@atomkey@#1\endcsname%
    \fi%
  \fi%
}%

%% @utility
% \codep@atomgetdisplay{atom-id}{macro}
%   Store the bare legacy display number for atom-id into macro.
\def\codep@atomgetdisplay#1#2{%
  \ifx#1\@empty%
    \let#2\@empty%
  \else%
    \expandafter\ifx\csname codep@atomdisplay@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@atomdisplay@#1\endcsname%
    \fi%
  \fi%
}%

%% @utility
% \codep@atomgetkind{atom-id}{macro}
%   Store the registered kind for atom-id into macro.
\def\codep@atomgetkind#1#2{%
  \ifx#1\@empty%
    \let#2\@empty%
  \else%
    \expandafter\ifx\csname codep@atomkind@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2\csname codep@atomkind@#1\endcsname%
    \fi%
  \fi%
}%

%% @utility
% \codep@keytoid{prefixed-key}{macro}
%   Resolve a legacy prefixed key back to an internal atom ID.
\def\codep@keytoid#1#2{%
  \expandafter\ifx\csname codep@idbykey@#1\endcsname\relax%
    \let#2\@empty%
  \else%
    \expandafter\let\expandafter#2\csname codep@idbykey@#1\endcsname%
  \fi%
}%

%% @implements \codep@writerefevent
% \codep@getcurrentownerid{macro}
%   Resolve the active owning atom ID, honouring proof pending state.
\def\codep@getcurrentownerid#1{%
  \ifnum\codep@replaydepth>0\relax%
    \let#1\@empty%
  \else%
    \codep@ctxpeekkind\codep@tmp@ctxkind%
    \codep@ctxpeekid\codep@tmp@ctxid%
    \def\codep@tmp@proofkind{proof}%
    \ifx\codep@tmp@ctxkind\@empty%
      \let#1\@empty%
    \else\ifx\codep@tmp@ctxkind\codep@tmp@proofkind%
      \ifcodep@proofdisplaypending%
        \let#1\@empty%
      \else%
        \let#1\codep@tmp@ctxid%
      \fi%
    \else%
      \let#1\codep@tmp@ctxid%
    \fi\fi%
  \fi%
}%

%% @implements \codep@writerefevent
% \codep@getcurrentatomkey{macro}
%   Resolve the active source atom's legacy prefixed key.
\def\codep@getcurrentatomkey#1{%
  \ifnum\codep@sourceblockdepth>0\relax%
    \let#1\@empty%
  \else%
    \codep@getcurrentownerid\codep@tmp@ownerid%
    \codep@atomgetkey{\codep@tmp@ownerid}{#1}%
  \fi%
}%

%% @implements \codep@recordlabelowner
% \codep@getcurrentatomdisplay{macro}
%   Resolve the active source atom's bare legacy display number.
\def\codep@getcurrentatomdisplay#1{%
  \codep@getcurrentatomkey\codep@tmp@atomkey%
  \ifx\codep@tmp@atomkey\@empty%
    \let#1\@empty%
  \else%
    \expandafter\codep@splitprefix\codep@tmp@atomkey\@nil%
    \let#1\codep@tmp@num%
  \fi%
}%

%% @implements \codep@recordlabelowner
% \codep@getcurrentatomkind{macro}
%   Resolve the active source atom's legacy type prefix.
\def\codep@getcurrentatomkind#1{%
  \codep@getcurrentatomkey\codep@tmp@atomkey%
  \ifx\codep@tmp@atomkey\@empty%
    \let#1\@empty%
  \else%
    \expandafter\codep@splitprefix\codep@tmp@atomkey\@nil%
    \let#1\codep@tmp@type%
  \fi%
}%

%% @behavior B-NUM-PARA
% \codep@closeparagraphifopen
%   Finalise the current paragraph atom, if any.
\def\codep@closeparagraphifopen{%
  \ifcodep@paragraphopen%
    \codep@ctxpop{paragraph}%
    \global\codep@paragraphopenfalse%
  \fi%
}%

%% @behavior B-NUM-EQINDEP
% \codep@recordlabelowner{label}
%   Write the legacy label-type ownership record for label, and
%   (W03-P03) populate the in-memory label->entity binding table +
%   emit the \codep@lblentity aux record.  Same replay guard covers
%   both.
\def\codep@recordlabelowner#1{%
  \if@filesw%
    \ifnum\codep@replaydepth>0\relax%
    \else%
      \codep@subsystem@recordtotal{label-bind}%
      \ifx\codep@eq@lbltype@pending\@empty%
        \codep@getcurrentatomkind\codep@tmp@labelkind%
        \ifx\codep@tmp@labelkind\@empty\else%
          \expandafter\gdef\csname codep@ltype@#1\endcsname{%
            \codep@tmp@labelkind}%
          \protected@write\@auxout{}{%
            \string\codep@lbltype{#1}{\codep@tmp@labelkind}}%
        \fi%
      \else%
        \expandafter\gdef\csname codep@ltype@#1\endcsname{%
          \codep@eq@lbltype@pending}%
        \protected@write\@auxout{}{%
          \string\codep@lbltype{#1}{\codep@eq@lbltype@pending}}%
      \fi%
      % W03-P03: in-memory label->entity binding + cross-run aux record.
      % Skip if no owning atom-key is resolvable at this point (e.g.,
      % \label outside any tracked env, or equation label before the
      % equation's atom-key is materialised).
      \codep@getcurrentatomkey\codep@tmp@lblentity%
      \ifx\codep@tmp@lblentity\@empty\else%
        % \xdef (not \gdef) so the csname stores the expanded
        % atom-key string, not a reference to \codep@tmp@lblentity
        % whose binding is local to this \codep@recordlabelowner
        % call and is undefined outside.
        \expandafter\xdef\csname codep@lblentity@#1\endcsname{%
          \codep@tmp@lblentity}%
        \expandafter\gdef\csname codep@lblentity@samerun@#1\endcsname{1}%
        \protected@write\@auxout{}{%
          \string\codep@lblentity{#1}{\codep@tmp@lblentity}}%
      \fi%
    \fi%
  \fi%
}%

%% @behavior B-DEDUP
%% @behavior B-EDGE-HEADING
% \codep@writerefevent{label}
%   Emit one legacy atomref write from the active source atom.
\def\codep@writerefevent#1{%
  \if@filesw%
    \codep@autoproofof@ifheadsuppressed{#1}{}{%
      \codep@proof@ifadjacenttargetsuppressed{#1}{}{%
        \codep@getcurrentatomkey\codep@tmp@srcatom%
        \ifx\codep@tmp@srcatom\@empty\else%
          \codep@subsystem@recordtotal{atomref}%
          \codep@dedupwrite{\codep@tmp@srcatom}{#1}%
        \fi%
      }%
    }%
  \fi%
}%

% \codep@proof@identitykey{proof-id}{macro}
%   Return the stable proof:a<N> source key for proof-id.
%% @behavior B-PROOF-OPAQUE-ID
\def\codep@proof@identitykey#1#2{%
  \edef#2{proof:#1}%
}%

% \codep@proof@setidentity{proof-id}
%   Make proof:a<N> the current atom key for proof-id.
%% @implements \codep@bindproofparent
\def\codep@proof@setidentity#1{%
  \codep@proof@identitykey{#1}{\codep@tmp@proofidentitykey}%
  \codep@atomsetkey{#1}{\codep@tmp@proofidentitykey}%
}%

% \codep@proof@markparent{proof-id}{target-key}
%   Remember that proof-id has at least one target parent.
%% @implements \codep@bindproofparent
\def\codep@proof@markparent#1#2{%
  \expandafter\ifx\csname codep@proofparent@#1\endcsname\relax%
    \expandafter\xdef\csname codep@proofparent@#1\endcsname{#2}%
  \else%
    \expandafter\ifx\csname codep@proofparent@#1\endcsname\@empty%
      \expandafter\xdef\csname codep@proofparent@#1\endcsname{#2}%
    \fi%
  \fi%
}%

% \codep@proof@maybeheadingoverrideadjacent{proof-id}{target-key}{display}
%   D3 policy: first tracked heading target supersedes adjacent binding.
%% @behavior B-PROOF-HEADING-OVERRIDE
%% @behavior B-WARN-ATTR-CONFLICTS
\def\codep@proof@maybeheadingoverrideadjacent#1#2#3{%
  \@ifundefined{codep@proofadjtarget@#1}{}{%
    \@ifundefined{codep@proofheadingoverride@#1}{%
      \edef\codep@tmp@adjtarget{\csname codep@proofadjtarget@#1\endcsname}%
      \edef\codep@tmp@headingtarget{#2}%
      \ifx\codep@tmp@adjtarget\codep@tmp@headingtarget\else%
        \ifbool{codep@warnattributionconflicts}{%
          \PackageWarning{codependent}{auto-attribution to #3\space%
            supersedes adjacent \csname codep@proofadjdisplay@#1\endcsname}%
        }{}%
        \codep@proof@suppressadjacenttarget{#1}{\codep@tmp@adjtarget}%
      \fi%
      \codep@proof@identitykey{#1}{\codep@tmp@overrideproofkey}%
      \codep@prooftargetmeta@clear{\codep@tmp@overrideproofkey}%
      \expandafter\xdef\csname codep@proofparent@#1\endcsname{}%
      \global\expandafter\let%
        \csname codep@proofheadingoverride@#1\endcsname\@empty%
    }{}%
  }%
}%

% \codep@proof@suppressadjacenttarget{proof-id}{target-key}
%   Record the adjacent target displaced by proof-heading attribution.
%% @implements \codep@bindproofparent
\def\codep@proof@suppressadjacenttarget#1#2{%
  \expandafter\xdef\csname codep@proofsuppressadjacent@#1\endcsname{#2}%
}%

% \codep@proof@ifadjacenttargetsuppressed{label}{then}{else}
%   Suppress later proof-body references to the displaced adjacent target.
%% @implements \codep@writerefevent
\def\codep@proof@ifadjacenttargetsuppressed#1#2#3{%
  \ifx\codep@currentproofid\@empty%
    #3%
  \else%
    \expandafter\ifx%
        \csname codep@proofsuppressadjacent@%
          \codep@currentproofid\endcsname\relax%
      #3%
    \else%
      \expandafter\ifx\csname codep@lblentity@#1\endcsname\relax%
        #3%
      \else%
        \edef\codep@tmp@suppressadjacent{%
          \csname codep@proofsuppressadjacent@%
            \codep@currentproofid\endcsname}%
        \edef\codep@tmp@suppresstarget{\csname codep@lblentity@#1\endcsname}%
        \ifx\codep@tmp@suppressadjacent\codep@tmp@suppresstarget%
          #2%
        \else%
          #3%
        \fi%
      \fi%
    \fi%
  \fi%
}%

%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-SEP
%% @behavior B-PROOF-JOINT
% \codep@bindproofparent{proof-id}{parent-id}{mode}
%   Bind proof-id to parent-id using the stable proof:a<N> key and
%   append parent-id to the proof target metadata list.
%   The third argument (mode) is currently unused at the call site;
%   the parent slot's emptiness alone drives the renderer's
%   ADJACENT-or-REBOUND vs. STANDALONE classifier (see
%   \codep@graph@getentityparent).  Retained in the signature for
%   call-site clarity.
%   The parent slot stores the parent atom's prefixed key (e.g.
%   "theorem:1.1") rather than the raw atom-id so the entitymeta
%   parent value is consistent across adjacent and rebound paths
%   (\codep@proofof@resolve also writes a prefixed key).  The
%   classifier still only checks emptiness.
\def\codep@bindproofparent#1#2#3{%
  \codep@proof@setidentity{#1}%
  \codep@proof@identitykey{#1}{\codep@tmp@proofkey}%
  \codep@atomgetkey{#2}{\codep@tmp@parentprefixedkey}%
  \codep@atomgetdisplay{#2}\codep@tmp@parentdisplay%
  \ifx\codep@tmp@parentprefixedkey\@empty\else%
    \codep@proof@markparent{#1}{\codep@tmp@parentprefixedkey}%
    % see @behavior B-PROOF-JOINT at \codep@proofof@capturejointmeta.
    \codep@prooftargetmeta@append{\codep@tmp@proofkey}{%
      \codep@tmp@parentprefixedkey}{\codep@tmp@parentdisplay}{*}%
  \fi%
}%

%% ===================================================================
%% Section 5: Core numbering machinery
%% ===================================================================

% \codep@removefromreset{counter}{parent}
%   Remove counter from parent's reset list.
%% @utility
\newcommand*{\codep@removefromreset}[2]{%
  \@ifundefined{@removefromreset}{%
    % Manual: rewrite \cl@parent without #1.
    \begingroup
      \expandafter\let\expandafter\codep@resetlist%
        \csname cl@#2\endcsname%
      \expandafter\global\expandafter\let%
        \csname cl@#2\endcsname\@empty%
      \def\@elt##1{%
        \def\codep@cur{##1}%
        \def\codep@tgt{#1}%
        \ifx\codep@cur\codep@tgt\else
          \expandafter\g@addto@macro%
            \csname cl@#2\endcsname{\@elt{##1}}%
        \fi
      }%
      \codep@resetlist%
    \endgroup
  }{%
    \@removefromreset{#1}{#2}%
  }%
}

% \codep@setupcounter
%   Create the atom counter and wire it to the base counter
%   (auto-detected from the first env in \codeptrack).
%   Called by \codeptrack.
%% @behavior B-NUM-SHARED
\newcommand*{\codep@setupcounter}{%
  \newcounter{atom}%
  % Copy current base counter value (if it exists).
  % Note: \@ifundefined uses \csname internally, which expands
  % \codep@basecounter automatically.
  \@ifundefined{c@\codep@basecounter}{}{%
    \setcounter{atom}{\value{\codep@basecounter}}%
    % Alias: \c@<basecounter> -> \c@atom.
    \expandafter\let\csname c@\codep@basecounter\endcsname\c@atom%
  }%
  \codep@configuredepth%
  % Sync base counter display format with atom display format.
  \@ifundefined{c@\codep@basecounter}{}{%
    \expandafter\let\csname the\codep@basecounter\endcsname\theatom%
  }%
}

% \codep@configuredepth
%   Set up counter resets and display format based on depth option
%   and document class.
%% @behavior B-NUM-DEPTH1
%% @behavior B-NUM-DEPTH2
\newcommand*{\codep@configuredepth}{%
  % Remove base counter from any existing reset parent.
  \@ifundefined{c@\codep@basecounter}{}{%
    \@ifundefined{cl@section}{}{%
      \expandafter\codep@removefromreset\expandafter{\codep@basecounter}{section}%
    }%
    \@ifundefined{cl@chapter}{}{%
      \expandafter\codep@removefromreset\expandafter{\codep@basecounter}{chapter}%
    }%
  }%
  \@ifundefined{chapter}{%
    \codep@configuredepth@article%
  }{%
    \codep@configuredepth@book%
  }%
}

% Article-class depth configuration.
%% @implements \codep@configuredepth
\newcommand*{\codep@configuredepth@article}{%
  \ifcase\codep@depth\relax
    % 0: invalid
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \or % 1
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{\thesection.\arabic{atom}}%
  \or % 2
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.\arabic{atom}}%
  \or % 3
    \@addtoreset{atom}{subsubsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.%
      \arabic{subsubsection}.\arabic{atom}}%
  \else
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi
}

% Book/report-class depth configuration.
%% @implements \codep@configuredepth
\newcommand*{\codep@configuredepth@book}{%
  \ifcase\codep@depth\relax
    % 0: invalid
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \or % 1
    \@addtoreset{atom}{chapter}%
    \renewcommand*{\theatom}{\thechapter.\arabic{atom}}%
  \or % 2
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.\arabic{atom}}%
  \or % 3
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.%
      \arabic{subsection}.\arabic{atom}}%
  \else
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi
}

% \codep@registeratom{num}{kind}
%   Append one entry to the count-indexed atom array.
%   num  -- the atom number token (e.g. \codep@outeratom or \theatom)
%   kind -- the atom type string (e.g. {#1}, proof, paragraph)
%% @behavior B-REND-APPENDIX
\def\codep@registeratom#1#2{%
  \global\advance\codep@atomcount by 1\relax
  \expandafter\xdef\csname codep@atom@\the\codep@atomcount\endcsname{%
    {#1}{#2}}%
  % Store current section number for appendix grouping.
  \expandafter\xdef%
    \csname codep@atom@sec@\the\codep@atomcount\endcsname{%
    \codep@cursecnum}%
}%

%% ===================================================================
%% Section 6: Theorem environment hooks
%% ===================================================================

% \codep@hooktheorem{envname}
%   Install begin/end hooks for a tracked theorem environment.
%   Uses LaTeX 2021+ cmd hooks (cmd/<env>/before) instead of
%   etoolbox's \AtBeginEnvironment so that hooks also fire when
%   thmtools' thm-restate.sty calls \theorem / \endtheorem
%   directly (bypassing \begin{theorem}).
%
%   Timing note (docs/DESIGN.md §8a.5.0): the cmd/before hook fires
%   BEFORE amsthm's \refstepcounter{theorem}, so \theatom at
%   begin-time is the PREVIOUS atom's number.  The queuebackref
%   call is therefore in the end hook, where the env body has
%   run and \theatom reflects the current atom.
%   \codep@currentatom is demoted to a sentinel — its value
%   is not used, only its emptiness; we set it to a literal
%   "1" on begin and clear to \@empty on end.
%
%   Restatable guard (§8a.5.a): \codep@setupcounter aliases
%   \c@<basecounter> to \c@atom.  When thmtools' thm-restate.sty
%   re-fires the env for \restate, it breaks this alias
%   (\c@<basecounter> -> \c@thmt@dummyctr).  The \ifx guard
%   detects whether the alias is intact (original occurrence) or
%   broken (restate occurrence) and skips the hook body on
%   restate, preventing spurious atom attribution and duplicate
%   .cdp records.  All envs declared with
%   \newtheorem{...}[<basecounter>] share
%   \c@<basecounter>, so the guard covers all shared-counter
%   envs.  Envs with independent counters are not supported by
%   this guard and should not be passed to \codeptrack.
%
%   Note: the env name is captured via the hook argument (#1)
%   rather than \@currenvir, because under restatable the
%   current environment is "restatable", not the theorem type.
%
%   The hook bodies are factored into named helpers below;
%   \codep@hooktheorem is a thin orchestrator that wires them
%   into the four hook points.

%% @behavior B-NUM-NESTED
%% @behavior B-EDGE-NESTED
%% @behavior B-EDGE-RESTATE
% \codep@hooktheorem@begin{envname}
%   Begin-hook body for tracked theorem-like environments.
\def\codep@hooktheorem@begin#1{%
  \codep@closeparagraphifopen%
  \global\let\codep@pendingresultid\@empty%
  \expandafter\ifx\csname c@\codep@basecounter\endcsname\c@atom%
    \global\advance\codep@trackeddepth by 1\relax%
    \global\advance\codep@suppressdepth by 1\relax%
    \ifnum\codep@trackeddepth>1\relax%
      \PackageWarning{codependent}{Nested tracked environment '#1'\space%
        inside another tracked environment. The inner\space%
        environment will not be assigned its own atom number}%
    \else%
      \codep@allocatomid{\codep@thisatomid}{#1}%
      \codep@ctxpush{\codep@thisatomid}{#1}%
    \fi%
  \else%
    \global\advance\codep@replaydepth by 1\relax%
    \global\advance\codep@suppressdepth by 1\relax%
  \fi%
}%

%% @behavior B-NUM-STARRED
% \codep@hooktheorem@after{envname}
%   Capture the theorem's legacy prefixed key after its counter steps.
%   Anchor written here captures the theorem's own \@currentHref;
%   the extractanchor mechanism (§8a.5) overwrites codep@anchor@<key>
%   on pass 2+ with the equation-shifted anchor when an equation inside
%   the theorem shares the same display number.
\def\codep@hooktheorem@after#1{%
  \ifnum\codep@trackeddepth=1\relax%
    \codep@ctxpeekid\codep@thisatomid%
    \xdef\codep@outeratom{#1:\theatom}%
    \codep@atomsetkey{\codep@thisatomid}{\codep@outeratom}%
    \codep@writeanchormap{\codep@outeratom}%
    \codep@writeanchorpagecurrent{\codep@outeratom}%
  \fi%
}%

%% @behavior B-NUM-SEQ
% \codep@hooktheorem@record{envname}
%   Emit the theorem's legacy .cdp records and appendix entry.
\def\codep@hooktheorem@record#1{%
  \expandafter\codep@splitprefix\codep@outeratom\@nil%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\codep@tmp@num}{#1}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@tmp@num}{env}{#1}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@tmp@num}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  \codep@registeratom{\codep@outeratom}{#1}%
}%

% \codep@hooktheorem@preparebackref{envname}
%   Queue backrefs, apply orphan prevention, flush inline style.
%   Block/margin styles flush later in \AfterEndEnvironment.
%   Delegates to the rendering hook point.
%% @implements \codep@hooktheorem
\def\codep@hooktheorem@preparebackref#1{%
  \codep@render@thm@preparebackref{#1}%
}%

%% @behavior B-PROOF-ADJ
% \codep@hooktheorem@end@outer{envname}
%   Outermost theorem end: serialize and arm proof adjacency.
%   Stashes the just-closed atom's prefixed key in
%   \codep@endenv@pendingclear so the cmd/end#1/after hook can
%   undefine the per-atom \codep@manuallyemitted@<key> flag once
%   the env's group has fully closed (atom-key no longer
%   resolvable from the ctx stack at that point).
\def\codep@hooktheorem@end@outer#1{%
  \codep@ctxpeekid\codep@thisatomid%
  \codep@hooktheorem@record{#1}%
  \codep@hooktheorem@preparebackref{#1}%
  % W03-P03: capture entitymeta for this just-closed theorem-rail
  % entity.  \codep@tmp@num is set by \codep@hooktheorem@record above
  % (via \codep@splitprefix on \codep@outeratom).  Kind is hardcoded
  % "theorem" (the category); print-kind is the actual env-name.
  \codep@captureentitymeta{\codep@outeratom}{theorem}%
    {\codep@tmp@num}{#1}{}%
  \codep@ctxpop{#1}%
  \global\advance\codep@trackeddepth by -1\relax%
  \global\advance\codep@suppressdepth by -1\relax%
  \xdef\codep@pendingresultid{\codep@thisatomid}%
  \xdef\codep@endenv@pendingclear{\codep@outeratom}%
}%

%% @behavior B-NUM-NESTED
%% @behavior B-EDGE-NESTED
%% @behavior B-EDGE-RESTATE
% \codep@hooktheorem@end{envname}
%   End-hook body: unwind replay, nested, or outer theorem state.
\def\codep@hooktheorem@end#1{%
  \expandafter\ifx\csname c@\codep@basecounter\endcsname\c@atom%
    \ifnum\codep@trackeddepth>1\relax%
      \global\advance\codep@trackeddepth by -1\relax%
      \global\advance\codep@suppressdepth by -1\relax%
    \else%
      \codep@hooktheorem@end@outer{#1}%
    \fi%
  \else%
    \global\advance\codep@replaydepth by -1\relax%
    \global\advance\codep@suppressdepth by -1\relax%
  \fi%
}%

% \codep@hooktheorem@afterend{envname}
%   After-end-environment hook body.  Inline backrefs are flushed
%   EARLY in cmd/end#1/before (inside the env body, in hmode, before
%   amsthm's \popQED/endmark mechanism) so "Used in" flows on the
%   same line as content; this post-env hook is a no-op for that
%   path.  For restatable re-fires (which call \theorem/\endtheorem
%   directly, bypassing \begin/\end), neither hook fires — correct,
%   since the restate guard already skipped backref queueing in the
%   cmd/end hook above.  Retained as a hook point so the theorem
%   orchestrator body stays stable across future rendering variants.
%% @implements \codep@hooktheorem
\def\codep@hooktheorem@afterend#1{%
  \codep@render@thm@afterend{#1}%
}

% \codep@manuallyemitted@end@outer@clear
%   cmd/end#1/after hook body for tracked theorem-like envs.
%   Consumes \codep@endenv@pendingclear (populated at
%   \codep@hooktheorem@end@outer time) and undefines the
%   corresponding per-atom flag so the next outer atom of the
%   same env starts with a clean slate.  Inert during replay
%   (the stash is only populated in the non-replay branch, so
%   the replay guard is belt+suspenders) and inert at inner-env
%   end (the stash is only populated for the OUTER env's
%   \codep@hooktheorem@end@outer path, never inner).
%% @utility
\def\codep@manuallyemitted@end@outer@clear{%
  \ifnum\codep@replaydepth=0\relax%
    \ifx\codep@endenv@pendingclear\@empty\else%
      \codep@manuallyemitted@clear@key{\codep@endenv@pendingclear}%
      \global\let\codep@endenv@pendingclear\@empty%
    \fi%
  \fi%
}%

% Thin orchestrator: wire the named helpers into the five hook points.
% Fifth hook (cmd/end#1/after) clears any per-atom
% \codep@manuallyemitted@<key> flag set by an inline
% \codepbackrefs call inside the env body; see the
% \codep@manuallyemitted@end@outer@clear helper above.
%% @behavior B-NUM-SEQ
%% @behavior B-PROOF-ADJ
\newcommand*{\codep@hooktheorem}[1]{%
  \AddToHook{cmd/#1/before}{\codep@hooktheorem@begin{#1}}%
  \AddToHook{cmd/#1/after}{\codep@hooktheorem@after{#1}}%
  \AddToHook{cmd/end#1/before}{\codep@hooktheorem@end{#1}}%
  \AfterEndEnvironment{#1}{\codep@hooktheorem@afterend{#1}}%
  \AddToHook{cmd/end#1/after}{\codep@manuallyemitted@end@outer@clear}%
}

% \codep@hookproof
%   Install hooks for the proof environment.
%   When proofs=on (default), adjacent proofs inherit the
%   preceding theorem's atom number with a star suffix (e.g.
%   "2.1*").  Non-adjacent proofs (no preceding theorem, or
%   an intervening paragraph) fall back to their own atom
%   number with a warning (if proof-warnings=on).
%   Standalone proofs defer margin emission to para/begin so
%   the number appears on the "Proof." line, not on a
%   separate line.
%   Delegates to:
%     \codep@hookproof@begin     — begin dispatch
%     \codep@proof@standalone    — non-adjacent proof path
%     \codep@proof@adjacent      — adjacent proof path
%     \codep@hookproof@end       — end cleanup
%     \codep@hookproof@afterend  — block/margin flush
%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-NONADJ
\newcommand*{\codep@hookproof}{%
  \@ifundefined{proof}{}{%
    \AtBeginEnvironment{proof}{\codep@hookproof@begin}%
    \AtEndEnvironment{proof}{\codep@hookproof@end}%
    \AfterEndEnvironment{proof}{\codep@hookproof@afterend}%
  }%
}%

% \codep@autoproofof@stop
%   Sentinel token for proof-heading scanner termination.
%% @utility
\def\codep@autoproofof@stop{\codep@autoproofof@stop}%

% Star token used by starred \ref-like scanner branches.
\let\codep@autoproofof@star=*

% \codep@autoproofof@reset
%   Clear scanner scratch slots after one proof-heading scan.
%% @implements \codep@hookproof
\def\codep@autoproofof@reset{%
  \global\codep@autoproofof@refcount=0\relax%
  \global\let\codep@autoproofof@pendinglist\@empty%
  \global\let\codep@autoproofof@provkey\@empty%
}%

% \codep@autoproofof@rememberlabel{label}
%   Append one supported ref-family label found in a proof heading.
%% @implements \codep@hookproof
\def\codep@autoproofof@rememberlabel#1{%
  \global\advance\codep@autoproofof@refcount by 1\relax%
  \ifx\codep@autoproofof@pendinglist\@empty%
    \xdef\codep@autoproofof@pendinglist{#1}%
  \else%
    \xdef\codep@autoproofof@pendinglist{%
      \codep@autoproofof@pendinglist,#1}%
  \fi%
}%

% \codep@autoproofof@remembercsv{csv-labels}
%   Count each comma-separated label in a \cref heading reference.
%% @implements \codep@hookproof
\def\codep@autoproofof@remembercsv#1{%
  \def\codep@tmp@csvlabels{#1}%
  \@for\codep@tmp@csvlabel:=\codep@tmp@csvlabels\do{%
    \ifx\codep@tmp@csvlabel\@empty\else%
      \expandafter\codep@autoproofof@rememberlabel\expandafter{%
        \codep@tmp@csvlabel}%
    \fi%
  }%
}%

% \codep@autoproofof@scan@tokens
%   Walk heading tokens without expansion, dispatching on ref-family macros.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@tokens{%
  \futurelet\codep@autoproofof@nexttoken%
    \codep@autoproofof@scan@dispatch%
}%

% \codep@autoproofof@scan@dispatch
%   Select the scanner continuation for the next token.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@dispatch{%
  \ifx\codep@autoproofof@nexttoken\codep@autoproofof@stop%
    \let\codep@autoproofof@next\codep@autoproofof@scan@end%
  \else%
    \codep@autoproofof@selectnext%
  \fi%
  \codep@autoproofof@next%
}%

% \codep@autoproofof@selectnext
%   Choose the scanner continuation for a non-stop token.
%% @implements \codep@hookproof
\def\codep@autoproofof@selectnext{%
  \let\codep@autoproofof@next\codep@autoproofof@scan@gobble%
  \ifx\codep@autoproofof@nexttoken\@sptoken%
    \let\codep@autoproofof@next\codep@autoproofof@scan@space%
  \fi%
  \ifx\codep@autoproofof@nexttoken\ref%
    \let\codep@autoproofof@next\codep@autoproofof@scan@ref%
  \fi%
  \codep@autoproofof@selectautoref%
  \codep@autoproofof@selectcref%
}%

% \codep@autoproofof@selectautoref
%   Select \autoref only when hyperref has defined it.
%% @implements \codep@hookproof
\def\codep@autoproofof@selectautoref{%
  \@ifundefined{autoref}{}{%
    \ifx\codep@autoproofof@nexttoken\autoref%
      \let\codep@autoproofof@next\codep@autoproofof@scan@autoref%
    \fi%
  }%
}%

% \codep@autoproofof@selectcref
%   Select \cref only when cleveref has defined it.
%% @implements \codep@hookproof
\def\codep@autoproofof@selectcref{%
  \@ifundefined{cref}{}{%
    \ifx\codep@autoproofof@nexttoken\cref%
      \let\codep@autoproofof@next\codep@autoproofof@scan@cref%
    \fi%
  }%
}%

% \codep@autoproofof@scan@space
%   Consume one explicit space token and resume heading scanning.
%% @implements \codep@hookproof
\let\codep@autoproofof@savedcolon\:%
\def\:{\codep@autoproofof@scan@space}%
\expandafter\def\: {%
  \codep@autoproofof@scan@tokens%
}%
\let\:\codep@autoproofof@savedcolon%

% \codep@autoproofof@scan@end
%   Consume the scanner stop token.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@end#1{}%

% \codep@autoproofof@scan@gobble{token-or-group}
%   Consume non-ref tokens and resume heading scanning.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@gobble#1{%
  \codep@autoproofof@scan@tokens%
}%

% \codep@autoproofof@scan@ref
%   Consume \ref and then one required label argument.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@ref\ref{%
  \futurelet\codep@autoproofof@nexttoken%
    \codep@autoproofof@scan@label@dispatch%
}%

% \codep@autoproofof@scan@autoref
%   Consume \autoref and then one required label argument.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@autoref\autoref{%
