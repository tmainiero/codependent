%% @utility
% \codep@allocatomid{macro}{kind}
%   Allocate a fresh opaque source-atom ID (aN) into macro.
\def\codep@allocatomid#1#2{%
  \global\advance\codep@atomid by 1\relax
  \xdef#1{a\the\codep@atomid}%
  \expandafter\xdef\csname codep@atomkind@#1\endcsname{#2}%
}%

%% @utility
% \codep@alloctargetid{macro}{kind}
%   Allocate a fresh opaque target ID (qN) into macro.
\def\codep@alloctargetid#1#2{%
  \global\advance\codep@targetid by 1\relax
  \xdef#1{q\the\codep@targetid}%
  \expandafter\xdef\csname codep@targetkind@#1\endcsname{#2}%
}%

%% @utility
% \codep@ctxpush{atom-id}{kind}
%   Push one source context entry onto the global stack.
\def\codep@ctxpush#1#2{%
  \global\advance\codep@ctxdepth by 1\relax%
  \expandafter\xdef\csname codep@ctxid@\the\codep@ctxdepth\endcsname{#1}%
  \expandafter\xdef%
    \csname codep@ctxkind@\the\codep@ctxdepth\endcsname{#2}%
}%

%% @utility
% \codep@ctxpop{kind}
%   Pop one source context entry, hard-erroring on mismatch.
\def\codep@ctxpop#1{%
  \ifnum\codep@ctxdepth<1\relax%
    \PackageError{codependent}{Context stack underflow on '#1'}{%
      codependent detected an internal stack underflow while%
      closing '#1'.}%
  \else%
    \edef\codep@tmp@ctxkind{%
      \csname codep@ctxkind@\the\codep@ctxdepth\endcsname}%
    \def\codep@tmp@expected{#1}%
    \ifx\codep@tmp@ctxkind\codep@tmp@expected\else%
      \PackageError{codependent}{Context stack mismatch on '#1'}{%
        Expected to pop '#1' but found '\codep@tmp@ctxkind'.}%
    \fi%
    \global\expandafter\let%
      \csname codep@ctxid@\the\codep@ctxdepth\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@ctxkind@\the\codep@ctxdepth\endcsname\@undefined%
    \global\advance\codep@ctxdepth by -1\relax%
  \fi%
}%

%% @utility
% \codep@ctxpeekid{macro}
%   Store the top source-context ID into macro, else \@empty.
\def\codep@ctxpeekid#1{%
  \ifnum\codep@ctxdepth<1\relax%
    \let#1\@empty%
  \else%
    \expandafter\let\expandafter#1%
      \csname codep@ctxid@\the\codep@ctxdepth\endcsname%
  \fi%
}%

%% @utility
% \codep@ctxpeekkind{macro}
%   Store the top source-context kind into macro, else \@empty.
\def\codep@ctxpeekkind#1{%
  \ifnum\codep@ctxdepth<1\relax%
    \let#1\@empty%
  \else%
    \expandafter\let\expandafter#1%
      \csname codep@ctxkind@\the\codep@ctxdepth\endcsname%
  \fi%
}%

%% @utility
% \codep@atomsetkey{atom-id}{prefixed-key}
%   Persist the legacy prefixed key derived for this atom.
\def\codep@atomsetkey#1#2{%
  \expandafter\xdef\csname codep@atomkey@#1\endcsname{#2}%
  \expandafter\xdef\csname codep@idbykey@#2\endcsname{#1}%
  \expandafter\codep@splitprefix#2\@nil%
  \expandafter\xdef\csname codep@atomdisplay@#1\endcsname{%
    \codep@tmp@num}%
}%

%% @utility
% \codep@atomgetkey{atom-id}{macro}
%   Store the legacy prefixed key for atom-id into macro.
\def\codep@atomgetkey#1#2{%
  \ifx#1\@empty%
    \let#2\@empty%
  \else%
    \expandafter\ifx\csname codep@atomkey@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2\csname codep@atomkey@#1\endcsname%
    \fi%
  \fi%
}%

%% @utility
% \codep@atomgetdisplay{atom-id}{macro}
%   Store the bare legacy display number for atom-id into macro.
\def\codep@atomgetdisplay#1#2{%
  \ifx#1\@empty%
    \let#2\@empty%
  \else%
    \expandafter\ifx\csname codep@atomdisplay@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2%
        \csname codep@atomdisplay@#1\endcsname%
    \fi%
  \fi%
}%

%% @utility
% \codep@atomgetkind{atom-id}{macro}
%   Store the registered kind for atom-id into macro.
\def\codep@atomgetkind#1#2{%
  \ifx#1\@empty%
    \let#2\@empty%
  \else%
    \expandafter\ifx\csname codep@atomkind@#1\endcsname\relax%
      \let#2\@empty%
    \else%
      \expandafter\let\expandafter#2\csname codep@atomkind@#1\endcsname%
    \fi%
  \fi%
}%

%% @utility
% \codep@keytoid{prefixed-key}{macro}
%   Resolve a legacy prefixed key back to an internal atom ID.
\def\codep@keytoid#1#2{%
  \expandafter\ifx\csname codep@idbykey@#1\endcsname\relax%
    \let#2\@empty%
  \else%
    \expandafter\let\expandafter#2\csname codep@idbykey@#1\endcsname%
  \fi%
}%

%% @implements \codep@writerefevent
% \codep@getcurrentownerid{macro}
%   Resolve the active owning atom ID, honouring proof pending state.
\def\codep@getcurrentownerid#1{%
  \ifnum\codep@replaydepth>0\relax%
    \let#1\@empty%
  \else%
    \codep@ctxpeekkind\codep@tmp@ctxkind%
    \codep@ctxpeekid\codep@tmp@ctxid%
    \def\codep@tmp@proofkind{proof}%
    \ifx\codep@tmp@ctxkind\@empty%
      \let#1\@empty%
    \else\ifx\codep@tmp@ctxkind\codep@tmp@proofkind%
      \ifcodep@proofdisplaypending%
        \let#1\@empty%
      \else%
        \let#1\codep@tmp@ctxid%
      \fi%
    \else%
      \let#1\codep@tmp@ctxid%
    \fi\fi%
  \fi%
}%

%% @implements \codep@writerefevent
% \codep@getcurrentatomkey{macro}
%   Resolve the active source atom's legacy prefixed key.
\def\codep@getcurrentatomkey#1{%
  \codep@getcurrentownerid\codep@tmp@ownerid%
  \codep@atomgetkey{\codep@tmp@ownerid}{#1}%
}%

%% @implements \codep@recordlabelowner
% \codep@getcurrentatomdisplay{macro}
%   Resolve the active source atom's bare legacy display number.
\def\codep@getcurrentatomdisplay#1{%
  \codep@getcurrentatomkey\codep@tmp@atomkey%
  \ifx\codep@tmp@atomkey\@empty%
    \let#1\@empty%
  \else%
    \expandafter\codep@splitprefix\codep@tmp@atomkey\@nil%
    \let#1\codep@tmp@num%
  \fi%
}%

%% @implements \codep@recordlabelowner
% \codep@getcurrentatomkind{macro}
%   Resolve the active source atom's legacy type prefix.
\def\codep@getcurrentatomkind#1{%
  \codep@getcurrentatomkey\codep@tmp@atomkey%
  \ifx\codep@tmp@atomkey\@empty%
    \let#1\@empty%
  \else%
    \expandafter\codep@splitprefix\codep@tmp@atomkey\@nil%
    \let#1\codep@tmp@type%
  \fi%
}%

%% @behavior B-NUM-PARA
% \codep@closeparagraphifopen
%   Finalise the current paragraph atom, if any.
\def\codep@closeparagraphifopen{%
  \ifcodep@paragraphopen%
    \codep@ctxpop{paragraph}%
    \global\codep@paragraphopenfalse%
  \fi%
}%

%% @behavior B-NUM-EQINDEP
% \codep@recordlabelowner{label}
%   Write the legacy label-type ownership record for label.
\def\codep@recordlabelowner#1{%
  \if@filesw%
    \ifnum\codep@replaydepth>0\relax%
    \else%
      \ifx\codep@eq@lbltype@pending\@empty%
        \codep@getcurrentatomkind\codep@tmp@labelkind%
        \ifx\codep@tmp@labelkind\@empty\else%
          \expandafter\gdef\csname codep@ltype@#1\endcsname{%
            \codep@tmp@labelkind}%
          \protected@write\@auxout{}{%
            \string\codep@lbltype{#1}{\codep@tmp@labelkind}}%
        \fi%
      \else%
        \expandafter\gdef\csname codep@ltype@#1\endcsname{%
          \codep@eq@lbltype@pending}%
        \protected@write\@auxout{}{%
          \string\codep@lbltype{#1}{\codep@eq@lbltype@pending}}%
      \fi%
    \fi%
  \fi%
}%

%% @behavior B-DEDUP
%% @behavior B-EDGE-HEADING
% \codep@writerefevent{label}
%   Emit one legacy atomref write from the active source atom.
\def\codep@writerefevent#1{%
  \if@filesw%
    \codep@getcurrentatomkey\codep@tmp@srcatom%
    \ifx\codep@tmp@srcatom\@empty\else%
      \codep@dedupwrite{\codep@tmp@srcatom}{#1}%
    \fi%
  \fi%
}%

%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-SEP
% \codep@bindproofparent{proof-id}{parent-id}{mode}
%   Bind proof-id to parent-id and derive the proof's legacy key.
\def\codep@bindproofparent#1#2#3{%
  \expandafter\xdef\csname codep@proofparent@#1\endcsname{#2}%
  \expandafter\xdef\csname codep@proofparentmode@#1\endcsname{#3}%
  \codep@atomgetdisplay{#2}\codep@tmp@parentdisplay%
  \ifx\codep@tmp@parentdisplay\@empty\else%
    \edef\codep@tmp@proofkey{proof:\codep@tmp@parentdisplay}%
    \codep@atomsetkey{#1}{\codep@tmp@proofkey}%
  \fi%
}%

%% ===================================================================
%% Section 5: Core numbering machinery
%% ===================================================================

% \codep@removefromreset{counter}{parent}
%   Remove counter from parent's reset list.
%% @utility
\newcommand*{\codep@removefromreset}[2]{%
  \@ifundefined{@removefromreset}{%
    % Manual: rewrite \cl@parent without #1.
    \begingroup
      \expandafter\let\expandafter\codep@resetlist%
        \csname cl@#2\endcsname%
      \expandafter\global\expandafter\let%
        \csname cl@#2\endcsname\@empty%
      \def\@elt##1{%
        \def\codep@cur{##1}%
        \def\codep@tgt{#1}%
        \ifx\codep@cur\codep@tgt\else
          \expandafter\g@addto@macro%
            \csname cl@#2\endcsname{\@elt{##1}}%
        \fi
      }%
      \codep@resetlist%
    \endgroup
  }{%
    \@removefromreset{#1}{#2}%
  }%
}

% \codep@setupcounter
%   Create the atom counter and wire it to the base counter
%   (auto-detected from the first env in \codeptrack).
%   Called by \codeptrack.
%% @behavior B-NUM-SHARED
\newcommand*{\codep@setupcounter}{%
  \newcounter{atom}%
  % Copy current base counter value (if it exists).
  % Note: \@ifundefined uses \csname internally, which expands
  % \codep@basecounter automatically.
  \@ifundefined{c@\codep@basecounter}{}{%
    \setcounter{atom}{\value{\codep@basecounter}}%
    % Alias: \c@<basecounter> -> \c@atom.
    \expandafter\let\csname c@\codep@basecounter\endcsname\c@atom%
  }%
  \codep@configuredepth%
  % Sync base counter display format with atom display format.
  \@ifundefined{c@\codep@basecounter}{}{%
    \expandafter\let\csname the\codep@basecounter\endcsname\theatom%
  }%
}

% \codep@configuredepth
%   Set up counter resets and display format based on depth option
%   and document class.
%% @behavior B-NUM-DEPTH1
%% @behavior B-NUM-DEPTH2
\newcommand*{\codep@configuredepth}{%
  % Remove base counter from any existing reset parent.
  \@ifundefined{c@\codep@basecounter}{}{%
    \@ifundefined{cl@section}{}{%
      \expandafter\codep@removefromreset\expandafter{\codep@basecounter}{section}%
    }%
    \@ifundefined{cl@chapter}{}{%
      \expandafter\codep@removefromreset\expandafter{\codep@basecounter}{chapter}%
    }%
  }%
  \@ifundefined{chapter}{%
    \codep@configuredepth@article%
  }{%
    \codep@configuredepth@book%
  }%
}

% Article-class depth configuration.
%% @implements \codep@configuredepth
\newcommand*{\codep@configuredepth@article}{%
  \ifcase\codep@depth\relax
    % 0: invalid
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \or % 1
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{\thesection.\arabic{atom}}%
  \or % 2
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.\arabic{atom}}%
  \or % 3
    \@addtoreset{atom}{subsubsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.%
      \arabic{subsubsection}.\arabic{atom}}%
  \else
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi
}

% Book/report-class depth configuration.
%% @implements \codep@configuredepth
\newcommand*{\codep@configuredepth@book}{%
  \ifcase\codep@depth\relax
    % 0: invalid
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \or % 1
    \@addtoreset{atom}{chapter}%
    \renewcommand*{\theatom}{\thechapter.\arabic{atom}}%
  \or % 2
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.\arabic{atom}}%
  \or % 3
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.%
      \arabic{subsection}.\arabic{atom}}%
  \else
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi
}

% \codep@registeratom{num}{kind}
%   Append one entry to the count-indexed atom array.
%   num  -- the atom number token (e.g. \codep@outeratom or \theatom)
%   kind -- the atom type string (e.g. {#1}, proof, paragraph)
%% @behavior B-REND-APPENDIX
\def\codep@registeratom#1#2{%
  \global\advance\codep@atomcount by 1\relax
  \expandafter\xdef\csname codep@atom@\the\codep@atomcount\endcsname{%
    {#1}{#2}}%
  % Store current section number for appendix grouping.
  \expandafter\xdef%
    \csname codep@atom@sec@\the\codep@atomcount\endcsname{%
    \codep@cursecnum}%
}%

%% ===================================================================
%% Section 6: Theorem environment hooks
%% ===================================================================

% \codep@hooktheorem{envname}
%   Install begin/end hooks for a tracked theorem environment.
%   Uses LaTeX 2021+ cmd hooks (cmd/<env>/before) instead of
%   etoolbox's \AtBeginEnvironment so that hooks also fire when
%   thmtools' thm-restate.sty calls \theorem / \endtheorem
%   directly (bypassing \begin{theorem}).
%
%   Timing note (docs/DESIGN.md §8a.5.0): the cmd/before hook fires
%   BEFORE amsthm's \refstepcounter{theorem}, so \theatom at
%   begin-time is the PREVIOUS atom's number.  The queuebackref
%   call is therefore in the end hook, where the env body has
%   run and \theatom reflects the current atom.
%   \codep@currentatom is demoted to a sentinel — its value
%   is not used, only its emptiness; we set it to a literal
%   "1" on begin and clear to \@empty on end.
%
%   Restatable guard (§8a.5.a): \codep@setupcounter aliases
%   \c@<basecounter> to \c@atom.  When thmtools' thm-restate.sty
%   re-fires the env for \restate, it breaks this alias
%   (\c@<basecounter> -> \c@thmt@dummyctr).  The \ifx guard
%   detects whether the alias is intact (original occurrence) or
%   broken (restate occurrence) and skips the hook body on
%   restate, preventing spurious atom attribution and duplicate
%   .cdp records.  All envs declared with
%   \newtheorem{...}[<basecounter>] share
%   \c@<basecounter>, so the guard covers all shared-counter
%   envs.  Envs with independent counters are not supported by
%   this guard and should not be passed to \codeptrack.
%
%   Note: the env name is captured via the hook argument (#1)
%   rather than \@currenvir, because under restatable the
%   current environment is "restatable", not the theorem type.
%
%   The hook bodies are factored into named helpers below;
%   \codep@hooktheorem is a thin orchestrator that wires them
%   into the four hook points.

%% @behavior B-NUM-NESTED
%% @behavior B-EDGE-RESTATE
% \codep@hooktheorem@begin{envname}
%   Begin-hook body for tracked theorem-like environments.
\def\codep@hooktheorem@begin#1{%
  \codep@closeparagraphifopen%
  \global\let\codep@pendingresultid\@empty%
  \expandafter\ifx\csname c@\codep@basecounter\endcsname\c@atom%
    \global\advance\codep@trackeddepth by 1\relax%
    \global\advance\codep@suppressdepth by 1\relax%
    \ifnum\codep@trackeddepth>1\relax%
      \PackageWarning{codependent}{Nested tracked environment '#1'\space%
        inside another tracked environment. The inner\space%
        environment will not be assigned its own atom number}%
    \else%
      \codep@allocatomid{\codep@thisatomid}{#1}%
      \codep@ctxpush{\codep@thisatomid}{#1}%
    \fi%
  \else%
    \global\advance\codep@replaydepth by 1\relax%
    \global\advance\codep@suppressdepth by 1\relax%
  \fi%
}%

%% @behavior B-NUM-STARRED
% \codep@hooktheorem@after{envname}
%   Capture the theorem's legacy prefixed key after its counter steps.
%   Anchor written here captures the theorem's own \@currentHref;
%   the extractanchor mechanism (§8a.5) overwrites codep@anchor@<key>
%   on pass 2+ with the equation-shifted anchor when an equation inside
%   the theorem shares the same display number.
\def\codep@hooktheorem@after#1{%
  \ifnum\codep@trackeddepth=1\relax%
    \codep@ctxpeekid\codep@thisatomid%
    \xdef\codep@outeratom{#1:\theatom}%
    \codep@atomsetkey{\codep@thisatomid}{\codep@outeratom}%
    \codep@writeanchormap{\codep@outeratom}%
  \fi%
}%

%% @behavior B-NUM-SEQ
% \codep@hooktheorem@record{envname}
%   Emit the theorem's legacy .cdp records and appendix entry.
\def\codep@hooktheorem@record#1{%
  \expandafter\codep@splitprefix\codep@outeratom\@nil%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\codep@tmp@num}{#1}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@tmp@num}{env}{#1}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@tmp@num}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  \codep@registeratom{\codep@outeratom}{#1}%
}%

% \codep@hooktheorem@preparebackref{envname}
%   Queue backrefs, apply orphan prevention, flush inline style.
%   Block/margin styles flush later in \AfterEndEnvironment.
%   Delegates to the rendering hook point.
%% @implements \codep@hooktheorem
\def\codep@hooktheorem@preparebackref#1{%
  \codep@render@thm@preparebackref{#1}%
}%

%% @behavior B-PROOF-ADJ
% \codep@hooktheorem@end@outer{envname}
%   Outermost theorem end: serialize and arm proof adjacency.
%   Stashes the just-closed atom's prefixed key in
%   \codep@endenv@pendingclear so the cmd/end#1/after hook can
%   undefine the per-atom \codep@manuallyemitted@<key> flag once
%   the env's group has fully closed (atom-key no longer
%   resolvable from the ctx stack at that point).
\def\codep@hooktheorem@end@outer#1{%
  \codep@ctxpeekid\codep@thisatomid%
  \codep@hooktheorem@record{#1}%
  \codep@hooktheorem@preparebackref{#1}%
  \codep@ctxpop{#1}%
  \global\advance\codep@trackeddepth by -1\relax%
  \global\advance\codep@suppressdepth by -1\relax%
  \xdef\codep@pendingresultid{\codep@thisatomid}%
  \xdef\codep@endenv@pendingclear{\codep@outeratom}%
}%

%% @behavior B-NUM-NESTED
%% @behavior B-EDGE-RESTATE
% \codep@hooktheorem@end{envname}
%   End-hook body: unwind replay, nested, or outer theorem state.
\def\codep@hooktheorem@end#1{%
  \expandafter\ifx\csname c@\codep@basecounter\endcsname\c@atom%
    \ifnum\codep@trackeddepth>1\relax%
      \global\advance\codep@trackeddepth by -1\relax%
      \global\advance\codep@suppressdepth by -1\relax%
    \else%
      \codep@hooktheorem@end@outer{#1}%
    \fi%
  \else%
    \global\advance\codep@replaydepth by -1\relax%
    \global\advance\codep@suppressdepth by -1\relax%
  \fi%
}%

% \codep@hooktheorem@afterend{envname}
%   After-end-environment hook body.  Inline backrefs are flushed
%   EARLY in cmd/end#1/before (inside the env body, in hmode, before
%   amsthm's \popQED/endmark mechanism) so "Used in" flows on the
%   same line as content; this post-env hook is a no-op for that
%   path.  For restatable re-fires (which call \theorem/\endtheorem
%   directly, bypassing \begin/\end), neither hook fires — correct,
%   since the restate guard already skipped backref queueing in the
%   cmd/end hook above.  Retained as a hook point so the theorem
%   orchestrator body stays stable across future rendering variants.
%% @implements \codep@hooktheorem
\def\codep@hooktheorem@afterend#1{%
  \codep@render@thm@afterend{#1}%
}

% \codep@manuallyemitted@end@outer@clear
%   cmd/end#1/after hook body for tracked theorem-like envs.
%   Consumes \codep@endenv@pendingclear (populated at
%   \codep@hooktheorem@end@outer time) and undefines the
%   corresponding per-atom flag so the next outer atom of the
%   same env starts with a clean slate.  Inert during replay
%   (the stash is only populated in the non-replay branch, so
%   the replay guard is belt+suspenders) and inert at inner-env
%   end (the stash is only populated for the OUTER env's
%   \codep@hooktheorem@end@outer path, never inner).
%% @utility
\def\codep@manuallyemitted@end@outer@clear{%
  \ifnum\codep@replaydepth=0\relax%
    \ifx\codep@endenv@pendingclear\@empty\else%
      \codep@manuallyemitted@clear@key{\codep@endenv@pendingclear}%
      \global\let\codep@endenv@pendingclear\@empty%
    \fi%
  \fi%
}%

% Thin orchestrator: wire the named helpers into the five hook points.
% Fifth hook (cmd/end#1/after) clears any per-atom
% \codep@manuallyemitted@<key> flag set by an inline
% \codepbackrefs call inside the env body; see the
% \codep@manuallyemitted@end@outer@clear helper above.
%% @behavior B-NUM-SEQ
%% @behavior B-PROOF-ADJ
\newcommand*{\codep@hooktheorem}[1]{%
  \AddToHook{cmd/#1/before}{\codep@hooktheorem@begin{#1}}%
  \AddToHook{cmd/#1/after}{\codep@hooktheorem@after{#1}}%
  \AddToHook{cmd/end#1/before}{\codep@hooktheorem@end{#1}}%
  \AfterEndEnvironment{#1}{\codep@hooktheorem@afterend{#1}}%
  \AddToHook{cmd/end#1/after}{\codep@manuallyemitted@end@outer@clear}%
}

% \codep@hookproof
%   Install hooks for the proof environment.
%   When proofs=on (default), adjacent proofs inherit the
%   preceding theorem's atom number with a star suffix (e.g.
%   "2.1*").  Non-adjacent proofs (no preceding theorem, or
%   an intervening paragraph) fall back to their own atom
%   number with a warning (if proof-warnings=on).
%   Standalone proofs defer margin emission to para/begin so
%   the number appears on the "Proof." line, not on a
%   separate line.
%   Delegates to:
%     \codep@hookproof@begin     — begin dispatch
%     \codep@proof@standalone    — non-adjacent proof path
%     \codep@proof@adjacent      — adjacent proof path
%     \codep@hookproof@end       — end cleanup
%     \codep@hookproof@afterend  — block/margin flush
%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-NONADJ
\newcommand*{\codep@hookproof}{%
  \@ifundefined{proof}{}{%
    \AtBeginEnvironment{proof}{\codep@hookproof@begin}%
    \AtEndEnvironment{proof}{\codep@hookproof@end}%
    \AfterEndEnvironment{proof}{\codep@hookproof@afterend}%
  }%
}%

%% @implements \codep@hookproof@begin
% \codep@proofstatesave{proof-id}
%   Save the outer proof state under the nested proof-id.
\def\codep@proofstatesave#1{%
  \expandafter\xdef\csname codep@savedproofid@#1\endcsname{%
    \codep@currentproofid}%
  \ifcodep@proofdisplaypending%
    \expandafter\gdef\csname codep@savedproofpending@#1\endcsname{1}%
  \else%
    \expandafter\gdef\csname codep@savedproofpending@#1\endcsname{0}%
  \fi%
  \expandafter\xdef\csname codep@savedproofbind@#1\endcsname{%
    \codep@pendingproofbind}%
  \global\codep@proofneststack=\expandafter{%
    \the\codep@proofneststack{\codep@currentproofid}}%
}%

%% @implements \codep@hookproof@end
% \codep@proofstaterestore{proof-id}
%   Restore any outer proof state saved under proof-id.
\def\codep@proofstaterestore#1{%
  \expandafter\ifx\csname codep@savedproofid@#1\endcsname\relax%
    \global\let\codep@currentproofid\@empty%
    \global\let\codep@pendingproofbind\@empty%
    \global\codep@proofdisplaypendingfalse%
  \else%
    \global\expandafter\let\expandafter\codep@currentproofid%
      \csname codep@savedproofid@#1\endcsname%
    \edef\codep@tmp@proofpending{%
      \csname codep@savedproofpending@#1\endcsname}%
    \def\codep@tmp@proofone{1}%
    \ifx\codep@tmp@proofpending\codep@tmp@proofone%
      \global\codep@proofdisplaypendingtrue%
    \else%
      \global\codep@proofdisplaypendingfalse%
    \fi%
    \global\expandafter\let\expandafter\codep@pendingproofbind%
      \csname codep@savedproofbind@#1\endcsname%
    \global\expandafter\let%
      \csname codep@savedproofid@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofpending@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofbind@#1\endcsname\@undefined%
  \fi%
}%

%% @behavior B-PROOF-OFF
%% @behavior B-PROOF-INNER
%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-NONADJ
% \codep@hookproof@begin
%   Begin dispatch for proof environments.
\newcommand*{\codep@hookproof@begin}{%
  \codep@closeparagraphifopen%
  \ifbool{codep@proofsnumbered}{%
    \codep@ctxpeekkind\codep@tmp@ctxkind%
    \def\codep@tmp@proofkind{proof}%
    \ifx\codep@currentproofid\@empty%
      \ifnum\codep@ctxdepth>0\relax%
        \global\advance\codep@suppressdepth by 1\relax%
      \else\ifnum\codep@suppressdepth>0\relax%
        \global\advance\codep@suppressdepth by 1\relax%
      \else%
        \codep@allocatomid{\codep@thisproofid}{proof}%
        \xdef\codep@currentproofid{\codep@thisproofid}%
        \codep@ctxpush{\codep@currentproofid}{proof}%
        \global\advance\codep@suppressdepth by 1\relax%
        \let\codep@pendingproofbind\@empty%
        \codep@proof@standalone%
        \ifx\codep@pendingresultid\@empty\else%
          \codep@proof@adjacent%
        \fi%
      \fi\fi%
    \else%
      \codep@allocatomid{\codep@thisproofid}{proof}%
      \codep@proofstatesave{\codep@thisproofid}%
      \xdef\codep@currentproofid{\codep@thisproofid}%
      \codep@ctxpush{\codep@currentproofid}{proof}%
      \global\advance\codep@suppressdepth by 1\relax%
      \let\codep@pendingproofbind\@empty%
      \codep@proof@standalone%
    \fi%
  }{%
    \global\advance\codep@suppressdepth by 1\relax%
  }%
}%

%% @behavior B-PROOF-NONADJ
% \codep@proof@standalone
%   Leave the current proof unresolved until fallback or \codepproofof.
\newcommand*{\codep@proof@standalone}{%
  \global\codep@proofdisplaypendingtrue%
}%

%% @behavior B-PROOF-NONADJ
%% @behavior B-EDGE-EMPTY-PROOF
% \codep@proof@materialize
%   Materialize the current proof as a standalone numbered proof atom.
\newcommand*{\codep@proof@materialize}{%
  \global\codep@proofdisplaypendingfalse%
  \refstepcounter{atom}%
  \edef\codep@tmp@proofkey{proof:\theatom}%
  \codep@atomsetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
  \codep@writeanchormap{\codep@tmp@proofkey}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\theatom}{proof}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\theatom}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  \codep@registeratom{\codep@tmp@proofkey}{proof}%
  \codep@render@queuebackref{\codep@tmp@proofkey}%
  \ifbool{codep@proofwarnings}{%
    \PackageWarning{codependent}{Proof not adjacent to a tracked\space%
      environment; assigned independent atom number \theatom}%
  }{}%
}%

%% @behavior B-PROOF-ADJ
% \codep@proof@adjacent
%   Bind the current proof to the pending adjacent theorem/result atom.
\newcommand*{\codep@proof@adjacent}{%
  \codep@bindproofparent{\codep@currentproofid}{\codep@pendingresultid}{%
    statement}%
  \global\codep@proofdisplaypendingfalse%
  \codep@atomgetdisplay{\codep@pendingresultid}\codep@tmp@num%
  \codep@atomgetkey{\codep@pendingresultid}{\codep@tmp@parentkey}%
  \edef\codep@tmp@thmanchor{%
    \expandafter\ifx\csname codep@anchor@\codep@tmp@parentkey\endcsname\relax%
      \noexpand\@empty%
    \else%
      \csname codep@anchor@\codep@tmp@parentkey\endcsname%
    \fi}%
  \codep@atomgetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
  \ifx\codep@tmp@thmanchor\@empty\else%
    \expandafter\xdef%
      \csname codep@anchor@\codep@tmp@proofkey\endcsname%
      {\codep@tmp@thmanchor}%
    \if@filesw%
      \protected@write\@auxout{}{%
        \string\codep@anchormap{\codep@tmp@proofkey}%
          {\codep@tmp@thmanchor}}%
    \fi%
  \fi%
  \global\let\codep@pendingresultid\@empty%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@proof{\codep@tmp@num*}}%
  \codep@render@queuebackref{\codep@tmp@proofkey}%
}%

%% @behavior B-PROOF-OFF
%% @behavior B-PROOF-NONADJ
% \codep@hookproof@end
%   Finalize and unwind the current proof environment.
%   Stashes the current proof's prefixed key in
%   \codep@proofend@pendingclear BEFORE \codep@proofstaterestore
%   overwrites \codep@currentproofid, so \codep@hookproof@afterend
%   can later undefine the corresponding per-atom
%   \codep@manuallyemitted@<key> flag.  Per-rail decision (v12 A4):
%   the proof rail stays on three hooks; the flag clear lives in
%   the existing afterend body, NOT a new cmd/endproof/after hook.
\newcommand*{\codep@hookproof@end}{%
  \ifbool{codep@proofsnumbered}{%
    \codep@ctxpeekkind\codep@tmp@ctxkind%
    \def\codep@tmp@proofkind{proof}%
    \ifx\codep@tmp@ctxkind\codep@tmp@proofkind%
      \ifcodep@proofdisplaypending%
        \codep@proof@materialize%
      \fi%
      \codep@ctxpeekid\codep@thisproofid%
      \codep@render@proof@end%
      \codep@ctxpop{proof}%
      \global\let\codep@pendingresultid\@empty%
      \codep@atomgetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
      \xdef\codep@proofend@pendingclear{\codep@tmp@proofkey}%
      \codep@proofstaterestore{\codep@thisproofid}%
    \fi%
  }{}%
  \global\advance\codep@suppressdepth by -1\relax%
}%

%% @behavior B-REND-INLINE
% \codep@hookproof@afterend
%   Post-env hook body.  Inline flush already happened in
%   \codep@hookproof@end; retained as a hook point so the proof
%   orchestrator body stays stable across future rendering variants.
%   Also consumes \codep@proofend@pendingclear to undefine the
%   per-atom \codep@manuallyemitted@<key> flag for the proof that
%   just closed (v12 A4: the proof-side flag clear lives here, NOT
%   in a new cmd/endproof/after hook).
\newcommand*{\codep@hookproof@afterend}{%
  \codep@render@proof@afterend%
  \ifnum\codep@replaydepth=0\relax%
    \ifx\codep@proofend@pendingclear\@empty\else%
      \codep@manuallyemitted@clear@key{\codep@proofend@pendingclear}%
      \global\let\codep@proofend@pendingclear\@empty%
    \fi%
  \fi%
}%

%% ===================================================================
%% Section 7: Paragraph numbering
%% ===================================================================

%% @behavior B-SUPP-EXTEND
% \codep@suppressenv{envname}
%   Increment suppressdepth on entry, decrement it on exit.
\newcommand*{\codep@suppressenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\advance\codep@suppressdepth by 1\relax
  }%
  \AtEndEnvironment{#1}{%
    \global\advance\codep@suppressdepth by -1\relax
  }%
}%

%% --- Equation backref tracking (two-track design) ---
%% Track 1: single-number environments (equation).
%% Track 2: multi-number environments (align, gather, multline, flalign).

%% @behavior B-EQ-OUTER
%% @behavior B-EQ-ALL
%% @behavior B-EQ-OFF
% \codep@eqshouldtrack
%   Set \codep@eqatom to a non-empty sentinel if this block owns refs.
\newcommand*{\codep@eqshouldtrack}{%
  \def\codep@eqatom{}%
  \ifx\codep@equationmode\codep@const@off%
  \else\ifx\codep@equationmode\codep@const@outer%
    \ifnum\codep@trackeddepth>0\relax\else%
      \def\codep@eqatom{pending}%
    \fi%
  \else%
    \def\codep@eqatom{pending}%
  \fi\fi%
}%

%% @behavior B-EQ-TRACK1
% \codep@trackeqenv{envname}
%   Track one-row equation environments.
\newcommand*{\codep@trackeqenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\let\codep@pendingresultid\@empty%
    \global\advance\codep@suppressdepth by 1\relax%
    \booltrue{codep@inequation}%
    \boolfalse{codep@eqmultiline}%
    \boolfalse{codep@eqnumbered}%
    \codep@getcurrentownerid\codep@tmp@eqowner%
    \xdef\codep@eqfallbacksourceid{\codep@tmp@eqowner}%
    \global\let\codep@currenteqsourceid\@empty%
    \ifnum\codep@trackeddepth>0\relax\else%
      \global\def\codep@eq@lbltype@pending{equation}%
    \fi%
    \codep@eqshouldtrack%
    \ifx\codep@eqatom\@empty\else%
      \codep@allocatomid{\codep@currenteqsourceid}{equation}%
      \codep@ctxpush{\codep@currenteqsourceid}{equation}%
    \fi%
  }%
  \AtEndEnvironment{#1}{%
    \boolfalse{codep@inequation}%
    \def\codep@eqatom{}%
    \ifx\codep@currenteqsourceid\@empty\else%
      \codep@ctxpop{equation}%
    \fi%
    \global\let\codep@currenteqsourceid\@empty%
    \global\let\codep@eqfallbacksourceid\@empty%
    \global\advance\codep@suppressdepth by -1\relax%
  }%
  \AfterEndEnvironment{#1}{%
    \global\let\codep@eq@lbltype@pending\@empty%
  }%
}%

%% @behavior B-EQ-TRACK2
% \codep@trackalignenv{envname}
%   Track multi-row equation environments.
\newcommand*{\codep@trackalignenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\let\codep@pendingresultid\@empty%
    \global\advance\codep@suppressdepth by 1\relax%
    \booltrue{codep@inequation}%
    \booltrue{codep@eqmultiline}%
    \boolfalse{codep@eqnumbered}%
    \codep@getcurrentownerid\codep@tmp@eqowner%
    \xdef\codep@eqfallbacksourceid{\codep@tmp@eqowner}%
    \global\let\codep@currenteqsourceid\@empty%
    \ifnum\codep@trackeddepth>0\relax\else%
      \global\def\codep@eq@lbltype@pending{equation}%
    \fi%
    \global\codep@eq@startcount=\c@equation\relax%
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax%
    \codep@eqshouldtrack%
    \ifx\codep@eqatom\@empty\else%
      \codep@allocatomid{\codep@currenteqsourceid}{equation}%
      \codep@ctxpush{\codep@currenteqsourceid}{equation}%
    \fi%
    \@ifpackageloaded{hyperref}{%
      \xdef\codep@eq@anchor{codep.eq.\the\c@equation}%
      \Hy@raisedlink{%
        \hyper@anchorstart{\codep@eq@anchor}\hyper@anchorend}%
    }{}%
  }%
  \AtEndEnvironment{#1}{%
    \boolfalse{codep@inequation}%
    \boolfalse{codep@eqmultiline}%
    \def\codep@eqatom{}%
  }%
  \AfterEndEnvironment{#1}{%
    \ifnum\codep@eqpendingcount>0\relax%
      \codep@flusheqrange%
    \fi%
    \ifx\codep@currenteqsourceid\@empty\else%
      \codep@ctxpop{equation}%
    \fi%
    \global\let\codep@currenteqsourceid\@empty%
    \global\let\codep@eqfallbacksourceid\@empty%
    \global\let\codep@eq@lbltype@pending\@empty%
    \global\advance\codep@suppressdepth by -1\relax%
  }%
}%

% \codep@dedupwrite{src}{tgt}
%   Per-(source, target) dedup write.  If the csname flag
%   codep@arw@<src>@<tgt> is undefined (\relax), set it to
%   \@empty and write \codep@atomref{src}{tgt} to the .aux
%   file.  Otherwise skip (already written this run).
\def\codep@dedupwrite#1#2{%
  \expandafter\ifx%
      \csname codep@arw@#1@#2\endcsname\relax
    \global\expandafter\let%
      \csname codep@arw@#1@#2\endcsname\@empty%
    \protected@write\@auxout{}{%
      \string\codep@atomref{#1}{#2}}%
  \fi
}

% \codep@flusheqrange@numbered
%   Numbered-line path: counter advanced, so compute the
%   equation range, write the anchormap entry, and flush
%   all pending refs with dedup.
%% @behavior B-DISP-EQRANGE
% \codep@flusheqrange@numbered
%   Compute the legacy equation range key and flush pending refs.
\def\codep@flusheqrange@numbered{%
  % Compute formatted start: saved+1 in a group.
  \begingroup
    \c@equation=\codep@eq@startcount\relax
    \advance\c@equation by 1\relax
    \xdef\codep@tmp@eqstart{\theequation}%
  \endgroup
  \edef\codep@tmp@eqend{\theequation}%
  % Build the equation:-prefixed key; display renders as (N) or (N--M).
  \ifx\codep@tmp@eqstart\codep@tmp@eqend%
    % Single numbered line: equation:N
    \edef\codep@eqatom{equation:\codep@tmp@eqstart}%
  \else%
    % Range: equation:N--M
    \edef\codep@eqatom{equation:\codep@tmp@eqstart--\codep@tmp@eqend}%
  \fi%
  \ifx\codep@currenteqsourceid\@empty\else%
    \codep@atomsetkey{\codep@currenteqsourceid}{\codep@eqatom}%
  \fi%
  % Write anchormap entry using dedicated block anchor.
  \@ifpackageloaded{hyperref}{%
    \expandafter\xdef%
      \csname codep@anchor@\codep@eqatom\endcsname%
      {\codep@eq@anchor}%
    \if@filesw%
      \protected@write\@auxout{}{%
        \string\codep@anchormap{\codep@eqatom}{\codep@eq@anchor}}%
    \fi%
  }{}%
  % Flush all pending refs (with dedup).
  \if@filesw%
    \def\codep@eqpending@entry##1{%
      \codep@dedupwrite{\codep@eqatom}{##1}%
    }%
    \the\codep@eqpending%
  \fi%
}%

%% @behavior B-EQ-NOTAG
% \codep@flusheqrange@fallback
%   All-notag path: replay pending refs from the enclosing owner.
\def\codep@flusheqrange@fallback{%
  \codep@atomgetkey{\codep@eqfallbacksourceid}{\codep@tmp@srcatom}%
  \ifx\codep@tmp@srcatom\@empty\else%
    \if@filesw%
      \def\codep@eqpending@entry##1{%
        \codep@dedupwrite{\codep@tmp@srcatom}{##1}%
      }%
      \the\codep@eqpending%
    \fi%
  \fi%
}%

% \codep@flusheqrange
%   Compute the equation range and flush all pending refs.
%   Called at \end{align} (Track 2).  Dispatches to
%   \codep@flusheqrange@numbered or @fallback.
\def\codep@flusheqrange{%
  % Check equation mode.
  \codep@eqshouldtrack%
  \ifx\codep@eqatom\@empty%
    % Mode says don't track; silently drop pending refs.
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
  \else
    % Check if counter advanced (at least one numbered line).
    \ifnum\c@equation>\codep@eq@startcount\relax
      \codep@flusheqrange@numbered%
    \else
      \codep@flusheqrange@fallback%
    \fi
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
  \fi
}

% \codep@suppresscmd{command}
%   Patch a command to suppress numbering in its body.
%% @behavior B-SUPP-EXTEND
% \codep@suppresscmd{command}
%   Patch a command to suppress paragraph numbering in its body.
\newcommand*{\codep@suppresscmd}[1]{%
  \pretocmd{#1}{\global\advance\codep@suppressdepth by 1\relax}{}{}%
  \apptocmd{#1}{\global\advance\codep@suppressdepth by -1\relax}{}{}%
}%

%% @utility
% \codep@withsuppression{tokens}
%   Execute tokens with codep@suppressdepth incremented, then
%   decremented.  Suppression is balanced by construction.
%   \global\advance is required: caller may be inside a group
%   (e.g., \AfterEndEnvironment callbacks).
\def\codep@withsuppression#1{%
  \global\advance\codep@suppressdepth\@ne%
  #1%
  \global\advance\codep@suppressdepth\m@ne%
}%

% \codep@installsuppress
%   Hook suppression for standard environments.
%% @behavior B-SUPP-TRACKED
\newcommand*{\codep@installsuppress}{%
  \codep@suppressenv{enumerate}%
  \codep@suppressenv{itemize}%
  \codep@suppressenv{description}%
  \codep@suppressenv{quote}%
  \codep@suppressenv{quotation}%
  \codep@suppressenv{figure}%
  \codep@suppressenv{table}%
  \codep@suppressenv{minipage}%
  \codep@suppressenv{tabular}%
  \codep@suppressenv{tabularx}%
  \codep@suppressenv{longtable}%
  \codep@suppressenv{trivlist}%
  % Numbered equation environments.
  % Track 1: single-number (counter steps at \begin).
  \codep@trackeqenv{equation}%
  % Track 2: multi-number (counter steps at \\).
  \codep@trackalignenv{align}%
  \codep@trackalignenv{gather}%
  \codep@trackalignenv{multline}%
  \codep@trackalignenv{flalign}%
  % Unnumbered/display-only: suppress paragraphs only.
  \codep@suppressenv{equation*}%
  \codep@suppressenv{displaymath}%
  \codep@suppressenv{align*}%
  \codep@suppressenv{gather*}%
  \codep@suppressenv{multline*}%
  \codep@suppressenv{flalign*}%
}

% \codep@suppresssectioning
%   Suppress atom numbering for sectioning heading paragraphs.
%   Uses LaTeX 2021+ generic cmd/<level>/before hooks, which
%   fire universally across standard classes, KOMA-Script,
%   memoir, and titlesec (unlike the old \@startsection wrapper
%   which was a no-op under those packages).
%% @behavior B-SUPP-SECTION
% \codep@suppresssectioning
%   One-shot suppression for heading paragraphs.
\newcommand*{\codep@suppresssectioning}{%
  \AddToHook{cmd/section/before}[codependent/sectioning]{%
    \codep@closeparagraphifopen%
    \global\let\codep@pendingresultid\@empty%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/subsection/before}[codependent/sectioning]{%
    \codep@closeparagraphifopen%
    \global\let\codep@pendingresultid\@empty%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/subsubsection/before}[codependent/sectioning]{%
    \codep@closeparagraphifopen%
    \global\let\codep@pendingresultid\@empty%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/chapter/before}[codependent/sectioning]{%
    \codep@closeparagraphifopen%
    \global\let\codep@pendingresultid\@empty%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/paragraph/before}[codependent/sectioning]{%
    \codep@closeparagraphifopen%
    \global\let\codep@pendingresultid\@empty%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/subparagraph/before}[codependent/sectioning]{%
    \codep@closeparagraphifopen%
    \global\let\codep@pendingresultid\@empty%
    \global\booltrue{codep@sectioning}}%
}%

% \codep@capturesectitle
%   Intercept \addcontentsline to capture section titles for
%   appendix-mode section grouping.  When a {toc}{section}
%   entry is written, extract the title (stripping \numberline)
%   and store it in \codep@cursecnum / \codep@cursectitle.
%   Only active in appendix mode.
%% @implements \codep@checktocsection
\newcommand*{\codep@capturesectitle}{%
  \ifbool{codep@appendix}{%
    \let\codep@orig@addcontentsline\addcontentsline%
    \renewcommand{\addcontentsline}[3]{%
      \codep@orig@addcontentsline{##1}{##2}{##3}%
      \codep@checktocsection{##1}{##2}{##3}%
    }%
  }{}%
}%
% \codep@checktocsection{file}{type}{entry}
%   If file=toc and type=section, extract the section number
%   and title from the entry.  Uses \thesection for the number
%   (guaranteed correct since \refstepcounter has already run)
%   and strips \numberline from the entry via controlled \edef
%   to recover the bare title text.
%% @behavior B-REND-APPENDIX
\def\codep@checktocsection#1#2#3{%
  \def\codep@tmp@tocfile{#1}\def\codep@tmp@toctype{toc}%
  \ifx\codep@tmp@tocfile\codep@tmp@toctype%
    \def\codep@tmp@tocfile{#2}\def\codep@tmp@toctype{section}%
    \ifx\codep@tmp@tocfile\codep@tmp@toctype%
      \codep@extractsectitle{#3}%
    \fi
  \fi
}%
% \codep@extractsectitle{entry}
%   Extract the bare title from a TOC entry by redefining
%   \numberline to absorb its argument and \edef-expanding
%   the entry with \protect neutralised.
%% @implements \codep@checktocsection
\def\codep@extractsectitle#1{%
  \begingroup
    \let\protect\@empty%
    \def\numberline##1{}%
    \edef\codep@tmp@expanded{#1}%
    \global\let\codep@tmp@result\codep@tmp@expanded%
  \endgroup
  \xdef\codep@cursecnum{\thesection}%
  \global\let\codep@cursectitle\codep@tmp@result%
  \global\expandafter\let%
    \csname codep@sectitle@\thesection\endcsname\codep@tmp@result%
}%

% Auto-suppress enumitem \newlist environments.
%   When enumitem is loaded, wraps \newlist so that every
%   user-defined list environment is automatically registered
%   for paragraph-number suppression.
\AddToHook{begindocument/before}[codependent/suppress/enumitem]{%
  \@ifpackageloaded{enumitem}{%
    \let\codep@orig@newlist\newlist
    \def\newlist#1#2#3{%
      \codep@orig@newlist{#1}{#2}{#3}%
      \codep@suppressenv{#1}%
    }%
  }{}%
}

% Auto-suppress tcolorbox / mdframed environments.
%   Conditionally suppresses boxed-content environments when
%   the respective package is loaded.
\AddToHook{begindocument/before}[codependent/suppress/boxes]{%
  \@ifpackageloaded{tcolorbox}{%
    \codep@suppressenv{tcolorbox}%
  }{}%
  \@ifpackageloaded{mdframed}{%
    \codep@suppressenv{mdframed}%
  }{}%
}

% \codep@suppresscommands
%   Suppress numbering inside footnote, parbox.
%   Note: \caption is NOT patched here because its complex
%   calling convention (\@ifstar + optional arg) makes
%   etoolbox patching unreliable.  Captions appear only
%   inside figure/table environments, which are already
%   suppressed at the env level.
%% @implements \codep@installsuppress
\newcommand*{\codep@suppresscommands}{%
  \codep@suppresscmd{\footnote}%
  \codep@suppresscmd{\parbox}%
  \codep@suppresscmd{\maketitle}%
}

%% @behavior B-NUM-PARA
% \codep@parahook@paragraph
%   Open a paragraph atom at top level.
\def\codep@parahook@paragraph{%
  \codep@allocatomid{\codep@thisatomid}{paragraph}%
  \codep@ctxpush{\codep@thisatomid}{paragraph}%
  \global\codep@paragraphopentrue%
  \refstepcounter{atom}%
  \edef\codep@tmp@parakey{paragraph:\theatom}%
  \codep@atomsetkey{\codep@thisatomid}{\codep@tmp@parakey}%
  \codep@writeanchormap{\codep@tmp@parakey}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\theatom}{paragraph}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\theatom}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  \codep@registeratom{\codep@tmp@parakey}{paragraph}%
  \codep@render@para@emit{\codep@tmp@parakey}{\theatom}%
}%

%% @behavior B-NUM-PARA
%% @behavior B-PROOF-ADJRULE
% \codep@installparahook
%   Install the top-level para/begin paragraph allocator.
\newcommand*{\codep@installparahook}{%
  \AddToHook{para/begin}{%
    \ifbool{codep@tracked}{%
      \global\let\codep@pendingresultid\@empty%
      \ifcodep@proofdisplaypending%
        \codep@ctxpeekkind\codep@tmp@ctxkind%
        \def\codep@tmp@proofkind{proof}%
        \ifx\codep@tmp@ctxkind\codep@tmp@proofkind%
          \codep@proof@materialize%
        \fi%
      \fi%
      \ifbool{codep@sectioning}{%
        \global\boolfalse{codep@sectioning}%
      }{%
        \ifbool{codep@paragraphs}{%
          \ifnum\codep@suppressdepth>0\relax%
          \else\ifnum\codep@ctxdepth>0\relax%
          \else%
            \codep@parahook@paragraph%
          \fi\fi%
        }{}%
      }%
    }{}%
  }%
}%

