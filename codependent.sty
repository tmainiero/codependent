%% --- Section 8a.0: Reference interception (three-site design) ---
%% Per REVIEW_E finding #2 (BLOCKER), the single-\@setref patch
%% covers only \ref/\eqref/\pageref/\vref/\nameref.  cleveref's
%% \cref@getlabel, hyperref's \HyRef@autosetref (\autoref), and
%% hyperref's \HyRef@@StarSetRef (\ref*/\Ref) all bypass \@setref.
%% This subsection installs THREE patch sites.  Per REVIEW_E #16,
%% \hyperref[]{} is deliberately uncovered (manual link, not a
%% cross-reference).

% Pass-1 safety: \codep@atomref must be defined to SOMETHING at
% package-load time so that if a stale .aux still references it
% (or a user script injects a record), LaTeX's aux read does not
% error.  A \providecommand no-op suits.
\providecommand*{\codep@atomref}[2]{}

% Pass-1 safety: \codep@lbltype records label→type-prefix mappings.
