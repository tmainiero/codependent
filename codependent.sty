% Base counter name: auto-detected from the first env in \codeptrack.
\newcommand*{\codep@basecounter}{}

% Suppression nesting depth.  When > 0, para/begin skips numbering.
\newcount\codep@nestlevel
\codep@nestlevel=0\relax

% Tracked-env nesting depth.  When > 1, inner tracked envs are
% suppressed (no atom record, no SBL entry).  Uses \global\advance
% because hooks may run inside groups.
\newcount\codep@trackedlevel
\codep@trackedlevel=0\relax

% Pending back-reference text (flushed at para/end or env end).
\newtoks\codep@pendingbr

% Current atom display number (set when atom is created).
\newcommand*{\codep@currentatom}{}

% Current atom type prefix for backref graph keys.
% Set alongside \codep@currentatom; used by \codep@writeatomref
% to construct the prefixed source key at write time.  Values:
% thm, para, proof, eq (matching the type: prefix scheme).
\newcommand*{\codep@currenttype}{}

% Last theorem atom number for proof adjacency detection.
% Set at theorem end, cleared at next top-level para/begin.
% When non-empty, a standalone proof inherits this number
% with a star suffix instead of getting its own atom number.
% Stores the prefixed key (thm:X).
\newcommand*{\codep@lasttheorematom}{}

% Override source atom for \codep@writeatomref.  When non-empty,
% \codep@writeatomref uses this instead of \theatom as the source
% atom number in aux records.  Used by adjacent proofs to emit
% proof-prefixed atom keys (e.g. "proof:2.1") in backref records.
\newcommand*{\codep@sourceatom}{}

% Saved atom number for the outermost tracked env.  When nesting
% occurs, \theatom at end-time reflects the LAST \refstepcounter
% (the inner env), not the outermost.  This macro captures the
% correct value after the outermost env's \refstepcounter fires.
\newcommand*{\codep@outeratom}{}

% Flag: true inside a tracked theorem environment.
\newbool{codep@intheorem}
\boolfalse{codep@intheorem}

% Flag: true when \codeptrack has been called.
\newbool{codep@tracked}
\boolfalse{codep@tracked}

% Flag: true when a sectioning heading paragraph is pending.
% Set by the \@startsection wrapper, cleared after one para/begin.
\newbool{codep@sectioning}
\boolfalse{codep@sectioning}

% Restate guard: counter-indexed LIFO stack for save/clear/restore
% of \codep@currentatom across restated theorem occurrences
% (§8a.5.a).  Depth 0 = no active restate; each push increments.
\newcount\codep@restate@depth
\codep@restate@depth=0\relax

% \codep@pushcurrentatom
%   Save \codep@currentatom onto the restate stack and clear it
%   to \@empty so semantic commands inside the restated body no-op.
\newcommand*{\codep@pushcurrentatom}{%
  \global\advance\codep@restate@depth 1\relax
  \expandafter\xdef
    \csname codep@saved@currentatom@%
      \the\codep@restate@depth\endcsname
    {\codep@currentatom}%
  \global\let\codep@currentatom\@empty
}

% \codep@popcurrentatom
%   Restore \codep@currentatom from the restate stack, undefine
%   the slot, and decrement the depth counter.
\newcommand*{\codep@popcurrentatom}{%
  \global\expandafter\let\expandafter\codep@currentatom
    \csname codep@saved@currentatom@%
      \the\codep@restate@depth\endcsname
  \global\expandafter\let
    \csname codep@saved@currentatom@%
      \the\codep@restate@depth\endcsname\@undefined
  \global\advance\codep@restate@depth -1\relax
}

% Flag: true inside a tracked equation environment.
\newbool{codep@inequation}

% Track 1: current equation atom (set at \ref time for single-number envs).
\newcommand*{\codep@eqatom}{}

% Track 2: pending ref targets for multi-number envs.
\newtoks\codep@eqpending
\codep@eqpending={}
\newcount\codep@eqpendingcount
\codep@eqpendingcount=0\relax

% Track 2: saved equation counter at \begin{align}.
\newcount\codep@eq@startcount
\codep@eq@startcount=0\relax

% Track 2: dedicated anchor name for the block.
\newcommand*{\codep@eq@anchor}{}

% Track 2 flag: distinguishes Track 1 vs Track 2 envs.
\newbool{codep@eqmultiline}

% Accumulated appendix data (token register).
% Still referenced by \codepappendix (Section 10); Wave 3 rewires
% its population path per §8a.6.g.
\newtoks\codep@appendixdata

% Count-indexed atom array for appendix mode (§8a.6.g).
% Each \codep@atom@<n> expands to {<num>}{<type>}.
% O(1) append via csname array; O(N) walk in \codepappendix.
\newcount\codep@atomcount

% Current section number and title for appendix section grouping.
% Updated by the \addcontentsline hook when a toc/section entry
% is written.  Stored per-atom at registration time so that
% \codepappendix can emit section headers.
\newcommand*{\codep@cursecnum}{}%
\newcommand*{\codep@cursectitle}{}%

% Sidecar (.cdp) stream state (§9a).
\newbool{codep@cdpopen}
\boolfalse{codep@cdpopen}

% Deferred sbl writes: preamble cmddef records accumulate here
% and flush once the .cdp stream opens at begindocument/before.
\def\codep@cdp@deferred{}

%% --- Rendering hook points (no-op defaults) ---
%% These are redefined to their live implementations after all
%% rendering code is loaded (see "Rendering hook activation" below).
%% When tracking runs without a rendering layer, these are inert.
\def\codep@render@queuebackref#1{}%
\def\codep@render@thm@preparebackref#1{}%
\def\codep@render@thm@afterend#1{}%
\def\codep@render@proof@end{}%
\def\codep@render@proof@afterend{}%
\def\codep@render@para@emit#1#2{}%
\def\codep@render@para@emitdeferred{}%
\def\codep@render@paraend@snapshot{}%
\def\codep@render@enddocument@flush{}%

%% ===================================================================
%% Section 5: Core numbering machinery
%% ===================================================================

% \codep@removefromreset{counter}{parent}
%   Remove counter from parent's reset list.
\newcommand*{\codep@removefromreset}[2]{%
  \@ifundefined{@removefromreset}{%
    % Manual: rewrite \cl@parent without #1.
    \begingroup
      \expandafter\let\expandafter\codep@resetlist
        \csname cl@#2\endcsname%
      \expandafter\global\expandafter\let
        \csname cl@#2\endcsname\@empty%
      \def\@elt##1{%
        \def\codep@cur{##1}%
        \def\codep@tgt{#1}%
        \ifx\codep@cur\codep@tgt\else
          \expandafter\g@addto@macro
            \csname cl@#2\endcsname{\@elt{##1}}%
        \fi
      }%
      \codep@resetlist
    \endgroup
  }{%
    \@removefromreset{#1}{#2}%
  }%
}

% \codep@setupcounter
%   Create the atom counter and wire it to the base counter
%   (auto-detected from the first env in \codeptrack).
%   Called by \codeptrack.
\newcommand*{\codep@setupcounter}{%
  \newcounter{atom}%
  % Copy current base counter value (if it exists).
  % Note: \@ifundefined uses \csname internally, which expands
  % \codep@basecounter automatically.
  \@ifundefined{c@\codep@basecounter}{}{%
    \setcounter{atom}{\value{\codep@basecounter}}%
    % Alias: \c@<basecounter> -> \c@atom.
    \expandafter\let\csname c@\codep@basecounter\endcsname\c@atom
  }%
  \codep@configuredepth
  % Sync base counter display format with atom display format.
  \@ifundefined{c@\codep@basecounter}{}{%
    \expandafter\let\csname the\codep@basecounter\endcsname\theatom
  }%
}

% \codep@configuredepth
%   Set up counter resets and display format based on depth option
%   and document class.
\newcommand*{\codep@configuredepth}{%
  % Remove base counter from any existing reset parent.
  \@ifundefined{c@\codep@basecounter}{}{%
    \@ifundefined{cl@section}{}{%
      \expandafter\codep@removefromreset\expandafter{\codep@basecounter}{section}%
    }%
    \@ifundefined{cl@chapter}{}{%
      \expandafter\codep@removefromreset\expandafter{\codep@basecounter}{chapter}%
    }%
  }%
  \@ifundefined{chapter}{%
    \codep@configuredepth@article
  }{%
    \codep@configuredepth@book
  }%
}

% Article-class depth configuration.
\newcommand*{\codep@configuredepth@article}{%
  \ifcase\codep@depth\relax
    % 0: invalid
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \or % 1
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{\thesection.\arabic{atom}}%
  \or % 2
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.\arabic{atom}}%
  \or % 3
    \@addtoreset{atom}{subsubsection}%
    \renewcommand*{\theatom}{%
      \thesection.\arabic{subsection}.%
      \arabic{subsubsection}.\arabic{atom}}%
  \else
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi
}

% Book/report-class depth configuration.
\newcommand*{\codep@configuredepth@book}{%
  \ifcase\codep@depth\relax
    % 0: invalid
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \or % 1
    \@addtoreset{atom}{chapter}%
    \renewcommand*{\theatom}{\thechapter.\arabic{atom}}%
  \or % 2
    \@addtoreset{atom}{section}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.\arabic{atom}}%
  \or % 3
    \@addtoreset{atom}{subsection}%
    \renewcommand*{\theatom}{%
      \thechapter.\arabic{section}.%
      \arabic{subsection}.\arabic{atom}}%
  \else
    \PackageError{codependent}{Invalid depth '\codep@depth'}{%
      The depth option must be 1, 2, or 3.}%
  \fi
}

% \codep@registeratom{num}{kind}
%   Append one entry to the count-indexed atom array.
%   num  -- the atom number token (e.g. \codep@outeratom or \theatom)
%   kind -- the atom type string (e.g. {#1}, proof, paragraph)
\def\codep@registeratom#1#2{%
  \global\advance\codep@atomcount by 1\relax
  \expandafter\xdef\csname codep@atom@\the\codep@atomcount\endcsname{%
    {#1}{#2}}%
  % Store current section number for appendix grouping.
  \expandafter\xdef%
    \csname codep@atom@sec@\the\codep@atomcount\endcsname{%
    \codep@cursecnum}%
}%

%% ===================================================================
%% Section 6: Theorem environment hooks
%% ===================================================================

% \codep@preventorphan
%   Prevent page breaks between an atom body and its "Used in"
%   line for block/margin styles.  Sets \@endparpenalty to \@M
%   (10000 = \nobreak) when the pending backref register is
%   non-empty.  The assignment is LOCAL to the current group,
%   so it is automatically restored after \endgroup.
%   No-op when the backref style is inline (inline flushes
%   in hmode, before the env closes).
\def\codep@preventorphan{%
  \ifx\codep@backrefstyle\codep@const@inline\else
    \expandafter\def\expandafter\codep@tmp\expandafter{%
      \the\codep@pendingbr}%
    \ifx\codep@tmp\@empty\else
      \@endparpenalty\@M
    \fi
  \fi
}%

% \codep@hooktheorem{envname}
%   Install begin/end hooks for a tracked theorem environment.
%   Uses LaTeX 2021+ cmd hooks (cmd/<env>/before) instead of
%   etoolbox's \AtBeginEnvironment so that hooks also fire when
%   thmtools' thm-restate.sty calls \theorem / \endtheorem
%   directly (bypassing \begin{theorem}).
%
%   Timing note (DESIGN.md §8a.5.0): the cmd/before hook fires
%   BEFORE amsthm's \refstepcounter{theorem}, so \theatom at
%   begin-time is the PREVIOUS atom's number.  The queuebackref
%   call is therefore in the end hook, where the env body has
%   run and \theatom reflects the current atom.
%   \codep@currentatom is demoted to a sentinel — its value
%   is not used, only its emptiness; we set it to a literal
%   "1" on begin and clear to \@empty on end.
%
%   Restatable guard (§8a.5.a): \codep@setupcounter aliases
%   \c@<basecounter> to \c@atom.  When thmtools' thm-restate.sty
%   re-fires the env for \restate, it breaks this alias
%   (\c@<basecounter> -> \c@thmt@dummyctr).  The \ifx guard
%   detects whether the alias is intact (original occurrence) or
%   broken (restate occurrence) and skips the hook body on
%   restate, preventing spurious atom attribution and duplicate
%   .cdp records.  All envs declared with
%   \newtheorem{...}[<basecounter>] share
%   \c@<basecounter>, so the guard covers all shared-counter
%   envs.  Envs with independent counters are not supported by
%   this guard and should not be passed to \codeptrack.
%
%   Note: the env name is captured via the hook argument (#1)
%   rather than \@currenvir, because under restatable the
%   current environment is "restatable", not the theorem type.
%
%   The hook bodies are factored into named helpers below;
%   \codep@hooktheorem is a thin orchestrator that wires them
%   into the four hook points.

% \codep@hooktheorem@begin{envname}
%   Begin-hook body: restate dispatch, trackedlevel,
%   nestlevel, intheorem, currentatom sentinel.
\def\codep@hooktheorem@begin#1{%
  \expandafter\ifx\csname c@\codep@basecounter\endcsname\c@atom
    % Original occurrence: alias intact, normal hook body.
    \global\advance\codep@trackedlevel by 1\relax
    \advance\codep@nestlevel by 1\relax
    \ifnum\codep@trackedlevel>1\relax
      % Nested tracked env: suppress atom creation.
      \PackageWarning{codependent}{Nested tracked environment '#1'
        inside another tracked environment. The inner
        environment will not be assigned its own atom number}%
    \else
      \booltrue{codep@intheorem}%
      % Sentinel only — the actual atom number is read at write
      % time via \theatom (see §8a.5.0).
      \def\codep@currentatom{1}%
      \def\codep@currenttype{#1}%
    \fi
  \else
    % Restate occurrence: \c@<basecounter> re-let to dummy
    % counter by thm-restate.sty.  Suppress the hook body to avoid
    %   (a) reading the wrong \theatom,
    %   (b) writing a duplicate \codep@cdp@atom record,
    %   (c) queuing back-refs against a stale atom number.
    % Bump nestlevel so paragraph numbering is suppressed
    % inside the restated body (matching normal theorem
    % semantics), and save/clear currentatom so semantic
    % commands inside the restated body no-op.
    \advance\codep@nestlevel by 1\relax
    \codep@pushcurrentatom
  \fi
}

% \codep@hooktheorem@after{envname}
%   After-hook body: save outeratom and write anchormap.
%   cmd/#1/after fires AFTER amsthm's \refstepcounter (unlike
%   cmd/#1/before which fires BEFORE it), so \theatom is correct
%   here.  For nested tracked envs this is a no-op; only
%   trackedlevel=1 saves.  The restate guard is not needed here
%   because trackedlevel is only incremented on the original path.
\def\codep@hooktheorem@after#1{%
  \ifnum\codep@trackedlevel=1\relax
    \xdef\codep@outeratom{#1:\theatom}%
    % Write atom->anchor mapping for hyperlinks (no-op without hyperref).
    \codep@writeanchormap{#1:\theatom}%
  \fi
}

% \codep@hooktheorem@record{envname}
%   Sidecar writes + atom-array registration.
%   Uses \codep@outeratom (captured after the outermost env's
%   \refstepcounter) instead of \theatom, because nested tracked
%   envs may have advanced the counter.
\def\codep@hooktheorem@record#1{%
  % .cdp records use bare display numbers (CLI does its own processing).
  % Extract bare number from prefixed \codep@outeratom (envname:X → X).
  \expandafter\codep@splitprefix\codep@outeratom\@nil
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\codep@tmp@num}{#1}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@tmp@num}{env}{#1}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@tmp@num}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  % Atom array stores the prefixed key for backref graph.
  \codep@registeratom{\codep@outeratom}{#1}%
}%

% \codep@hooktheorem@preparebackref{envname}
%   Queue backrefs, apply orphan prevention, flush inline style.
%   Block/margin styles flush later in \AfterEndEnvironment.
%   Delegates to the rendering hook point.
\def\codep@hooktheorem@preparebackref#1{%
  \codep@render@thm@preparebackref{#1}%
}%

% \codep@hooktheorem@end@outer{envname}
%   Outermost-end logic: record, backref, atom-state cleanup,
%   adjacency flag.  Delegates heavy lifting to helpers.
\def\codep@hooktheorem@end@outer#1{%
  \codep@hooktheorem@record{#1}%
  \codep@hooktheorem@preparebackref{#1}%
  % §8a.5 atom-end clear of the in-atom sentinel.
  \let\codep@currentatom\@empty
  \let\codep@currenttype\@empty
  \global\advance\codep@trackedlevel by -1\relax
  \advance\codep@nestlevel by -1\relax
  \ifnum\codep@nestlevel=0\relax
    \boolfalse{codep@intheorem}%
  \fi
  % Set adjacency flag for proof inheritance.
  % Stores the prefixed key (envname:X) for proof adjacency.
  \global\edef\codep@lasttheorematom{\codep@outeratom}%
}

% \codep@hooktheorem@end{envname}
%   End-hook body: restate dispatch to nested vs outer.
\def\codep@hooktheorem@end#1{%
  \expandafter\ifx\csname c@\codep@basecounter\endcsname\c@atom
    % Original occurrence: normal end body.
    \ifnum\codep@trackedlevel>1\relax
      % Nested end: skip SBL/backref, just decrement.
      \global\advance\codep@trackedlevel by -1\relax
      \advance\codep@nestlevel by -1\relax
    \else
      % Outermost end: delegate to \codep@hooktheorem@end@outer.
      \codep@hooktheorem@end@outer{#1}%
    \fi
  \else
    % Restate end: restore currentatom from the stack, then
    % decrement nestlevel (LIFO order per §8a.5.a).
    \codep@popcurrentatom
    \advance\codep@nestlevel by -1\relax
  \fi
}

% \codep@hooktheorem@afterend{envname}
%   After-end-environment body: block/margin backref flush.
%   Timing depends on backref-style:
%   - inline: flushed EARLY in cmd/end#1/before (inside the env
%     body, in hmode, before amsthm's \popQED/endmark mechanism)
%     so "Used in" flows on the same line as content.
%   - block/margin: flush AFTER the env fully closes
%     (\AfterEndEnvironment, vmode) so "Used in" renders after
%     endmarks and QED symbols.
%   For restatable re-fires (which call \theorem/\endtheorem
%   directly, bypassing \begin/\end), neither hook fires —
%   correct, since the restate guard already skipped backref
%   queueing in the cmd/end hook above.
%   Inline style: already flushed in cmd/end#1/before (above),
%   so this is a no-op for inline.
%   Anti-orphan: \codep@preventorphan (called in
%   \codep@hooktheorem@preparebackref) ensures \endtrivlist
%   cannot introduce a page break before the "Used in" line.
\def\codep@hooktheorem@afterend#1{%
  \codep@render@thm@afterend{#1}%
}

% Thin orchestrator: wire the named helpers into the four hook points.
\newcommand*{\codep@hooktheorem}[1]{%
  \AddToHook{cmd/#1/before}{\codep@hooktheorem@begin{#1}}%
  \AddToHook{cmd/#1/after}{\codep@hooktheorem@after{#1}}%
  \AddToHook{cmd/end#1/before}{\codep@hooktheorem@end{#1}}%
  \AfterEndEnvironment{#1}{\codep@hooktheorem@afterend{#1}}%
}

% \codep@hookproof
%   Install hooks for the proof environment.
%   When proofs=on (default), adjacent proofs inherit the
%   preceding theorem's atom number with a star suffix (e.g.
%   "2.1*").  Non-adjacent proofs (no preceding theorem, or
%   an intervening paragraph) fall back to their own atom
%   number with a warning (if proof-warnings=on).
%   Standalone proofs defer margin emission to para/begin so
%   the number appears on the "Proof." line, not on a
%   separate line.
%   Delegates to:
%     \codep@hookproof@begin     — begin dispatch
%     \codep@proof@standalone    — non-adjacent proof path
%     \codep@proof@adjacent      — adjacent proof path
%     \codep@hookproof@end       — end cleanup
%     \codep@hookproof@afterend  — block/margin flush
\newcommand*{\codep@hookproof}{%
  \@ifundefined{proof}{}{%
    \AtBeginEnvironment{proof}{\codep@hookproof@begin}%
    \AtEndEnvironment{proof}{\codep@hookproof@end}%
    \AfterEndEnvironment{proof}{\codep@hookproof@afterend}%
  }%
}

% \codep@hookproof@begin
%   Begin dispatch for proof environment.
%   4-way branch: proofs off / inside tracked / standalone
%   non-adjacent / standalone adjacent.
\newcommand*{\codep@hookproof@begin}{%
  \ifbool{codep@proofsnumbered}{%
    \ifnum\codep@nestlevel>0\relax
      % Inside a tracked env: just suppress.
      \advance\codep@nestlevel by 1\relax
    \else
      % Standalone proof: check adjacency.
      \ifx\codep@lasttheorematom\@empty
        \codep@proof@standalone
      \else
        \codep@proof@adjacent
      \fi
    \fi
  }{%
    % proofs=off: just suppress paragraph numbering.
    \advance\codep@nestlevel by 1\relax
  }%
}

% \codep@proof@standalone
%   Non-adjacent proof path: own atom, proofof label, warning.
%   No preceding theorem — fallback to own atom number.
\newcommand*{\codep@proof@standalone}{%
  \refstepcounter{atom}%
  \codep@writeanchormap{proof:\theatom}%
  \advance\codep@nestlevel by 1\relax
  \edef\codep@currentatom{proof:\theatom}%
  \def\codep@currenttype{proof}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\theatom}{proof}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\theatom}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  \codep@registeratom{proof:\theatom}{proof}%
  \codep@render@queuebackref{proof:\theatom}%
  \ifbool{codep@proofwarnings}{%
    \PackageWarning{codependent}{Proof not adjacent to a tracked
      environment; assigned independent atom number \theatom}%
  }{}%
}

% \codep@proof@adjacent
%   Adjacent proof path: inherit lasttheorematom with proof: prefix.
%   \codep@lasttheorematom is envname:X; extract X, build proof:X.
\newcommand*{\codep@proof@adjacent}{%
  \advance\codep@nestlevel by 1\relax
  % Extract bare number from envname:X.
  \expandafter\codep@splitprefix\codep@lasttheorematom\@nil
  \edef\codep@currentatom{proof:\codep@tmp@num}%
  \def\codep@currenttype{proof}%
  % Override source atom for \codep@writeatomref so
  % that \ref inside this proof writes proof:X (starred display)
  % instead of envname:X (bare \theatom).
  \edef\codep@sourceatom{\codep@currentatom}%
  % Copy theorem's anchor to proof key so hyperlinks resolve.
  % The theorem's anchor is at codep@anchor@<lasttheorematom>;
  % copy it to codep@anchor@proof:X so \codep@brhyper finds it.
  % Guarded: only when the source anchor exists (hyperref loaded).
  \edef\codep@tmp@thmanchor{%
    \expandafter\ifx
        \csname codep@anchor@\codep@lasttheorematom\endcsname\relax
      \noexpand\@empty
    \else
      \csname codep@anchor@\codep@lasttheorematom\endcsname
    \fi}%
  \ifx\codep@tmp@thmanchor\@empty\else
    \expandafter\xdef
      \csname codep@anchor@\codep@currentatom\endcsname
      {\codep@tmp@thmanchor}%
    % Persist the proof→theorem anchor mapping to .aux so that
    % backrefs rendered BEFORE this proof (earlier in the document)
    % can resolve the hyperlink on the next pass.
    \if@filesw
      \protected@write\@auxout{}{%
        \string\codep@anchormap{\codep@currentatom}%
          {\codep@tmp@thmanchor}}%
    \fi
  \fi
  \global\let\codep@lasttheorematom\@empty
  % SBL sub-record for the inherited proof.
  % .cdp records use bare display form (X*) for the proof atom.
  \codep@cdpwrite@atom{%
    \string\codep@cdp@proof{\codep@tmp@num*}}%
  % No \refstepcounter -- inheriting the theorem's number.
  % No margin number -- proof shares theorem's visual
  % identity; the proof heading ("Proof.") is sufficient.
  % No atomcount append -- proof is not a separate atom.
  \codep@render@queuebackref{\codep@currentatom}%
}

% \codep@hookproof@end
%   End cleanup: clear currentatom, sourceatom, rendering,
%   decrement nestlevel.
%   Rendering (inline flush / orphan prevention) delegated to hook.
\newcommand*{\codep@hookproof@end}{%
  \ifbool{codep@proofsnumbered}{%
    % §8a.5 atom-end clear of the in-atom sentinel.
    \let\codep@currentatom\@empty
    \let\codep@currenttype\@empty
    % Clear source atom override (adjacent proof path).
    \let\codep@sourceatom\@empty
    % Rendering: inline flush or orphan prevention.
    \codep@render@proof@end
  }{}%
  \advance\codep@nestlevel by -1\relax
}

% \codep@hookproof@afterend
%   Block/margin style: flush after env closes (vmode, after QED).
%   Delegates to the rendering hook point.
\newcommand*{\codep@hookproof@afterend}{%
  \codep@render@proof@afterend
}

%% ===================================================================
%% Section 7: Paragraph numbering
%% ===================================================================

% \codep@emitmargin{number}
%   Typeset a superscript atom number in the left margin.
\newcommand*{\codep@emitmargin}[1]{%
  \leavevmode%
  \smash{%
    \llap{%
      {\codep@marginfont\textsuperscript{#1}\kern0.5em}%
    }%
  }%
}

% \codep@suppressenv{envname}
%   Increment nestlevel on entry, decrement on exit.
\newcommand*{\codep@suppressenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \advance\codep@nestlevel by 1\relax
  }%
  \AtEndEnvironment{#1}{%
    \advance\codep@nestlevel by -1\relax
  }%
}

%% --- Equation backref tracking (two-track design) ---
%% Track 1: single-number environments (equation).
%% Track 2: multi-number environments (align, gather, multline, flalign).

% \codep@eqshouldtrack
%   Set \codep@eqatom to a non-empty sentinel if equation tracking
%   should proceed, empty if suppressed by the current mode.
%   Early-return structure: off → false; outer+intheorem → false;
%   otherwise → true.
\newcommand*{\codep@eqshouldtrack}{%
  \def\codep@eqatom{}%
  \ifx\codep@equationmode\codep@const@off
  \else\ifx\codep@equationmode\codep@const@outer
    \ifbool{codep@intheorem}{}{\def\codep@eqatom{pending}}%
  \else
    \def\codep@eqatom{pending}%
  \fi\fi
}

% \codep@trackeqenv{envname}
%   Track 1: single-number equation environments.
%   \theequation is correct at \ref time (counter steps at \begin).
%   Suppresses paragraph numbering and sets the equation flag.
\newcommand*{\codep@trackeqenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \advance\codep@nestlevel by 1\relax
    \booltrue{codep@inequation}%
    \boolfalse{codep@eqmultiline}%
  }%
  \AtEndEnvironment{#1}{%
    \advance\codep@nestlevel by -1\relax
    \boolfalse{codep@inequation}%
    \def\codep@eqatom{}%
  }%
}

% \codep@trackalignenv{envname}
%   Track 2: multi-number equation environments (align, gather, etc.).
%   \theequation is stale at \ref time (counter steps at \\).
%   Saves the equation counter at \begin, defers \ref targets to a
%   pending list, and computes the range at \end.
%
%   Timing: the equation counter for the LAST numbered line is
%   stepped during \end<env> (amsmath processes the final row
%   there), AFTER \AtEndEnvironment fires but BEFORE
%   \AfterEndEnvironment fires.  The flush therefore runs in
%   \AfterEndEnvironment to see the final counter value.
%   Nestlevel/flag cleanup stays in \AtEndEnvironment (LOCAL
%   to the group) so it is undone together with the increment;
%   putting it in \AfterEndEnvironment would fire OUTSIDE the
%   group, after TeX has already undone the local +1, pushing
%   nestlevel to -1.
\newcommand*{\codep@trackalignenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \advance\codep@nestlevel by 1\relax
    \booltrue{codep@inequation}%
    \booltrue{codep@eqmultiline}%
    % Save counter for range computation.
    \global\codep@eq@startcount=\c@equation\relax
    % Clear pending list.
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
    % Inject a dedicated hypertarget for the block anchor.
    % \@currentHref at \end is stale (points to last row's anchor).
    % Use \xdef so the anchor name survives group boundaries
    % (needed at \AfterEndEnvironment flush time).
    \@ifpackageloaded{hyperref}{%
      \xdef\codep@eq@anchor{codep.eq.\the\c@equation}%
      \Hy@raisedlink{%
        \hyper@anchorstart{\codep@eq@anchor}\hyper@anchorend}%
    }{}%
  }%
  \AtEndEnvironment{#1}{%
    \advance\codep@nestlevel by -1\relax
    \boolfalse{codep@inequation}%
    \boolfalse{codep@eqmultiline}%
    \def\codep@eqatom{}%
  }%
  \AfterEndEnvironment{#1}{%
    % Flush ONLY — all state cleanup already done above.
    % The flush stays here because amsmath steps the last row's
    % counter during \endalign, which runs between \AtEndEnvironment
    % and \AfterEndEnvironment.  The range computation needs the
    % final counter value.
    \ifnum\codep@eqpendingcount>0\relax
      \codep@flusheqrange
    \fi
  }%
}

% \codep@dedupwrite{src}{tgt}
%   Per-(source, target) dedup write.  If the csname flag
%   codep@arw@<src>@<tgt> is undefined (\relax), set it to
%   \@empty and write \codep@atomref{src}{tgt} to the .aux
%   file.  Otherwise skip (already written this run).
\def\codep@dedupwrite#1#2{%
  \expandafter\ifx
      \csname codep@arw@#1@#2\endcsname\relax
    \global\expandafter\let
      \csname codep@arw@#1@#2\endcsname\@empty
    \protected@write\@auxout{}{%
      \string\codep@atomref{#1}{#2}}%
  \fi
}

% \codep@flusheqrange@numbered
%   Numbered-line path: counter advanced, so compute the
%   equation range, write the anchormap entry, and flush
%   all pending refs with dedup.
\def\codep@flusheqrange@numbered{%
  % Compute formatted start: saved+1 in a group.
  \begingroup
    \c@equation=\codep@eq@startcount\relax
    \advance\c@equation by 1\relax
    \xdef\codep@tmp@eqstart{\theequation}%
  \endgroup
  \edef\codep@tmp@eqend{\theequation}%
  % Build the equation:-prefixed key; display renders as (N) or (N--M).
  \ifx\codep@tmp@eqstart\codep@tmp@eqend
    % Single numbered line: equation:N
    \edef\codep@eqatom{equation:\codep@tmp@eqstart}%
  \else
    % Range: equation:N--M
    \edef\codep@eqatom{equation:\codep@tmp@eqstart--\codep@tmp@eqend}%
  \fi
  % Write anchormap entry using dedicated block anchor.
  \@ifpackageloaded{hyperref}{%
    \expandafter\xdef
      \csname codep@anchor@\codep@eqatom\endcsname
      {\codep@eq@anchor}%
    \if@filesw
      \protected@write\@auxout{}{%
        \string\codep@anchormap{\codep@eqatom}{\codep@eq@anchor}}%
    \fi
  }{}%
  % Flush all pending refs (with dedup).
  \if@filesw
    \def\codep@eqpending@entry##1{%
      \codep@dedupwrite{\codep@eqatom}{##1}%
    }%
    \the\codep@eqpending
  \fi
}

% \codep@flusheqrange@fallback
%   All-notag path: counter didn't advance, so fall through
%   to the containing atom (if any) for pending refs.
\def\codep@flusheqrange@fallback{%
  \ifx\codep@currentatom\@empty\else
    \if@filesw
      % Construct prefixed source from \codep@sourceatom
      % (already prefixed) or \codep@currenttype:\theatom.
      \ifx\codep@sourceatom\@empty
        \edef\codep@tmp@srcatom{\codep@currenttype:\theatom}%
      \else
        \edef\codep@tmp@srcatom{\codep@sourceatom}%
      \fi
      \def\codep@eqpending@entry##1{%
        \codep@dedupwrite{\codep@tmp@srcatom}{##1}%
      }%
      \the\codep@eqpending
    \fi
  \fi
}

% \codep@flusheqrange
%   Compute the equation range and flush all pending refs.
%   Called at \end{align} (Track 2).  Dispatches to
%   \codep@flusheqrange@numbered or @fallback.
\def\codep@flusheqrange{%
  % Check equation mode.
  \codep@eqshouldtrack
  \ifx\codep@eqatom\@empty
    % Mode says don't track; silently drop pending refs.
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
  \else
    % Check if counter advanced (at least one numbered line).
    \ifnum\c@equation>\codep@eq@startcount\relax
      \codep@flusheqrange@numbered
    \else
      \codep@flusheqrange@fallback
    \fi
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
  \fi
}

% \codep@suppresscmd{command}
%   Patch a command to suppress numbering in its body.
\newcommand*{\codep@suppresscmd}[1]{%
  \pretocmd{#1}{\advance\codep@nestlevel by 1\relax}{}{}%
  \apptocmd{#1}{\advance\codep@nestlevel by -1\relax}{}{}%
}

% \codep@installsuppress
%   Hook suppression for standard environments.
\newcommand*{\codep@installsuppress}{%
  \codep@suppressenv{enumerate}%
  \codep@suppressenv{itemize}%
  \codep@suppressenv{description}%
  \codep@suppressenv{quote}%
  \codep@suppressenv{quotation}%
  \codep@suppressenv{figure}%
  \codep@suppressenv{table}%
  \codep@suppressenv{minipage}%
  \codep@suppressenv{tabular}%
  \codep@suppressenv{tabularx}%
  \codep@suppressenv{longtable}%
  \codep@suppressenv{trivlist}%
  % Numbered equation environments.
  % Track 1: single-number (counter steps at \begin).
  \codep@trackeqenv{equation}%
  % Track 2: multi-number (counter steps at \\).
  \codep@trackalignenv{align}%
  \codep@trackalignenv{gather}%
  \codep@trackalignenv{multline}%
  \codep@trackalignenv{flalign}%
  % Unnumbered/display-only: suppress paragraphs only.
  \codep@suppressenv{equation*}%
  \codep@suppressenv{displaymath}%
  \codep@suppressenv{align*}%
  \codep@suppressenv{gather*}%
  \codep@suppressenv{multline*}%
  \codep@suppressenv{flalign*}%
}

% \codep@suppresssectioning
%   Suppress atom numbering for sectioning heading paragraphs.
%   Uses LaTeX 2021+ generic cmd/<level>/before hooks, which
%   fire universally across standard classes, KOMA-Script,
%   memoir, and titlesec (unlike the old \@startsection wrapper
%   which was a no-op under those packages).
\newcommand*{\codep@suppresssectioning}{%
  \AddToHook{cmd/section/before}[codependent/sectioning]{%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/subsection/before}[codependent/sectioning]{%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/subsubsection/before}[codependent/sectioning]{%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/chapter/before}[codependent/sectioning]{%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/paragraph/before}[codependent/sectioning]{%
    \global\booltrue{codep@sectioning}}%
  \AddToHook{cmd/subparagraph/before}[codependent/sectioning]{%
    \global\booltrue{codep@sectioning}}%
}

% \codep@capturesectitle
%   Intercept \addcontentsline to capture section titles for
%   appendix-mode section grouping.  When a {toc}{section}
%   entry is written, extract the title (stripping \numberline)
%   and store it in \codep@cursecnum / \codep@cursectitle.
%   Only active in appendix mode.
\newcommand*{\codep@capturesectitle}{%
  \ifbool{codep@appendix}{%
    \let\codep@orig@addcontentsline\addcontentsline
    \renewcommand{\addcontentsline}[3]{%
      \codep@orig@addcontentsline{##1}{##2}{##3}%
      \codep@checktocsection{##1}{##2}{##3}%
    }%
  }{}%
}%
% \codep@checktocsection{file}{type}{entry}
%   If file=toc and type=section, extract the section number
%   and title from the entry.  Uses \thesection for the number
%   (guaranteed correct since \refstepcounter has already run)
%   and strips \numberline from the entry via controlled \edef
%   to recover the bare title text.
\def\codep@checktocsection#1#2#3{%
  \def\codep@tmp@a{#1}\def\codep@tmp@b{toc}%
  \ifx\codep@tmp@a\codep@tmp@b
    \def\codep@tmp@a{#2}\def\codep@tmp@b{section}%
    \ifx\codep@tmp@a\codep@tmp@b
      \codep@extractsectitle{#3}%
    \fi
  \fi
}%
% \codep@extractsectitle{entry}
%   Extract the bare title from a TOC entry by redefining
%   \numberline to absorb its argument and \edef-expanding
%   the entry with \protect neutralised.
\def\codep@extractsectitle#1{%
  \begingroup
    \let\protect\@empty
    \def\numberline##1{}%
    \edef\codep@tmp{#1}%
    \global\let\codep@tmp@result\codep@tmp
  \endgroup
  \xdef\codep@cursecnum{\thesection}%
  \global\let\codep@cursectitle\codep@tmp@result
  \global\expandafter\let%
    \csname codep@sectitle@\thesection\endcsname\codep@tmp@result
}%

% Auto-suppress enumitem \newlist environments.
%   When enumitem is loaded, wraps \newlist so that every
%   user-defined list environment is automatically registered
%   for paragraph-number suppression.
\AddToHook{begindocument/before}[codependent/suppress/enumitem]{%
  \@ifpackageloaded{enumitem}{%
    \let\codep@orig@newlist\newlist
    \def\newlist#1#2#3{%
      \codep@orig@newlist{#1}{#2}{#3}%
      \codep@suppressenv{#1}%
    }%
  }{}%
}

% Auto-suppress tcolorbox / mdframed environments.
%   Conditionally suppresses boxed-content environments when
%   the respective package is loaded.
\AddToHook{begindocument/before}[codependent/suppress/boxes]{%
  \@ifpackageloaded{tcolorbox}{%
    \codep@suppressenv{tcolorbox}%
  }{}%
  \@ifpackageloaded{mdframed}{%
    \codep@suppressenv{mdframed}%
  }{}%
}

% \codep@suppresscommands
%   Suppress numbering inside footnote, parbox.
%   Note: \caption is NOT patched here because its complex
%   calling convention (\@ifstar + optional arg) makes
%   etoolbox patching unreliable.  Captions appear only
%   inside figure/table environments, which are already
%   suppressed at the env level.
\newcommand*{\codep@suppresscommands}{%
  \codep@suppresscmd{\footnote}%
  \codep@suppresscmd{\parbox}%
  \codep@suppresscmd{\maketitle}%
}

% \codep@parahook@emitdeferred
%   Emit the deferred backref from the previous paragraph, if any.
%   Uses \vadjust pre to inject the "Used in X." line above the
%   current paragraph's first line (end of previous output box)
%   without a horizontal-mode change.  Clears the register after
%   emission.  Called from \codep@installparahook.
\def\codep@parahook@emitdeferred{%
  \ifx\codep@deferredbr\@empty\else
    \vadjust pre{%
      \codep@renderbackref@para{\codep@deferredbr}%
    }%
    \global\let\codep@deferredbr\@empty
  \fi
}%

% \codep@parahook@paragraph
%   Paragraph numbering body for a normal (non-suppressed) paragraph.
%   Increments the atom counter, writes anchormap and SBL records,
%   updates the atom queue, emits the margin label, and queues the
%   backref.  Only runs when codep@paragraphs is true.
%   Called from \codep@installparahook.
\def\codep@parahook@paragraph{%
  \ifbool{codep@paragraphs}{%
    \refstepcounter{atom}%
    \codep@writeanchormap{paragraph:\theatom}%
    \edef\codep@currentatom{paragraph:\theatom}%
    \def\codep@currenttype{paragraph}%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@atom
        {\theatom}{paragraph}}%
    \codep@cdpwrite@atom{%
      \string\codep@cdp@meta{\theatom}{src}%
        {\jobname.tex:\the\inputlineno:1}}%
    \codep@registeratom{paragraph:\theatom}{paragraph}%
    \codep@render@para@emit{\codep@currentatom}{\theatom}%
  }{}%
}%

% \codep@installparahook
%   Install the para/begin hook for paragraph numbering.
%   Guard chain (outermost -> innermost):
%   1. codep@tracked: hook is active at all
%   2. codep@sectioning: one-shot skip for heading paragraphs
%   3. codep@nestlevel > 0: inside a suppressed env/command
%   Deferred backref emission and proof-adjacency reset are
%   unconditional under codep@tracked (delegated to helpers).
\newcommand*{\codep@installparahook}{%
  \AddToHook{para/begin}{%
    \ifbool{codep@tracked}{%
      \codep@render@para@emitdeferred
      % Clear proof adjacency flag on any top-level paragraph.
      % A paragraph between a theorem and a proof means the
      % proof is not adjacent and must get its own atom number.
      \ifnum\codep@nestlevel=0\relax
        \global\let\codep@lasttheorematom\@empty
      \fi
      % Sectioning heading paragraph: skip entirely.
      \ifbool{codep@sectioning}{%
        \global\boolfalse{codep@sectioning}%
      }{%
        % Normal paragraph (not suppressed).
        \ifnum\codep@nestlevel>0\relax\else
          \codep@parahook@paragraph
        \fi
      }%
    }{}%
  }%
}

