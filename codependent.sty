% \codep@autoproofof@allocateunresref{macro}
%   Allocate one unresolved-reference source key.
%% @implements \codep@hookproof
\def\codep@autoproofof@allocateunresref#1{%
  \global\advance\codep@autoproofof@unresrefcount by 1\relax%
  \edef#1{unresref:\the\codep@autoproofof@unresrefcount}%
}%

% \codep@autoproofof@ensureunresref{macro}
%   Allocate at most one provisional source key for this heading scan.
%% @implements \codep@hookproof
\def\codep@autoproofof@ensureunresref#1{%
  \ifx\codep@autoproofof@provkey\@empty%
    \codep@autoproofof@allocateunresref{\codep@autoproofof@provkey}%
  \fi%
  \let#1\codep@autoproofof@provkey%
}%

% \codep@autoproofof@markheadsuppress{label}
%   Suppress the ordinary ref-edge produced by proof optional-heading
%   typesetting; the proof attribution resolver writes the semantic edge.
%% @utility
\def\codep@autoproofof@markheadsuppress#1{%
  \expandafter\ifx%
      \csname codep@autoproofof@headsuppress@#1\endcsname\relax%
    \count@=0\relax%
  \else%
    \count@=\csname codep@autoproofof@headsuppress@#1\endcsname\relax%
  \fi%
  \advance\count@ by 1\relax%
  \expandafter\xdef\csname codep@autoproofof@headsuppress@#1\endcsname{%
    \the\count@}%
}%

% \codep@autoproofof@ifheadsuppressed{label}{then}{else}
%   Consume one heading-suppression ticket for label, if present.
%% @utility
\def\codep@autoproofof@ifheadsuppressed#1#2#3{%
  \expandafter\ifx%
      \csname codep@autoproofof@headsuppress@#1\endcsname\relax%
    #3%
  \else%
    \count@=\csname codep@autoproofof@headsuppress@#1\endcsname\relax%
    \ifnum\count@>0\relax%
      \advance\count@ by -1\relax%
      \expandafter\xdef\csname codep@autoproofof@headsuppress@#1\endcsname{%
        \the\count@}%
      #2%
    \else%
      #3%
    \fi%
  \fi%
}%

% \codep@autoproofof@routeforward{label}
%   Queue an unresolved heading label through the proof-ref drain rail.
%% @behavior B-PROOF-UNRESREF
\def\codep@autoproofof@routeforward#1{%
  \def\codep@tmp@autoproofofshoulddefer{1}%
  \expandafter\ifx\csname codep@lblentity@#1\endcsname\relax%
    \expandafter\ifx\csname codep@lblnum@#1\endcsname\relax%
    \else%
      \let\codep@tmp@autoproofofshoulddefer\@empty%
    \fi%
  \fi%
  \ifx\codep@tmp@autoproofofshoulddefer\@empty%
  \else%
    \codep@autoproofof@ensureunresref{\codep@tmp@autoproofofprov}%
    \ifcodep@proofdisplaypending%
      \codep@atomsetkey{\codep@currentproofid}{\codep@tmp@autoproofofprov}%
      \global\codep@proofdisplaypendingfalse%
      \global\codep@autoproofof@eligiblefalse%
      \global\let\codep@pendingproofbind\@empty%
      \codep@proof@adjcandidate@drop{\codep@currentproofid}%
    \fi%
    \edef\codep@tmp@autoproofofdefer{%
      \noexpand\codep@defer@proofof{\noexpand\codep@autoproofof@resolve}%
        {\codep@currentproofid}{\unexpanded{#1}}%
        {\codep@tmp@autoproofofprov}}%
    \codep@tmp@autoproofofdefer%
  \fi%
}%

% \codep@autoproofof@dispatchlabel{label}
%   Resolve same-run heading labels now; otherwise allocate and defer.
%% @implements \codep@hookproof
\def\codep@autoproofof@dispatchlabel#1{%
  \ifx\codep@currentproofid\@empty%
  \else%
    \codep@autoproofof@markheadsuppress{#1}%
    \codep@subsystem@recordtotal{proofof}%
    \expandafter\ifx\csname codep@lblentity@samerun@#1\endcsname\relax%
      % see @behavior B-PROOF-UNRESREF at
      % \codep@autoproofof@routeforward.
      \codep@autoproofof@routeforward{#1}%
    \else%
      \codep@autoproofof@resolve{\codep@currentproofid}{#1}{}%
    \fi%
  \fi%
}%

% \codep@autoproofof@scan{heading}
%   Scan a proof heading and route each supported label independently.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan#1{%
  \codep@autoproofof@reset%
  \codep@autoproofof@scan@tokens#1\codep@autoproofof@stop%
  \@for\codep@tmp@autoproofoflabel:=\codep@autoproofof@pendinglist\do{%
    \ifx\codep@tmp@autoproofoflabel\@empty\else%
      \expandafter\codep@autoproofof@dispatchlabel\expandafter{%
        \codep@tmp@autoproofoflabel}%
    \fi%
  }%
  \codep@autoproofof@reset%
}%

% \codep@proofof@attribcount@get{proof-id}{macro}
%   Return the number of successful proof-attribution resolutions
%   already performed for proof-id.
%% @utility
\def\codep@proofof@attribcount@get#1#2{%
  \codep@proof@identitykey{#1}{\codep@tmp@attribproofkey}%
  \codep@prooftargetmeta@getcount{\codep@tmp@attribproofkey}{#2}%
  \ifnum#2>0\relax%
  \else%
    \expandafter\ifx%
        \csname codep@proofof@attribcount@#1\endcsname\relax%
      \def#2{0}%
    \else%
      \edef#2{\csname codep@proofof@attribcount@#1\endcsname}%
    \fi%
  \fi%
}%

% \codep@proofof@attribcount@advance{proof-id}
%   Mark one successful proof-attribution resolution for proof-id.
%% @implements \codep@proofof@resolve
\def\codep@proofof@attribcount@advance#1{%
  \codep@proofof@attribcount@get{#1}{\codep@tmp@proofofcount}%
  \count@=\codep@tmp@proofofcount\relax%
  \advance\count@ by 1\relax%
  \expandafter\xdef\csname codep@proofof@attribcount@#1\endcsname{%
    \the\count@}%
}%

% \codep@proofof@attribcount@clear{proof-id}
%   Clear per-proof attribution count when the proof scope closes.
%% @implements \codep@hookproof@end
\def\codep@proofof@attribcount@clear#1{%
  \global\expandafter\let%
    \csname codep@proofof@attribcount@#1\endcsname\relax%
}%

% \codep@proofof@capturejointmeta{proof-id}{proof-key}
%   Preserve entity metadata for a non-final proof key when a later
%   explicit proof attribution joins the proof to another target.  The
%   keymap rail is deliberately skipped for joint attribution, so each
%   proof key needs its own parent metadata for source-token rendering.
%% @behavior B-PROOF-JOINT
\def\codep@proofof@capturejointmeta#1#2{%
  \expandafter\let\expandafter\codep@tmp@jointparent%
    \csname codep@proofparent@#1\endcsname%
  \ifx\codep@tmp@jointparent\relax%
    \let\codep@tmp@jointparent\@empty%
  \fi%
  \ifx\codep@tmp@jointparent\@empty\else%
    \expandafter\codep@splitprefix#2\@nil%
    \codep@captureentitymeta{#2}{proof}{\codep@tmp@num}{proof}%
      {\codep@tmp@jointparent}%
  \fi%
}%

% \codep@autoproofof@markseen{envname}
%   Mark that the patched optional-heading body ran for this proof.
%% @implements \codep@hookproof
\def\codep@autoproofof@markseen#1{%
  \ifx\codep@currentproofid\@empty\else%
    \expandafter\gdef\csname codep@autoproofof@seen@%
      \codep@currentproofid\endcsname{1}%
  \fi%
}%

% \codep@autoproofof@warnclobbered{envname}
%   Warn once when a proof redefinition removes the heading patch.
%% @implements \codep@hookproof
\def\codep@autoproofof@warnclobbered#1{%
  \@ifundefined{codep@autoproofof@warned@#1}{%
    \PackageWarning{codependent}{Automatic proof-heading detection for\space%
      '#1' was disabled by a proof environment redefinition;\space%
      use explicit \string\codepproofof\space for affected proofs}%
    \expandafter\gdef\csname codep@autoproofof@warned@#1\endcsname{1}%
  }{}%
}%

% \codep@autoproofof@checkseen{envname}{proof-id}
%   Verify that the patched optional-heading body survived to this proof.
%% @implements \codep@hookproof
\def\codep@autoproofof@checkseen#1#2{%
  \expandafter\ifx\csname codep@autoproofof@seen@#2\endcsname\relax%
    \codep@autoproofof@warnclobbered{#1}%
  \else%
    \global\expandafter\let%
      \csname codep@autoproofof@seen@#2\endcsname\@undefined%
  \fi%
}%

% \codep@autoproofof@heading{envname}{heading}
%   Entry point prepended to proof's internal optional-heading body.
%% @implements \codep@hookproof
\def\codep@autoproofof@heading#1#2{%
  \codep@autoproofof@markseen{#1}%
  \ifcodep@autoproofof@eligible%
    \codep@autoproofof@scan{#2}%
    \codep@proof@adjacent@finalize%
    \global\codep@autoproofof@eligiblefalse%
  \fi%
  \codep@proof@captureheadinganchor{\codep@currentproofid}%
}%

\begingroup
  \catcode`\#=12
  % \codep@autoproofof@install@proof
  %   Patch proof's generated optional-argument body under catcode-12 #.
  %% @implements \codep@hookproof
  \gdef\codep@autoproofof@install@proof{%
    \@ifundefined{proof}{}{%
      \expandafter\pretocmd\csname\string\proof\endcsname{%
        \codep@autoproofof@heading{proof}{#1}%
      }{}{%
        \PackageWarning{codependent}{Automatic proof-heading detection\space%
          unavailable: could not patch proof's optional-heading body;\space%
          use explicit \string\codepproofof\space for separated proofs}%
        \expandafter\gdef%
          \csname codep@autoproofof@warned@proof\endcsname{1}%
      }%
    }%
  }%
\endgroup
\AtBeginDocument{%
  \global\codep@autoproofof@unresrefcount=0\relax%
  \codep@autoproofof@install@proof%
}

%% @implements \codep@hookproof@begin
% \codep@proofstatesave{proof-id}
%   Save the outer proof state under the nested proof-id.
\def\codep@proofstatesave#1{%
  \expandafter\xdef\csname codep@savedproofid@#1\endcsname{%
    \codep@currentproofid}%
  \ifcodep@proofdisplaypending%
    \expandafter\gdef\csname codep@savedproofpending@#1\endcsname{1}%
  \else%
    \expandafter\gdef\csname codep@savedproofpending@#1\endcsname{0}%
  \fi%
  \ifcodep@autoproofof@eligible%
    \expandafter\gdef\csname codep@savedproofautoeligible@#1\endcsname{1}%
  \else%
    \expandafter\gdef\csname codep@savedproofautoeligible@#1\endcsname{0}%
  \fi%
  \ifcodep@proof@adjcommit@needed%
    \expandafter\gdef\csname codep@savedproofadjcommit@#1\endcsname{1}%
  \else%
    \expandafter\gdef\csname codep@savedproofadjcommit@#1\endcsname{0}%
  \fi%
  \expandafter\xdef\csname codep@savedproofbind@#1\endcsname{%
    \codep@pendingproofbind}%
  \expandafter\xdef\csname codep@savedproofadjkey@#1\endcsname{%
    \codep@proofadj@pendinganchormapkey}%
  \expandafter\xdef\csname codep@savedproofadjanchor@#1\endcsname{%
    \codep@proofadj@pendinganchormapanchor}%
  \global\codep@proofneststack=\expandafter{%
    \the\codep@proofneststack{\codep@currentproofid}}%
}%

%% @implements \codep@hookproof@end
% \codep@proofstaterestore{proof-id}
%   Restore any outer proof state saved under proof-id.
\def\codep@proofstaterestore#1{%
  \expandafter\ifx\csname codep@savedproofid@#1\endcsname\relax%
    \global\let\codep@currentproofid\@empty%
    \codep@pendingproofbind@checkoverwrite%
    \global\let\codep@pendingproofbind\@empty%
    \global\codep@proofdisplaypendingfalse%
    \global\codep@autoproofof@eligiblefalse%
    \global\codep@proof@adjcommit@neededfalse%
    \global\let\codep@proofadj@pendinganchormapkey\@empty%
    \global\let\codep@proofadj@pendinganchormapanchor\@empty%
  \else%
    \global\expandafter\let\expandafter\codep@currentproofid%
      \csname codep@savedproofid@#1\endcsname%
    \edef\codep@tmp@proofpending{%
      \csname codep@savedproofpending@#1\endcsname}%
    \def\codep@tmp@proofone{1}%
    \ifx\codep@tmp@proofpending\codep@tmp@proofone%
      \global\codep@proofdisplaypendingtrue%
    \else%
      \global\codep@proofdisplaypendingfalse%
    \fi%
    \edef\codep@tmp@proofautoeligible{%
      \csname codep@savedproofautoeligible@#1\endcsname}%
    \ifx\codep@tmp@proofautoeligible\codep@tmp@proofone%
      \global\codep@autoproofof@eligibletrue%
    \else%
      \global\codep@autoproofof@eligiblefalse%
    \fi%
    \edef\codep@tmp@proofadjcommit{%
      \csname codep@savedproofadjcommit@#1\endcsname}%
    \ifx\codep@tmp@proofadjcommit\codep@tmp@proofone%
      \global\codep@proof@adjcommit@neededtrue%
    \else%
      \global\codep@proof@adjcommit@neededfalse%
    \fi%
    \global\expandafter\let\expandafter\codep@pendingproofbind%
      \csname codep@savedproofbind@#1\endcsname%
    \global\expandafter\let\expandafter%
      \codep@proofadj@pendinganchormapkey%
      \csname codep@savedproofadjkey@#1\endcsname%
    \global\expandafter\let\expandafter%
      \codep@proofadj@pendinganchormapanchor%
      \csname codep@savedproofadjanchor@#1\endcsname%
    \global\expandafter\let%
      \csname codep@savedproofid@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofpending@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofautoeligible@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofadjcommit@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofbind@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofadjkey@#1\endcsname\@undefined%
    \global\expandafter\let%
      \csname codep@savedproofadjanchor@#1\endcsname\@undefined%
  \fi%
}%

%% @behavior B-PROOF-OFF
%% @behavior B-PROOF-INNER
%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-NONADJ
% \codep@hookproof@begin
%   Begin dispatch for proof environments.
\newcommand*{\codep@hookproof@begin}{%
  \codep@closeparagraphifopen%
  \global\codep@autoproofof@eligiblefalse%
  \ifbool{codep@proofsnumbered}{%
    \codep@ctxpeekkind\codep@tmp@ctxkind%
    \def\codep@tmp@proofkind{proof}%
    \ifx\codep@currentproofid\@empty%
      \ifnum\codep@ctxdepth>0\relax%
        \global\codep@autoproofof@eligiblefalse%
        \global\advance\codep@suppressdepth by 1\relax%
      \else\ifnum\codep@suppressdepth>0\relax%
        \global\codep@autoproofof@eligiblefalse%
        \global\advance\codep@suppressdepth by 1\relax%
      \else%
        \codep@allocatomid{\codep@thisproofid}{proof}%
        \xdef\codep@currentproofid{\codep@thisproofid}%
        \codep@proof@setidentity{\codep@currentproofid}%
        \codep@proof@capturebeginpage{\codep@currentproofid}%
        \codep@ctxpush{\codep@currentproofid}{proof}%
        \global\advance\codep@suppressdepth by 1\relax%
        \global\let\codep@proofadj@pendinganchormapkey\@empty%
        \global\let\codep@proofadj@pendinganchormapanchor\@empty%
        \codep@pendingproofbind@checkoverwrite%
        \let\codep@pendingproofbind\@empty%
        \codep@proof@standalone%
        \ifx\codep@pendingresultid\@empty%
        \else%
          \codep@proof@adjacent%
        \fi%
      \fi\fi%
    \else%
      \codep@allocatomid{\codep@thisproofid}{proof}%
      \codep@proofstatesave{\codep@thisproofid}%
      \xdef\codep@currentproofid{\codep@thisproofid}%
      \codep@proof@setidentity{\codep@currentproofid}%
      \codep@proof@capturebeginpage{\codep@currentproofid}%
      \codep@ctxpush{\codep@currentproofid}{proof}%
      \global\advance\codep@suppressdepth by 1\relax%
      \global\let\codep@proofadj@pendinganchormapkey\@empty%
      \global\let\codep@proofadj@pendinganchormapanchor\@empty%
      \codep@pendingproofbind@checkoverwrite%
      \let\codep@pendingproofbind\@empty%
      \codep@proof@standalone%
    \fi%
  }{%
    \global\codep@autoproofof@eligiblefalse%
    \global\advance\codep@suppressdepth by 1\relax%
  }%
}%

%% @behavior B-PROOF-NONADJ
% \codep@proof@standalone
%   Leave the current proof unresolved until fallback or \codepproofof.
\newcommand*{\codep@proof@standalone}{%
  \global\codep@proofdisplaypendingtrue%
  \global\codep@autoproofof@eligibletrue%
  \global\codep@proof@adjcommit@neededfalse%
}%

% Proof-heading anchors are emitted after optional-argument parsing.
% pdfsavepos captures the top of the line box; the visible baseline in
% the default amsthm proof heading is about 3pt lower.  The offset was
% chosen empirically against integ-proof-link-target's 10pt tolerance.
\newdimen\codep@proof@anchoroffset
\codep@proof@anchoroffset=3pt

%% @utility
% \codep@proof@emitanchorname{anchor-name}
%   Emit a zero-size hyperref destination at the current location.
\newcommand*{\codep@proof@emitanchorname}[1]{%
  \@ifpackageloaded{hyperref}{%
    \Hy@raisedlink{\hyper@anchorstart{#1}\hyper@anchorend}%
  }{}%
}%

%% @utility
% \codep@proof@emitheadinganchorname{anchor-name}
%   Emit a proof destination after optional-argument parsing, lowered
%   to match the visible amsthm proof-heading baseline.
\newcommand*{\codep@proof@emitheadinganchorname}[1]{%
  \@ifpackageloaded{hyperref}{%
    \smash{\lower\codep@proof@anchoroffset\hbox{%
      \hyper@anchorstart{#1}\hyper@anchorend}}%
  }{}%
}%

%% @utility
% \codep@proof@beginanchorname{proof-id}{macro}
%   Compute the emitted proof-begin anchor name for proof-id.
%   Adjacent proofs use their resolved proof:N.M key; standalone
%   and not-yet-rebound proofs fall back to the opaque atom id.
\newcommand*{\codep@proof@beginanchorname}[2]{%
  \codep@atomgetkey{#1}{\codep@tmp@proofkey}%
  \ifx\codep@tmp@proofkey\@empty%
    \edef#2{codep-proof:#1}%
  \else%
    \expandafter\codep@splitprefix\codep@tmp@proofkey\@nil%
    \edef#2{codep-proof:\codep@tmp@num}%
  \fi%
}%

%% @behavior B-LINK-PROOF-DEST
%% @behavior B-PROOF-ANCHOR-NEAR-HEADING
% \codep@proof@capturebeginanchor{proof-id}
%   Emit a zero-size proof-begin destination and remember its
%   anchor name for later proof-key binding.
\newcommand*{\codep@proof@capturebeginanchor}[1]{%
  \@ifpackageloaded{hyperref}{%
    \codep@proof@beginanchorname{#1}{\codep@tmp@proofbeginanchor}%
    \codep@proof@emitanchorname{\codep@tmp@proofbeginanchor}%
    \expandafter\xdef\csname codep@proofbeginanchor@#1\endcsname{%
      \codep@tmp@proofbeginanchor}%
  }{}%
}%

%% @implements \codep@proof@capturebeginanchor
% \codep@proof@captureheadinganchor{proof-id}
%   Emit the proof destination after the proof optional argument is parsed.
\newcommand*{\codep@proof@captureheadinganchor}[1]{%
  \def\codep@tmp@headingproofid{#1}%
  \ifx\codep@tmp@headingproofid\@empty\else%
    \expandafter\ifx%
        \csname codep@proofbeginanchor@\codep@tmp@headingproofid\endcsname%
        \relax%
      \@ifpackageloaded{hyperref}{%
        \codep@proof@beginanchorname{\codep@tmp@headingproofid}{%
          \codep@tmp@proofbeginanchor}%
        \codep@proof@emitheadinganchorname{\codep@tmp@proofbeginanchor}%
        \expandafter\xdef%
          \csname codep@proofbeginanchor@%
            \codep@tmp@headingproofid\endcsname{\codep@tmp@proofbeginanchor}%
      }{}%
    \fi%
  \fi%
}%

%% @utility
% \codep@proof@bindbeginanchor{proof-id}{proof-key}
%   Bind proof-key to the proof-begin destination emitted for proof-id.
\newcommand*{\codep@proof@bindbeginanchor}[2]{%
  \expandafter\ifx\csname codep@proofbeginanchor@#1\endcsname\relax%
    \codep@proof@beginanchorname{#1}{\codep@tmp@proofanchor}%
  \else%
    \edef\codep@tmp@proofanchor{%
      \csname codep@proofbeginanchor@#1\endcsname}%
  \fi%
  \codep@writeanchormapvalue{#2}{\codep@tmp@proofanchor}%
}%

%% @utility
% \codep@proof@capturebeginpage{proof-id}
%   Snapshot \thepage at proof begin so later key rebinds can
%   keep the proof-start page rather than the resolution page.
\newcommand*{\codep@proof@capturebeginpage}[1]{%
  \edef\codep@tmp@proofbeginpage{\thepage}%
  \expandafter\xdef\csname codep@proofbeginpage@#1\endcsname{%
    \codep@tmp@proofbeginpage}%
}%

%% @utility
% \codep@proof@writebeginpage{proof-id}{proof-key}
%   Persist the proof-start page under the current proof key.
\newcommand*{\codep@proof@writebeginpage}[2]{%
  \expandafter\ifx\csname codep@proofbeginpage@#1\endcsname\relax%
    \codep@writeanchorpagecurrent{#2}%
  \else%
    \edef\codep@tmp@proofpage{%
      \csname codep@proofbeginpage@#1\endcsname}%
    \codep@writeanchorpage{#2}{\codep@tmp@proofpage}%
  \fi%
}%

%% @behavior B-PROOF-NONADJ
%% @behavior B-EDGE-EMPTY-PROOF
% \codep@proof@materialize
%   Materialize the current proof as a standalone proof atom.
%   Standalone proofs do NOT consume a shared-counter slot — their
%   key uses the opaque atom-id (\codep@currentproofid → "proof:a<N>")
%   so the atom remains addressable for graph queries while being
%   suppressed from rendered source-token output by the
%   collapsebr classifier (codependent-render.sty:codep@collapsebr@cb).
%   Adjacent and \codepproofof-rebound proofs continue to bind a
%   "proof:N.M" key via \codep@proof@adjacent / \codep@proofof@resolve;
%   only the standalone path lands here.
\newcommand*{\codep@proof@materialize}{%
  \global\codep@proofdisplaypendingfalse%
  \global\codep@autoproofof@eligiblefalse%
  \edef\codep@tmp@proofkey{proof:\codep@currentproofid}%
  \codep@atomsetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
  \codep@proof@writebeginpage{\codep@currentproofid}{\codep@tmp@proofkey}%
  \codep@proof@bindbeginanchor{\codep@currentproofid}{\codep@tmp@proofkey}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@atom{\codep@currentproofid}{proof}}%
  \codep@cdpwrite@atom{%
    \string\codep@cdp@meta{\codep@currentproofid}{src}%
      {\jobname.tex:\the\inputlineno:1}}%
  \codep@registeratom{\codep@tmp@proofkey}{proof}%
  \codep@render@queuebackref{\codep@tmp@proofkey}%
  \ifbool{codep@proofwarnings}{%
    \PackageWarning{codependent}{Proof not adjacent to a tracked\space%
      environment and has no \string\codepproofof\space binding;\space%
      suppressed from backref source-token output}%
  }{}%
}%

%% @behavior B-PROOF-ADJ
%% @behavior B-PROOF-DELAYED-COMMIT
% \codep@proof@adjacent
%   Stage the pending adjacent theorem/result atom for delayed binding.
\newcommand*{\codep@proof@adjacent}{%
  \codep@atomgetkey{\codep@pendingresultid}{\codep@tmp@adjtargetkey}%
  \codep@atomgetdisplay{\codep@pendingresultid}{\codep@tmp@adjtargetdisplay}%
  % see @behavior B-PROOF-DELAYED-COMMIT on this macro.
  \expandafter\xdef\csname codep@adjcandidate@%
    \codep@currentproofid\endcsname{\codep@pendingresultid}%
  \expandafter\xdef\csname codep@adjcandidate@target@%
    \codep@currentproofid\endcsname{\codep@tmp@adjtargetkey}%
  \expandafter\xdef\csname codep@adjcandidate@display@%
    \codep@currentproofid\endcsname{\codep@tmp@adjtargetdisplay}%
  \expandafter\xdef\csname codep@proofadjtarget@%
    \codep@currentproofid\endcsname{\codep@tmp@adjtargetkey}%
  \expandafter\xdef\csname codep@proofadjdisplay@%
    \codep@currentproofid\endcsname{\codep@tmp@adjtargetdisplay}%
  \global\codep@proof@adjcommit@neededtrue%
  \codep@atomgetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
  \global\let\codep@proofadj@pendinganchormapkey\@empty%
  \global\let\codep@proofadj@pendinganchormapanchor\@empty%
  \codep@proof@bindbeginanchor{\codep@currentproofid}{\codep@tmp@proofkey}%
  \codep@proof@writebeginpage{\codep@currentproofid}{\codep@tmp@proofkey}%
  \global\let\codep@pendingresultid\@empty%
}%

% \codep@proof@adjcandidate@clear{proof-id}
%   Clear staged adjacent-candidate state for proof-id.
%% @implements \codep@proof@adjacent
% see @behavior B-PROOF-DELAYED-COMMIT at \codep@proof@adjacent.
\def\codep@proof@adjcandidate@clear#1{%
  \global\expandafter\let\csname codep@adjcandidate@#1\endcsname\relax%
  \global\expandafter\let%
    \csname codep@adjcandidate@target@#1\endcsname\relax%
  \global\expandafter\let%
    \csname codep@adjcandidate@display@#1\endcsname\relax%
}%

% \codep@proof@adjcandidate@drop{proof-id}
%   Drop a staged adjacent candidate without committing it.
%% @implements \codep@proof@adjacent
\def\codep@proof@adjcandidate@drop#1{%
  \global\codep@proof@adjcommit@neededfalse%
  \codep@proof@adjcandidate@clear{#1}%
  \global\expandafter\let\csname codep@proofadjtarget@#1\endcsname\relax%
  \global\expandafter\let\csname codep@proofadjdisplay@#1\endcsname\relax%
}%

% \codep@proof@adjacent@commit{proof-id}{target-id}
%   Commit a staged adjacent binding after proof-heading scan returns.
%% @implements \codep@proof@adjacent
% see @behavior B-PROOF-DELAYED-COMMIT at \codep@proof@adjacent.
\def\codep@proof@adjacent@commit#1#2{%
  \codep@bindproofparent{#1}{#2}{statement}%
  \global\codep@proofdisplaypendingfalse%
  \codep@atomgetkey{#1}{\codep@tmp@proofkey}%
  \codep@render@queuebackref{\codep@tmp@proofkey}%
  \global\codep@proof@adjcommit@neededfalse%
  \codep@proof@adjcandidate@clear{#1}%
}%

% \codep@proof@adjacent@finalize
%   Commit the current proof's staged adjacent candidate, if any.
%% @implements \codep@proof@adjacent
% see @behavior B-PROOF-DELAYED-COMMIT at \codep@proof@adjacent.
\def\codep@proof@adjacent@finalize{%
  \ifcodep@proof@adjcommit@needed%
    \expandafter\ifx%
        \csname codep@adjcandidate@\codep@currentproofid\endcsname\relax%
      \global\codep@proof@adjcommit@neededfalse%
    \else%
      \edef\codep@tmp@adjproofid{\codep@currentproofid}%
      \edef\codep@tmp@adjtargetid{%
        \csname codep@adjcandidate@\codep@tmp@adjproofid\endcsname}%
      \codep@proof@adjacent@commit{%
        \codep@tmp@adjproofid}{\codep@tmp@adjtargetid}%
    \fi%
  \fi%
}%

%% @behavior B-PROOF-OFF
%% @behavior B-PROOF-NONADJ
% \codep@hookproof@end
%   Finalize and unwind the current proof environment.  Stash the
%   current proof key in \codep@proofend@pendingclear BEFORE
%   \codep@proofstaterestore overwrites \codep@currentproofid, so
%   \codep@hookproof@afterend can later clear the per-atom
%   \codep@manuallyemitted@<key> flag after the environment closes.
\newcommand*{\codep@hookproof@end}{%
  \ifbool{codep@proofsnumbered}{%
    \codep@ctxpeekkind\codep@tmp@ctxkind%
    \def\codep@tmp@proofkind{proof}%
    \ifx\codep@tmp@ctxkind\codep@tmp@proofkind%
      \ifcodep@proofdisplaypending%
        \codep@proof@materialize%
      \fi%
      \codep@ctxpeekid\codep@thisproofid%
      \codep@autoproofof@checkseen{proof}{\codep@thisproofid}%
      \codep@render@proof@end%
      \codep@ctxpop{proof}%
      \global\let\codep@pendingresultid\@empty%
      \codep@atomgetkey{\codep@currentproofid}{\codep@tmp@proofkey}%
      \xdef\codep@proofend@pendingclear{\codep@tmp@proofkey}%
      % W03-P03/W05-A2: capture entitymeta for this just-closed proof.
      % The stable proof source key is proof:a<N>; display now comes
      % from proof target metadata rather than the key suffix.
      \codep@graph@getdisplay{\codep@tmp@proofkey}{\codep@tmp@num}%
      \ifx\codep@tmp@num\@empty%
        \expandafter\codep@splitprefix\codep@tmp@proofkey\@nil%
      \fi%
      \codep@prooftargetmeta@firstkey{\codep@tmp@proofkey}{%
        \codep@tmp@proofparentval}%
      \ifx\codep@tmp@proofparentval\@empty%
        \expandafter\let\expandafter\codep@tmp@proofparentval%
          \csname codep@proofparent@\codep@thisproofid\endcsname%
      \fi%
      \ifx\codep@tmp@proofparentval\relax%
        \let\codep@tmp@proofparentval\@empty%
      \fi%
      \codep@captureentitymeta{\codep@tmp@proofkey}{proof}%
        {\codep@tmp@num}{proof}{\codep@tmp@proofparentval}%
      \codep@proofof@attribcount@clear{\codep@thisproofid}%
      \codep@proofstaterestore{\codep@thisproofid}%
    \fi%
  }{}%
  \global\advance\codep@suppressdepth by -1\relax%
}%

%% @behavior B-REND-INLINE
% \codep@hookproof@afterend
%   Post-env hook body.  Proof destinations are emitted at
%   proof-begin; this afterend hook only runs the rendering
%   follow-up and clears the per-atom \codep@manuallyemitted@<key>
%   flag for the proof that just closed.
\newcommand*{\codep@hookproof@afterend}{%
  \codep@render@proof@afterend%
  \ifnum\codep@replaydepth=0\relax%
    \ifx\codep@proofend@pendingclear\@empty\else%
      \codep@manuallyemitted@clear@key{\codep@proofend@pendingclear}%
      \global\let\codep@proofend@pendingclear\@empty%
    \fi%
  \fi%
}%

%% ===================================================================
%% Section 7: Paragraph numbering
%% ===================================================================

%% @behavior B-SUPP-EXTEND
% \codep@suppressenv{envname}
%   Increment suppressdepth on entry, decrement it on exit.
\newcommand*{\codep@suppressenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\advance\codep@suppressdepth by 1\relax
  }%
  \AtEndEnvironment{#1}{%
    \global\advance\codep@suppressdepth by -1\relax
  }%
}%

%% --- Equation backref tracking (two-track design) ---
%% Track 1: single-number environments (equation).
%% Track 2: multi-number environments (align, gather, multline, flalign).

%% @behavior B-EQ-OUTER
%% @behavior B-EQ-ALL
%% @behavior B-EQ-OFF
% \codep@eqshouldtrack
%   Set \codep@eqatom to a non-empty sentinel if this block owns refs.
\newcommand*{\codep@eqshouldtrack}{%
  \def\codep@eqatom{}%
  \ifx\codep@equationmode\codep@const@off%
  \else\ifx\codep@equationmode\codep@const@outer%
    \ifnum\codep@trackeddepth>0\relax\else%
      \def\codep@eqatom{pending}%
    \fi%
  \else%
    \def\codep@eqatom{pending}%
  \fi\fi%
}%

%% @behavior B-EQ-TRACK1
% \codep@trackeqenv{envname}
%   Track one-row equation environments.
\newcommand*{\codep@trackeqenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\let\codep@pendingresultid\@empty%
    \global\advance\codep@suppressdepth by 1\relax%
    \booltrue{codep@inequation}%
    \boolfalse{codep@eqmultiline}%
    \boolfalse{codep@eqnumbered}%
    \codep@getcurrentownerid\codep@tmp@eqowner%
    \xdef\codep@eqfallbacksourceid{\codep@tmp@eqowner}%
    \global\let\codep@currenteqsourceid\@empty%
    \ifnum\codep@trackeddepth>0\relax\else%
      \global\def\codep@eq@lbltype@pending{equation}%
    \fi%
    \codep@eqshouldtrack%
    \ifx\codep@eqatom\@empty\else%
      \codep@allocatomid{\codep@currenteqsourceid}{equation}%
      \codep@ctxpush{\codep@currenteqsourceid}{equation}%
    \fi%
  }%
  \AtEndEnvironment{#1}{%
    \boolfalse{codep@inequation}%
    \def\codep@eqatom{}%
    \ifx\codep@currenteqsourceid\@empty\else%
      \codep@ctxpop{equation}%
    \fi%
    \global\let\codep@currenteqsourceid\@empty%
    \global\let\codep@eqfallbacksourceid\@empty%
    \global\advance\codep@suppressdepth by -1\relax%
  }%
  \AfterEndEnvironment{#1}{%
    \global\let\codep@eq@lbltype@pending\@empty%
  }%
}%

%% @behavior B-EQ-TRACK2
% \codep@trackalignenv{envname}
%   Track multi-row equation environments.
\newcommand*{\codep@trackalignenv}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\let\codep@pendingresultid\@empty%
    \global\advance\codep@suppressdepth by 1\relax%
    \booltrue{codep@inequation}%
    \booltrue{codep@eqmultiline}%
    \boolfalse{codep@eqnumbered}%
    \codep@getcurrentownerid\codep@tmp@eqowner%
    \xdef\codep@eqfallbacksourceid{\codep@tmp@eqowner}%
    \global\let\codep@currenteqsourceid\@empty%
    \ifnum\codep@trackeddepth>0\relax\else%
      \global\def\codep@eq@lbltype@pending{equation}%
    \fi%
    \global\codep@eq@startcount=\c@equation\relax%
    % Clear SW5c pending-append guards from the previous equation block.
    \the\codep@eqpendguards%
    \global\codep@eqpendguards={}%
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax%
    \codep@eqshouldtrack%
    \ifx\codep@eqatom\@empty\else%
      \codep@allocatomid{\codep@currenteqsourceid}{equation}%
      \codep@ctxpush{\codep@currenteqsourceid}{equation}%
    \fi%
    \@ifpackageloaded{hyperref}{%
      \xdef\codep@eq@anchor{codep.eq.\the\c@equation}%
      \codep@proof@emitanchorname{\codep@eq@anchor}%
    }{}%
  }%
  \AtEndEnvironment{#1}{%
    \boolfalse{codep@inequation}%
    \boolfalse{codep@eqmultiline}%
    \def\codep@eqatom{}%
  }%
  \AfterEndEnvironment{#1}{%
    \ifnum\codep@eqpendingcount>0\relax%
      \codep@flusheqrange%
    \fi%
    \ifx\codep@currenteqsourceid\@empty\else%
      \codep@ctxpop{equation}%
    \fi%
    \global\let\codep@currenteqsourceid\@empty%
    \global\let\codep@eqfallbacksourceid\@empty%
    \global\let\codep@eq@lbltype@pending\@empty%
    \global\advance\codep@suppressdepth by -1\relax%
  }%
}%

%% @behavior B-EDGE-DEDUP
%% @behavior B-EDGE-MULTI-SAME
% \codep@dedupwrite{src}{tgt}
%   Per-(source, target) dedup write.  If the csname flag
%   codep@arw@<src>@<tgt> is undefined (\relax), set it to
%   \@empty and write \codep@atomref{src}{tgt} to the .aux
%   file.  Otherwise skip (already written this run).
\def\codep@dedupwrite#1#2{%
  \expandafter\ifx%
      \csname codep@arw@#1@#2\endcsname\relax
    \global\expandafter\let%
      \csname codep@arw@#1@#2\endcsname\@empty%
    \codep@ifunresrefkey{#1}{%
      \codep@unresref@rememberref{#1}{#2}%
    }{%
      \protected@write\@auxout{}{%
        \string\codep@atomref{#1}{#2}}%
    }%
  \fi
}

% \codep@unresref@rememberref{unresref-key}{target-label}
%   Remember atomrefs written under a provisional proof source so drain
%   can mirror them under the final proof:N.M key in the same aux pass.
%% @utility
\def\codep@unresref@rememberref#1#2{%
  \expandafter\ifx\csname codep@unresrefs@#1\endcsname\relax%
    \expandafter\gdef\csname codep@unresrefs@#1\endcsname{}%
  \fi%
  \expandafter\g@addto@macro\csname codep@unresrefs@#1\endcsname{%
    \do{#2}}%
}%

% \codep@unresref@flushrefs{unresref-key}{final-proof-key}
%   Live migration path for forward-ref proof-heading body cites.  During
%   proof body scanning, \codep@dedupwrite intercepts unresref:<N> source
%   writes and stores their targets in memory through
%   \codep@unresref@rememberref instead of emitting provisional atomrefs to
%   the .aux.  When the deferred auto resolver later learns the final
%   proof:N.M key, this helper mirrors those remembered refs under that
%   final key in the same aux pass.  The appendbr unresref branch remains as
%   a defensive backup for any provisional source that reaches replay.
%% @implements \codep@proofof@resolve
\def\codep@unresref@flushrefs#1#2{%
  \expandafter\ifx\csname codep@unresrefs@#1\endcsname\relax%
  \else%
    \begingroup%
      \def\codep@tmp@unresreffinal{#2}%
      \def\do##1{%
        \codep@dedupwrite{\codep@tmp@unresreffinal}{##1}}%
      \csname codep@unresrefs@#1\endcsname%
    \endgroup%
  \fi%
}%

% \codep@flusheqrange@numbered
%   Numbered-line path: counter advanced, so compute the
%   equation range, write the anchormap entry, and flush
%   all pending refs with dedup.
%% @behavior B-DISP-EQRANGE
% \codep@flusheqrange@numbered
%   Compute the legacy equation range key and flush pending refs.
\def\codep@flusheqrange@numbered{%
  % Compute formatted start: saved+1 in a group.
  \begingroup
    \c@equation=\codep@eq@startcount\relax
    \advance\c@equation by 1\relax
    \xdef\codep@tmp@eqstart{\theequation}%
  \endgroup
  \edef\codep@tmp@eqend{\theequation}%
  % Build the equation:-prefixed key; display renders as (N) or (N--M).
  \ifx\codep@tmp@eqstart\codep@tmp@eqend%
    % Single numbered line: equation:N
    \edef\codep@eqatom{equation:\codep@tmp@eqstart}%
  \else%
    % Range: equation:N--M
    \edef\codep@eqatom{equation:\codep@tmp@eqstart--\codep@tmp@eqend}%
  \fi%
  \ifx\codep@currenteqsourceid\@empty\else%
    \codep@atomsetkey{\codep@currenteqsourceid}{\codep@eqatom}%
  \fi%
  % Write anchormap entry using dedicated block anchor.
  \@ifpackageloaded{hyperref}{%
    \expandafter\xdef%
      \csname codep@anchor@\codep@eqatom\endcsname%
      {\codep@eq@anchor}%
    \if@filesw%
      \protected@write\@auxout{}{%
        \string\codep@anchormap{\codep@eqatom}{\codep@eq@anchor}}%
    \fi%
  }{}%
  % Flush all pending refs (with dedup).
  \if@filesw%
    \def\codep@eqpending@entry##1{%
      \codep@dedupwrite{\codep@eqatom}{##1}%
    }%
    \the\codep@eqpending%
  \fi%
}%

%% @behavior B-EQ-NOTAG
%% @behavior B-EDGE-NOTAG
% \codep@flusheqrange@fallback
%   All-notag path: replay pending refs from the enclosing owner.
\def\codep@flusheqrange@fallback{%
  \codep@atomgetkey{\codep@eqfallbacksourceid}{\codep@tmp@srcatom}%
  \ifx\codep@tmp@srcatom\@empty\else%
    \if@filesw%
      \def\codep@eqpending@entry##1{%
        \codep@dedupwrite{\codep@tmp@srcatom}{##1}%
      }%
      \the\codep@eqpending%
    \fi%
  \fi%
}%

%% @behavior B-EQ-TRACK2
% \codep@flusheqrange
%   Compute the equation range and flush all pending refs.
%   Called at \end{align} (Track 2).  Dispatches to
%   \codep@flusheqrange@numbered or @fallback.
\def\codep@flusheqrange{%
  % Check equation mode.
  \codep@eqshouldtrack%
  \ifx\codep@eqatom\@empty%
    % Mode says don't track; silently drop pending refs.
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
  \else
    % Check if counter advanced (at least one numbered line).
    \ifnum\c@equation>\codep@eq@startcount\relax
      \codep@flusheqrange@numbered%
    \else
      \codep@flusheqrange@fallback%
    \fi
    \global\codep@eqpending={}%
    \global\codep@eqpendingcount=0\relax
  \fi
}

% \codep@suppresscmd{command}
%   Patch a command to suppress numbering in its body.
%% @behavior B-SUPP-EXTEND
% \codep@suppresscmd{command}
%   Patch a command to suppress paragraph numbering in its body.
\newcommand*{\codep@suppresscmd}[1]{%
  \pretocmd{#1}{\global\advance\codep@suppressdepth by 1\relax}{}{}%
  \apptocmd{#1}{\global\advance\codep@suppressdepth by -1\relax}{}{}%
}%

%% @utility
% \codep@withsuppression{tokens}
%   Execute tokens with codep@suppressdepth incremented, then
%   decremented.  Suppression is balanced by construction.
%   \global\advance is required: caller may be inside a group
%   (e.g., \AfterEndEnvironment callbacks).
\def\codep@withsuppression#1{%
  \global\advance\codep@suppressdepth\@ne\relax%
  #1%
  \global\advance\codep@suppressdepth\m@ne\relax%
}%

\newif\ifcodep@footnotesuppressed
%% @behavior B-EDGE-FOOTNOTE
% \codep@suppressfootnote
%   Suppress paragraph atoms and source attribution while the footnote
%   body is typeset; direct wrapping avoids \footnote's \unskip path.
\newcommand*{\codep@suppressfootnote}{%
  \ifcodep@footnotesuppressed%
  \else%
    \global\codep@footnotesuppressedtrue%
    \let\codep@orig@footnote\footnote%
    \RenewDocumentCommand{\footnote}{o +m}{%
      \global\advance\codep@sourceblockdepth\@ne\relax%
      \codep@withsuppression{%
        \IfNoValueTF{##1}{%
          \codep@orig@footnote{##2}%
        }{%
          \codep@orig@footnote[##1]{##2}%
        }%
      }%
      \global\advance\codep@sourceblockdepth\m@ne\relax%
    }%
  \fi%
}%

