    \codep@autoproofof@scan@label@dispatch%
}%

% \codep@autoproofof@scan@cref
%   Consume \cref and then one comma-separated label argument.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@cref\cref{%
  \futurelet\codep@autoproofof@nexttoken%
    \codep@autoproofof@scan@csv@dispatch%
}%

% \codep@autoproofof@scan@label@dispatch
%   Route starred/non-starred \ref-like commands.
%% @implements \codep@hookproof
\def\codep@autoproofof@scan@label@dispatch{%
  \ifx\codep@autoproofof@nexttoken\codep@autoproofof@star%
    \let\codep@autoproofof@next\codep@autoproofof@scan@label@star%
  \else%
    \let\codep@autoproofof@next\codep@autoproofof@scan@label%
  \fi%
