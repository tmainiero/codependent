{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "bash -c 'CHANGED=\"$CLAUDE_FILE_PATH\"; case \"$CHANGED\" in *.sty) python3 .claude/scripts/lint_sty_structural.py \"$CHANGED\" ;; *.lvt) .claude/scripts/lint-tests.sh \"$CHANGED\" ;; esac'",
        "description": "Structural lint .sty files after edit; lint .lvt files after edit",
        "blocking": true
      }
    ],
    "PreCommit": [
      {
        "command": "python3 .claude/scripts/lint_sty_structural.py && .claude/scripts/lint-tests.sh",
        "description": "Structural lint all .sty and .lvt files before commit",
        "blocking": true
      }
    ]
  }
}
